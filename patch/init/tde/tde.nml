This is the RAMSES parameter file for TDE simulation.
Compile the code with:

make NDIM=3 MPI=1 GRAV=1 HYDRO=1 NPSCAL=1 PATCH=../patch/init/tde

&RUN_PARAMS
hydro=.true.
poisson=.true.
ncontrol=1
nsubcycle=20*1,
nrestart=0
verbose=.false.
/

&AMR_PARAMS
levelmin=5
levelmax=20
ngridmax=1000000
nexpand=10*1
boxlen=1e4
/

&INIT_PARAMS
/

&OUTPUT_PARAMS
delta_tout=1.0
tend=1000.
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
riemann='hllc'
smallr=1d-22
smallc=1d-20
entropy=.true.
dual_energy=0.01
/

&REFINE_PARAMS
m_refine=20*1
mass_sph=1e-12
interpol_var=0
interpol_type=0
/

&POISSON_PARAMS
gravity_type=1
/
