This namelist contains various input parameters for the sedov2d test.
Compile using:
make NDIM=2 MPI=1 HYDRO=1

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=10*1,
verbose=.false.
nremap=10
/

&AMR_PARAMS
levelmin=3
levelmax=11
ngridmax=800000
/

&BOUNDARY_PARAMS
bound_levelmin=3
box_size=1.0
box_xmin=1
box_ymin=1
box_xmax=-1
box_ymax=-1
nbound=4
periodic=.false.,.false.
bound_dir=1,1,2,2
bound_type=1,1,1,1
bound_shift=1,-1,1,-1
bound_xmin= 0,-1, 0, 0
bound_ymin= 1, 1, 0,-1
bound_xmax= 1, 0, 0, 0
bound_ymax=-1,-1, 1, 0
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='point'
x_center=0.5,0.0
y_center=0.5,0.0
length_x=10.0,1.0
length_y=10.0,1.0
exp_region=10.0,10.0
d_region=1.0,0.0
u_region=0.0,0.0
v_region=0.0,0.0
p_region=1e-5,0.4
/

&OUTPUT_PARAMS
tout=0.5
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=1
/

&REFINE_PARAMS
interpol_var=0
interpol_type=0
err_grad_p=0.1
/
