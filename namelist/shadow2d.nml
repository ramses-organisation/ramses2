This namelist contains various input parameters for a 2d shadow test
from Iliev et al. test 7.
Compile using:
make NDIM=2 DO_RT=1 NRTGRP=1 NION=1 MPI=1

&RUN_PARAMS
hydro=.true.
rt=.true.
nrestart=0
nsubcycle=10*2
static_gas=.true.
verbose=.false.
/

&AMR_PARAMS
levelmin=5
levelmax=10
ngridmax=800000
nexpand=1
/

&BOUNDARY_PARAMS
bound_levelmin=5
box_size=6.6
box_xmin=2
box_xmax=-2
box_ymin=5
box_ymax=-5
nbound=4
periodic=.false.,.false.
bound_dir=1,1,2,2
bound_type=3,2,2,2
bound_shift=1,-1,1,-1
bound_xmin= 0,-2, 0, 0
bound_xmax= 2, 0, 0, 0
bound_ymin= 5, 5, 0,-5
bound_ymax=-5,-5, 5, 0
d_bound=2.d-4
p_bound=1.391794d-08
var_bound=1.
rt_n_bound=4.47d5        ! Source flux (photons per cm per sec)
rt_u_bound=1.            ! Reduced x-direction flux
rt_v_bound=0.            ! Reduced y-direction flux
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=3.30, 5.00
y_center=1.65, 1.65
length_x=10.0, 1.6
length_y=10.0, 1.6
exp_region=10.0, 2.
d_region=2.d-4, 4.d-2			! (1=1e-3 cm-3)
u_region=0.0, 0.0
v_region=0.0, 0.0
p_region= 1.391794d-08, 1.391795d-08	! 8000 K and 40 K
/

&OUTPUT_PARAMS
tout=0.1,0.2,0.5,1,2,5
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=1
/

&UNITS_PARAMS
units_density=1.66000d-24
units_time=3.1556926d13		! 1 Myr in seconds
units_length=3.08568025d21 	! 1 kpc in cm
/

&COOLING_PARAMS                 ! Cooling / basic chemistry
neq_chem=.true.
isHe=.false.
isH2=.false.
X_H=1.0
Y_He=0.0
neq_TConst=1d4                  ! Force constant gas temperature of 10^4 K
is_init_xion=.true.
/

&REFINE_PARAMS
err_grad_d=0.3
err_grad_xHII=0.3
/

&RT_PARAMS
rt_advect=.true.
rt_c_fraction=0.01
rt_nsubcycle=1
/

&RT_GROUPS                       ! Photon group properties
group_csn(1,:)= 1.6d-18          ! group 1 cross sec. -> HI, HeI, HeII [cm^2]
group_cse(1,:)= 1.1d-18          ! group 1 e-weighted cs -> HI, HeI, HeII [cm^2]
group_egy     = 29.6             ! group 1 photon energy [eV]
/
