2D cosmic ray induced blast test, as shown in Fig 7 of Rosdahl+25 (Cosmic Rays in RAMSES)
make DO_CR=1 NDIM=2 MPI=1

&RUN_PARAMS
hydro=.true.
nremap=10
ncontrol=1
nsubcycle=10*2
static_gas=.false.
cr=.true.
/

&AMR_PARAMS
levelmin=6
levelmax=9
ngridmax=10000
nexpand=1
/

&BOUNDARY_PARAMS
box_size=1.0
/

&CR_PARAMS
cr_advect=.true.
cr_streaming_diffusion=.false.
cr_streaming_heating=.false.
cr_c_fraction=3.3356409297285193e-9  ! light-speed=100
cr_nsubcycle=10
cr_reduced_flux_correction=.true.
cr_courant_factor=0.8
/

&CR_GROUPS
cr_d=0.033333333
cr_d_perp_factors=1d-12
/

&INIT_PARAMS
nregion=2
region_type(1)='square'
region_type(2)='square'
x_center=0.5,0.5
y_center=0.5,0.5
length_x=10.0,0.04
length_y=10.0,0.04
d_region=1.,1.0
u_region=0.0,0.0
v_region=0.0,0.0
p_region=1.66667,1.66667
prad_region(:,1) = 0.033333333, 33.3333333
A_ave=1.0
B_ave=0.0
C_ave=0.0
/

&OUTPUT_PARAMS
tout=0.1
!foutput=20
/

&HYDRO_PARAMS
gamma=1.66667
courant_factor=0.8
slope_type=2
riemann='hlld'
/

&REFINE_PARAMS
err_grad_d=0.05
err_grad_p=0.05
err_grad_prad=0.05
interpol_var=0
interpol_type=1
/
