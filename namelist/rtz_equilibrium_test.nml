This namelist contains various input parameters for a 1 zone RTZ EQM test. Set rtz_equilibrium_test=1 for
equilibrium cooling curves or 2 for ionization states in T=[1e2,1e8] at fixed density
Compile using:
make NDIM=1 INIT=RTZEQM DO_RT=1 DO_RTZ=1 NRTGRP=1 NMETAL=10 N_HYDROGEN_IONS=2 N_H2=1 N_HELIUM_IONS=3 N_CARBON_IONS=7 N_NITROGEN_IONS=8 N_OXYGEN_IONS=9 N_NEON_IONS=11 N_MAGNESIUM_IONS=13 N_SILICON_IONS=15 N_SULFUR_IONS=17 N_IRON_IONS=27 NVECTOR=1

&RUN_PARAMS
hydro=.true.
rt=.false.
ncontrol=1
verbose=.false.
static_gas=.true.
nrestart=0
nstepmax=1
/

&AMR_PARAMS
levelmin=4
levelmax=4
ngridmax=80000
/

&INIT_PARAMS
aexp_ini=1.d-3
/

&BOUNDARY_PARAMS
bound_levelmin=4
box_size=1.0
box_xmin=1
box_xmax=-1
nbound=2
periodic=.false.
bound_dir=1,1
bound_type=1,1
bound_shift=1,-1
bound_xmin= 0,-1
bound_xmax= 1, 0
/

&OUTPUT_PARAMS
foutput=1
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=1
/

&UNITS_PARAMS                   ! Unit conversion to cgs. We work in kpc-mp-Myr.
units_length=3.09d21            ! 1 kpc in cm
units_density=1.66000d-24       ! 1 proton mass
units_time=3.1556926d13         ! 1 Myr in seconds
/

&COOLING_PARAMS                 ! Cooling / basic chemistry
neq_chem=.true.
rtz_cooling=.true.
rtz_equilibrium_test=1         ! 1 for t-rho eqm curves, 2 for ion fracs at fixed T
rtz_include_collisional_ionization=.true.
rtz_include_photoionization=.true.
rtz_include_cosmic_ray_ionization=.true.
rtz_include_charge_exchange=.true.
rtz_include_dust_recombination=.true.
rtz_include_HM12_UVB=.true.
rtz_UV_background_G0=1.0d0
rtz_primary_cosmic_ray_ionization_rate=1.d-16
rtz_max_cool_timestep=1.d11
rtz_eqm_min_its=10000
isH2_rtz=.true.
neq_TConst=-1.d0                  ! Force constant gas temperature of 10^4 K
is_init_xion=.true.
z_ave = 1.d0
/

&REFINE_PARAMS
interpol_var=0
interpol_type=0
/
