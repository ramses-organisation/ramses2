This is the RAMSES parameter file for the ABC flow test in Teyssier, Fromang and Dormy (2006).
make NDIM=3 MPI=1 HYDRO=1 MHD=1 INIT=ABC NSUBGRID=4

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=4*1,2
verbose=.false.
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=2000000
nexpand=1
boxlen=1
/

&INIT_PARAMS
C_ave=0.001
/

&OUTPUT_PARAMS
delta_tout=0.1
tend=10.
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
riemann='upwind'
riemann2d='upwind'
induction=.true.
etamag=0.001
/

&REFINE_PARAMS
err_grad_b2=0.1
interpol_var=0
interpol_type=2
/
