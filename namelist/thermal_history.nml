&INIT_PARAMS
filetype='ascii'
initfile(1)='.'
H0=72.
omega_m=0.3
omega_l=0.7
omega_b=0.045
boxlen_ini=25.
aexp_ini=0.0005
delta_ini=0.
/

&AMR_PARAMS
levelmin=3
levelmax=3
ngridmax=100
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.5
slope_type=2
riemann='hllc'
/

&COOLING_PARAMS
neq_chem=.true.
haardt_madau=.true.
z_reion=8.
eos_T2=0.01
/
