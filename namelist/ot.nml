This namelist contains various input parameters for the Orszag-Tang MHD test.
Compile using:
make NDIM=2 MPI=1 HYDRO=1 MHD=1 INIT=OT

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=1,2
verbose=.false.
/

&AMR_PARAMS
levelmin=5
levelmax=9
ngridmax=80000
nexpand=1
boxlen=1.0
/

&INIT_PARAMS
/

&OUTPUT_PARAMS
tout=0.5,1.0
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
riemann='hlld'
riemann2d='hlld'
/

&REFINE_PARAMS
err_grad_p=0.15
interpol_var=0
interpol_type=2
/
