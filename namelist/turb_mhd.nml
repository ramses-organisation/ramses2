This namelist contains the parameters for a turbulent driving simulation with MHD.
Compile using:
make NDIM=3 MPI=1 HYDRO=1 TURB=1 MHD=1
Note that you must have the FFTW library properly installed.
You can specify the location of the FFTW library if needed:
make NDIM=3 MPI=1 HYDRO=1 TURB=1 MHD=1 FFTW=$HOME/local_fftw

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=10*1,
verbose=.false.
nremap=10
/

&AMR_PARAMS
levelmin=8
levelmax=8
ngridmax=3000000
boxlen=4
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=2
y_center=2
z_center=2
length_x=4.0
length_y=4.0
length_z=4.0
exp_region=10.0
d_region=0.28954719470909174
p_region=0.030361026190591216
C_ave=1e-12
/

&OUTPUT_PARAMS
delta_tout=1.
tend=100.
/

&TURB_PARAMS
turb=.true.
turb_seed=1
comp_frac=0.3333333333333333
forcing_power_spectrum='power_law'
turb_T=0.29241000937376255
turb_Ndt=100
turb_rms=5.094074502271999
turb_min_rho=2.5470372511355715d-6
/

&UNITS_PARAMS
units_density=1.50492957435d-20
units_time=3.1556926d13
units_length=3.0857d18
/

&COOLING_PARAMS
isothermal=.true.
eos_type=1
eos_T2=4.2194
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=1
slope_mag_type=2
riemann='hlld'
riemann2d='hlld'
switch_llf_dmin=1e-6
/

&REFINE_PARAMS
interpol_var=0
interpol_type=0
err_grad_p=0.1
/
