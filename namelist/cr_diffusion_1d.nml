1d cosmic ray diffusion test, as shown in Fig 2 of Rosdahl+25 (Cosmic Rays in RAMSES).
make DO_CR=1 NDIM=1 MPI=1

&RUN_PARAMS
hydro=.true.
nremap=10
ncontrol=1
nsubcycle=10*2
static_gas=.false.
cr=.true.
/

&AMR_PARAMS
levelmin=7
levelmax=9
ngridmax=10000
nexpand=1
/

&BOUNDARY_PARAMS
box_size=2.0
/

&CR_PARAMS
cr_advect=.true.
cr_streaming_diffusion=.false.
cr_streaming_heating=.false.
cr_c_fraction=3.3356409297285193e-9  ! light-speed=100
cr_nsubcycle=10
cr_reduced_flux_correction=.false.
cr_courant_factor=0.8
cr_test_setup='diffusion'
/

&CR_GROUPS
cr_d=0.1d0
cr_d_perp_factors=1d-6
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=0.5
length_x=100.0
d_region=1.0
u_region=1.0
v_region=0.0
w_region=0.0
p_region=100.0
A_ave=1.0
B_region=0.0
C_region=0.0
/

&OUTPUT_PARAMS
tout=0.05,0.1
tout=0.2,0.4
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=1
riemann='hlld'
/

&REFINE_PARAMS
err_grad_prad=0.05
/
