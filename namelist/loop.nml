This namelist contains various input parameters for the MHD loop advection test.
Compile using:
make NDIM=2 MPI=1 HYDRO=1 MHD=1 INIT=LOOP

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=1,2
verbose=.false.
/

&AMR_PARAMS
levelmin=7
levelmax=9
ngridmax=80000
nexpand=1
boxlen=2
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=1.0,
y_center=1.0,
z_center=1.0,
length_x=10.0,
length_y=10.0,
length_z=10.0,
exp_region=10.0,
d_region=1.0,
u_region=2.0,
v_region=1.0,
w_region=0.0,
p_region=1.0,
C_region=0.0,
C_ave=0.0
/

&OUTPUT_PARAMS
tout=2.0
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
riemann='hlld'
riemann2d='hlld'
/

&REFINE_PARAMS
err_grad_b2=0.05
floor_b2=1d-8
interpol_var=0
interpol_type=2
/
