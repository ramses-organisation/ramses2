! =========================================================================
!> @brief
!> Compute mix64 hash
!>
attributes(device) pure function mix64(key)
  implicit none
  integer(kind=8), intent(in) :: key
  integer(kind=8) :: mix64
  integer(kind=8) :: hash

  integer(kind=8), parameter :: mix64_1 = -7046029254386353131_8
  integer(kind=8), parameter :: mix64_2 = -4658895280553007687_8
  integer(kind=8), parameter :: mix64_3 = -7723592293110705685_8

  hash = key + mix64_1
  hash = ieor(hash, ishft(hash, -30))
  hash = hash * mix64_2
  hash = ieor(hash, ishft(hash, -27))
  hash = hash * mix64_3
  hash = ieor(hash, ishft(hash, -31))

  mix64 = hash

end function mix64
! =========================================================================

! =========================================================================
!> @brief
!> Compute fnv 64-bit hash
!>
attributes(device) pure function fnv64(key)
  implicit none
  integer(kind=8), intent(in) :: key
  integer(kind=8) :: fnv64
  integer(kind=8) :: k, hash
  integer :: j

  integer(kind=8), parameter :: fnv64_basis = 14695981039346656037_8
  integer(kind=8), parameter :: fnv64_prime = 1099511628211_8

  hash = fnv64_basis

  do j = 0, 7
     k = ibits(key, 8*j, 8)
     hash = ieor(hash, k)
     hash = hash * fnv64_prime
  end do

  fnv64 = hash

end function fnv64

! =========================================================================
!> @brief
!> Compute fnv 32-bit hash
!>
attributes(device) pure function fnv32(key)
  implicit none
  integer(kind=8), intent(in) :: key
  integer(kind=8) :: fnv32
  integer(kind=8) :: k, hash
  integer :: j

  integer(kind=8) :: fnv32_basis = 2166136261_8
  integer(kind=8) :: fnv32_prime = 16777619_8

  hash = fnv32_basis

  do j = 0, 3
     k = ibits(key, 8*j, 8)
     hash = ieor(hash, k)
     hash = hash * fnv32_prime
     hash = ibits(hash, 0, 32)
  end do

  fnv32 = hash

end function fnv32
! =========================================================================

! =========================================================================
!> @brief
!> Insert new key/value pair in hash table
!>
attributes(device) subroutine hash_set(hash_key, hash_val, hash_size, key, val)
  implicit none
  integer(kind=8) :: hash_key(*)
  integer(kind=4) :: hash_val(*)
  integer(kind=4) :: hash_size
  integer(kind=8) :: key
  integer(kind=4) :: val

  integer(kind=8) :: ibucket, prev

  ! Compute bucket idx from hash function
  ibucket = MOD(fnv64(key), hash_size)
  if (ibucket < 0) ibucket = ibucket + hash_size
  ibucket = ibucket + 1

  ! Insert value using linear probing
  do
     prev = atomiccas(hash_key(ibucket), 0, key)
     if((prev == 0) .or. (prev == key))then
        hash_val(ibucket) = val
        return
     endif
     ibucket = MOD(ibucket, hash_size) + 1
  end do

end subroutine hash_set
! =========================================================================

! =========================================================================
!> @brief
!> Free existing key in hash table
!>
attributes(device) subroutine hash_free(hash_key, hash_val, hash_size, key)
  implicit none
  integer(kind=8) :: hash_key(*)
  integer(kind=4) :: hash_val(*)
  integer(kind=4) :: hash_size
  integer(kind=8) :: key

  integer(kind=8) :: ibucket

  ! Compute bucket idx from hash function
  ibucket = MOD(fnv64(key), hash_size)
  if (ibucket < 0) ibucket = ibucket + hash_size
  ibucket = ibucket + 1

  ! Delete value using linear probing
  ! Note that key is left in the hash table
  do
     if(hash_key(ibucket) == key)then
        hash_val(ibucket) = 0
        return
     endif
     if(hash_key(ibucket) == 0)then
        return
     endif
     ibucket = MOD(ibucket, hash_size) + 1
  end do

end subroutine hash_free
! =========================================================================

! =========================================================================
!> @brief
!> Update val of existing key in hash table
!>
attributes(device) subroutine hash_update(hash_key, hash_val, hash_size, key, val)
  implicit none
  integer(kind=8) :: hash_key(*)
  integer(kind=4) :: hash_val(*)
  integer(kind=4) :: hash_size
  integer(kind=8) :: key
  integer(kind=4) :: val

  integer(kind=8) :: ibucket

  ! Compute bucket idx from hash function
  ibucket = MOD(fnv64(key), hash_size)
  if (ibucket < 0) ibucket = ibucket + hash_size
  ibucket = ibucket + 1

  ! Update value using linear probing
  do
     if(hash_key(ibucket) == key)then
        hash_val(ibucket) = val
        return
     endif
     if(hash_key(ibucket) == 0)then
        return
     endif
     ibucket = MOD(ibucket, hash_size) + 1
  end do

end subroutine hash_update
! =========================================================================

! =========================================================================
!> @brief
!> Get value from key in hash table
!>
attributes(device) function hash_get(hash_key, hash_val, hash_size, key)
  implicit none
  integer(kind=8) :: hash_key(*)
  integer(kind=4) :: hash_val(*)
  integer(kind=4) :: hash_size
  integer(kind=8) :: key
  integer(kind=4) :: hash_get

  integer(kind=8) :: ibucket

  ! Compute bucket idx from hash function
  ibucket = MOD(fnv64(key), hash_size)
  if (ibucket < 0) ibucket = ibucket + hash_size
  ibucket = ibucket + 1

  ! Read value using linear probing
  do
     if(hash_key(ibucket) == key)then
        hash_get = hash_val(ibucket)
        return
     endif
     if(hash_key(ibucket) == 0)then
        hash_get = 0
        return
     endif
     ibucket = MOD(ibucket, hash_size) + 1
  end do

end function hash_get
! =========================================================================

! =========================================================================
!> @brief
!> Helper device subroutine to query a grid and cell by integer coordinates
!>
attributes(device) subroutine get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     & level, ckey_nbor, igrid, icell)
  implicit none
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), intent(in), value :: level
  integer(kind=4), intent(in) :: ckey_nbor(3)
  integer(kind=4), intent(out) :: igrid, icell

  integer :: ix(3), ii(3), idim
  integer(kind=8) :: ix8, iy8, iz8, nx, offset, key

  do idim = 1, 3
     ix(idim) = ckey_nbor(idim) / 2
     ii(idim) = mod(ckey_nbor(idim), 2)
  end do

  ix8 = int(ix(1), kind=8)
  iy8 = int(ix(2), kind=8)
  iz8 = int(ix(3), kind=8)
  nx  = int(ckey_max_d(level), kind=8)
  offset = key_off_d(level)
  key = offset + ix8 + iy8*nx + iz8*nx*nx
  igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

  if (igrid /= 0) then
     icell = 1 + ii(1) + ii(2) * 2 + ii(3) * 4
  else
     icell = 0
  endif
end subroutine get_cell_by_key
! =========================================================================
