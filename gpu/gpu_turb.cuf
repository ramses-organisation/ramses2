module turb_device
  use amr_parameters, only: ndim, twotondim, dp
  use hydro_parameters, only: nvar
  use oct_commons, only: oct
  use turb_commons, only: TURB_GS, turb_gs_real
  use cudafor
  implicit none

contains
  ! PI of turb_commons, a default real constant, for the random phases of gaussian_cmplx
#define PI 3.141592653589793

  !=====================================================================================
  ! Time-interpolation of the acceleration field.
  ! afield_now = next_tfrac*afield_last + last_tfrac*afield_next, elementwise.
  ! Mirrors the host array statement in turb/turb_update.f90.
  ! Arrays are passed as assumed-size (flattened) -- one thread per element.
  !=====================================================================================
  attributes(global) subroutine turb_interp_field_kernel(afield_last, afield_next, &
       & afield_now, last_tfrac, next_tfrac, ntot)
    real(kind=8), device :: afield_last(*)
    real(kind=8), device :: afield_next(*)
    real(kind=8), device :: afield_now(*)
    real(kind=8), intent(in), value :: last_tfrac, next_tfrac
    integer(kind=4), intent(in), value :: ntot

    integer :: i

    i = (blockIdx%x - 1)*blockDim%x + threadIdx%x
    if (i > ntot) return

    afield_now(i) = next_tfrac*afield_last(i) + last_tfrac*afield_next(i)

  end subroutine turb_interp_field_kernel

  !=====================================================================================
  ! Acceleration field from the backward FFT of its spectrum, as FFT_3D and turb_next_field:
  ! afield = real part / TURB_GS**3 * turb_norm * turb_rms, elementwise.
  ! Written by Daniel Han (mini-ramses version October 2026).
  !=====================================================================================
  attributes(global) subroutine turb_normalise_kernel(fft_field, afield, turb_norm, &
       & turb_rms, ntot)
    complex(kind=8), device :: fft_field(*)
    real(kind=8), device :: afield(*)
    real(kind=8), intent(in), value :: turb_norm, turb_rms
    integer(kind=4), intent(in), value :: ntot

    integer :: i

    i = (blockIdx%x - 1)*blockDim%x + threadIdx%x
    if (i > ntot) return

    afield(i) = real(fft_field(i), kind=8) / (turb_gs_real**3) * turb_norm * turb_rms

  end subroutine turb_normalise_kernel

  !=====================================================================================
  ! Decay of every mode, as decay_turbulence: spec(:,inew) = spec(:,iold) -
  ! spec(:,iold)*decay_frac, elementwise. The modes add_turbulence sets are rewritten after.
  ! Written by Daniel Han (mini-ramses version October 2026).
  !=====================================================================================
  attributes(global) subroutine turb_decay_kernel(spec, iold, inew, decay_frac, ntot)
    complex(kind=8), device :: spec(1:ndim*TURB_GS**ndim,1:2)
    integer(kind=4), intent(in), value :: iold, inew, ntot
    real(kind=8), intent(in), value :: decay_frac

    integer :: i

    i = (blockIdx%x - 1)*blockDim%x + threadIdx%x
    if (i > ntot) return

    spec(i,inew) = spec(i,iold) - (spec(i,iold) * decay_frac)

  end subroutine turb_decay_kernel

  !=====================================================================================
  ! New spectrum at the modes add_turbulence draws, one thread per mode: the end of
  ! gaussian_cmplx from the host random numbers, the power and Helmholtz projection of
  ! add_turbulence and the decay of decay_turbulence, in the host order of operations.
  ! Written by Daniel Han (mini-ramses version October 2026).
  !=====================================================================================
  attributes(global) subroutine turb_add_modes_kernel(spec, iold, inew, mode_cell, mode_own, &
       & mode_power, mode_unitk, rnd, nmode, dt, comp_amp, sol_amp, decay_frac)
    complex(kind=8), device :: spec(1:ndim,0:TURB_GS**ndim-1,1:2)
    integer(kind=4), device :: mode_cell(*)
    logical, device :: mode_own(*)
    real(kind=8), device :: mode_power(*)
    real(kind=8), device :: mode_unitk(1:ndim,*)
    real(kind=8), device :: rnd(1:3,1:ndim,*)
    integer(kind=4), intent(in), value :: iold, inew, nmode
    real(kind=8), intent(in), value :: dt, comp_amp, sol_amp, decay_frac

    integer :: imode, icell, d
    real(kind=8) :: w, mag, arg
    complex(kind=8) :: dot
    complex(kind=8) :: complex_vec(1:ndim), unitk_cmplx(1:ndim)
    complex(kind=8) :: comp_cmplx(1:ndim), sol_cmplx(1:ndim)

    imode = (blockIdx%x - 1)*blockDim%x + threadIdx%x
    if (imode > nmode) return
    icell = mode_cell(imode)

    ! Gaussian magnitude from the accepted Rnd(1) and w, uniform argument
    do d = 1, ndim
       w = rnd(2,d,imode)
       w = sqrt( (-2.0 * log( w ) ) / w )
       mag = rnd(1,d,imode) * w
       arg = (rnd(3,d,imode) * 2.0 * PI) - 1.0
       complex_vec(d) = cmplx(mag * cos(arg), mag * sin(arg), kind=8)
    end do

    ! Power spectrum and width, zero phase for an own conjugate mode
    do d = 1, ndim
       complex_vec(d) = complex_vec(d) * sqrt(dt) * mode_power(imode)
       if (mode_own(imode)) complex_vec(d) = abs(complex_vec(d))
    end do

    ! Helmholtz decomposition
    dot = (0d0, 0d0)
    do d = 1, ndim
       unitk_cmplx(d) = cmplx(mode_unitk(d,imode), kind=8)
       dot = dot + conjg(unitk_cmplx(d)) * complex_vec(d)
    end do
    do d = 1, ndim
       comp_cmplx(d) = unitk_cmplx(d) * dot
       sol_cmplx(d) = complex_vec(d) - comp_cmplx(d)
       complex_vec(d) = comp_cmplx(d)*comp_amp + sol_cmplx(d)*sol_amp
    end do

    ! Add to the current spectrum, then subtract its decay
    do d = 1, ndim
       spec(d,icell,inew) = (spec(d,icell,iold) + complex_vec(d)) - &
            & (spec(d,icell,iold) * decay_frac)
    end do

  end subroutine turb_add_modes_kernel

  !=====================================================================================
  ! Hermitian pairs of add_turbulence, one thread per pair, after turb_add_modes_kernel:
  ! spec(:,h,inew) = conjg(spec(:,p,inew)).
  ! Written by Daniel Han (mini-ramses version October 2026).
  !=====================================================================================
  attributes(global) subroutine turb_conjg_pairs_kernel(spec, inew, pair_cell, npair)
    complex(kind=8), device :: spec(1:ndim,0:TURB_GS**ndim-1,1:2)
    integer(kind=4), device :: pair_cell(1:2,*)
    integer(kind=4), intent(in), value :: inew, npair

    integer :: ipair, d

    ipair = (blockIdx%x - 1)*blockDim%x + threadIdx%x
    if (ipair > npair) return

    do d = 1, ndim
       spec(d,pair_cell(1,ipair),inew) = conjg(spec(d,pair_cell(2,ipair),inew))
    end do

  end subroutine turb_conjg_pairs_kernel

  !=====================================================================================
  ! Turbulent driving force.
  ! Per (cell, oct): compute cell-centre position, read density from uold, apply the
  ! density filter, trilinearly interpolate the 64^3 afield_now onto the cell, and store
  ! the result in fturb. Fuses drive_turb (turb/turb_driving.f90) and turb_force_calc
  ! (turb/turb_commons.f90). NDIM==3.
  !=====================================================================================
  attributes(global) subroutine turb_drive_kernel(grid, uold, fturb, afield_now, &
       & d_skip, head_idx, num_octs, dx, boxlen, turb_min_rho)
    type(oct), device :: grid(*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: fturb(1:twotondim,1:3,*)
    real(kind=8), device :: afield_now(1:ndim,0:TURB_GS-1,0:TURB_GS-1,0:TURB_GS-1)
    real(kind=8), device :: d_skip(1:3)
    integer(kind=4), intent(in), value :: head_idx, num_octs
    real(kind=dp), intent(in), value :: dx, boxlen, turb_min_rho

    integer :: block_idx, cell_idx, oct_idx, idim
    integer :: bmin(1:3), bmax(1:3)
    real(kind=8) :: x, rr, rho, dr1(1:3), dr2(1:3)

    block_idx = blockIdx%x - 1

    ! Compute the oct idx
    oct_idx = block_idx*blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute the cell idx
    cell_idx = threadIdx%x

    ! Density filter: leave fturb=0 for under-dense cells (matches turb_force_calc).
    rho = uold(cell_idx, 1, oct_idx)
    if (rho < turb_min_rho) then
       do idim = 1, 3
          fturb(cell_idx, idim, oct_idx) = 0d0
       end do
       return
    end if

    ! Cell-centre position -> position in the turbulence grid, with periodic wrap.
    do idim = 1, ndim
       x = (2*grid(oct_idx)%ckey(idim) + mod((cell_idx-1)/2**(idim-1), 2) + 0.5d0)*dx - d_skip(idim)
       rr = x/boxlen*turb_gs_real
       bmin(idim) = floor(rr)
       bmax(idim) = ceiling(rr)
       if (bmin(idim) == TURB_GS) bmin(idim) = 0
       if (bmax(idim) == TURB_GS) bmax(idim) = 0
       dr1(idim) = rr - real(floor(rr), kind=8)
       dr2(idim) = 1d0 - dr1(idim)
    end do

    ! Trilinear interpolation over the 8 corners, all 3 force components.
    do idim = 1, 3
       fturb(cell_idx, idim, oct_idx) = &
            & afield_now(idim, bmin(1), bmin(2), bmin(3))*dr2(1)*dr2(2)*dr2(3) + &
            & afield_now(idim, bmax(1), bmin(2), bmin(3))*dr1(1)*dr2(2)*dr2(3) + &
            & afield_now(idim, bmin(1), bmax(2), bmin(3))*dr2(1)*dr1(2)*dr2(3) + &
            & afield_now(idim, bmax(1), bmax(2), bmin(3))*dr1(1)*dr1(2)*dr2(3) + &
            & afield_now(idim, bmin(1), bmin(2), bmax(3))*dr2(1)*dr2(2)*dr1(3) + &
            & afield_now(idim, bmax(1), bmin(2), bmax(3))*dr1(1)*dr2(2)*dr1(3) + &
            & afield_now(idim, bmin(1), bmax(2), bmax(3))*dr2(1)*dr1(2)*dr1(3) + &
            & afield_now(idim, bmax(1), bmax(2), bmax(3))*dr1(1)*dr1(2)*dr1(3)
    end do

  end subroutine turb_drive_kernel

  !=====================================================================================
  ! Turbulent source term.
  ! Per (cell, oct): subtract kinetic energy, add rho*fturb*dteff to momentum, recompute
  ! total energy. Direct port of turb_hydro (turb/turb_hydro.f90); operates on uold.
  !=====================================================================================
  attributes(global) subroutine turb_hydro_kernel(uold, fturb, head_idx, num_octs, &
       & smallr, smallc, dteff)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: fturb(1:twotondim,1:3,*)
    integer(kind=4), intent(in), value :: head_idx, num_octs
    real(kind=dp), intent(in), value :: smallr, smallc
    real(kind=8), intent(in), value :: dteff

    integer :: block_idx, cell_idx, oct_idx, idim
    real(kind=dp) :: ener, rho

    block_idx = blockIdx%x - 1

    oct_idx = block_idx*blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    cell_idx = threadIdx%x

    rho = uold(cell_idx, 1, oct_idx)

    ! Remove kinetic energy from total energy
    ener = uold(cell_idx, 5, oct_idx)
    do idim = 1, 3
       ener = max(ener - 0.5_dp*uold(cell_idx, idim+1, oct_idx)**2/max(rho, smallr), rho*smallc**2)
    end do

    ! Update momentum
    do idim = 1, 3
       uold(cell_idx, idim+1, oct_idx) = uold(cell_idx, idim+1, oct_idx) + &
            & max(rho, smallr)*fturb(cell_idx, idim, oct_idx)*dteff
    end do

    ! Update total energy
    do idim = 1, 3
       ener = max(ener + 0.5_dp*uold(cell_idx, idim+1, oct_idx)**2/max(rho, smallr), rho*smallc**2)
    end do
    uold(cell_idx, 5, oct_idx) = ener

  end subroutine turb_hydro_kernel

end module turb_device
