! =========================================================================

! =========================================================================
!> @brief
!> @brief
!> Performs a reduction min within a warp.
!>
!> @param[in] mass : The variable to min over the warp
attributes(device) subroutine warp_reduce_max(dt)
  real(kind=8) :: dt

  integer :: offset

  offset = warpsize/2
  do
     if (offset.le.0) exit
     dt = max(dt,__shfl_down(dt,offset))
     offset = offset / 2
  enddo

end subroutine warp_reduce_max
! =========================================================================

! =========================================================================
!> @brief
!> Fused block-wide reduction: four sums (s1..s4) and one min (m1).
!> One pair of syncthreads for all five reductions. Avoids the per-call
!> shared-memory / register cost of chaining 5 separate block_reduce calls.
attributes(device) subroutine block_reduce_sum4_min1(s1, s2, s3, s4, m1)
  implicit none
  real(kind=dp) :: s1, s2, s3, s4, m1

  real(kind=dp), shared :: sh(5, 32)
  integer :: tid, lane, wid

  tid = threadIdx%x
  lane = mod(tid - 1, warpsize) + 1
  wid  = (tid - 1) / warpsize + 1

  ! warp-level reductions (independent, no barrier needed)
  call warp_reduce_dp_sum(s1)
  call warp_reduce_dp_sum(s2)
  call warp_reduce_dp_sum(s3)
  call warp_reduce_dp_sum(s4)
  call warp_reduce_dp_min(m1)

  ! one lane per warp writes all five partials
  if (lane == 1) then
     sh(1, wid) = s1
     sh(2, wid) = s2
     sh(3, wid) = s3
     sh(4, wid) = s4
     sh(5, wid) = m1
  endif
  call syncthreads()

  ! first warp gathers per-warp partials
  if (tid <= (blockdim%x / warpsize)) then
     s1 = sh(1, lane)
     s2 = sh(2, lane)
     s3 = sh(3, lane)
     s4 = sh(4, lane)
     m1 = sh(5, lane)
  else
     s1 = 0_dp
     s2 = 0_dp
     s3 = 0_dp
     s4 = 0_dp
     m1 = huge(0_dp)
  endif
  call syncthreads()

  ! final reduce within first warp
  if (wid == 1) then
     call warp_reduce_dp_sum(s1)
     call warp_reduce_dp_sum(s2)
     call warp_reduce_dp_sum(s3)
     call warp_reduce_dp_sum(s4)
     call warp_reduce_dp_min(m1)
  endif

end subroutine block_reduce_sum4_min1
! =========================================================================

! ==========================================================================
!> @brief
!> Performs a reduction min within a block.
!>
!> @param[in] mass : The variable to min over the block
attributes(device) function block_reduce_max(dt)
  implicit none
  real(kind=8) :: block_reduce_max
  real(kind=8) :: dt

  real(kind=8), shared :: svalues(32)
  integer :: tid, lane, wid

  tid = threadIdx%x
  lane = mod(tid-1,warpsize)+1
  wid = (tid-1)/warpsize+1

  ! each warp performs its own reduction
  call warp_reduce_max(dt)

  ! write reduced value to shared memory
  if (lane.eq.1) svalues(wid) = dt

  ! wait for all partial reductions
  call syncthreads()

  ! read from shared memory only if that warp existed
  if (tid .le. ((blockdim%x) / warpsize)) then
     dt = svalues(lane)
  else
     dt = - huge(0d0)
  endif

  ! wait for all partial reads
  call syncthreads()

  ! final reduce within first warp
  if (wid.eq.1) call warp_reduce_max(dt)
  block_reduce_max = dt

end function block_reduce_max
! =========================================================================
