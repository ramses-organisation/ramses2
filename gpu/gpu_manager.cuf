module gpu_manager
  use cudafor
  use nvtx
  use gpu_utils
  use gpu_runner
  use ramses_commons, only: ramses_t
contains
!###########################################################
!###########################################################
!###########################################################
!###########################################################
recursive subroutine r_set_grid_device(pst)
  use mdl_module
  use ramses_commons, only: pst_t
  use refine_device, only: insert_hash_kernel, update_nbor_array
  use mdl_parameters
  implicit none
  type(pst_t)::pst

  integer::rID
  integer::head_idx, num_octs, num_subgrids, num_threads, num_blocks, ind

  if(pst%nLower>0)then
     rID = mdl_send_request(pst%s%mdl,MDL_SET_GRID_DEVICE,pst%iUpper+1)
     call r_set_grid_device(pst%pLower)
     call mdl_get_reply(pst%s%mdl,rID,0)
  else

     ! Copy grid from host to device
     call nvtxStartRange("Copy entire mesh from host to device", color=5)!red
     grid = pst%s%m%grid
     ! flag1 is only allocated/used for adaptive mesh refinement
     if(pst%s%r%nlevelmax > pst%s%r%levelmin) flag1 = pst%s%m%flag1
#ifdef HYDRO
     uold = pst%s%m%uold
#ifdef MHD
     bold = pst%s%m%bold
#endif
#endif
#ifdef DO_RT
     rtuold = pst%s%m%rtuold
#endif
#ifdef GRAV
     f = pst%s%m%f
     phi = pst%s%m%phi
     phi_old = pst%s%m%phi_old
#endif
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

     ! Particle H→D
     if (pst%s%r%part .and. allocated(pst%s%p%xp) .and. allocated(xp)) then
        call nvtxStartRange("Copy part from host to device", color=5)!red
        xp     = pst%s%p%xp
        vp     = pst%s%p%vp
        mp     = pst%s%p%mp
        levelp = pst%s%p%levelp
        sortp  = pst%s%p%sortp
        if (allocated(idp)) idp = pst%s%p%idp
        call GPU_Error_Check(__FILE__, __LINE__)
        call nvtxEndRange()
     endif

     ! Star particle H→D
     if (pst%s%r%star .and. allocated(pst%s%star%xp) .and. allocated(star_xp)) then
        call nvtxStartRange("Copy star from host to device", color=5)!red
        star_xp     = pst%s%star%xp
        star_vp     = pst%s%star%vp
        star_mp     = pst%s%star%mp
        star_tp     = pst%s%star%tp
        star_zp     = pst%s%star%zp
        star_levelp = pst%s%star%levelp
        star_sortp  = pst%s%star%sortp
        star_idp    = pst%s%star%idp
        call GPU_Error_Check(__FILE__, __LINE__)
        call nvtxEndRange()
     endif

#ifdef DO_RT
     ! Stellar SED H→D
     if (pst%s%r%rt .and. pst%s%r%star .and. pst%s%r%rt_star) call gpu_rt_upload_sed(pst%s)
#endif

     ! Sink particle H→D
     if (pst%s%r%sink .and. allocated(pst%s%sink%xp) .and. allocated(sink_xp)) then
        call nvtxStartRange("Copy sink from host to device", color=5)!red
        sink_xp     = pst%s%sink%xp
        sink_vp     = pst%s%sink%vp
        sink_fp     = pst%s%sink%fp
        sink_jp     = pst%s%sink%jp
        sink_mp     = pst%s%sink%mp
        sink_tp     = pst%s%sink%tp
        sink_tm     = pst%s%sink%tm
        sink_levelp = pst%s%sink%levelp
        sink_sortp  = pst%s%sink%sortp
        sink_idp    = pst%s%sink%idp
        sink_idm    = pst%s%sink%idm
        call GPU_Error_Check(__FILE__, __LINE__)
        call nvtxEndRange()
     endif

     ! Core particle H→D
     if (pst%s%r%core .and. allocated(pst%s%core%xp) .and. allocated(core_xp)) then
        call nvtxStartRange("Copy core from host to device", color=5)!red
        core_xp     = pst%s%core%xp
        core_vp     = pst%s%core%vp
        core_fp     = pst%s%core%fp
        core_jp     = pst%s%core%jp
        core_mp     = pst%s%core%mp
        core_zp     = pst%s%core%zp
        core_tp     = pst%s%core%tp
        core_up     = pst%s%core%up
        core_levelp = pst%s%core%levelp
        core_nacc   = pst%s%core%nacc
        core_sortp  = pst%s%core%sortp
        core_idp    = pst%s%core%idp
        call GPU_Error_Check(__FILE__, __LINE__)
        call nvtxEndRange()
     endif

     ! Tree particle H→D
     if (pst%s%r%tree .and. allocated(pst%s%tree%xp) .and. allocated(tree_xp)) then
        call nvtxStartRange("Copy tree from host to device", color=5)!red
        tree_xp     = pst%s%tree%xp
        tree_vp     = pst%s%tree%vp
        tree_mp     = pst%s%tree%mp
        tree_tp     = pst%s%tree%tp
        tree_tm     = pst%s%tree%tm
        tree_levelp = pst%s%tree%levelp
        tree_sortp  = pst%s%tree%sortp
        tree_idp    = pst%s%tree%idp
        tree_idm    = pst%s%tree%idm
        tree_idt    = pst%s%tree%idt
        call GPU_Error_Check(__FILE__, __LINE__)
        call nvtxEndRange()
     endif

     ! Insert entire grid in the device hash table
     head_idx = 1
     num_octs = pst%s%m%ifree - 1
     num_threads = 128
     num_blocks = (num_octs + num_threads - 1) / num_threads

     call nvtxStartRange("Insert grid in hash table", color=5)!red
     call insert_hash_kernel<<<num_blocks, num_threads>>>(grid, hash_key, hash_val, pst%s%m%hash_size, &
          & ckey_max, key_off, head_idx, num_octs)
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

     ! Compute nbor grids array for coarse level only
     head_idx = 1
     num_subgrids = pst%s%m%noct(pst%s%r%levelmin) / nsubgridtondim
     num_threads = 128
     num_blocks = (num_subgrids + num_threads - 1) / num_threads
     call nvtxStartRange("Compute nbor array", color=5)!red
     do ind = 1, subgridsize
        call update_nbor_array<<<num_blocks, num_threads>>>(nbor, grid, hash_key, hash_val, pst%s%m%hash_size, &
             & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_subgrids, ind)
        call GPU_Error_Check(__FILE__, __LINE__)
     end do
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

     pst%s%m%data_on_device=.true.

  endif

end subroutine r_set_grid_device
!###########################################################
!###########################################################
!###########################################################
!###########################################################
recursive subroutine r_transfer_grid_host(pst)
  use mdl_module
  use ramses_commons, only: pst_t
  use mdl_parameters
  implicit none
  type(pst_t)::pst

  integer::rID

  if(pst%nLower>0)then
     rID = mdl_send_request(pst%s%mdl,MDL_TRANSFER_GRID_HOST,pst%iUpper+1)
     call r_transfer_grid_host(pst%pLower)
     call mdl_get_reply(pst%s%mdl,rID,0)
  else

     ! Copy grid from device to host
     call nvtxStartRange("Copy entire mesh from device to host", color=5)!red
     if(pst%s%r%nlevelmax > pst%s%r%levelmin) pst%s%m%grid = grid
#ifdef HYDRO
     pst%s%m%uold = uold
#ifdef MHD
     pst%s%m%bold = bold
#endif
#endif
#ifdef DO_RT
     pst%s%m%rtuold = rtuold
#endif
#ifdef GRAV
     pst%s%m%f = f
     pst%s%m%phi = phi
     pst%s%m%phi_old = phi_old
#endif
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

     if(pst%s%r%pic)then
        call gpu_to_host_part(pst)
     endif

  endif

end subroutine r_transfer_grid_host
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_to_host_part(pst)
  use ramses_commons, only: pst_t
  implicit none
  type(pst_t)::pst

  if (allocated(xp)) then
     call nvtxStartRange("Copy part from device to host", color=5)!red
     pst%s%p%xp     = xp
     pst%s%p%vp     = vp
     pst%s%p%mp     = mp
     pst%s%p%levelp = levelp
     pst%s%p%sortp  = sortp
     if (allocated(idp)) pst%s%p%idp = idp
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
  endif

  if (allocated(star_xp)) then
     call nvtxStartRange("Copy star from device to host", color=5)!red
     pst%s%star%xp     = star_xp
     pst%s%star%vp     = star_vp
     pst%s%star%mp     = star_mp
     pst%s%star%tp     = star_tp
     pst%s%star%zp     = star_zp
     pst%s%star%levelp = star_levelp
     pst%s%star%sortp  = star_sortp
     pst%s%star%idp    = star_idp
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
  endif

  if (allocated(sink_xp)) then
     call nvtxStartRange("Copy sink from device to host", color=5)!red
     pst%s%sink%xp     = sink_xp
     pst%s%sink%vp     = sink_vp
     pst%s%sink%fp     = sink_fp
     pst%s%sink%jp     = sink_jp
     pst%s%sink%mp     = sink_mp
     pst%s%sink%tp     = sink_tp
     pst%s%sink%tm     = sink_tm
     pst%s%sink%levelp = sink_levelp
     pst%s%sink%sortp  = sink_sortp
     pst%s%sink%idp    = sink_idp
     pst%s%sink%idm    = sink_idm
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
  endif

  if (allocated(core_xp)) then
     call nvtxStartRange("Copy core from device to host", color=5)!red
     pst%s%core%xp     = core_xp
     pst%s%core%vp     = core_vp
     pst%s%core%fp     = core_fp
     pst%s%core%jp     = core_jp
     pst%s%core%mp     = core_mp
     pst%s%core%zp     = core_zp
     pst%s%core%tp     = core_tp
     pst%s%core%up     = core_up
     pst%s%core%levelp = core_levelp
     pst%s%core%nacc   = core_nacc
     pst%s%core%sortp  = core_sortp
     pst%s%core%idp    = core_idp
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
  endif

  if (allocated(tree_xp)) then
     call nvtxStartRange("Copy tree from device to host", color=5)!red
     pst%s%tree%xp     = tree_xp
     pst%s%tree%vp     = tree_vp
     pst%s%tree%mp     = tree_mp
     pst%s%tree%tp     = tree_tp
     pst%s%tree%tm     = tree_tm
     pst%s%tree%levelp = tree_levelp
     pst%s%tree%sortp  = tree_sortp
     pst%s%tree%idp    = tree_idp
     pst%s%tree%idm    = tree_idm
     pst%s%tree%idt    = tree_idt
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
  endif

end subroutine gpu_to_host_part
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_star_to_host(sim)
  implicit none
  type(ramses_t)::sim
  integer::istat

  ! Copy the masses, birth times and metallicities of the stars to the host
  if (.not. allocated(star_xp) .or. sim%star%npart <= 0) return
  call nvtxStartRange("Copy star mass, time and metallicity from device to host", color=5)!red
  istat = cudaMemcpy(sim%star%mp, star_mp, int(sim%star%npart,8))
  istat = cudaMemcpy(sim%star%tp, star_tp, int(sim%star%npart,8))
  istat = cudaMemcpy(sim%star%zp, star_zp, int(sim%star%npart,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_star_to_host
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_to_host_turb(pst)
  use ramses_commons, only: pst_t
  implicit none
  type(pst_t)::pst

  if (.not. allocated(turb_spec_d)) return

  call nvtxStartRange("Copy turb spectra from device to host", color=5)!red
  pst%s%turb%turb_last = turb_spec_d(:,:,:,:,iturb_last)
  pst%s%turb%turb_next = turb_spec_d(:,:,:,:,3-iturb_last)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_to_host_turb
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_turb_init_fields(pst)
  use ramses_commons, only: pst_t
#ifdef TURB
  use cufft, only: cufftPlanMany, CUFFT_Z2Z, CUFFT_SUCCESS
  use turb_commons, only: TURB_GS
#endif
  implicit none
  type(pst_t)::pst
#ifdef TURB
  integer :: istat, n(1:3)
#endif

  if (.not. allocated(afield_d)) return

  call nvtxStartRange("Copy initial turb fields host to device", color=5)!red
  iturb_last = 1
  afield_d(:,:,:,:,1) = pst%s%turb%afield_last
  afield_d(:,:,:,:,2) = pst%s%turb%afield_next
  afield_now_d  = pst%s%turb%afield_now
  turb_spec_d(:,:,:,:,1) = pst%s%turb%turb_last
  turb_spec_d(:,:,:,:,2) = pst%s%turb%turb_next
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  call gpu_turb_init_modes(pst%s%turb)

#ifdef TURB
  ! Backward FFT of the ndim components of a spectrum, interleaved as in turb_spec_d
  n = TURB_GS
  istat = cufftPlanMany(turb_fft_plan, 3, n, n, ndim, 1, n, ndim, 1, CUFFT_Z2Z, ndim)
  if (istat /= CUFFT_SUCCESS) then
     write(*,*)'Error: gpu_turb_init_fields: cufftPlanMany failed with status ',istat
     error stop
  endif
#endif

end subroutine gpu_turb_init_fields
!###########################################################
!###########################################################
!###########################################################
!> Table of the modes add_turbulence draws, in its loop order, and of the Hermitian pairs
!> it copies, from the power spectrum of the host.
! Written by Daniel Han (mini-ramses version October 2026).
subroutine gpu_turb_init_modes(turb)
  use turb_commons, only: turb_t, TURB_GS, TGRID_X, TGRID_Y, TGRID_Z, find_conj_pair, find_unitk
  implicit none
  type(turb_t)::turb

  integer :: i, j, k, ii, jj, kk, halfway
  logical :: hermitian_pair
  integer(kind=4), allocatable :: mode_cell(:), pair_cell(:,:)
  logical, allocatable :: mode_own(:)
  real(kind=8), allocatable :: mode_power(:), mode_unitk(:,:)

  halfway = TURB_GS / 2
  allocate(mode_cell(1:TURB_GS**ndim), mode_own(1:TURB_GS**ndim), mode_power(1:TURB_GS**ndim))
  allocate(mode_unitk(1:ndim,1:TURB_GS**ndim), pair_cell(1:2,1:TURB_GS**ndim))

  turb_nmode = 0
  turb_npair = 0
  do k = 0, TGRID_Z
     do j = 0, TGRID_Y
        do i = 0, TGRID_X
           if (turb%power_spec(i,j,k) == 0.0) cycle
           call find_conj_pair(i,j,k,ii,jj,kk)
           hermitian_pair = .false.
           if (k > halfway) then
              hermitian_pair = .true.
           else if (k == 0 .or. 2*k == TURB_GS) then
              if (j > halfway) then
                 hermitian_pair = .true.
              else if (j == 0 .or. 2*j == TURB_GS) then
                 if (i > halfway) hermitian_pair = .true.
              end if
           end if
           if (hermitian_pair) then
              turb_npair = turb_npair + 1
              pair_cell(1,turb_npair) = i + TURB_GS*(j + TURB_GS*k)
              pair_cell(2,turb_npair) = ii + TURB_GS*(jj + TURB_GS*kk)
           else
              turb_nmode = turb_nmode + 1
              mode_cell(turb_nmode) = i + TURB_GS*(j + TURB_GS*k)
              mode_own(turb_nmode) = (i == ii .and. j == jj .and. k == kk)
              mode_power(turb_nmode) = turb%power_spec(i,j,k)
              call find_unitk(i, j, k, halfway, mode_unitk(:,turb_nmode))
           end if
        end do
     end do
  end do

  ! Device copies of the tables that are not empty
  if (turb_nmode > 0) then
     allocate(turb_mode_cell(1:turb_nmode), turb_mode_own(1:turb_nmode))
     allocate(turb_mode_power(1:turb_nmode), turb_mode_unitk(1:ndim,1:turb_nmode))
     allocate(turb_rnd_h(1:3,1:ndim,1:turb_nmode), turb_rnd_d(1:3,1:ndim,1:turb_nmode))
     turb_mode_cell = mode_cell(1:turb_nmode)
     turb_mode_own = mode_own(1:turb_nmode)
     turb_mode_power = mode_power(1:turb_nmode)
     turb_mode_unitk = mode_unitk(:,1:turb_nmode)
  endif
  if (turb_npair > 0) then
     allocate(turb_pair_cell(1:2,1:turb_npair))
     turb_pair_cell = pair_cell(:,1:turb_npair)
  endif
  call GPU_Error_Check(__FILE__, __LINE__)
  deallocate(mode_cell, mode_own, mode_power, mode_unitk, pair_cell)

end subroutine gpu_turb_init_modes
!###########################################################
!###########################################################
!###########################################################
!> Random numbers of the next field, drawn as gaussian_cmplx draws them for each mode of
!> the table: per dimension the accepted Rnd(1) and w of the polar method, then the ndim
!> uniforms of the arguments.
! Written by Daniel Han (mini-ramses version October 2026).
subroutine gpu_turb_draw_modes(turb)
  use turb_commons, only: turb_t, ILP, kiss64_core
  implicit none
  type(turb_t)::turb

  integer :: imode, d
  integer(ILP) :: r
  real(kind=8) :: Rnd(1:2), w

  do imode = 1, turb_nmode
     do d = 1, ndim
        do
           call kiss64_core(turb%kiss64_state, r)
           Rnd(1) = 2.0 * kiss64_uniform(r) - 1.0
           call kiss64_core(turb%kiss64_state, r)
           Rnd(2) = 2.0 * kiss64_uniform(r) - 1.0
           w = Rnd(1)**2 + Rnd(2)**2
           if (w<1.0) exit
        end do
        turb_rnd_h(1,d,imode) = Rnd(1)
        turb_rnd_h(2,d,imode) = w
     end do
     do d = 1, ndim
        call kiss64_core(turb%kiss64_state, r)
        turb_rnd_h(3,d,imode) = kiss64_uniform(r)
     end do
  end do

contains

  ! Uniform number in [0,1) from a KISS64 integer, as kiss64_double makes it
  real(kind=8) function kiss64_uniform(r)
    integer(ILP), intent(in) :: r
    kiss64_uniform = transfer(ieor(iand(r, z'FFFFFFFFFFFFF'), z'3FF0000000000000'), 1d0) - 1.0
  end function kiss64_uniform

end subroutine gpu_turb_draw_modes
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_turb_next_field(pst)
  use ramses_commons, only: pst_t
  implicit none
  type(pst_t)::pst

  ! Set turbulent field times
  pst%s%turb%turb_last_time = pst%s%turb%turb_next_time
  pst%s%turb%turb_next_time = pst%s%turb%turb_last_time + pst%s%turb%turb_dt

  ! Random numbers on the host, the new spectrum on the device
  call nvtxStartRange("Draw turb random numbers", color=5)!red
  call gpu_turb_draw_modes(pst%s%turb)
  call nvtxEndRange()
  call gpu_turb_add_modes(pst%s)

  ! Fourier transform on the device
  call gpu_turb_transform(pst%s)

end subroutine gpu_turb_next_field
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_update_turb(pst)
  use ramses_commons, only: pst_t
  implicit none
  type(pst_t)::pst

  ! Advance the turbulent field(s).
  do
     if (pst%s%g%t >= pst%s%turb%turb_next_time) then
        call gpu_turb_next_field(pst)
     else
        exit
     end if
  end do

  ! Device time-interpolation.
  call gpu_turb_interp(pst%s)

end subroutine gpu_update_turb
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_allocate_amr(sim)
  use amr_parameters, ONLY: ndim, twotondim
#ifdef HYDRO
  use hydro_parameters, ONLY: nvar
#endif
#ifdef DO_RT
  use rt_parameters, ONLY: nrtvar, nrtgrp
#endif
#ifdef TURB
  use turb_commons, ONLY: TURB_GS
#endif
  implicit none
  type(ramses_t) :: sim
  integer :: nborarrsize, ilevel
  integer :: scan_size
#ifdef MHD
  integer :: ng, nh, istat
#endif

  allocate(grid(1:sim%m%ngridmax+sim%m%ncachemax))
  if(sim%r%nlevelmax > sim%r%levelmin .or. sim%r%clump_finder .or. sim%r%sink_form .or. &
       & sim%r%sink_merge .or. sim%r%star .or. sim%r%tree)then
     allocate(flag1(1:twotondim,1:sim%m%ngridmax+sim%m%ncachemax))
     allocate(flag2(1:twotondim,1:sim%m%ngridmax+sim%m%ncachemax))
     flag1=0
     flag2=0
  endif
  if(sim%r%nlevelmax > sim%r%levelmin)then
     allocate(father(1:sim%m%ngridmax+sim%m%ncachemax))
     father=0
  endif
  nborarrsize = (sim%m%ngridmax + nsubgridtondim - 1) / nsubgridtondim
  allocate(nbor(1:subgridsize,1:nborarrsize))
  nbor=0
  ! Allocate hash table space
  sim%m%hash_size=2*(sim%m%ngridmax+sim%m%ncachemax)
  allocate(hash_key(1:sim%m%hash_size))
  allocate(hash_val(1:sim%m%hash_size))
  hash_key=0
  hash_val=0
  ! Work buffers for GPU scan/sort/refine
  allocate(swap_local(1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(swap_global(1:sim%m%ngridmax+sim%m%ncachemax))
  scan_size = sim%m%ngridmax + sim%m%ncachemax
  call ensure_scan_capacity(scan_size, 0)
  swap_local=0
  swap_global=0
  prefix_sum=0

#ifdef HYDRO
  allocate(uold(1:twotondim,1:nvar,1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(unew(1:twotondim,1:nvar,1:sim%m%ngridmax+sim%m%ncachemax))
  uold=0d0
  unew=0d0
#endif
#ifdef MHD
  allocate(bold(1:twotondim,1:6,1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(bnew(1:twotondim,1:6,1:sim%m%ngridmax+sim%m%ncachemax))
  bold=0d0
  bnew=0d0
  if(sim%r%nimhd_solver/='unsplit')then
     ng=sim%m%ngridmax+sim%m%ncachemax
     allocate(b_roll2(1:twotondim,1:6,1:ng),b_my0(1:twotondim,1:6,1:ng),eta_nimhd(1:twotondim,1:2,1:ng),stat=istat)
     if(istat==0.and.sim%r%nimhd_split=='strang'.and..not.sim%r%nimhd_composite)allocate(b_y0(1:twotondim,1:6,1:ng),stat=istat)
     if(istat==0.and.sim%r%nimhd_composite)allocate(b_cf(1:twotondim,1:6,1:ng),stat=istat)
     nh=1
     if(.not.(sim%r%isothermal.or.sim%r%induction))nh=ng
     if(istat==0)allocate(e_acc(1:twotondim,1:nh),stat=istat)
     if(sim%r%nimhd_split/='strang')nh=1
     if(istat==0)allocate(e_acc0(1:twotondim,1:nh),stat=istat)
     if(istat/=0)then
        write(*,*)'gpu_allocate_amr: not enough device memory for the split non-ideal MHD solver'
        error stop
     endif
  endif
#endif
#ifdef DO_RT
  allocate(rtuold(1:twotondim,1:nrtvar,1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(rtunew(1:twotondim,1:nrtvar,1:sim%m%ngridmax))
  if(sim%r%rt_advect .or. (sim%r%rt .and. sim%r%star .and. sim%r%rt_star))then
     allocate(rt_dep_val(1:2*ndim,1:nrtvar,1:sim%m%ncachemax))
     allocate(rt_dep_src(1:2*ndim,1:sim%m%ncachemax))
  endif
  allocate(emissivity(1:twotondim,1:nrtgrp,1:sim%m%ngridmax))
#endif
#ifdef TURB
  allocate(afield_d    (1:ndim,0:TURB_GS-1,0:TURB_GS-1,0:TURB_GS-1,1:2))
  allocate(afield_now_d(1:ndim,0:TURB_GS-1,0:TURB_GS-1,0:TURB_GS-1))
  allocate(turb_spec_d (1:ndim,0:TURB_GS-1,0:TURB_GS-1,0:TURB_GS-1,1:2))
  allocate(turb_fft_d  (1:ndim,0:TURB_GS-1,0:TURB_GS-1,0:TURB_GS-1))
  allocate(fturb(1:twotondim,1:3,1:sim%m%ngridmax+sim%m%ncachemax))
  afield_d=0d0
  afield_now_d=0d0
  turb_spec_d=(0d0,0d0)
  fturb=0d0
#endif
#ifdef GRAV
  allocate(rho(1:twotondim,1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(phi(1:twotondim,1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(nref(1:twotondim,1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(f(1:twotondim,1:3,1:sim%m%ngridmax+sim%m%ncachemax))
  allocate(phi_old(1:twotondim,1:sim%m%ngridmax+sim%m%ncachemax))
  f=0d0
  rho=0d0
  phi=0d0
  nref=0d0
  phi_old=0d0
#endif

  allocate(sim%m%head_cache(1:sim%r%nlevelmax))
  allocate(sim%m%tail_cache(1:sim%r%nlevelmax))
  allocate(sim%m%noct_cache(1:sim%r%nlevelmax))
  sim%m%head_cache=1
  sim%m%tail_cache=0
  sim%m%noct_cache=0
  sim%m%ifree_cache=1
  ! Compute Cartesian key offset for GPU hash table
  allocate(sim%m%key_off(1:sim%r%nlevelmax+1))
  sim%m%key_off(1)=1
  do ilevel=2,sim%r%nlevelmax+1
     sim%m%key_off(ilevel)=sim%m%key_off(ilevel-1)+sim%m%hkey_max(1,ilevel-1)
  end do
  ! Transfer debug parameter to host global
  gpu_debug = sim%r%debug
  ! Allocate and transfer bounding box to device
  allocate(ckey_max(1:sim%r%nlevelmax+1))
  allocate(key_off(1:sim%r%nlevelmax+1))
  allocate(box_ckey_min(1:3,1:sim%r%nlevelmax+1))
  allocate(box_ckey_max(1:3,1:sim%r%nlevelmax+1))
  ckey_max=sim%m%ckey_max
  key_off=sim%m%key_off
  periodic=sim%r%periodic
  box_size=sim%r%box_size
  constant_gravity=real(sim%r%constant_gravity,kind=dp)
  box_ckey_min=sim%m%box_ckey_min
  box_ckey_max=sim%m%box_ckey_max
  if(sim%r%nbound>0)then
     allocate(bound_ckey_min(1:3,1:sim%r%nbound,1:sim%r%nlevelmax+1))
     allocate(bound_ckey_max(1:3,1:sim%r%nbound,1:sim%r%nlevelmax+1))
     bound_ckey_min=sim%m%bound_ckey_min
     bound_ckey_max=sim%m%bound_ckey_max
  endif
  allocate(d_skip(1:ndim))
  d_skip = sim%m%skip

end subroutine gpu_allocate_amr
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_allocate_mg(sim)
  use amr_parameters, ONLY: ndim, twotondim, threetondim
  implicit none
  type(ramses_t) :: sim

#ifdef GRAV
  allocate(grid_mg(1:sim%m_mg%ngridmax+sim%m_mg%ncachemax))
  allocate(father_mg(1:sim%r%ngridmax+sim%r%ngridmax/7+sim%m_mg%ncachemax))
  allocate(nbor_mg(1:threetondim,1:sim%m_mg%ngridmax))
  father_mg=0
  nbor_mg=0
  ! Allocate hash table space
  sim%m_mg%hash_size=2*(sim%m_mg%ngridmax+sim%m_mg%ncachemax)
  allocate(hash_key_mg(1:sim%m_mg%hash_size))
  allocate(hash_val_mg(1:sim%m_mg%hash_size))
  hash_key_mg=0
  hash_val_mg=0
  allocate(phi_mg(1:twotondim,1:sim%m_mg%ngridmax+sim%m_mg%ncachemax))
  allocate(f_mg(1:twotondim,1:3,1:sim%m_mg%ngridmax+sim%m_mg%ncachemax))
#endif

end subroutine gpu_allocate_mg
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_allocate_part(sim)
  use amr_parameters, ONLY: ndim
  implicit none
  type(ramses_t) :: sim
  integer :: scan_size

  allocate(xp(1:sim%r%npartmax, 1:ndim))
  allocate(vp(1:sim%r%npartmax, 1:ndim))
  allocate(mp(1:sim%r%npartmax))
  allocate(levelp(1:sim%r%npartmax))
  allocate(sortp(1:sim%r%npartmax))
  if (sim%r%nlevelmax > sim%r%levelmin) allocate(idp(1:sim%r%npartmax))
  if (sim%r%clump_finder) then
     allocate(pid(1:sim%r%npartmax))
     allocate(hid(1:sim%r%npartmax))
  endif
  ! Particle scratch and prefix sum arrays
  scan_size = sim%r%npartmax
  call ensure_part_swap_capacity(scan_size)
  call ensure_scan_capacity(scan_size, sim%r%part_dep_algo)

end subroutine gpu_allocate_part
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_allocate_star(sim)
  use amr_parameters, ONLY: ndim
  implicit none
  type(ramses_t) :: sim
  integer :: scan_size

  allocate(star_xp(1:sim%r%nstarmax, 1:ndim))
  allocate(star_vp(1:sim%r%nstarmax, 1:ndim))
  allocate(star_mp(1:sim%r%nstarmax))
  allocate(star_tp(1:sim%r%nstarmax))
  allocate(star_zp(1:sim%r%nstarmax))
  allocate(star_sortp(1:sim%r%nstarmax))
  allocate(star_levelp(1:sim%r%nstarmax))
  allocate(star_idp(1:sim%r%nstarmax))
  if (sim%r%clump_finder) then
     allocate(star_pid(1:sim%r%nstarmax))
     allocate(star_hid(1:sim%r%nstarmax))
  endif
  ! Particle scratch and prefix sum arrays
  scan_size = sim%r%nstarmax
  call ensure_part_swap_capacity(scan_size)
  call ensure_scan_capacity(scan_size, sim%r%star_dep_algo)

end subroutine gpu_allocate_star
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_allocate_sink(sim)
  use amr_parameters, ONLY: ndim
  implicit none
  type(ramses_t) :: sim
  integer :: scan_size

  allocate(sink_xp(1:sim%r%nsinkmax, 1:ndim))
  allocate(sink_vp(1:sim%r%nsinkmax, 1:ndim))
  allocate(sink_fp(1:sim%r%nsinkmax, 1:ndim))
  allocate(sink_jp(1:sim%r%nsinkmax, 1:ndim))
  allocate(sink_mp(1:sim%r%nsinkmax))
  allocate(sink_tp(1:sim%r%nsinkmax))
  allocate(sink_tm(1:sim%r%nsinkmax))
  allocate(sink_sortp(1:sim%r%nsinkmax))
  allocate(sink_levelp(1:sim%r%nsinkmax))
  allocate(sink_pid(1:sim%r%nsinkmax))
  if (sim%r%clump_finder) allocate(sink_hid(1:sim%r%nsinkmax))
  allocate(sink_idp(1:sim%r%nsinkmax))
  allocate(sink_idm(1:sim%r%nsinkmax))
  ! Particle scratch and prefix sum arrays
  scan_size = sim%r%nsinkmax
  call ensure_part_swap_capacity(scan_size)
  call ensure_scan_capacity(scan_size, sim%r%sink_dep_algo)

end subroutine gpu_allocate_sink
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_allocate_core(sim)
  use amr_parameters, ONLY: ndim
  implicit none
  type(ramses_t) :: sim
  integer :: scan_size

  allocate(core_xp(1:sim%r%ncoremax, 1:ndim))
  allocate(core_vp(1:sim%r%ncoremax, 1:ndim))
  allocate(core_fp(1:sim%r%ncoremax, 1:ndim))
  allocate(core_jp(1:sim%r%ncoremax, 1:ndim))
  allocate(core_mp(1:sim%r%ncoremax))
  allocate(core_zp(1:sim%r%ncoremax))
  allocate(core_tp(1:sim%r%ncoremax))
  allocate(core_up(1:sim%r%ncoremax))
  allocate(core_sortp(1:sim%r%ncoremax))
  allocate(core_levelp(1:sim%r%ncoremax))
  allocate(core_nacc(1:sim%r%ncoremax))
  allocate(core_idp(1:sim%r%ncoremax))
  allocate(prefix_sum_phys(1:sim%r%ncoremax))
  ! Particle scratch and prefix sum arrays (cores use the large CIC deposit)
  scan_size = sim%r%ncoremax
  call ensure_part_swap_capacity(scan_size)
  call ensure_scan_capacity(scan_size, 1)

end subroutine gpu_allocate_core
!###########################################################
!###########################################################
!###########################################################
!###########################################################
subroutine gpu_allocate_tree(sim)
  use amr_parameters, ONLY: ndim
  implicit none
  type(ramses_t) :: sim
  integer :: scan_size

  allocate(tree_xp(1:sim%r%ntreemax, 1:ndim))
  allocate(tree_vp(1:sim%r%ntreemax, 1:ndim))
  allocate(tree_mp(1:sim%r%ntreemax))
  allocate(tree_tp(1:sim%r%ntreemax))
  allocate(tree_tm(1:sim%r%ntreemax))
  allocate(tree_sortp(1:sim%r%ntreemax))
  allocate(tree_levelp(1:sim%r%ntreemax))
  allocate(tree_pid(1:sim%r%ntreemax))
  if (sim%r%clump_finder) allocate(tree_hid(1:sim%r%ntreemax))
  allocate(tree_idp(1:sim%r%ntreemax))
  allocate(tree_idm(1:sim%r%ntreemax))
  allocate(tree_idt(1:sim%r%ntreemax))
  ! Particle scratch and prefix sum arrays (trees are massless: no CIC deposit workspace)
  scan_size = sim%r%ntreemax
  call ensure_part_swap_capacity(scan_size)
  call ensure_scan_capacity(scan_size, 1)

end subroutine gpu_allocate_tree
!###########################################################
!###########################################################
!###########################################################
!###########################################################
!> Grow shared particle swap and sort scratch buffers to at least min_capacity.
subroutine ensure_part_swap_capacity(min_capacity)
  implicit none
  integer(kind=4), intent(in) :: min_capacity

  if (min_capacity <= 0) return

  if (allocated(xp_swap)) then
     if (size(xp_swap) < min_capacity) then
        deallocate(xp_swap)
        allocate(xp_swap(1:min_capacity))
     endif
  else
     allocate(xp_swap(1:min_capacity))
  endif

  if (allocated(isp_swap)) then
     if (size(isp_swap) < min_capacity) then
        deallocate(isp_swap)
        allocate(isp_swap(1:min_capacity))
     endif
  else
     allocate(isp_swap(1:min_capacity))
  endif

  if (allocated(idp_swap)) then
     if (size(idp_swap) < min_capacity) then
        deallocate(idp_swap)
        allocate(idp_swap(1:min_capacity))
     endif
  else
     allocate(idp_swap(1:min_capacity))
  endif

#if defined(CUB_SORT_PART)
  if (allocated(hkeyp)) then
     if (size(hkeyp) < min_capacity) then
        deallocate(hkeyp)
        allocate(hkeyp(1:min_capacity))
     endif
  else
     allocate(hkeyp(1:min_capacity))
  endif
#endif

end subroutine ensure_part_swap_capacity
!###########################################################
!###########################################################
!###########################################################
!###########################################################
!> Grow scan buffers to at least min_capacity.
subroutine ensure_scan_capacity(min_capacity, dep_algo)
  implicit none
  integer(kind=4), intent(in) :: min_capacity, dep_algo
  integer(kind=4), parameter :: block_size = 256
  integer(kind=4) :: gs0, gs1, gs2

  if (min_capacity <= 0) return

  if (allocated(prefix_sum)) then
     if (size(prefix_sum) < min_capacity) then
        deallocate(prefix_sum)
        allocate(prefix_sum(1:min_capacity))
     endif
  else
     allocate(prefix_sum(1:min_capacity))
  endif

  gs0 = max(1, (min_capacity - 1) / block_size + 1)
  gs1 = max(1, (gs0 + block_size - 1) / block_size)
  gs2 = max(1, (gs1 + block_size - 1) / block_size)

  if (allocated(partial_sums_0)) then
     if (size(partial_sums_0) < gs0) then
        deallocate(partial_sums_0)
        allocate(partial_sums_0(1:gs0))
     endif
  else
     allocate(partial_sums_0(1:gs0))
  endif

  if (allocated(partial_sums_1)) then
     if (size(partial_sums_1) < gs1) then
        deallocate(partial_sums_1)
        allocate(partial_sums_1(1:gs1))
     endif
  else
     allocate(partial_sums_1(1:gs1))
  endif

  if (allocated(partial_sums_2)) then
     if (size(partial_sums_2) < gs2) then
        deallocate(partial_sums_2)
        allocate(partial_sums_2(1:gs2))
     endif
  else
     allocate(partial_sums_2(1:gs2))
  endif

  ! Real(dp) partial-sum workspace, mirroring the integer tiers above. Used by
  ! the CIC small-stencil deposit's per-offset gpu_scan_dp passes.
  if (dep_algo == 3) then
     if (allocated(partial_sums_dp_0)) then
        if (size(partial_sums_dp_0) < gs0) then
           deallocate(partial_sums_dp_0)
           allocate(partial_sums_dp_0(1:gs0))
        endif
     else
        allocate(partial_sums_dp_0(1:gs0))
     endif

     if (allocated(partial_sums_dp_1)) then
        if (size(partial_sums_dp_1) < gs1) then
           deallocate(partial_sums_dp_1)
           allocate(partial_sums_dp_1(1:gs1))
        endif
     else
        allocate(partial_sums_dp_1(1:gs1))
     endif

     if (allocated(partial_sums_dp_2)) then
        if (size(partial_sums_dp_2) < gs2) then
           deallocate(partial_sums_dp_2)
           allocate(partial_sums_dp_2(1:gs2))
        endif
     else
        allocate(partial_sums_dp_2(1:gs2))
     endif
  endif

end subroutine ensure_scan_capacity
!###########################################################
!###########################################################
!###########################################################
!###########################################################
end module gpu_manager
