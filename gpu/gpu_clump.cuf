!> GPU Clump Finder and Merger CUDA kernels.
module clump_device
  use amr_parameters, only: dp, ndim, twotondim, nbin, i8b, MAXLEVEL
  use hydro_parameters, only: nvar
  use oct_commons, only: oct
  use gpu_utils
  use cudafor
  use gpu_runner, only: grid, father, flag1, flag2, rho, nref, gpu_scan, hash_key, hash_val, &
       uold, f, periodic, box_ckey_min, box_ckey_max, ckey_max, key_off, d_skip, &
       sink_xp, sink_levelp, sink_pid, sink_vp, sink_fp, sink_mp, sink_tp, sink_idp, swap_local, &
       prefix_sum, box_size, xp, vp, mp, star_xp, star_vp, star_mp, &
       sink_jp, sink_tm, sink_idm, pid, hid, star_pid, star_hid, sink_hid
  use gpu_runner, only: tree_xp, tree_vp, tree_mp, tree_tp, tree_tm, tree_levelp, &
       tree_idp, tree_idm, tree_idt, tree_pid, tree_hid
  use part_device, only: dtnew_part_d
  implicit none

  ! 56-neighbor half-cell offsets in CPU scan order (ii fastest, inner 2x2x2 skipped)
  real(kind=dp), parameter, dimension(3, 56) :: xnbor_const = reshape((/ &
       & -0.75_dp,-0.75_dp,-0.75_dp,-0.25_dp,-0.75_dp,-0.75_dp, 0.25_dp,-0.75_dp,-0.75_dp, 0.75_dp,-0.75_dp,-0.75_dp, &
       & -0.75_dp,-0.25_dp,-0.75_dp,-0.25_dp,-0.25_dp,-0.75_dp, 0.25_dp,-0.25_dp,-0.75_dp, 0.75_dp,-0.25_dp,-0.75_dp, &
       & -0.75_dp, 0.25_dp,-0.75_dp,-0.25_dp, 0.25_dp,-0.75_dp, 0.25_dp, 0.25_dp,-0.75_dp, 0.75_dp, 0.25_dp,-0.75_dp, &
       & -0.75_dp, 0.75_dp,-0.75_dp,-0.25_dp, 0.75_dp,-0.75_dp, 0.25_dp, 0.75_dp,-0.75_dp, 0.75_dp, 0.75_dp,-0.75_dp, &
       & -0.75_dp,-0.75_dp,-0.25_dp,-0.25_dp,-0.75_dp,-0.25_dp, 0.25_dp,-0.75_dp,-0.25_dp, 0.75_dp,-0.75_dp,-0.25_dp, &
       & -0.75_dp,-0.25_dp,-0.25_dp, 0.75_dp,-0.25_dp,-0.25_dp,-0.75_dp, 0.25_dp,-0.25_dp, 0.75_dp, 0.25_dp,-0.25_dp, &
       & -0.75_dp, 0.75_dp,-0.25_dp,-0.25_dp, 0.75_dp,-0.25_dp, 0.25_dp, 0.75_dp,-0.25_dp, 0.75_dp, 0.75_dp,-0.25_dp, &
       & -0.75_dp,-0.75_dp, 0.25_dp,-0.25_dp,-0.75_dp, 0.25_dp, 0.25_dp,-0.75_dp, 0.25_dp, 0.75_dp,-0.75_dp, 0.25_dp, &
       & -0.75_dp,-0.25_dp, 0.25_dp, 0.75_dp,-0.25_dp, 0.25_dp,-0.75_dp, 0.25_dp, 0.25_dp, 0.75_dp, 0.25_dp, 0.25_dp, &
       & -0.75_dp, 0.75_dp, 0.25_dp,-0.25_dp, 0.75_dp, 0.25_dp, 0.25_dp, 0.75_dp, 0.25_dp, 0.75_dp, 0.75_dp, 0.25_dp, &
       & -0.75_dp,-0.75_dp, 0.75_dp,-0.25_dp,-0.75_dp, 0.75_dp, 0.25_dp,-0.75_dp, 0.75_dp, 0.75_dp,-0.75_dp, 0.75_dp, &
       & -0.75_dp,-0.25_dp, 0.75_dp,-0.25_dp,-0.25_dp, 0.75_dp, 0.25_dp,-0.25_dp, 0.75_dp, 0.75_dp,-0.25_dp, 0.75_dp, &
       & -0.75_dp, 0.25_dp, 0.75_dp,-0.25_dp, 0.25_dp, 0.75_dp, 0.25_dp, 0.25_dp, 0.75_dp, 0.75_dp, 0.25_dp, 0.75_dp, &
       & -0.75_dp, 0.75_dp, 0.75_dp,-0.25_dp, 0.75_dp, 0.75_dp, 0.25_dp, 0.75_dp, 0.75_dp, 0.75_dp, 0.75_dp, 0.75_dp  &
       /), (/3, 56/))

  ! -------------------------------------------------------------
  ! Device arrays for test-cells (allocated to ntestmax)
  ! -------------------------------------------------------------
  integer, device, allocatable, dimension(:)         :: grid_d
  integer, device, allocatable, dimension(:)         :: cell_d
  integer, device, allocatable, dimension(:)         :: level_d
  integer, device, allocatable, dimension(:)         :: nbor_grid_d
  integer, device, allocatable, dimension(:)         :: nbor_cell_d
  integer, device, allocatable, dimension(:)         :: is_peak_d
  integer, device, allocatable, dimension(:)         :: is_peak_scan_d
  integer, device, allocatable, dimension(:)         :: parent_d
  real(kind=dp), device, allocatable, dimension(:)   :: dens_d

  ! -------------------------------------------------------------
  ! Device arrays for clumps (allocated to nclumpmax)
  ! -------------------------------------------------------------
  integer, device, allocatable, dimension(:)         :: peak_cell_d
  integer, device, allocatable, dimension(:)         :: peak_grid_d
  integer, device, allocatable, dimension(:)         :: peak_level_d
  real(kind=dp), device, allocatable, dimension(:)   :: max_dens_d
  real(kind=dp), device, allocatable, dimension(:)   :: saddle_dens_d
  integer, device, allocatable, dimension(:)         :: saddle_nbor_d
  integer(kind=8), device, allocatable, dimension(:) :: saddle_edge_d
  integer, device, allocatable, dimension(:)         :: lev_peak_d
  integer, device, allocatable, dimension(:)         :: new_peak_d
  real(kind=dp), device, allocatable, dimension(:)   :: relevance_d
  integer, device, allocatable, dimension(:)         :: alive_d
  real(kind=dp), device, allocatable, dimension(:)   :: tidal_dens_d
  real(kind=dp), device, allocatable, dimension(:)   :: min_dens_d
  integer, device, allocatable, dimension(:)         :: n_cells_d
  real(kind=dp), device, allocatable, dimension(:)   :: clump_mass_d
  real(kind=dp), device, allocatable, dimension(:)   :: clump_vol_d
  real(kind=dp), device, allocatable, dimension(:)   :: clump_rad_d
  integer, device, allocatable, dimension(:)         :: npart_d
  real(kind=dp), device, allocatable, dimension(:)   :: particle_mass_d
  integer, device, allocatable, dimension(:)         :: ind_final_d
  real(kind=dp), device, allocatable, dimension(:,:) :: peak_pos_d
  real(kind=dp), device, allocatable, dimension(:,:) :: peak_vel_d
  real(kind=dp), device, allocatable, dimension(:,:) :: peak_acc_d
  real(kind=dp), device, allocatable, dimension(:,:) :: peak_com_d
  integer, device, allocatable, dimension(:)         :: ind_halo_d
  real(kind=dp), device, allocatable, dimension(:)   :: halo_mass_d
  real(kind=dp), device, allocatable, dimension(:,:) :: mass_bin_d
  real(kind=dp), device, allocatable, dimension(:,:) :: phi_clump_d
  integer, device, allocatable, dimension(:)         :: nsink_d
  integer, device, allocatable, dimension(:)         :: ntree_d
  integer(i8b), device, allocatable, dimension(:)    :: min_tree_id_d

  ! Time step per level in dp for the tree kernels (filled by the host drivers)
  real(kind=dp), device, dimension(1:MAXLEVEL)       :: dtnew_dp_d

contains

  include 'gpu_hash.cuf'
  include 'gpu_cell.cuf'

  ! =========================================================================
  ! Allocate clump arrays on the device
  ! =========================================================================
  subroutine gpu_allocate_clump(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    integer :: ntestmax, nclumpmax
    logical :: do_halo, do_profile

    do_halo = ((sim%r%clump_finder .or. sim%r%tree) .and. sim%r%saddle_threshold > 0) .or. &
         & (sim%r%sink_form .and. sim%r%sink_saddle_threshold > 0)
    do_profile = (sim%r%clump_finder .and. sim%r%saddle_threshold > 0 .and. &
         & sim%r%part .and. sim%r%rho_type_clump == 1)

    ! Test cells are scanned with gpu_scan: use the size of the scan buffers,
    ! i.e. the largest capacity requested by gpu_allocate_amr/part/star/sink/tree
    ntestmax = sim%m%ngridmax + sim%m%ncachemax
    if (sim%r%part) ntestmax = max(ntestmax, sim%r%npartmax)
    if (sim%r%star) ntestmax = max(ntestmax, sim%r%nstarmax)
    if (sim%r%sink) ntestmax = max(ntestmax, sim%r%nsinkmax)
    if (sim%r%tree) ntestmax = max(ntestmax, sim%r%ntreemax)
    nclumpmax = sim%m%ngridmax/10

    ! Allocate test cell arrays
    if (.not. allocated(grid_d))           allocate(grid_d(1:ntestmax))
    if (.not. allocated(cell_d))           allocate(cell_d(1:ntestmax))
    if (.not. allocated(level_d))          allocate(level_d(1:ntestmax))
    if (.not. allocated(nbor_grid_d))      allocate(nbor_grid_d(1:ntestmax))
    if (.not. allocated(nbor_cell_d))      allocate(nbor_cell_d(1:ntestmax))
    if (.not. allocated(is_peak_d))        allocate(is_peak_d(1:ntestmax))
    if (.not. allocated(is_peak_scan_d))   allocate(is_peak_scan_d(1:ntestmax))
    if (.not. allocated(parent_d))         allocate(parent_d(1:ntestmax))
    if (.not. allocated(dens_d))           allocate(dens_d(1:ntestmax))

    ! Allocate clump arrays
    if (.not. allocated(peak_cell_d))      allocate(peak_cell_d(1:nclumpmax))
    if (.not. allocated(peak_grid_d))      allocate(peak_grid_d(1:nclumpmax))
    if (.not. allocated(peak_level_d))     allocate(peak_level_d(1:nclumpmax))
    if (.not. allocated(max_dens_d))       allocate(max_dens_d(1:nclumpmax))
    if (.not. allocated(saddle_dens_d))    allocate(saddle_dens_d(1:nclumpmax))
    if (.not. allocated(saddle_nbor_d))    allocate(saddle_nbor_d(1:nclumpmax))
    if (.not. allocated(saddle_edge_d))    allocate(saddle_edge_d(1:nclumpmax))
    if (.not. allocated(lev_peak_d))       allocate(lev_peak_d(1:nclumpmax))
    if (.not. allocated(new_peak_d))       allocate(new_peak_d(1:nclumpmax))
    if (.not. allocated(relevance_d))      allocate(relevance_d(1:nclumpmax))
    if (.not. allocated(alive_d))          allocate(alive_d(1:nclumpmax))
    if (.not. allocated(tidal_dens_d))     allocate(tidal_dens_d(1:nclumpmax))
    if (.not. allocated(min_dens_d))       allocate(min_dens_d(1:nclumpmax))
    if (.not. allocated(n_cells_d))        allocate(n_cells_d(1:nclumpmax))
    if (.not. allocated(clump_mass_d))     allocate(clump_mass_d(1:nclumpmax))
    if (.not. allocated(clump_vol_d))      allocate(clump_vol_d(1:nclumpmax))
    if (.not. allocated(clump_rad_d))      allocate(clump_rad_d(1:nclumpmax))
    if (.not. allocated(npart_d))          allocate(npart_d(1:nclumpmax))
    if (.not. allocated(particle_mass_d))  allocate(particle_mass_d(1:nclumpmax))
    if (.not. allocated(ind_final_d))      allocate(ind_final_d(1:nclumpmax))
    if (.not. allocated(peak_pos_d))       allocate(peak_pos_d(1:ndim, 1:nclumpmax))
    if (.not. allocated(peak_vel_d))       allocate(peak_vel_d(1:ndim, 1:nclumpmax))
    if (.not. allocated(peak_acc_d))       allocate(peak_acc_d(1:ndim, 1:nclumpmax))
    if (.not. allocated(peak_com_d))       allocate(peak_com_d(1:ndim, 1:nclumpmax))
    if (do_halo) then
       if (.not. allocated(ind_halo_d))    allocate(ind_halo_d(1:nclumpmax))
       if (.not. allocated(halo_mass_d))   allocate(halo_mass_d(1:nclumpmax))
    endif
    if (do_profile) then
       if (.not. allocated(mass_bin_d))    allocate(mass_bin_d(1:nbin, 1:nclumpmax))
       if (.not. allocated(phi_clump_d))   allocate(phi_clump_d(1:nbin, 1:nclumpmax))
    endif
    if (sim%r%sink) then
       if (.not. allocated(nsink_d))       allocate(nsink_d(1:nclumpmax))
    endif
    if (sim%r%tree) then
       if (.not. allocated(ntree_d))       allocate(ntree_d(1:nclumpmax))
       if (.not. allocated(min_tree_id_d)) allocate(min_tree_id_d(1:nclumpmax))
    endif
  end subroutine gpu_allocate_clump

  ! =========================================================================
  ! Deallocate clump arrays on the device
  ! =========================================================================
  subroutine gpu_deallocate_clump()
    if (allocated(grid_d))           deallocate(grid_d)
    if (allocated(cell_d))           deallocate(cell_d)
    if (allocated(level_d))          deallocate(level_d)
    if (allocated(nbor_grid_d))      deallocate(nbor_grid_d)
    if (allocated(nbor_cell_d))      deallocate(nbor_cell_d)
    if (allocated(is_peak_d))        deallocate(is_peak_d)
    if (allocated(is_peak_scan_d))   deallocate(is_peak_scan_d)
    if (allocated(parent_d))         deallocate(parent_d)
    if (allocated(dens_d))           deallocate(dens_d)

    if (allocated(peak_cell_d))      deallocate(peak_cell_d)
    if (allocated(peak_grid_d))      deallocate(peak_grid_d)
    if (allocated(peak_level_d))     deallocate(peak_level_d)
    if (allocated(max_dens_d))       deallocate(max_dens_d)
    if (allocated(saddle_dens_d))    deallocate(saddle_dens_d)
    if (allocated(saddle_nbor_d))    deallocate(saddle_nbor_d)
    if (allocated(saddle_edge_d))    deallocate(saddle_edge_d)
    if (allocated(lev_peak_d))       deallocate(lev_peak_d)
    if (allocated(new_peak_d))       deallocate(new_peak_d)
    if (allocated(relevance_d))      deallocate(relevance_d)
    if (allocated(alive_d))          deallocate(alive_d)
    if (allocated(tidal_dens_d))     deallocate(tidal_dens_d)
    if (allocated(min_dens_d))       deallocate(min_dens_d)
    if (allocated(n_cells_d))        deallocate(n_cells_d)
    if (allocated(clump_mass_d))     deallocate(clump_mass_d)
    if (allocated(clump_vol_d))      deallocate(clump_vol_d)
    if (allocated(clump_rad_d))      deallocate(clump_rad_d)
    if (allocated(npart_d))          deallocate(npart_d)
    if (allocated(particle_mass_d))  deallocate(particle_mass_d)
    if (allocated(ind_final_d))      deallocate(ind_final_d)
    if (allocated(peak_pos_d))       deallocate(peak_pos_d)
    if (allocated(peak_vel_d))       deallocate(peak_vel_d)
    if (allocated(peak_acc_d))       deallocate(peak_acc_d)
    if (allocated(peak_com_d))       deallocate(peak_com_d)
    if (allocated(ind_halo_d))       deallocate(ind_halo_d)
    if (allocated(halo_mass_d))      deallocate(halo_mass_d)
    if (allocated(mass_bin_d))       deallocate(mass_bin_d)
    if (allocated(phi_clump_d))      deallocate(phi_clump_d)
    if (allocated(nsink_d))          deallocate(nsink_d)
    if (allocated(ntree_d))          deallocate(ntree_d)
    if (allocated(min_tree_id_d))    deallocate(min_tree_id_d)
  end subroutine gpu_deallocate_clump

  ! =========================================================================
  ! Reset clump counters after GPU sink formation.
  ! Device clump arrays are allocated once at startup and never deallocated.
  ! =========================================================================
  subroutine gpu_reset_clump(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    sim%c%ntest = 0
    sim%c%ntest_tot = 0
    sim%c%npeak = 0
    sim%c%npeak_tot = 0

    ! Deallocate host peak arrays filled by gpu_clump_to_host
    if (allocated(sim%c%peak_pos)) then
       deallocate(sim%c%npeak_cum)
       deallocate(sim%c%peak_cell, sim%c%peak_grid, sim%c%peak_level, sim%c%max_dens)
       deallocate(sim%c%saddle_dens, sim%c%saddle_nbor, sim%c%lev_peak, sim%c%new_peak)
       deallocate(sim%c%relevance, sim%c%tidal_dens)
       deallocate(sim%c%peak_pos, sim%c%peak_vel, sim%c%peak_acc, sim%c%peak_com)
       deallocate(sim%c%min_dens, sim%c%n_cells, sim%c%clump_mass, sim%c%clump_vol, sim%c%clump_rad)
       deallocate(sim%c%npart, sim%c%particle_mass, sim%c%ind_final)
       if (allocated(sim%c%ind_halo)) deallocate(sim%c%ind_halo, sim%c%halo_mass)
       if (allocated(sim%c%mass_bin)) deallocate(sim%c%mass_bin, sim%c%phi)
       if (allocated(sim%c%nsink)) deallocate(sim%c%nsink, sim%c%form_sink)
    endif

    ! Deallocate host particle peak and halo ids filled by gpu_clump_to_host
    if (allocated(sim%p%pid))    deallocate(sim%p%pid, sim%p%hid)
    if (allocated(sim%star%pid)) deallocate(sim%star%pid, sim%star%hid)
    if (allocated(sim%sink%pid)) deallocate(sim%sink%pid, sim%sink%hid)
    if (allocated(sim%tree%pid)) deallocate(sim%tree%pid, sim%tree%hid)
  end subroutine gpu_reset_clump

  ! =========================================================================
  ! Copy GPU clump finder results to the host for output (single rank).
  ! Host arrays are deallocated in gpu_reset_clump.
  ! =========================================================================
  subroutine gpu_clump_to_host(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    integer :: npeak
    real(kind=dp), allocatable, dimension(:,:) :: tmp

    npeak = sim%c%npeak
    if (npeak <= 0) return

    associate(c=>sim%c, m=>sim%m)

    ! Peak counts (single rank)
    allocate(c%npeak_cum(0:sim%g%ncpu))
    c%npeak_cum(0) = 0
    c%npeak_cum(1) = npeak
    c%npeak_max = npeak

    ! Peak-patch properties
    allocate(c%peak_cell(1:npeak));     c%peak_cell     = peak_cell_d(1:npeak)
    allocate(c%peak_grid(1:npeak));     c%peak_grid     = peak_grid_d(1:npeak)
    allocate(c%peak_level(1:npeak));    c%peak_level    = peak_level_d(1:npeak)
    allocate(c%max_dens(1:npeak));      c%max_dens      = max_dens_d(1:npeak)
    allocate(c%saddle_dens(1:npeak));   c%saddle_dens   = saddle_dens_d(1:npeak)
    allocate(c%saddle_nbor(1:npeak));   c%saddle_nbor   = saddle_nbor_d(1:npeak)
    allocate(c%lev_peak(1:npeak));      c%lev_peak      = lev_peak_d(1:npeak)
    allocate(c%new_peak(1:npeak));      c%new_peak      = new_peak_d(1:npeak)
    allocate(c%relevance(1:npeak));     c%relevance     = relevance_d(1:npeak)
    allocate(c%tidal_dens(1:npeak));    c%tidal_dens    = tidal_dens_d(1:npeak)
    allocate(c%min_dens(1:npeak));      c%min_dens      = min_dens_d(1:npeak)
    allocate(c%n_cells(1:npeak));       c%n_cells       = n_cells_d(1:npeak)
    allocate(c%clump_mass(1:npeak));    c%clump_mass    = clump_mass_d(1:npeak)
    allocate(c%clump_vol(1:npeak));     c%clump_vol     = clump_vol_d(1:npeak)
    allocate(c%clump_rad(1:npeak));     c%clump_rad     = clump_rad_d(1:npeak)
    allocate(c%npart(1:npeak));         c%npart         = npart_d(1:npeak)
    allocate(c%particle_mass(1:npeak)); c%particle_mass = particle_mass_d(1:npeak)

    ! Device vectors are (ndim,npeak), host ones are (npeak,ndim)
    allocate(tmp(1:ndim, 1:npeak))
    allocate(c%peak_pos(1:npeak, 1:ndim)); tmp = peak_pos_d(:, 1:npeak); c%peak_pos = transpose(tmp)
    allocate(c%peak_vel(1:npeak, 1:ndim)); tmp = peak_vel_d(:, 1:npeak); c%peak_vel = transpose(tmp)
    allocate(c%peak_acc(1:npeak, 1:ndim)); tmp = peak_acc_d(:, 1:npeak); c%peak_acc = transpose(tmp)
    allocate(c%peak_com(1:npeak, 1:ndim)); tmp = peak_com_d(:, 1:npeak); c%peak_com = transpose(tmp)
    deallocate(tmp)

    ! Final clump ids (computed by trim_clumps)
    allocate(c%ind_final(1:npeak)); c%ind_final = ind_final_d(1:npeak)

    ! Halo-patch properties
    if (c%saddle_threshold > 0) then
       allocate(c%ind_halo(1:npeak));  c%ind_halo  = ind_halo_d(1:npeak)
       allocate(c%halo_mass(1:npeak)); c%halo_mass = halo_mass_d(1:npeak)
       if (allocated(mass_bin_d)) then
          ! Device profiles are (nbin,npeak), host ones are (npeak,nbin)
          allocate(tmp(1:nbin, 1:npeak))
          allocate(c%mass_bin(1:npeak, 1:nbin)); tmp = mass_bin_d(:, 1:npeak);  c%mass_bin = transpose(tmp)
          allocate(c%phi(1:npeak, 1:nbin));      tmp = phi_clump_d(:, 1:npeak); c%phi      = transpose(tmp)
          deallocate(tmp)
       endif
    endif

    ! Sink counts per peak
    if (sim%r%sink) then
       allocate(c%nsink(1:npeak));     c%nsink     = nsink_d(1:npeak)
       allocate(c%form_sink(1:npeak)); c%form_sink = 0
    endif

    ! Mesh fields: halo id (flag1), peak id (flag2) and smoothed density
    m%flag1 = flag1
    m%flag2 = flag2
#ifdef GRAV
    m%rho   = rho
#endif

    ! Particle peak and halo ids (without halo merging, each clump is its own halo)
    if (sim%r%part) then
       allocate(sim%p%pid(1:sim%p%npart), sim%p%hid(1:sim%p%npart))
       if (sim%p%npart > 0) then
          sim%p%pid = pid(1:sim%p%npart)
          if (c%saddle_threshold > 0) then
             sim%p%hid = hid(1:sim%p%npart)
          else
             sim%p%hid = sim%p%pid
          endif
       endif
    endif
    if (sim%r%star) then
       allocate(sim%star%pid(1:sim%star%npart), sim%star%hid(1:sim%star%npart))
       if (sim%star%npart > 0) then
          sim%star%pid = star_pid(1:sim%star%npart)
          if (c%saddle_threshold > 0) then
             sim%star%hid = star_hid(1:sim%star%npart)
          else
             sim%star%hid = sim%star%pid
          endif
       endif
    endif
    if (sim%r%sink) then
       allocate(sim%sink%pid(1:sim%sink%npart), sim%sink%hid(1:sim%sink%npart))
       if (sim%sink%npart > 0) then
          sim%sink%pid = sink_pid(1:sim%sink%npart)
          if (c%saddle_threshold > 0) then
             sim%sink%hid = sink_hid(1:sim%sink%npart)
          else
             sim%sink%hid = sim%sink%pid
          endif
       endif
    endif
    if (sim%r%tree) then
       allocate(sim%tree%pid(1:sim%tree%npart), sim%tree%hid(1:sim%tree%npart))
       if (sim%tree%npart > 0) then
          sim%tree%pid = tree_pid(1:sim%tree%npart)
          if (c%saddle_threshold > 0) then
             sim%tree%hid = tree_hid(1:sim%tree%npart)
          else
             sim%tree%hid = sim%tree%pid
          endif
       endif
    endif

    end associate
  end subroutine gpu_clump_to_host

  ! =========================================================================
  ! CUDA Kernel: Save raw density to nref for levelmin
  ! =========================================================================
  attributes(global) subroutine save_nref_kernel(rho, nref, head_idx, num_octs)
    real(kind=dp), device :: rho(1:twotondim, *)
    real(kind=dp), device :: nref(1:twotondim, *)
    integer, value :: head_idx, num_octs

    integer :: cell_idx, oct_idx, block_idx

    block_idx = blockIdx%x - 1
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    cell_idx = threadIdx%x

    ! Save true density value into nref
    nref(cell_idx, oct_idx) = rho(cell_idx, oct_idx)
  end subroutine save_nref_kernel

  ! =========================================================================
  ! CUDA Kernel: Smooth density field
  ! =========================================================================
  attributes(global) subroutine smooth_rho_kernel(rho, nref, grid, father, head_idx, num_octs)
    real(kind=dp), device :: rho(1:twotondim, *)
    real(kind=dp), device :: nref(1:twotondim, *)
    type(oct), device :: grid(*)
    integer, device :: father(*)
    integer, value :: head_idx, num_octs

    integer :: cell_idx, oct_idx, block_idx
    integer :: father_idx, father_cell_idx

    block_idx = blockIdx%x - 1
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    cell_idx = threadIdx%x

    ! Save true density value into nref
    nref(cell_idx, oct_idx) = rho(cell_idx, oct_idx)

    ! Compute parent indices
    father_idx = father(oct_idx)
    father_cell_idx = parent_cell_idx(grid(oct_idx)%ckey, grid(father_idx)%ckey)

    ! Smooth density field
    rho(cell_idx, oct_idx) = 0.5d0 * rho(cell_idx, oct_idx) + 0.5d0 * rho(father_cell_idx, father_idx)
  end subroutine smooth_rho_kernel

  ! =========================================================================
  ! Host Driver: Smooth density field level-by-level on GPU
  ! =========================================================================
  subroutine gpu_smooth_rho(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer :: ilevel, num_octs, head_idx
    integer :: block_y, grid_x
    type(dim3) :: block_dim, grid_dim

    block_y = 16
    block_dim = dim3(twotondim, block_y, 1)

    ! Save true density value into nref at levelmin
    head_idx = sim%m%head(sim%r%levelmin)
    num_octs = sim%m%noct(sim%r%levelmin)
    if (num_octs > 0) then
       grid_x = (num_octs + block_y - 1) / block_y
       grid_dim = dim3(grid_x, 1, 1)
       call save_nref_kernel<<<grid_dim, block_dim>>>(rho, nref, head_idx, num_octs)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif

    do ilevel = sim%r%levelmin + 1, sim%r%nlevelmax
       head_idx = sim%m%head(ilevel)
       num_octs = sim%m%noct(ilevel)
       if (num_octs > 0) then
          grid_x = (num_octs + block_y - 1) / block_y
          grid_dim = dim3(grid_x, 1, 1)
          call smooth_rho_kernel<<<grid_dim, block_dim>>>(rho, nref, grid, father, head_idx, num_octs)
          call GPU_Error_Check(__FILE__, __LINE__)
       endif
    enddo
  end subroutine gpu_smooth_rho

  ! =========================================================================
  ! CUDA Kernel: Count active cells above threshold per oct
  ! Requires blockDim%x == twotondim and blockDim%x*blockDim%y a multiple of 32
  ! =========================================================================
  attributes(global) subroutine flag_test_cells_kernel(prefix_sum, rho, grid, threshold, head_idx, num_octs)
    integer, device :: prefix_sum(*)
    real(kind=dp), device :: rho(1:twotondim, *)
    type(oct), device :: grid(*)
    real(kind=dp), value :: threshold
    integer, value :: head_idx, num_octs

    integer :: cell_idx, oct_idx, block_idx
    integer :: irank, offset, num
    logical :: valid, ok

    block_idx = blockIdx%x - 1
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    cell_idx = threadIdx%x

    valid = (oct_idx < num_octs)
    if (valid) then
       oct_idx = head_idx + oct_idx
       ok = .not. grid(oct_idx)%refined(cell_idx) .and. rho(cell_idx, oct_idx) > threshold
    else
       ok = .false.
    endif

    irank = merge(1, 0, ok)

    ! Intra-oct inclusive scan across the 8 cells (all warp lanes active)
    offset = 1
    do while (offset < twotondim)
       num = __shfl_up(irank, offset)
       if (offset < cell_idx) irank = irank + num
       offset = offset * 2
    end do

    if (valid .and. cell_idx == twotondim) prefix_sum(oct_idx) = irank
  end subroutine flag_test_cells_kernel

  ! =========================================================================
  ! CUDA Kernel: Scatter active test cells to compacted arrays
  ! Requires blockDim%x == twotondim and blockDim%x*blockDim%y a multiple of 32
  ! =========================================================================
  attributes(global) subroutine scatter_test_cells_kernel(grid_d, cell_d, level_d, dens_d, &
       & prefix_sum, rho, grid, threshold, head_idx, num_octs)
    integer, device :: grid_d(*), cell_d(*), level_d(*)
    real(kind=dp), device :: dens_d(*)
    integer, device :: prefix_sum(*)
    real(kind=dp), device :: rho(1:twotondim, *)
    type(oct), device :: grid(*)
    real(kind=dp), value :: threshold
    integer, value :: head_idx, num_octs

    integer :: cell_idx, oct_idx, block_idx, idx, base_idx
    integer :: irank, offset, num
    logical :: ok

    block_idx = blockIdx%x - 1
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    cell_idx = threadIdx%x

    if (oct_idx < num_octs) then
       oct_idx = head_idx + oct_idx
       ok = .not. grid(oct_idx)%refined(cell_idx) .and. rho(cell_idx, oct_idx) > threshold
    else
       ok = .false.
    endif

    irank = merge(1, 0, ok)

    ! Intra-oct inclusive scan across the 8 cells (all warp lanes active)
    offset = 1
    do while (offset < twotondim)
       num = __shfl_up(irank, offset)
       if (offset < cell_idx) irank = irank + num
       offset = offset * 2
    end do

    if (ok) then
       base_idx = 0
       if (oct_idx > head_idx) base_idx = prefix_sum(oct_idx - 1)
       idx = base_idx + irank
       grid_d(idx) = oct_idx
       cell_d(idx) = cell_idx
       level_d(idx) = grid(oct_idx)%lev
       dens_d(idx) = rho(cell_idx, oct_idx)
    endif
  end subroutine scatter_test_cells_kernel

  ! =========================================================================
  ! Host Driver: Collect and compact cells above threshold
  ! =========================================================================
  subroutine gpu_collect_test(sim, ntest)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(out) :: ntest

    integer :: num_octs, head_idx
    integer :: block_y, grid_x
    type(dim3) :: block_dim, grid_dim
    integer, device :: total_test_d
    real(kind=dp) :: threshold

    threshold = sim%c%density_threshold

    block_y = 16
    block_dim = dim3(twotondim, block_y, 1)

    head_idx = 1
    num_octs = sim%m%ifree - 1
    if (num_octs <= 0) then
       ntest = 0
       return
    endif

    ! 1. Count active test cells per oct into prefix_sum(1:num_octs)
    grid_x = (num_octs + block_y - 1) / block_y
    grid_dim = dim3(grid_x, 1, 1)
    call flag_test_cells_kernel<<<grid_dim, block_dim>>>(prefix_sum, rho, grid, threshold, head_idx, num_octs)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Compute inclusive prefix scan over octs
    call gpu_scan(prefix_sum, 1, num_octs, total_test_d)
    ntest = total_test_d
    if (ntest < 0 .or. ntest > size(grid_d)) then
       write(*,*) 'gpu_collect_test: cells above density threshold exceed ntestmax (', size(grid_d), ')'
       write(*,*) 'Increase density_threshold (clump finder) or sink_density_threshold (sink formation)'
       stop
    endif
    if (ntest == 0) return

    ! 3. Scatter to compacted arrays in a single launch
    call scatter_test_cells_kernel<<<grid_dim, block_dim>>>(grid_d, cell_d, level_d, dens_d, &
         & prefix_sum, rho, grid, threshold, head_idx, num_octs)
    call GPU_Error_Check(__FILE__, __LINE__)
  end subroutine gpu_collect_test

  ! =========================================================================
  ! Device Function: Resolve spatial coordinates to a parent grid and cell
  ! =========================================================================
  attributes(device) subroutine get_parent_cell_device(hash_nbor, igridn, icelln, hash_key, hash_val, hash_size)
    integer(kind=8), intent(in) :: hash_nbor(0:3)
    integer, intent(out) :: igridn, icelln
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer, value :: hash_size

    integer :: ilev_par
    integer(kind=8) :: ix, iy, iz, nx, offset, key
    integer :: bit(3)

    ilev_par = hash_nbor(0) - 1

    ix = hash_nbor(1) / 2
    iy = hash_nbor(2) / 2
    iz = hash_nbor(3) / 2

    bit(1) = hash_nbor(1) - 2 * ix
    bit(2) = hash_nbor(2) - 2 * iy
    bit(3) = hash_nbor(3) - 2 * iz
    icelln = 1 + bit(1) + 2*bit(2) + 4*bit(3)

    nx = ckey_max(ilev_par)
    offset = key_off(ilev_par)
    key = offset + ix + iy*nx + iz*nx*nx

    igridn = hash_get(hash_key, hash_val, hash_size, key)
  end subroutine get_parent_cell_device

  ! =========================================================================
  ! CUDA Kernel: Scan neighbors and identify peaks
  ! =========================================================================
  attributes(global) subroutine collect_peak_kernel( &
       & grid_d, cell_d, level_d, nbor_grid_d, nbor_cell_d, is_peak_d, &
       & rho, grid, periodic, box_ckey_min, box_ckey_max, &
       & hash_key, hash_val, hash_size, ntest, ngridmax)
    integer, device :: grid_d(*), cell_d(*), level_d(*)
    integer, device :: nbor_grid_d(*), nbor_cell_d(*)
    integer, device :: is_peak_d(*)
    real(kind=dp), device :: rho(1:twotondim, *)
    type(oct), device :: grid(*)
    logical, device :: periodic(3)
    integer, device :: box_ckey_min(3,*), box_ckey_max(3,*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer, value :: hash_size, ntest
    integer, value :: ngridmax

    integer :: itest, lane, cblk, offset
    integer :: ilevel, igrid, ind, igridn, icelln
    integer :: idim
    real(kind=8) :: xcen(3), xnei(3)
    integer :: ckey_nbor(3)
    integer(kind=8) :: hash_nbor(0:3)
    real(kind=8) :: dens_nbor, density_max, dens_cand

    ! Per-cell argmax reduction: 56 lanes padded to 64 slots, 4 cells per block
    real(kind=dp), shared :: s_dens(0:63, 0:3)
    integer, shared :: s_lane(0:63, 0:3), s_grid(0:63, 0:3), s_cell(0:63, 0:3)

    ! One thread per neighbor: 56 lanes per test cell, 4 cells per block
    cblk = (threadIdx%x - 1) / 56
    lane = mod(threadIdx%x - 1, 56)
    itest = (blockIdx%x - 1) * 4 + cblk + 1

    igridn = 0
    icelln = 0
    dens_cand = -huge(0.0_dp)

    if (itest <= ntest) then
       ilevel = level_d(itest)
       igrid = grid_d(itest)
       ind = cell_d(itest)

       xcen(1) = 2*grid(igrid)%ckey(1) + MOD((ind-1),   2) + 0.5d0
       xcen(2) = 2*grid(igrid)%ckey(2) + MOD((ind-1)/2, 2) + 0.5d0
       xcen(3) = 2*grid(igrid)%ckey(3) + MOD((ind-1)/4, 2) + 0.5d0

       density_max = 1.0001d0 * rho(ind, igrid)

       xnei(1) = xcen(1) + xnbor_const(1, lane+1)
       xnei(2) = xcen(2) + xnbor_const(2, lane+1)
       xnei(3) = xcen(3) + xnbor_const(3, lane+1)

       ! Periodic boundary conditions
       do idim = 1, 3
          if (periodic(idim)) then
             if (xnei(idim) < box_ckey_min(idim, ilevel+1)) then
                xnei(idim) = xnei(idim) - box_ckey_min(idim, ilevel+1) + box_ckey_max(idim, ilevel+1)
             endif
             if (xnei(idim) >= box_ckey_max(idim, ilevel+1)) then
                xnei(idim) = xnei(idim) + box_ckey_min(idim, ilevel+1) - box_ckey_max(idim, ilevel+1)
             endif
          endif
       end do

       ! Get neighboring cell at ilevel
       ckey_nbor(1) = int(xnei(1))
       ckey_nbor(2) = int(xnei(2))
       ckey_nbor(3) = int(xnei(3))
       hash_nbor(0) = ilevel + 1
       hash_nbor(1:3) = ckey_nbor(1:3)
       call get_parent_cell_device(hash_nbor, igridn, icelln, hash_key, hash_val, hash_size)

       ! If missing, get neighboring cell at ilevel-1
       if (igridn <= 0 .or. igridn > ngridmax) then
          ckey_nbor(1) = int(xnei(1)/2.0d0)
          ckey_nbor(2) = int(xnei(2)/2.0d0)
          ckey_nbor(3) = int(xnei(3)/2.0d0)
          hash_nbor(0) = ilevel
          hash_nbor(1:3) = ckey_nbor(1:3)
          call get_parent_cell_device(hash_nbor, igridn, icelln, hash_key, hash_val, hash_size)
       ! If refined, get neighboring cell at ilevel+1
       else if (grid(igridn)%refined(icelln)) then
          ckey_nbor(1) = int(xnei(1)*2.0d0)
          ckey_nbor(2) = int(xnei(2)*2.0d0)
          ckey_nbor(3) = int(xnei(3)*2.0d0)
          hash_nbor(0) = ilevel + 2
          hash_nbor(1:3) = ckey_nbor(1:3)
          call get_parent_cell_device(hash_nbor, igridn, icelln, hash_key, hash_val, hash_size)
       endif

       if (igridn > 0 .and. igridn <= ngridmax) then
          dens_nbor = rho(icelln, igridn)
          if (dens_nbor > density_max) then
             dens_cand = dens_nbor
          else
             igridn = 0
             icelln = 0
          endif
       else
          igridn = 0
          icelln = 0
       endif
    endif

    s_dens(lane, cblk) = dens_cand
    s_lane(lane, cblk) = lane
    s_grid(lane, cblk) = igridn
    s_cell(lane, cblk) = icelln
    if (lane < 8) then ! pad slots 56-63
       s_dens(lane+56, cblk) = -huge(0.0_dp)
       s_lane(lane+56, cblk) = 64
    endif
    call syncthreads()

    ! Tree argmax over the 64 slots (ties: lowest lane, as in the CPU scan order)
    offset = 32
    do while (offset >= 1)
       if (lane < offset) then
          if (s_dens(lane+offset, cblk) > s_dens(lane, cblk) .or. &
              (s_dens(lane+offset, cblk) == s_dens(lane, cblk) .and. &
               s_lane(lane+offset, cblk) < s_lane(lane, cblk))) then
             s_dens(lane, cblk) = s_dens(lane+offset, cblk)
             s_lane(lane, cblk) = s_lane(lane+offset, cblk)
             s_grid(lane, cblk) = s_grid(lane+offset, cblk)
             s_cell(lane, cblk) = s_cell(lane+offset, cblk)
          endif
       endif
       call syncthreads()
       offset = offset / 2
    end do

    if (lane == 0 .and. itest <= ntest) then
       if (s_dens(0, cblk) > -huge(0.0_dp)) then ! some neighbor is denser: not a peak
          is_peak_d(itest) = 0
          nbor_grid_d(itest) = s_grid(0, cblk)
          nbor_cell_d(itest) = s_cell(0, cblk)
       else
          is_peak_d(itest) = 1
          nbor_grid_d(itest) = 0
          nbor_cell_d(itest) = 0
       endif
    endif
  end subroutine collect_peak_kernel

  ! =========================================================================
  ! Host Driver: Detect peaks on GPU
  ! =========================================================================
  subroutine gpu_collect_peak(sim, ntest, npeak)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: ntest
    integer, intent(out) :: npeak

    integer :: block_size, grid_size
    integer, device :: total_peaks_d

    ! 56 threads per test cell, so block size 224 (4 cells per block)
    block_size = 224
    grid_size = (ntest + 3) / 4

    ! Launch peak detection kernel
    call collect_peak_kernel<<<grid_size, block_size>>>( &
         & grid_d, cell_d, level_d, nbor_grid_d, nbor_cell_d, is_peak_d, &
         & rho, grid, periodic, box_ckey_min, box_ckey_max, &
         & hash_key, hash_val, sim%m%hash_size, ntest, sim%m%ngridmax)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! Compute prefix scan to count total peaks
    is_peak_scan_d = is_peak_d
    call gpu_scan(is_peak_scan_d, 1, ntest, total_peaks_d)
    npeak = total_peaks_d
    if (npeak > size(peak_cell_d)) then
       write(*,*) 'gpu_collect_peak: npeak (', npeak, ') exceeds preallocated size (', size(peak_cell_d), ')'
       stop
    endif
  end subroutine gpu_collect_peak

  ! =========================================================================
  ! CUDA Kernel: Map peak IDs to all cells and populate peak properties
  ! =========================================================================
  attributes(global) subroutine map_final_labels_kernel( &
       & flag1, peak_grid_d, peak_cell_d, peak_level_d, max_dens_d, &
       & parent_d, grid_d, cell_d, level_d, rho, is_peak_scan, ntest)
    integer, device :: flag1(1:twotondim, *)
    integer, device :: peak_grid_d(*), peak_cell_d(*), peak_level_d(*)
    real(kind=dp), device :: max_dens_d(*)
    integer, device :: parent_d(*), grid_d(*), cell_d(*), level_d(*)
    real(kind=dp), device :: rho(1:twotondim, *)
    integer, device :: is_peak_scan(*)
    integer, value :: ntest

    integer :: itest, gid, tid, root_idx, peak_id, igrid, ind

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntest) return

    itest = gid
    root_idx = parent_d(itest)
    if (root_idx == 0) return
    peak_id = is_peak_scan(root_idx)

    igrid = grid_d(itest)
    ind = cell_d(itest)
    flag1(ind, igrid) = peak_id

    if (itest == root_idx) then
       peak_grid_d(peak_id) = igrid
       peak_cell_d(peak_id) = ind
       peak_level_d(peak_id) = level_d(itest)
       max_dens_d(peak_id) = rho(ind, igrid)
    endif
  end subroutine map_final_labels_kernel

  ! =========================================================================
  ! CUDA Kernel: Map test cell index to flag1 temporarily
  ! =========================================================================
  attributes(global) subroutine map_indices_kernel(flag1, grid_d, cell_d, ntest)
    integer, device :: flag1(1:twotondim, *), grid_d(*), cell_d(*)
    integer, value :: ntest

    integer :: itest, gid, tid, igrid, ind

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntest) return

    itest = gid
    igrid = grid_d(itest)
    ind = cell_d(itest)
    flag1(ind, igrid) = itest
  end subroutine map_indices_kernel

  ! =========================================================================
  ! CUDA Kernel: Initialize parent array from neighbor pointers
  ! =========================================================================
  attributes(global) subroutine init_parent_kernel(parent_d, grid_d, cell_d, nbor_grid_d, nbor_cell_d, flag1, ntest)
    integer, device :: parent_d(*), grid_d(*), cell_d(*), nbor_grid_d(*), nbor_cell_d(*), flag1(1:twotondim, *)
    integer, value :: ntest

    integer :: itest, gid, tid, igridn, icelln

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntest) return

    itest = gid
    igridn = nbor_grid_d(itest)
    icelln = nbor_cell_d(itest)

    if (igridn > 0) then
       parent_d(itest) = flag1(icelln, igridn)
    else
       parent_d(itest) = itest
    endif
  end subroutine init_parent_kernel

  ! =========================================================================
  ! CUDA Kernel: Pointer-jumping step to flatten tree paths
  ! =========================================================================
  attributes(global) subroutine pointer_jump_kernel(parent_d, nmove, ntest)
    integer, device :: parent_d(*), nmove
    integer, value :: ntest

    integer :: itest, gid, tid, p, gp, info
    integer, shared :: block_nmove

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x

    if (tid == 1) then
       block_nmove = 0
    endif
    call syncthreads()

    if (gid <= ntest) then
       itest = gid
       p = parent_d(itest)
       if (p > 0) then ! p=0 means unlabeled (densest neighbor not a test cell)
          gp = parent_d(p)
          if (p /= gp) then
             parent_d(itest) = gp ! gp=0 propagates the zero label
             info = atomicadd(block_nmove, 1)
          endif
       endif
    endif

    call syncthreads()
    if (tid == 1) then
       if (block_nmove > 0) then
          info = atomicadd(nmove, block_nmove)
       endif
    endif
  end subroutine pointer_jump_kernel

  ! =========================================================================
  ! Host Driver: Watershed patch segmentation on GPU using Pointer-Jumping
  ! =========================================================================
  subroutine gpu_collect_patch(sim, ntest, npeak)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: ntest, npeak

    integer :: block_size, grid_size
    integer, device :: nmove_d
    integer :: nmove_h, istep

    if (ntest == 0) return

    block_size = 256
    grid_size = (ntest + block_size - 1) / block_size

    ! 1. Store test cell indices in flag1 temporarily for parent lookup
    flag1 = 0
    call map_indices_kernel<<<grid_size, block_size>>>(flag1, grid_d, cell_d, ntest)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Initialize parent array
    call init_parent_kernel<<<grid_size, block_size>>>(parent_d, grid_d, cell_d, nbor_grid_d, nbor_cell_d, flag1, ntest)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 3. Pointer-jumping loop to flatten tree paths
    nmove_h = 1
    istep = 0
    do while (nmove_h > 0)
       nmove_d = 0
       call pointer_jump_kernel<<<grid_size, block_size>>>(parent_d, nmove_d, ntest)
       call GPU_Error_Check(__FILE__, __LINE__)
       nmove_h = nmove_d
       istep = istep + 1
    end do

    ! 4. Clear flag1 and flag2, then write the final labels and peak properties in one kernel
    flag1 = 0
    flag2 = 0
    call map_final_labels_kernel<<<grid_size, block_size>>>( &
         & flag1, peak_grid_d, peak_cell_d, peak_level_d, max_dens_d, &
         & parent_d, grid_d, cell_d, level_d, rho, is_peak_scan_d, ntest)
    call GPU_Error_Check(__FILE__, __LINE__)
  end subroutine gpu_collect_patch

  ! =========================================================================
  ! CUDA Kernel: Initialize saddle density, neighbor id and edge key
  ! =========================================================================
  attributes(global) subroutine init_saddle_arrays_kernel(saddle_dens_d, saddle_nbor_d, saddle_edge_d, density_threshold, npeak)
    real(kind=dp), device :: saddle_dens_d(*)
    integer, device :: saddle_nbor_d(*)
    integer(kind=8), device :: saddle_edge_d(*)
    real(kind=dp), value :: density_threshold
    integer, value :: npeak

    integer :: ipeak, gid

    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    saddle_dens_d(ipeak) = density_threshold
    saddle_nbor_d(ipeak) = 0
    saddle_edge_d(ipeak) = huge(0_8)
  end subroutine init_saddle_arrays_kernel

  ! =========================================================================
  ! CUDA Kernel: Scan neighbors and identify saddle points
  ! =========================================================================
  attributes(global) subroutine collect_saddle_kernel( &
       & flag1, grid_d, cell_d, level_d, saddle_dens_d, saddle_nbor_d, saddle_edge_d, &
       & rho, grid, periodic, box_ckey_min, box_ckey_max, threshold, &
       & hash_key, hash_val, hash_size, ntest, ngridmax, npass)
    integer, device :: flag1(1:twotondim, *)
    integer, device :: grid_d(*), cell_d(*), level_d(*)
    real(kind=dp), device :: saddle_dens_d(*)
    integer, device :: saddle_nbor_d(*)
    integer(kind=8), device :: saddle_edge_d(*)
    real(kind=dp), device :: rho(1:twotondim, *)
    type(oct), device :: grid(*)
    logical, device :: periodic(3)
    integer, device :: box_ckey_min(3,*), box_ckey_max(3,*)
    real(kind=dp), value :: threshold
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer, value :: hash_size, ntest, ngridmax, npass

    integer :: itest, lane, cblk, offset
    integer :: ilevel, igrid, ind, igridn, icelln
    integer :: idim
    real(kind=8) :: xcen(3), xnei(3)
    integer :: ckey_nbor(3)
    integer(kind=8) :: hash_nbor(0:3)
    integer :: peak_cen, peak_nbor
    real(kind=dp) :: dens_cen, dens_ave, dens_cand, dens_old
    integer(kind=8) :: edge, edge_old
    logical :: ok

    ! Per-cell max reduction: 56 lanes padded to 64 slots, 4 cells per block
    real(kind=dp), shared :: s_dens(0:63, 0:3)

    ! One thread per neighbor: 56 lanes per test cell, 4 cells per block
    cblk = (threadIdx%x - 1) / 56
    lane = mod(threadIdx%x - 1, 56)
    itest = (blockIdx%x - 1) * 4 + cblk + 1

    dens_cand = -huge(0.0_dp)

    if (itest <= ntest) then
       ilevel = level_d(itest)
       igrid = grid_d(itest)
       ind = cell_d(itest)

       peak_cen = flag1(ind, igrid)
       dens_cen = rho(ind, igrid)

       if (peak_cen /= 0) then
          xcen(1) = 2*grid(igrid)%ckey(1) + MOD((ind-1), 2) + 0.5d0
          xcen(2) = 2*grid(igrid)%ckey(2) + MOD((ind-1)/2, 2) + 0.5d0
          xcen(3) = 2*grid(igrid)%ckey(3) + MOD((ind-1)/4, 2) + 0.5d0

          xnei(1) = xcen(1) + xnbor_const(1, lane+1)
          xnei(2) = xcen(2) + xnbor_const(2, lane+1)
          xnei(3) = xcen(3) + xnbor_const(3, lane+1)

          ! Periodic boundary conditions
          do idim = 1, 3
             if (periodic(idim)) then
                if (xnei(idim) < box_ckey_min(idim, ilevel+1)) then
                   xnei(idim) = xnei(idim) - box_ckey_min(idim, ilevel+1) + box_ckey_max(idim, ilevel+1)
                endif
                if (xnei(idim) >= box_ckey_max(idim, ilevel+1)) then
                   xnei(idim) = xnei(idim) + box_ckey_min(idim, ilevel+1) - box_ckey_max(idim, ilevel+1)
                endif
             endif
          end do

          ! Get neighboring cell at ilevel
          ckey_nbor(1) = int(xnei(1))
          ckey_nbor(2) = int(xnei(2))
          ckey_nbor(3) = int(xnei(3))
          hash_nbor(0) = ilevel + 1
          hash_nbor(1:3) = ckey_nbor(1:3)
          call get_parent_cell_device(hash_nbor, igridn, icelln, hash_key, hash_val, hash_size)

          ! If missing, get neighboring cell at ilevel-1
          if (igridn <= 0 .or. igridn > ngridmax) then
             ckey_nbor(1) = int(xnei(1)/2.0d0)
             ckey_nbor(2) = int(xnei(2)/2.0d0)
             ckey_nbor(3) = int(xnei(3)/2.0d0)
             hash_nbor(0) = ilevel
             hash_nbor(1:3) = ckey_nbor(1:3)
             call get_parent_cell_device(hash_nbor, igridn, icelln, hash_key, hash_val, hash_size)
          ! If refined, get neighboring cell at ilevel+1
          else if (grid(igridn)%refined(icelln)) then
             ckey_nbor(1) = int(xnei(1)*2.0d0)
             ckey_nbor(2) = int(xnei(2)*2.0d0)
             ckey_nbor(3) = int(xnei(3)*2.0d0)
             hash_nbor(0) = ilevel + 2
             hash_nbor(1:3) = ckey_nbor(1:3)
             call get_parent_cell_device(hash_nbor, igridn, icelln, hash_key, hash_val, hash_size)
          endif

          if (igridn > 0 .and. igridn <= ngridmax) then
             peak_nbor = flag1(icelln, igridn)
             ok = peak_nbor /= 0 .and. peak_nbor /= peak_cen

             if (ok) then
                dens_ave = 0.5d0 * (dens_cen + rho(icelln, igridn))
                if (npass == 1) then
                   ! Pass 1: contribute to the per-cell saddle density maximum
                   dens_cand = dens_ave
                else if (dens_ave > threshold .and. dens_ave == saddle_dens_d(peak_cen)) then
                   edge = int(itest-1, kind=8)*56_8 + int(lane, kind=8)
                   if (npass == 2) then
                      ! Pass 2: keep the smallest edge key among the pairs at the maximum
                      edge_old = atomicmin(saddle_edge_d(peak_cen), edge)
                   else if (edge == saddle_edge_d(peak_cen)) then
                      ! Pass 3: that edge claims the neighbor
                      saddle_nbor_d(peak_cen) = peak_nbor
                   endif
                endif
             endif
          endif
       endif
    endif

    if (npass == 1) then
       ! Tree max-reduction over the 64 slots, then one atomic per cell
       s_dens(lane, cblk) = dens_cand
       if (lane < 8) then ! pad slots 56-63
          s_dens(lane+56, cblk) = -huge(0.0_dp)
       endif
       call syncthreads()

       offset = 32
       do while (offset >= 1)
          if (lane < offset) then
             if (s_dens(lane+offset, cblk) > s_dens(lane, cblk)) then
                s_dens(lane, cblk) = s_dens(lane+offset, cblk)
             endif
          endif
          call syncthreads()
          offset = offset / 2
       end do

       if (lane == 0 .and. itest <= ntest) then
          if (peak_cen /= 0 .and. s_dens(0, cblk) > threshold) then
             dens_old = atomicmax(saddle_dens_d(peak_cen), s_dens(0, cblk))
          endif
       endif
    endif
  end subroutine collect_saddle_kernel

  ! =========================================================================
  ! Host Driver: Collect saddle points on GPU
  ! =========================================================================
  subroutine gpu_collect_saddle(sim, ntest, npeak)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: ntest, npeak

    integer :: block_size, grid_size, grid_size_peaks, ipass

    if (ntest == 0) return

    block_size = 256
    grid_size_peaks = (npeak + block_size - 1) / block_size

    ! Initialize saddle density to threshold, saddle neighbor to 0 and edge key to huge
    call init_saddle_arrays_kernel<<<grid_size_peaks, block_size>>>( &
         & saddle_dens_d, saddle_nbor_d, saddle_edge_d, real(sim%c%density_threshold, kind=dp), npeak)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 56 threads per test cell, so block size 224 (4 cells per block)
    grid_size = (ntest + 3) / 4

    ! Three passes: max-reduce saddle density, keep the smallest edge key at that
    ! density, then let that edge store the neighbor id
    do ipass = 1, 3
       call collect_saddle_kernel<<<grid_size, 224>>>( &
            & flag1, grid_d, cell_d, level_d, saddle_dens_d, saddle_nbor_d, saddle_edge_d, &
            & rho, grid, periodic, box_ckey_min, box_ckey_max, real(sim%c%density_threshold, kind=dp), &
            & hash_key, hash_val, sim%m%hash_size, ntest, sim%m%ngridmax, ipass)
       call GPU_Error_Check(__FILE__, __LINE__)
    end do
  end subroutine gpu_collect_saddle

  ! =========================================================================
  ! CUDA Kernel: Initialize merge arrays and alive status
  ! =========================================================================
  attributes(global) subroutine init_merge_kernel( &
       & new_peak_d, tidal_dens_d, lev_peak_d, alive_d, max_dens_d, relevance_d, &
       & relevance_threshold, saddle_threshold, npeak, action_code)
    integer, device :: new_peak_d(*), lev_peak_d(*), alive_d(*)
    real(kind=dp), device :: tidal_dens_d(*), max_dens_d(*), relevance_d(*)
    real(kind=dp), value :: relevance_threshold, saddle_threshold
    integer, value :: npeak, action_code

    integer :: ipeak, gid, tid

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    new_peak_d(ipeak) = ipeak
    tidal_dens_d(ipeak) = saddle_threshold

    if (action_code == 1) then ! 'relevance'
       alive_d(ipeak) = 1
       lev_peak_d(ipeak) = -1
    else if (action_code == 2) then ! 'saddleden'
       if (relevance_d(ipeak) > relevance_threshold) then
          alive_d(ipeak) = 1
       else
          alive_d(ipeak) = 0
       endif
       lev_peak_d(ipeak) = -1
    endif
  end subroutine init_merge_kernel

  ! =========================================================================
  ! CUDA Kernel: Propagate merges between neighbor peaks
  ! =========================================================================
  attributes(global) subroutine propagate_merge_kernel( &
       & new_peak_d, tidal_dens_d, alive_d, max_dens_d, saddle_dens_d, saddle_nbor_d, &
       & relevance_threshold, saddle_threshold, npeak, action_code, nmove)
    integer, device :: new_peak_d(*), alive_d(*), saddle_nbor_d(*)
    real(kind=dp), device :: tidal_dens_d(*), max_dens_d(*), saddle_dens_d(*)
    real(kind=dp), value :: relevance_threshold, saddle_threshold
    integer, value :: npeak, action_code
    integer, device :: nmove

    integer :: ipeak, gid, tid, jpeak, global_peak_id, info, merge_target
    integer :: merge_to, current_merge
    real(kind=dp) :: relevance_val
    logical :: do_merge

    integer, shared :: block_nmove

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x

    if (tid == 1) then
       block_nmove = 0
    endif
    call syncthreads()

    if (gid <= npeak) then
       ipeak = gid
       ! No path compression: dead peaks must keep their per-level parent
       current_merge = new_peak_d(ipeak)
       merge_to = current_merge

       if (alive_d(ipeak) > 0) then
          do_merge = .false.
          if (action_code == 1) then ! 'relevance'
             relevance_val = max_dens_d(ipeak) / saddle_dens_d(ipeak)
             do_merge = relevance_val < relevance_threshold
          else if (action_code == 2) then ! 'saddleden'
             do_merge = saddle_dens_d(ipeak) > saddle_threshold
          endif

          if (do_merge) then
             global_peak_id = saddle_nbor_d(ipeak)
             if (global_peak_id > 0) then
                jpeak = global_peak_id
                merge_target = new_peak_d(jpeak)
                if (max_dens_d(jpeak) > max_dens_d(ipeak)) then
                   merge_to = merge_target
                else if (max_dens_d(jpeak) == max_dens_d(ipeak)) then
                   merge_to = min(current_merge, merge_target)
                endif
             endif
          endif
       endif

       if (current_merge /= merge_to) then
          new_peak_d(ipeak) = merge_to
          tidal_dens_d(ipeak) = saddle_dens_d(ipeak)
          info = atomicadd(block_nmove, 1)
       endif
    endif

    call syncthreads()
    if (tid == 1) then
       if (block_nmove > 0) then
          info = atomicadd(nmove, block_nmove)
       endif
    endif
  end subroutine propagate_merge_kernel

  ! =========================================================================
  ! CUDA Kernel: Update cell-to-peak associations (flag1)
  ! =========================================================================
  attributes(global) subroutine update_flag1_kernel(flag1, grid_d, cell_d, new_peak_d, ntest)
    integer, device :: flag1(1:twotondim, *)
    integer, device :: grid_d(*), cell_d(*), new_peak_d(*)
    integer, value :: ntest

    integer :: itest, gid, tid, igrid, ind, global_peak_id, ipeak

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntest) return

    itest = gid
    igrid = grid_d(itest)
    ind = cell_d(itest)
    global_peak_id = flag1(ind, igrid)
    if (global_peak_id > 0) then
       ipeak = global_peak_id
       flag1(ind, igrid) = new_peak_d(ipeak)
    endif
  end subroutine update_flag1_kernel

  ! =========================================================================
  ! CUDA Kernel: Update alive status and merge depth of peaks
  ! =========================================================================
  attributes(global) subroutine update_alive_kernel( &
       & new_peak_d, alive_d, lev_peak_d, idepth, npeak, nzero)
    integer, device :: new_peak_d(*), alive_d(*), lev_peak_d(*)
    integer, value :: idepth, npeak
    integer, device :: nzero

    integer :: ipeak, gid, tid, info

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    if (alive_d(ipeak) > 0) then
       if (new_peak_d(ipeak) /= ipeak) then
          alive_d(ipeak) = 0
          lev_peak_d(ipeak) = idepth
          info = atomicadd(nzero, 1)
       endif
    endif
  end subroutine update_alive_kernel

  ! =========================================================================
  ! CUDA Kernel: Count surviving (alive) peaks after merging
  ! =========================================================================
  attributes(global) subroutine count_alive_kernel(alive_d, npeak, nalive)
    integer, device :: alive_d(*)
    integer, value :: npeak
    integer, device :: nalive

    integer :: ipeak, gid, tid, info

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    if (alive_d(ipeak) > 0) info = atomicadd(nalive, 1)
  end subroutine count_alive_kernel

  ! =========================================================================
  ! CUDA Kernels: Post-merge relevance processing
  ! =========================================================================
  attributes(global) subroutine propagate_merge_level_kernel(new_peak_d, lev_peak_d, ilev, npeak)
    integer, device :: new_peak_d(*), lev_peak_d(*)
    integer, value :: ilev, npeak
    integer :: ipeak, gid, jpeak
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    if (lev_peak_d(ipeak) == ilev) then
       jpeak = new_peak_d(ipeak)
       new_peak_d(ipeak) = new_peak_d(jpeak)
    endif
  end subroutine propagate_merge_level_kernel

  attributes(global) subroutine compute_relevance_kernel(relevance_d, max_dens_d, saddle_dens_d, alive_d, npeak)
    real(kind=dp), device :: relevance_d(*), max_dens_d(*), saddle_dens_d(*)
    integer, device :: alive_d(*)
    integer, value :: npeak
    integer :: ipeak, gid
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    if (alive_d(ipeak) > 0) then
       relevance_d(ipeak) = max_dens_d(ipeak) / saddle_dens_d(ipeak)
    else
       relevance_d(ipeak) = 0.0d0
    endif
  end subroutine compute_relevance_kernel

  ! =========================================================================
  ! CUDA Kernels: Halo index propagation and level initialization
  ! =========================================================================
  attributes(global) subroutine init_halo_index_kernel(ind_halo_d, new_peak_d, npeak)
    integer, device :: ind_halo_d(*), new_peak_d(*)
    integer, value :: npeak
    integer :: ipeak, gid
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    ind_halo_d(ipeak) = new_peak_d(ipeak)
  end subroutine init_halo_index_kernel

  attributes(global) subroutine propagate_halo_level_kernel(ind_halo_d, lev_peak_d, ilev, npeak)
    integer, device :: ind_halo_d(*), lev_peak_d(*)
    integer, value :: ilev, npeak
    integer :: ipeak, gid, jpeak
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    if (lev_peak_d(ipeak) == ilev) then
       jpeak = ind_halo_d(ipeak)
       ind_halo_d(ipeak) = ind_halo_d(jpeak)
    endif
  end subroutine propagate_halo_level_kernel

  attributes(global) subroutine set_halo_level_kernel(lev_peak_d, ind_halo_d, idepth, npeak)
    integer, device :: lev_peak_d(*), ind_halo_d(*)
    integer, value :: idepth, npeak
    integer :: ipeak, gid
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    if (ind_halo_d(ipeak) == ipeak) then
       lev_peak_d(ipeak) = idepth - 1
    endif
  end subroutine set_halo_level_kernel

  ! =========================================================================
  ! CUDA Kernels: Halo mass accumulation and back-assignment
  ! =========================================================================
  attributes(global) subroutine init_halo_mass_kernel(halo_mass_d, npeak)
    real(kind=dp), device :: halo_mass_d(*)
    integer, value :: npeak
    integer :: ipeak, gid
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    halo_mass_d(ipeak) = 0.0d0
  end subroutine init_halo_mass_kernel

  attributes(global) subroutine accumulate_halo_mass_kernel(halo_mass_d, ind_halo_d, clump_mass_d, npeak)
    real(kind=dp), device :: halo_mass_d(*), clump_mass_d(*)
    integer, device :: ind_halo_d(*)
    integer, value :: npeak
    integer :: ipeak, gid, merge_to
    real(kind=dp) :: info
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    merge_to = ind_halo_d(ipeak)
    info = atomicadd(halo_mass_d(merge_to), clump_mass_d(ipeak))
  end subroutine accumulate_halo_mass_kernel

  attributes(global) subroutine assign_halo_mass_kernel(halo_mass_d, ind_halo_d, npeak)
    real(kind=dp), device :: halo_mass_d(*)
    integer, device :: ind_halo_d(*)
    integer, value :: npeak
    integer :: ipeak, gid, merge_to
    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    merge_to = ind_halo_d(ipeak)
    halo_mass_d(ipeak) = halo_mass_d(merge_to)
  end subroutine assign_halo_mass_kernel

  ! =========================================================================
  ! CUDA Kernel: Hierarchical clump properties accumulation
  ! =========================================================================
  attributes(global) subroutine hierarchical_properties_kernel( &
       & new_peak_d, lev_peak_d, clump_mass_d, clump_vol_d, n_cells_d, min_dens_d, halo_mass_d, &
       & fraction_threshold, ilev, idepth, npeak)
    integer, device :: new_peak_d(*), lev_peak_d(*), n_cells_d(*)
    real(kind=dp), device :: clump_mass_d(*), clump_vol_d(*), min_dens_d(*), halo_mass_d(*)
    real(kind=dp), value :: fraction_threshold
    integer, value :: ilev, idepth, npeak
    integer :: ipeak, gid, merge_to
    real(kind=dp) :: info_dp
    integer :: info_int

    gid = threadIdx%x + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid

    if (lev_peak_d(ipeak) == ilev) then
       ! If clump is too massive, then it does not merge
       if (clump_mass_d(ipeak) > fraction_threshold * halo_mass_d(ipeak)) then
          new_peak_d(ipeak) = ipeak
          lev_peak_d(ipeak) = idepth - 1
       endif
       merge_to = new_peak_d(ipeak)
       if (merge_to /= ipeak) then
          info_dp = atomicadd(clump_mass_d(merge_to), clump_mass_d(ipeak))
          info_dp = atomicadd(clump_vol_d(merge_to), clump_vol_d(ipeak))
          info_int = atomicadd(n_cells_d(merge_to), n_cells_d(ipeak))
          info_dp = atomicmin(min_dens_d(merge_to), min_dens_d(ipeak))
       endif
    endif
  end subroutine hierarchical_properties_kernel

  ! =========================================================================
  ! Host Driver: Merge irrelevant clumps iteratively on GPU
  ! =========================================================================
  subroutine gpu_merge_clumps(sim, action, ntest, npeak)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    character(len=*), intent(in) :: action
    integer, intent(in) :: ntest, npeak

    integer :: action_code
    integer :: block_size, grid_size_peaks, grid_size_test
    integer, device :: nmove_d, nzero_d, nalive_d
    integer :: nmove_h, nzero_h, nsurvive_h, idepth, iter, ilev

    if (npeak == 0) return

    if (action == 'relevance') then
       action_code = 1
     else if (action == 'saddleden') then
       action_code = 2
     else
        return
     endif

    block_size = 256
    grid_size_peaks = (npeak + block_size - 1) / block_size
    grid_size_test = (ntest + block_size - 1) / block_size

    ! 1. Initialize merge arrays
    call init_merge_kernel<<<grid_size_peaks, block_size>>>( &
         & new_peak_d, tidal_dens_d, lev_peak_d, alive_d, max_dens_d, relevance_d, &
         & real(sim%c%relevance_threshold, kind=dp), real(sim%c%saddle_threshold, kind=dp), npeak, action_code)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Outer loop: Merge hierarchy depth
    nzero_h = npeak
    idepth = 0
    do while (nzero_h > 0)

       ! 2.1 Compute new saddle points
       call gpu_collect_saddle(sim, ntest, npeak)

       ! 2.2 Inner loop: propagate merges
       nmove_h = 1
       iter = 0
       do while (nmove_h > 0)
          nmove_d = 0
          call propagate_merge_kernel<<<grid_size_peaks, block_size>>>( &
               & new_peak_d, tidal_dens_d, alive_d, max_dens_d, saddle_dens_d, saddle_nbor_d, &
               & real(sim%c%relevance_threshold, kind=dp), real(sim%c%saddle_threshold, kind=dp), &
               & npeak, action_code, nmove_d)
          call GPU_Error_Check(__FILE__, __LINE__)
          nmove_h = nmove_d
          iter = iter + 1
       end do

       ! 2.3 Update cells to peak associations (flag1)
       if (ntest > 0) then
          call update_flag1_kernel<<<grid_size_test, block_size>>>(flag1, grid_d, cell_d, new_peak_d, ntest)
          call GPU_Error_Check(__FILE__, __LINE__)
       endif

       ! 2.4 Update alive status of merged peaks
       nzero_d = 0
       call update_alive_kernel<<<grid_size_peaks, block_size>>>( &
            & new_peak_d, alive_d, lev_peak_d, idepth, npeak, nzero_d)
       call GPU_Error_Check(__FILE__, __LINE__)
       nzero_h = nzero_d
       idepth = idepth + 1
    end do

    ! Count surviving peaks
    nalive_d = 0
    call count_alive_kernel<<<grid_size_peaks, block_size>>>(alive_d, npeak, nalive_d)
    call GPU_Error_Check(__FILE__, __LINE__)
    nsurvive_h = nalive_d
    if (sim%g%myid == 1) then
       if (action == 'relevance') write(*,'(" Found",I12,"  relevant peaks")')nsurvive_h
       if (action == 'saddleden') write(*,'(" Found",I12,"  halos")')nsurvive_h
    endif

    sim%c%merge_levelmax = idepth - 2

    ! Post-processing
    if (action == 'relevance') then
       do ilev = idepth - 2, 0, -1
          call propagate_merge_level_kernel<<<grid_size_peaks, block_size>>>(new_peak_d, lev_peak_d, ilev, npeak)
          call GPU_Error_Check(__FILE__, __LINE__)
       end do
       call compute_relevance_kernel<<<grid_size_peaks, block_size>>>(relevance_d, max_dens_d, &
            & saddle_dens_d, alive_d, npeak)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif

    if (action == 'saddleden') then
       call init_halo_index_kernel<<<grid_size_peaks, block_size>>>(ind_halo_d, new_peak_d, npeak)
       call GPU_Error_Check(__FILE__, __LINE__)
       do ilev = idepth - 2, 0, -1
          call propagate_halo_level_kernel<<<grid_size_peaks, block_size>>>(ind_halo_d, lev_peak_d, ilev, npeak)
          call GPU_Error_Check(__FILE__, __LINE__)
       end do
       call set_halo_level_kernel<<<grid_size_peaks, block_size>>>(lev_peak_d, ind_halo_d, idepth, npeak)
       call GPU_Error_Check(__FILE__, __LINE__)

       ! Compute halo mass
       call init_halo_mass_kernel<<<grid_size_peaks, block_size>>>(halo_mass_d, npeak)
       call GPU_Error_Check(__FILE__, __LINE__)
       call accumulate_halo_mass_kernel<<<grid_size_peaks, block_size>>>(halo_mass_d, ind_halo_d, clump_mass_d, npeak)
       call GPU_Error_Check(__FILE__, __LINE__)
       call assign_halo_mass_kernel<<<grid_size_peaks, block_size>>>(halo_mass_d, ind_halo_d, npeak)
       call GPU_Error_Check(__FILE__, __LINE__)

       ! Compute hierarchical clump properties
       do ilev = 0, idepth - 2
          call hierarchical_properties_kernel<<<grid_size_peaks, block_size>>>( &
               & new_peak_d, lev_peak_d, clump_mass_d, clump_vol_d, n_cells_d, min_dens_d, halo_mass_d, &
               & real(sim%c%fraction_threshold, kind=dp), ilev, idepth, npeak)
          call GPU_Error_Check(__FILE__, __LINE__)
       end do
    endif
  end subroutine gpu_merge_clumps

  ! =========================================================================
  ! CUDA Kernel: Initialize peak position, velocity, and acceleration
  ! =========================================================================
  attributes(global) subroutine init_peak_properties_kernel( &
       & peak_pos_d, peak_vel_d, peak_acc_d, peak_com_d, peak_grid_d, peak_cell_d, peak_level_d, &
       & min_dens_d, n_cells_d, clump_mass_d, clump_vol_d, npart_d, &
       & uold, f, grid, boxlen, skip, npeak, rtype)
    real(kind=dp), device :: peak_pos_d(1:ndim, *), peak_vel_d(1:ndim, *), peak_acc_d(1:ndim, *)
    real(kind=dp), device :: peak_com_d(1:ndim, *)
    integer, device :: peak_grid_d(*), peak_cell_d(*), peak_level_d(*)
    real(kind=dp), device :: min_dens_d(*), clump_mass_d(*), clump_vol_d(*)
    integer, device :: n_cells_d(*), npart_d(*)
    real(kind=dp), device :: uold(1:twotondim, 1:nvar, *)
    real(kind=dp), device :: f(1:twotondim, 1:3, *)
    type(oct), device :: grid(*)
    real(kind=8), value :: boxlen
    real(kind=8), device :: skip(3)
    integer, value :: npeak, rtype

    integer :: ipeak, gid, tid, ilevel, igrid, ind
    real(kind=8) :: dx_loc, xcell(3)

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return
    ipeak = gid
    min_dens_d(ipeak) = huge(0.0_dp)
    n_cells_d(ipeak) = 0
    clump_mass_d(ipeak) = 0.0d0
    clump_vol_d(ipeak) = 0.0d0
    npart_d(ipeak) = 0

    ilevel = peak_level_d(ipeak)
    igrid = peak_grid_d(ipeak)
    ind = peak_cell_d(ipeak)
    dx_loc = boxlen / (2**ilevel)

    xcell(1) = (2*grid(igrid)%ckey(1) + MOD((ind-1),   2) + 0.5d0) * dx_loc - skip(1)
    xcell(2) = (2*grid(igrid)%ckey(2) + MOD((ind-1)/2, 2) + 0.5d0) * dx_loc - skip(2)
    xcell(3) = (2*grid(igrid)%ckey(3) + MOD((ind-1)/4, 2) + 0.5d0) * dx_loc - skip(3)

    peak_pos_d(1:ndim, ipeak) = xcell(1:ndim)
    peak_com_d(1:ndim, ipeak) = 0.0d0
    peak_vel_d(1:ndim, ipeak) = 0.0d0
    peak_acc_d(1:ndim, ipeak) = 0.0d0

#ifdef HYDRO
    if (rtype == 4) then
       peak_vel_d(1:ndim, ipeak) = uold(ind, 2:ndim+1, igrid) / uold(ind, 1, igrid)
       peak_com_d(1:ndim, ipeak) = xcell(1:ndim)
    endif
#endif
#ifdef GRAV
    peak_acc_d(1:ndim, ipeak) = f(ind, 1:ndim, igrid)
#endif
  end subroutine init_peak_properties_kernel

  ! =========================================================================
  ! CUDA Kernel: Accumulate properties over all test cells
  ! =========================================================================
  attributes(global) subroutine accumulate_clump_properties_kernel( &
       & flag1, flag2, grid_d, cell_d, level_d, n_cells_d, min_dens_d, clump_mass_d, clump_vol_d, &
       & rho, nref, boxlen, ntest)
    integer, device :: flag1(1:twotondim, *), flag2(1:twotondim, *)
    integer, device :: grid_d(*), cell_d(*), level_d(*)
    integer, device :: n_cells_d(*)
    real(kind=dp), device :: min_dens_d(*), clump_mass_d(*), clump_vol_d(*)
    real(kind=dp), device :: rho(1:twotondim, *), nref(1:twotondim, *)
    real(kind=8), value :: boxlen
    integer, value :: ntest

    integer :: itest, gid, tid, ilevel, igrid, ind, peak_nr, info
    integer :: global_peak_id
    real(kind=dp) :: d, nr, dx_loc, vol

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntest) return

    itest = gid
    igrid = grid_d(itest)
    ind = cell_d(itest)
    ilevel = level_d(itest)
    global_peak_id = flag1(ind, igrid)

    flag2(ind, igrid) = global_peak_id

    if (global_peak_id /= 0) then
       peak_nr = global_peak_id
       d = rho(ind, igrid)
       nr = nref(ind, igrid)
       dx_loc = boxlen / (2**ilevel)
       vol = dx_loc**ndim

       info = atomicadd(n_cells_d(peak_nr), 1)
       info = atomicmin(min_dens_d(peak_nr), d)
       info = atomicadd(clump_mass_d(peak_nr), vol * nr)
       info = atomicadd(clump_vol_d(peak_nr), vol)
    endif
  end subroutine accumulate_clump_properties_kernel

  ! =========================================================================
  ! CUDA Kernel: Finalize clump properties (tidal radius)
  ! =========================================================================
  attributes(global) subroutine finalize_clump_properties_kernel( &
       & clump_rad_d, clump_mass_d, tidal_dens_d, npeak)
    real(kind=dp), device :: clump_rad_d(*), clump_mass_d(*), tidal_dens_d(*)
    integer, value :: npeak

    integer :: ipeak, gid, tid
    real(kind=8), parameter :: pi = 3.141592653589793d0

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    clump_rad_d(ipeak) = (clump_mass_d(ipeak) * 3.0d0 / (4.0d0 * pi * tidal_dens_d(ipeak)))**(1.0d0 / 3.0d0)
  end subroutine finalize_clump_properties_kernel

  ! =========================================================================
  ! Host Driver: Compute clump properties on GPU
  ! =========================================================================
  subroutine gpu_compute_clump_properties(sim, rtype, ntest, npeak)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: rtype, ntest, npeak

    integer :: block_size, grid_size_peaks, grid_size_test

    if (npeak == 0) return

    block_size = 256
    grid_size_peaks = (npeak + block_size - 1) / block_size
    grid_size_test = (ntest + block_size - 1) / block_size

    ! 1. Launch peak properties initialization
    call init_peak_properties_kernel<<<grid_size_peaks, block_size>>>( &
         & peak_pos_d, peak_vel_d, peak_acc_d, peak_com_d, peak_grid_d, peak_cell_d, peak_level_d, &
         & min_dens_d, n_cells_d, clump_mass_d, clump_vol_d, npart_d, &
         & uold, f, grid, sim%r%boxlen, d_skip, npeak, rtype)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Accumulate properties from cells
    call accumulate_clump_properties_kernel<<<grid_size_test, block_size>>>( &
         & flag1, flag2, grid_d, cell_d, level_d, n_cells_d, min_dens_d, clump_mass_d, clump_vol_d, &
         & rho, nref, sim%r%boxlen, ntest)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 3. Finalize clump properties
    call finalize_clump_properties_kernel<<<grid_size_peaks, block_size>>>( &
         & clump_rad_d, clump_mass_d, tidal_dens_d, npeak)
    call GPU_Error_Check(__FILE__, __LINE__)
  end subroutine gpu_compute_clump_properties

  ! =========================================================================
  ! CUDA Kernel: Initialize particle-based peak properties
  ! =========================================================================
  attributes(global) subroutine init_particle_properties_kernel( &
       & peak_com_d, peak_vel_d, particle_mass_d, npart_d, npeak)
    real(kind=dp), device :: peak_com_d(1:ndim, *), peak_vel_d(1:ndim, *), particle_mass_d(*)
    integer, device :: npart_d(*)
    integer, value :: npeak

    integer :: ipeak, gid, tid

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    peak_com_d(1:ndim, ipeak) = 0.0d0
    peak_vel_d(1:ndim, ipeak) = 0.0d0
    particle_mass_d(ipeak) = 0.0d0
    npart_d(ipeak) = 0
  end subroutine init_particle_properties_kernel

  ! =========================================================================
  ! CUDA Kernel: Accumulate particle mass, momentum and position into peaks
  ! =========================================================================
  attributes(global) subroutine particle_clump_properties_kernel( &
       & xp_d, vp_d, mp_d, flag2, peak_pos_d, peak_level_d, &
       & peak_com_d, peak_vel_d, particle_mass_d, npart_d, periodic, box_size, &
       & hash_key, hash_val, hash_size, boxlen, ilevel, head_part, num_parts, leading)
    integer(kind=8), value :: leading
    real(kind=dp), device :: xp_d(*), vp_d(*), mp_d(*)
    integer, device :: flag2(1:twotondim, *)
    real(kind=dp), device :: peak_pos_d(1:ndim, *)
    integer, device :: peak_level_d(*)
    real(kind=dp), device :: peak_com_d(1:ndim, *), peak_vel_d(1:ndim, *), particle_mass_d(*)
    integer, device :: npart_d(*)
    logical, device :: periodic(3)
    real(kind=8), device :: box_size(3)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer, value :: hash_size, ilevel, head_part, num_parts
    real(kind=dp), value :: boxlen

    integer :: ipart, gid, tid, idim, ipeak, info
    real(kind=dp) :: x(1:ndim), xpart(1:ndim), r2, dx_loc, core_radius, info_dp

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > num_parts) return

    ! Particle of level ilevel (headp..tailp list, as on the CPU)
    ipart = head_part + gid - 1

    do idim = 1, ndim
       x(idim) = xp_d(ipart + (idim-1)*leading)
    end do
    ipeak = particle_peak_id_device(x, ilevel, boxlen, flag2, &
         & hash_key, hash_val, hash_size)
    if (ipeak == 0) return

    ! Compute distance to peak cell center
    r2 = 0.0d0
    do idim = 1, ndim
       xpart(idim) = x(idim) - peak_pos_d(idim, ipeak)
       ! In case of periodic boundaries
       if (periodic(idim)) then
          if (xpart(idim) >  box_size(idim)*0.5d0) xpart(idim) = xpart(idim) - box_size(idim)
          if (xpart(idim) < -box_size(idim)*0.5d0) xpart(idim) = xpart(idim) + box_size(idim)
       endif
       r2 = r2 + xpart(idim)**2
    end do

    ! Keep only particles within 2 peak cells
    dx_loc = boxlen / (2**peak_level_d(ipeak))
    core_radius = 2.0d0 * dx_loc
    if (r2 <= core_radius**2) then
       do idim = 1, ndim
          info_dp = atomicadd(peak_com_d(idim, ipeak), mp_d(ipart) * xpart(idim))
          info_dp = atomicadd(peak_vel_d(idim, ipeak), mp_d(ipart) * vp_d(ipart + (idim-1)*leading))
       end do
       info_dp = atomicadd(particle_mass_d(ipeak), mp_d(ipart))
       info = atomicadd(npart_d(ipeak), 1)
    endif
  end subroutine particle_clump_properties_kernel

  ! =========================================================================
  ! CUDA Kernel: Finalize particle-based peak properties
  ! =========================================================================
  attributes(global) subroutine finalize_particle_properties_kernel( &
       & peak_com_d, peak_vel_d, peak_pos_d, particle_mass_d, periodic, box_size, npeak)
    real(kind=dp), device :: peak_com_d(1:ndim, *), peak_vel_d(1:ndim, *), peak_pos_d(1:ndim, *)
    real(kind=dp), device :: particle_mass_d(*)
    logical, device :: periodic(3)
    real(kind=8), device :: box_size(3)
    integer, value :: npeak

    integer :: ipeak, gid, tid, idim

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    ! Compute specific quantities
    if (particle_mass_d(ipeak) > 0.0d0) then
       peak_vel_d(1:ndim, ipeak) = peak_vel_d(1:ndim, ipeak) / particle_mass_d(ipeak)
       peak_com_d(1:ndim, ipeak) = peak_com_d(1:ndim, ipeak) / particle_mass_d(ipeak)
    endif
    peak_com_d(1:ndim, ipeak) = peak_com_d(1:ndim, ipeak) + peak_pos_d(1:ndim, ipeak)
    ! Periodic boundary conditions
    do idim = 1, ndim
       if (periodic(idim)) then
          if (peak_com_d(idim, ipeak) <  0.0d0)          peak_com_d(idim, ipeak) = peak_com_d(idim, ipeak) + box_size(idim)
          if (peak_com_d(idim, ipeak) >= box_size(idim)) peak_com_d(idim, ipeak) = peak_com_d(idim, ipeak) - box_size(idim)
       endif
    end do
  end subroutine finalize_particle_properties_kernel

  ! =========================================================================
  ! Host Driver: Compute particle-based clump properties on GPU
  ! =========================================================================
  subroutine gpu_particle_clump_properties(sim, ptype, npeak)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: ptype ! 1 = dark matter, 2 = stars
    integer, intent(in) :: npeak

    integer :: block_size, grid_size_peaks, grid_size_part, ilevel, num_parts

    if (npeak == 0) return

    block_size = 256
    grid_size_peaks = (npeak + block_size - 1) / block_size

    ! 1. Reset particle-based peak properties
    call init_particle_properties_kernel<<<grid_size_peaks, block_size>>>( &
         & peak_com_d, peak_vel_d, particle_mass_d, npart_d, npeak)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Accumulate particle contributions
    if (ptype == 1 .and. sim%p%npart > 0) then
       do ilevel = sim%r%levelmin, sim%r%nlevelmax
          num_parts = sim%p%tailp(ilevel) - sim%p%headp(ilevel) + 1
          if (num_parts <= 0) cycle
          grid_size_part = (num_parts + block_size - 1) / block_size
          call particle_clump_properties_kernel<<<grid_size_part, block_size>>>( &
               & xp, vp, mp, flag2, peak_pos_d, peak_level_d, &
               & peak_com_d, peak_vel_d, particle_mass_d, npart_d, periodic, box_size, &
               & hash_key, hash_val, sim%m%hash_size, real(sim%r%boxlen, kind=dp), &
               & ilevel, sim%p%headp(ilevel), num_parts, int(sim%r%npartmax, kind=8))
          call GPU_Error_Check(__FILE__, __LINE__)
       end do
    else if (ptype == 2 .and. sim%star%npart > 0) then
       do ilevel = sim%r%levelmin, sim%r%nlevelmax
          num_parts = sim%star%tailp(ilevel) - sim%star%headp(ilevel) + 1
          if (num_parts <= 0) cycle
          grid_size_part = (num_parts + block_size - 1) / block_size
          call particle_clump_properties_kernel<<<grid_size_part, block_size>>>( &
               & star_xp, star_vp, star_mp, flag2, peak_pos_d, peak_level_d, &
               & peak_com_d, peak_vel_d, particle_mass_d, npart_d, periodic, box_size, &
               & hash_key, hash_val, sim%m%hash_size, real(sim%r%boxlen, kind=dp), &
               & ilevel, sim%star%headp(ilevel), num_parts, int(sim%r%nstarmax, kind=8))
          call GPU_Error_Check(__FILE__, __LINE__)
       end do
    endif

    ! 3. Compute specific quantities and wrap center of mass
    call finalize_particle_properties_kernel<<<grid_size_peaks, block_size>>>( &
         & peak_com_d, peak_vel_d, peak_pos_d, particle_mass_d, periodic, box_size, npeak)
    call GPU_Error_Check(__FILE__, __LINE__)
  end subroutine gpu_particle_clump_properties

  ! =========================================================================
  ! Device Function: Linear radial bin of a particle around its peak (0 if outside)
  ! =========================================================================
  attributes(device) function mass_bin_index_device(x, xc, rad, periodic, &
       & box_size1, box_size2, box_size3) result(jbin)
    real(kind=dp), intent(in) :: x(1:ndim), xc(1:ndim)
    real(kind=dp), value :: rad, box_size1, box_size2, box_size3
    logical, device :: periodic(3)
    integer :: jbin

    integer :: idim, ibin
    real(kind=dp) :: xpart(1:ndim), box(1:3), dist, dr

    box(1) = box_size1; box(2) = box_size2; box(3) = box_size3
    dist = 0.0_dp
    do idim = 1, ndim
       xpart(idim) = x(idim) - xc(idim)
       ! In case of periodic boundaries
       if (periodic(idim)) then
          if (xpart(idim) >  box(idim)*0.5_dp) xpart(idim) = xpart(idim) - box(idim)
          if (xpart(idim) < -box(idim)*0.5_dp) xpart(idim) = xpart(idim) + box(idim)
       endif
       dist = dist + xpart(idim)**2
    end do
    dist = sqrt(dist)
    dr = 2.0_dp * rad / real(nbin, kind=dp)
    jbin = 0
    do ibin = 1, nbin
       ! We use a simple linear binning as the mass is usually propto r
       if (dist <= real(ibin, kind=dp) * dr) then
          jbin = ibin
          exit
       endif
    end do
  end function mass_bin_index_device

  ! =========================================================================
  ! CUDA Kernel: Reset mass profiles, potentials and particle counts
  ! =========================================================================
  attributes(global) subroutine reset_mass_bin_kernel(mass_bin_d, phi_clump_d, npart_d, reset_phi, npeak)
    real(kind=dp), device :: mass_bin_d(1:nbin, *), phi_clump_d(1:nbin, *)
    integer, device :: npart_d(*)
    logical, value :: reset_phi
    integer, value :: npeak

    integer :: ipeak, gid, tid

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    mass_bin_d(1:nbin, ipeak) = 0.0_dp
    if (reset_phi) phi_clump_d(1:nbin, ipeak) = 0.0_dp
    npart_d(ipeak) = 0
  end subroutine reset_mass_bin_kernel

  ! =========================================================================
  ! CUDA Kernel: Bin particles of peaks at merging level ilevel, then move
  ! them to the next peak in the hierarchy
  ! =========================================================================
  attributes(global) subroutine particle_potential_kernel( &
       & xp_d, mp_d, pid_d, lev_peak_d, new_peak_d, clump_rad_d, peak_pos_d, &
       & mass_bin_d, npart_d, periodic, box_size1, box_size2, box_size3, &
       & ilevel, num_parts, leading)
    integer(kind=8), value :: leading
    real(kind=dp), device :: xp_d(*), mp_d(*)
    integer, device :: pid_d(*), lev_peak_d(*), new_peak_d(*), npart_d(*)
    real(kind=dp), device :: clump_rad_d(*), peak_pos_d(1:ndim, *), mass_bin_d(1:nbin, *)
    logical, device :: periodic(3)
    real(kind=dp), value :: box_size1, box_size2, box_size3
    integer, value :: ilevel, num_parts

    integer :: ipart, gid, tid, idim, ipeak, ibin, info
    real(kind=dp) :: x(1:ndim), info_dp

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > num_parts) return

    ipart = gid
    ipeak = pid_d(ipart)
    if (ipeak == 0) return
    if (lev_peak_d(ipeak) /= ilevel) return

    do idim = 1, ndim
       x(idim) = xp_d(ipart + (idim-1)*leading)
    end do
    ibin = mass_bin_index_device(x, peak_pos_d(1:ndim, ipeak), clump_rad_d(ipeak), periodic, &
         & box_size1, box_size2, box_size3)
    if (ibin > 0) then
       info_dp = atomicadd(mass_bin_d(ibin, ipeak), mp_d(ipart))
       info = atomicadd(npart_d(ipeak), 1)
    endif

    ! Assign particle to next peak in hierarchy
    pid_d(ipart) = new_peak_d(ipeak)
  end subroutine particle_potential_kernel

  ! =========================================================================
  ! CUDA Kernel: Cumulative mass profile and self-potential of relevant peaks
  ! =========================================================================
  attributes(global) subroutine finalize_potential_kernel( &
       & mass_bin_d, phi_clump_d, clump_rad_d, clump_mass_d, relevance_d, &
       & mass_threshold, relevance_threshold, grav, npeak)
    real(kind=dp), device :: mass_bin_d(1:nbin, *), phi_clump_d(1:nbin, *)
    real(kind=dp), device :: clump_rad_d(*), clump_mass_d(*), relevance_d(*)
    real(kind=dp), value :: mass_threshold, relevance_threshold, grav
    integer, value :: npeak

    integer :: ipeak, gid, tid, ibin
    real(kind=dp) :: dr, dist

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    if (clump_mass_d(ipeak) <= mass_threshold) return
    if (relevance_d(ipeak) <= relevance_threshold) return

    ! Compute cumulative mass
    do ibin = 1, nbin-1
       mass_bin_d(ibin+1, ipeak) = mass_bin_d(ibin+1, ipeak) + mass_bin_d(ibin, ipeak)
    end do

    ! Convert mass profile into potential energy
    dr = 2.0_dp * clump_rad_d(ipeak) / real(nbin, kind=dp)
    dist = (real(nbin-1, kind=dp) + 0.5_dp) * dr
    phi_clump_d(nbin, ipeak) = grav * mass_bin_d(nbin, ipeak) / dist**2 * dr
    do ibin = nbin-1, 1, -1
       dist = (real(ibin-1, kind=dp) + 0.5_dp) * dr
       phi_clump_d(ibin, ipeak) = phi_clump_d(ibin+1, ipeak) + grav * mass_bin_d(ibin, ipeak) / dist**2 * dr
    end do
  end subroutine finalize_potential_kernel

  ! =========================================================================
  ! Host Driver: Hierarchical mass profiles and self-potential of clumps (DM)
  ! =========================================================================
  subroutine gpu_particle_potential(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    integer :: block_size, grid_size_peaks, grid_size_part, ilevel
    real(kind=8) :: pi, grav

    if (sim%c%npeak == 0) return

    ! Constants
    pi = acos(-1.0d0)
    grav = 1.0d0
    if (sim%r%cosmo) grav = 3.0d0/8.0d0/pi*sim%g%omega_m*sim%g%aexp

    block_size = 256
    grid_size_peaks = (sim%c%npeak + block_size - 1) / block_size

    ! 1. Reset mass profiles, potentials and particle counts
    call reset_mass_bin_kernel<<<grid_size_peaks, block_size>>>(mass_bin_d, phi_clump_d, npart_d, &
         & .true., sim%c%npeak)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Loop over merging hierarchy levels
    if (sim%p%npart > 0) then
       grid_size_part = (sim%p%npart + block_size - 1) / block_size
       do ilevel = 0, sim%c%merge_levelmax + 1
          call particle_potential_kernel<<<grid_size_part, block_size>>>( &
               & xp, mp, pid, lev_peak_d, new_peak_d, clump_rad_d, peak_pos_d, &
               & mass_bin_d, npart_d, periodic, real(sim%r%box_size(1), kind=dp), &
               & real(sim%r%box_size(2), kind=dp), real(sim%r%box_size(3), kind=dp), &
               & ilevel, sim%p%npart, int(sim%r%npartmax, kind=8))
          call GPU_Error_Check(__FILE__, __LINE__)
       end do
    endif

    ! 3. Cumulative mass profiles and self-potential
    call finalize_potential_kernel<<<grid_size_peaks, block_size>>>( &
         & mass_bin_d, phi_clump_d, clump_rad_d, clump_mass_d, relevance_d, &
         & real(sim%c%mass_threshold, kind=dp), real(sim%c%relevance_threshold, kind=dp), &
         & real(grav, kind=dp), sim%c%npeak)
    call GPU_Error_Check(__FILE__, __LINE__)
  end subroutine gpu_particle_potential

  ! =========================================================================
  ! Device Function: Total energy of a particle in the potential of its peak
  ! =========================================================================
  attributes(device) function total_energy_device(x, xc, v, vc, phi, rad, periodic, &
       & box_size1, box_size2, box_size3) result(etot)
    real(kind=dp), intent(in) :: x(1:ndim), xc(1:ndim), v(1:ndim), vc(1:ndim)
    real(kind=dp), intent(in) :: phi(1:nbin)
    real(kind=dp), value :: rad, box_size1, box_size2, box_size3
    logical, device :: periodic(3)
    real(kind=dp) :: etot

    integer :: idim, ibin, ileft, iright
    real(kind=dp) :: xpart(1:ndim), box(1:3), r2, r, dr, xbin, epot, ekin

    box(1) = box_size1; box(2) = box_size2; box(3) = box_size3
    r2 = 0.0_dp
    do idim = 1, ndim
       xpart(idim) = x(idim) - xc(idim)
       ! In case of periodic boundaries
       if (periodic(idim)) then
          if (xpart(idim) >  box(idim)*0.5_dp) xpart(idim) = xpart(idim) - box(idim)
          if (xpart(idim) < -box(idim)*0.5_dp) xpart(idim) = xpart(idim) + box(idim)
       endif
       r2 = r2 + xpart(idim)**2
    end do
    r = sqrt(r2)
    dr = 2.0_dp * rad / real(nbin, kind=dp)
    xbin = min(r / dr, real(nbin, kind=dp))
    ibin = int(xbin)
    ileft = ibin + 1
    iright = ileft + 1
    epot = 0.0_dp
    if (ileft < nbin) then
       epot = phi(ileft) * (real(ileft, kind=dp) - xbin) + phi(iright) * (xbin - real(ibin, kind=dp))
    else if (ileft == nbin) then
       epot = phi(ileft) * (real(ileft, kind=dp) - xbin)
    endif
    ekin = 0.0_dp
    do idim = 1, ndim
       ekin = ekin + 0.5_dp * (v(idim) - vc(idim))**2
    end do
    etot = ekin - epot
  end function total_energy_device

  ! =========================================================================
  ! CUDA Kernel: Unbind particles of peaks at merging level ilevel
  ! =========================================================================
  attributes(global) subroutine particle_unbind_kernel( &
       & xp_d, vp_d, pid_d, lev_peak_d, new_peak_d, clump_rad_d, clump_mass_d, &
       & peak_pos_d, peak_vel_d, phi_clump_d, mass_threshold, periodic, &
       & box_size1, box_size2, box_size3, ilevel, num_parts, leading)
    integer(kind=8), value :: leading
    real(kind=dp), device :: xp_d(*), vp_d(*)
    integer, device :: pid_d(*), lev_peak_d(*), new_peak_d(*)
    real(kind=dp), device :: clump_rad_d(*), clump_mass_d(*)
    real(kind=dp), device :: peak_pos_d(1:ndim, *), peak_vel_d(1:ndim, *), phi_clump_d(1:nbin, *)
    real(kind=dp), value :: mass_threshold, box_size1, box_size2, box_size3
    logical, device :: periodic(3)
    integer, value :: ilevel, num_parts

    integer :: ipart, gid, tid, idim, ipeak
    real(kind=dp) :: x(1:ndim), v(1:ndim), bound

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > num_parts) return

    ipart = gid
    ipeak = pid_d(ipart)
    if (ipeak == 0) return ! ignore orphans
    if (lev_peak_d(ipeak) /= ilevel) return

    do idim = 1, ndim
       x(idim) = xp_d(ipart + (idim-1)*leading)
       v(idim) = vp_d(ipart + (idim-1)*leading)
    end do
    bound = total_energy_device(x, peak_pos_d(1:ndim, ipeak), v, peak_vel_d(1:ndim, ipeak), &
         & phi_clump_d(1:nbin, ipeak), clump_rad_d(ipeak), periodic, box_size1, box_size2, box_size3)

    ! If unbound, assign to next peak in hierarchy
    if (bound >= 0.0_dp .or. clump_mass_d(ipeak) <= mass_threshold) then
       if (new_peak_d(ipeak) == ipeak) then
          ! If central, unbind particles to the void
          pid_d(ipart) = 0
       else
          ! If satellite, offer unbound particles to the next peak in the hierarchy
          pid_d(ipart) = new_peak_d(ipeak)
       endif
    endif
  end subroutine particle_unbind_kernel

  ! =========================================================================
  ! Host Driver: Unbind particles hierarchically from clumps (DM)
  ! =========================================================================
  subroutine gpu_particle_unbind(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    integer :: block_size, grid_size_part, ilevel

    if (sim%c%npeak == 0 .or. sim%p%npart == 0) return

    block_size = 256
    grid_size_part = (sim%p%npart + block_size - 1) / block_size

    ! Loop over merging hierarchy levels
    do ilevel = 0, sim%c%merge_levelmax+1
       call particle_unbind_kernel<<<grid_size_part, block_size>>>( &
            & xp, vp, pid, lev_peak_d, new_peak_d, clump_rad_d, clump_mass_d, &
            & peak_pos_d, peak_vel_d, phi_clump_d, real(sim%c%mass_threshold, kind=dp), periodic, &
            & real(sim%r%box_size(1), kind=dp), real(sim%r%box_size(2), kind=dp), &
            & real(sim%r%box_size(3), kind=dp), ilevel, sim%p%npart, int(sim%r%npartmax, kind=8))
       call GPU_Error_Check(__FILE__, __LINE__)
    end do
  end subroutine gpu_particle_unbind

  ! =========================================================================
  ! CUDA Kernel: Bin particles around their final peak
  ! =========================================================================
  attributes(global) subroutine mass_profile_kernel( &
       & xp_d, mp_d, pid_d, clump_rad_d, peak_pos_d, mass_bin_d, npart_d, periodic, &
       & box_size1, box_size2, box_size3, num_parts, leading)
    integer(kind=8), value :: leading
    real(kind=dp), device :: xp_d(*), mp_d(*)
    integer, device :: pid_d(*), npart_d(*)
    real(kind=dp), device :: clump_rad_d(*), peak_pos_d(1:ndim, *), mass_bin_d(1:nbin, *)
    logical, device :: periodic(3)
    real(kind=dp), value :: box_size1, box_size2, box_size3
    integer, value :: num_parts

    integer :: ipart, gid, tid, idim, ipeak, ibin, info
    real(kind=dp) :: x(1:ndim), info_dp

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > num_parts) return

    ipart = gid
    ipeak = pid_d(ipart)
    if (ipeak == 0) return

    do idim = 1, ndim
       x(idim) = xp_d(ipart + (idim-1)*leading)
    end do
    ibin = mass_bin_index_device(x, peak_pos_d(1:ndim, ipeak), clump_rad_d(ipeak), periodic, &
         & box_size1, box_size2, box_size3)
    if (ibin > 0) then
       info_dp = atomicadd(mass_bin_d(ibin, ipeak), mp_d(ipart))
       info = atomicadd(npart_d(ipeak), 1)
    endif
  end subroutine mass_profile_kernel

  ! =========================================================================
  ! CUDA Kernel: Cumulative mass profile of relevant peaks
  ! =========================================================================
  attributes(global) subroutine cumulate_mass_kernel( &
       & mass_bin_d, clump_mass_d, relevance_d, mass_threshold, relevance_threshold, npeak)
    real(kind=dp), device :: mass_bin_d(1:nbin, *), clump_mass_d(*), relevance_d(*)
    real(kind=dp), value :: mass_threshold, relevance_threshold
    integer, value :: npeak

    integer :: ipeak, gid, tid, ibin

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    if (clump_mass_d(ipeak) <= mass_threshold) return
    if (relevance_d(ipeak) <= relevance_threshold) return

    ! Compute cumulative mass
    do ibin = 1, nbin-1
       mass_bin_d(ibin+1, ipeak) = mass_bin_d(ibin+1, ipeak) + mass_bin_d(ibin, ipeak)
    end do
  end subroutine cumulate_mass_kernel

  ! =========================================================================
  ! Host Driver: Final clump mass profiles (DM)
  ! =========================================================================
  subroutine gpu_mass_profile(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    integer :: block_size, grid_size_peaks, grid_size_part

    if (sim%c%npeak == 0) return

    block_size = 256
    grid_size_peaks = (sim%c%npeak + block_size - 1) / block_size

    ! 1. Reset mass profiles and particle counts (keep the potential)
    call reset_mass_bin_kernel<<<grid_size_peaks, block_size>>>(mass_bin_d, phi_clump_d, npart_d, &
         & .false., sim%c%npeak)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Bin particles around their final peak
    if (sim%p%npart > 0) then
       grid_size_part = (sim%p%npart + block_size - 1) / block_size
       call mass_profile_kernel<<<grid_size_part, block_size>>>( &
            & xp, mp, pid, clump_rad_d, peak_pos_d, mass_bin_d, npart_d, periodic, &
            & real(sim%r%box_size(1), kind=dp), real(sim%r%box_size(2), kind=dp), &
            & real(sim%r%box_size(3), kind=dp), sim%p%npart, int(sim%r%npartmax, kind=8))
       call GPU_Error_Check(__FILE__, __LINE__)
    endif

    ! 3. Cumulative mass profiles
    call cumulate_mass_kernel<<<grid_size_peaks, block_size>>>( &
         & mass_bin_d, clump_mass_d, relevance_d, real(sim%c%mass_threshold, kind=dp), &
         & real(sim%c%relevance_threshold, kind=dp), sim%c%npeak)
    call GPU_Error_Check(__FILE__, __LINE__)
  end subroutine gpu_mass_profile

  ! =========================================================================
  ! Device Function: Is this peak kept as a final clump?
  ! =========================================================================
  attributes(device) function keep_clump_device(clump_mass, relevance, npart, &
       & mass_threshold, relevance_threshold, part_clump) result(keep)
    real(kind=dp), value :: clump_mass, relevance, mass_threshold, relevance_threshold
    integer, value :: npart
    logical, value :: part_clump
    logical :: keep

    ! The particle count criterion only applies to particle-based clumps
    keep = clump_mass > mass_threshold .and. relevance > relevance_threshold .and. &
         & (npart > 0 .or. .not. part_clump)
  end function keep_clump_device

  ! =========================================================================
  ! CUDA Kernel: Flag kept peaks (1) for the final index scan
  ! =========================================================================
  attributes(global) subroutine keep_clump_kernel(ind_final_d, clump_mass_d, relevance_d, npart_d, &
       & mass_threshold, relevance_threshold, part_clump, npeak)
    integer, device :: ind_final_d(*), npart_d(*)
    real(kind=dp), device :: clump_mass_d(*), relevance_d(*)
    real(kind=dp), value :: mass_threshold, relevance_threshold
    logical, value :: part_clump
    integer, value :: npeak

    integer :: ipeak, gid, tid

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    if (keep_clump_device(clump_mass_d(ipeak), relevance_d(ipeak), npart_d(ipeak), &
         & mass_threshold, relevance_threshold, part_clump)) then
       ind_final_d(ipeak) = 1
    else
       ind_final_d(ipeak) = 0
    endif
  end subroutine keep_clump_kernel

  ! =========================================================================
  ! CUDA Kernel: Zero the final index of dropped peaks (after the scan)
  ! =========================================================================
  attributes(global) subroutine drop_clump_kernel(ind_final_d, clump_mass_d, relevance_d, npart_d, &
       & mass_threshold, relevance_threshold, part_clump, npeak)
    integer, device :: ind_final_d(*), npart_d(*)
    real(kind=dp), device :: clump_mass_d(*), relevance_d(*)
    real(kind=dp), value :: mass_threshold, relevance_threshold
    logical, value :: part_clump
    integer, value :: npeak

    integer :: ipeak, gid, tid

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    if (.not. keep_clump_device(clump_mass_d(ipeak), relevance_d(ipeak), npart_d(ipeak), &
         & mass_threshold, relevance_threshold, part_clump)) ind_final_d(ipeak) = 0
  end subroutine drop_clump_kernel

  ! =========================================================================
  ! CUDA Kernel: Change parent and halo indices of kept peaks to final indices
  ! =========================================================================
  attributes(global) subroutine remap_peak_index_kernel(new_peak_d, ind_halo_d, ind_final_d, &
       & do_halo, npeak)
    integer, device :: new_peak_d(*), ind_halo_d(*), ind_final_d(*)
    logical, value :: do_halo
    integer, value :: npeak

    integer :: ipeak, gid, tid

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid
    if (ind_final_d(ipeak) == 0) return
    new_peak_d(ipeak) = ind_final_d(new_peak_d(ipeak))
    if (do_halo) ind_halo_d(ipeak) = ind_final_d(ind_halo_d(ipeak))
  end subroutine remap_peak_index_kernel

  ! =========================================================================
  ! CUDA Kernel: Change particle peak ids to final indices (0 if dropped)
  ! =========================================================================
  attributes(global) subroutine trim_particles_kernel(id_d, ind_final_d, num_parts)
    integer, device :: id_d(*), ind_final_d(*)
    integer, value :: num_parts

    integer :: ipart, gid, tid

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > num_parts) return

    ipart = gid
    if (id_d(ipart) /= 0) id_d(ipart) = ind_final_d(id_d(ipart))
  end subroutine trim_particles_kernel

  ! =========================================================================
  ! CUDA Kernel: Change peak (flag2) or halo (flag1) ids of test cells to final indices
  ! =========================================================================
  attributes(global) subroutine trim_flag_kernel(flag, grid_d, cell_d, ind_final_d, ntest)
    integer, device :: flag(1:twotondim, *)
    integer, device :: grid_d(*), cell_d(*), ind_final_d(*)
    integer, value :: ntest

    integer :: itest, gid, tid, igrid, ind

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntest) return

    itest = gid
    igrid = grid_d(itest)
    ind = cell_d(itest)
    if (flag(ind, igrid) /= 0) flag(ind, igrid) = ind_final_d(flag(ind, igrid))
  end subroutine trim_flag_kernel

  ! =========================================================================
  ! Host Driver: Remove irrelevant clumps and renumber the final ones on GPU
  ! =========================================================================
  subroutine gpu_trim_clumps(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    integer :: block_size, grid_size_peaks, grid_size_test, grid_size_part
    logical :: part_clump, do_halo
    real(kind=dp) :: mass_threshold, relevance_threshold

    if (sim%c%npeak == 0) return

    ! The particle count criterion only applies to particle-based clumps
    part_clump = (sim%r%rho_type_clump == 1 .or. sim%r%rho_type_clump == 2)
    do_halo = (sim%c%saddle_threshold > 0)
    mass_threshold = real(sim%c%mass_threshold, kind=dp)
    relevance_threshold = real(sim%c%relevance_threshold, kind=dp)

    block_size = 256
    grid_size_peaks = (sim%c%npeak + block_size - 1) / block_size
    grid_size_test = (sim%c%ntest + block_size - 1) / block_size

    ! 1. Final clump indices: inclusive scan of kept peaks, 0 for dropped ones
    call keep_clump_kernel<<<grid_size_peaks, block_size>>>(ind_final_d, clump_mass_d, relevance_d, &
         & npart_d, mass_threshold, relevance_threshold, part_clump, sim%c%npeak)
    call GPU_Error_Check(__FILE__, __LINE__)
    call gpu_scan(ind_final_d, 1, sim%c%npeak)
    call drop_clump_kernel<<<grid_size_peaks, block_size>>>(ind_final_d, clump_mass_d, relevance_d, &
         & npart_d, mass_threshold, relevance_threshold, part_clump, sim%c%npeak)
    call GPU_Error_Check(__FILE__, __LINE__)

    ! 2. Change other important peak indices
    if (do_halo) then
       call remap_peak_index_kernel<<<grid_size_peaks, block_size>>>(new_peak_d, ind_halo_d, ind_final_d, &
            & .true., sim%c%npeak)
       call GPU_Error_Check(__FILE__, __LINE__)
    else
       call remap_peak_index_kernel<<<grid_size_peaks, block_size>>>(new_peak_d, new_peak_d, ind_final_d, &
            & .false., sim%c%npeak)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif

    ! 3. Modify particle peak ids accordingly
    if (sim%r%part .and. sim%p%npart > 0) then
       grid_size_part = (sim%p%npart + block_size - 1) / block_size
       call trim_particles_kernel<<<grid_size_part, block_size>>>(pid, ind_final_d, sim%p%npart)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif
    if (sim%r%star .and. sim%star%npart > 0) then
       grid_size_part = (sim%star%npart + block_size - 1) / block_size
       call trim_particles_kernel<<<grid_size_part, block_size>>>(star_pid, ind_final_d, sim%star%npart)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif
    if (sim%r%sink .and. sim%sink%npart > 0) then
       grid_size_part = (sim%sink%npart + block_size - 1) / block_size
       call trim_particles_kernel<<<grid_size_part, block_size>>>(sink_pid, ind_final_d, sim%sink%npart)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif
    if (sim%r%tree .and. sim%tree%npart > 0) then
       grid_size_part = (sim%tree%npart + block_size - 1) / block_size
       call trim_particles_kernel<<<grid_size_part, block_size>>>(tree_pid, ind_final_d, sim%tree%npart)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif

    ! 4. Modify flag2 (and flag1 if halos) accordingly
    if (sim%c%ntest > 0) then
       call trim_flag_kernel<<<grid_size_test, block_size>>>(flag2, grid_d, cell_d, ind_final_d, sim%c%ntest)
       call GPU_Error_Check(__FILE__, __LINE__)
       if (do_halo) then
          call trim_flag_kernel<<<grid_size_test, block_size>>>(flag1, grid_d, cell_d, ind_final_d, sim%c%ntest)
          call GPU_Error_Check(__FILE__, __LINE__)
       endif
    endif
  end subroutine gpu_trim_clumps

  ! =========================================================================
  ! Host Driver: Complete clump finder workflow on the GPU
  ! =========================================================================
  subroutine gpu_clump_finder(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    ! 0. The GPU clump finder works on a single MPI rank only
    if (sim%g%ncpu > 1) then
       write(*,*) 'gpu_clump_finder: the GPU clump finder requires a single MPI rank'
       stop
    endif

    ! 1. Store clump finder parameters in clump object
    sim%c%relevance_threshold = sim%r%relevance_threshold
    sim%c%density_threshold   = sim%r%density_threshold
    sim%c%saddle_threshold    = sim%r%saddle_threshold
    sim%c%mass_threshold      = sim%r%mass_threshold
    sim%c%purity_threshold    = sim%r%purity_threshold
    sim%c%fraction_threshold  = sim%r%fraction_threshold

    ! 2. Smooth density field
    call gpu_smooth_rho(sim)

    ! 3. Collect test cells above threshold
    call gpu_collect_test(sim, sim%c%ntest)
    sim%c%ntest_tot = sim%c%ntest
    if (sim%g%myid == 1) then
       write(*,'(" Found",I12,"  cells above threshold")')int(sim%c%ntest_tot,kind=4)
    endif
    if (sim%c%ntest_tot == 0) return

    ! 4. Detect local density peaks
    call gpu_collect_peak(sim, sim%c%ntest, sim%c%npeak)
    sim%c%npeak_tot = sim%c%npeak
    if (sim%g%myid == 1) then
       write(*,'(" Found",I12,"  density peaks")')int(sim%c%npeak_tot,kind=4)
    endif
    if (sim%c%npeak_tot == 0) return

    ! 5. Watershed segmentation
    call gpu_collect_patch(sim, sim%c%ntest, sim%c%npeak)

    ! 6. Merge irrelevant peak-patches
    call gpu_merge_clumps(sim, 'relevance', sim%c%ntest, sim%c%npeak)

    ! 7. Peak-patch properties (peak ids saved into flag2)
    call gpu_compute_clump_properties(sim, sim%r%rho_type_clump, sim%c%ntest, sim%c%npeak)

    ! 8. Particle peak ids and particle-based peak-patch properties
    if (sim%r%part) then
       call gpu_particle_peak_id(sim, 1)
       if (sim%r%rho_type_clump == 1) call gpu_particle_clump_properties(sim, 1, sim%c%npeak)
    endif
    if (sim%r%star) then
       call gpu_particle_peak_id(sim, 2)
       if (sim%r%rho_type_clump == 2) call gpu_particle_clump_properties(sim, 2, sim%c%npeak)
    endif
    if (sim%r%sink) then
       call gpu_particle_peak_id(sim, 3)
    endif
    if (sim%r%tree) then
       call gpu_particle_peak_id(sim, 4)
    endif

    ! 9. Merge peak-patches into halo-patches (halo ids in flag1)
    if (sim%c%saddle_threshold > 0) then
       call gpu_merge_clumps(sim, 'saddleden', sim%c%ntest, sim%c%npeak)
    endif

    ! 10. Self-potential, unbinding and final mass profiles (dark matter)
    if (sim%c%saddle_threshold > 0 .and. sim%r%part .and. sim%r%rho_type_clump == 1) then
       call gpu_particle_potential(sim)
       call gpu_particle_peak_id(sim, 1)
       call gpu_particle_unbind(sim)
       call gpu_mass_profile(sim)
    endif

    ! 11. Remove irrelevant clumps and renumber the final ones
    call gpu_trim_clumps(sim)

    ! 12. Particle halo ids
    if (sim%c%saddle_threshold > 0) then
       if (sim%r%part) call gpu_particle_halo_id(sim, 1)
       if (sim%r%star) call gpu_particle_halo_id(sim, 2)
       if (sim%r%sink) call gpu_particle_halo_id(sim, 3)
       if (sim%r%tree) call gpu_particle_halo_id(sim, 4)
    endif
  end subroutine gpu_clump_finder

  ! =========================================================================
  ! Host Driver: Complete clump finding workflow on the GPU
  ! =========================================================================
  subroutine gpu_sink_clump(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    ! 0. The GPU clump finder works on a single MPI rank only
    if (sim%g%ncpu > 1) then
       write(*,*) 'gpu_sink_clump: GPU sink formation requires a single MPI rank'
       stop
    endif

    ! 1. Load clump finder parameters
    sim%c%relevance_threshold = sim%r%sink_relevance_threshold
    sim%c%density_threshold   = sim%r%sink_density_threshold
    sim%c%saddle_threshold    = sim%r%sink_saddle_threshold
    sim%c%mass_threshold      = sim%r%sink_mass_threshold
    sim%c%purity_threshold    = sim%r%sink_purity_threshold
    sim%c%fraction_threshold  = sim%r%sink_fraction_threshold

    ! 2. Smooth density field
    call gpu_smooth_rho(sim)

    ! 3. Collect test cells above threshold
    call gpu_collect_test(sim, sim%c%ntest)
    sim%c%ntest_tot = sim%c%ntest
    if (sim%g%myid == 1) then
       write(*,'(" Found",I12,"  cells above threshold")')int(sim%c%ntest_tot,kind=4)
    endif

    if (sim%c%ntest_tot == 0) return

    ! 4. Detect local density peaks
    call gpu_collect_peak(sim, sim%c%ntest, sim%c%npeak)
    sim%c%npeak_tot = sim%c%npeak
    if (sim%g%myid == 1) then
       write(*,'(" Found",I12,"  density peaks")')int(sim%c%npeak_tot,kind=4)
    endif

    if (sim%c%npeak_tot == 0) return

    ! 5. Perform watershed segmentation (collect patches)
    call gpu_collect_patch(sim, sim%c%ntest, sim%c%npeak)

    ! 6. Merge irrelevant clumps
    call gpu_merge_clumps(sim, 'relevance', sim%c%ntest, sim%c%npeak)

    ! 7. Compute clump properties
    call gpu_compute_clump_properties(sim, sim%r%rho_type_sink, sim%c%ntest, sim%c%npeak)

    ! 8. Compute particle-based clump properties
    if (sim%r%part .and. sim%r%rho_type_sink == 1) then
       call gpu_particle_clump_properties(sim, 1, sim%c%npeak)
    endif
    if (sim%r%star .and. sim%r%rho_type_sink == 2) then
       call gpu_particle_clump_properties(sim, 2, sim%c%npeak)
    endif

    ! 9. Merge clumps into halos if saddle density threshold is positive
    if (sim%c%saddle_threshold > 0.0d0) then
       call gpu_merge_clumps(sim, 'saddleden', sim%c%ntest, sim%c%npeak)
    endif

    ! 10. Map sinks to peaks
    call gpu_sink_peak_id(sim)

    ! 11. Reset sink position to peak position and count sinks inside each peak
    call gpu_sink_in_peak(sim, sim%r%sink_recenter_on_peak, .true.)
  end subroutine gpu_sink_clump

  ! =========================================================================
  ! Host Driver: Clump finding for merger tree particles on the GPU
  ! =========================================================================
  subroutine gpu_tree_clump(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

#if NDIM==3 && defined(GRAV)
    ! 0. The GPU clump finder works on a single MPI rank only
    if (sim%g%ncpu > 1) then
       write(*,*) 'gpu_tree_clump: GPU merger tree formation requires a single MPI rank'
       stop
    endif

    ! 1. Load clump finder parameters
    sim%c%relevance_threshold = sim%r%relevance_threshold
    sim%c%density_threshold   = sim%r%density_threshold
    sim%c%saddle_threshold    = sim%r%saddle_threshold
    sim%c%mass_threshold      = sim%r%mass_threshold
    sim%c%purity_threshold    = sim%r%purity_threshold
    sim%c%fraction_threshold  = 2d0

    ! 2. Smooth density field
    call gpu_smooth_rho(sim)

    ! 3. Collect test cells above threshold
    call gpu_collect_test(sim, sim%c%ntest)
    sim%c%ntest_tot = sim%c%ntest
    if (sim%g%myid == 1) then
       write(*,'(" Found",I12,"  cells above threshold")')int(sim%c%ntest_tot,kind=4)
    endif
    if (sim%c%ntest_tot == 0) return

    ! 4. Detect local density peaks
    call gpu_collect_peak(sim, sim%c%ntest, sim%c%npeak)
    sim%c%npeak_tot = sim%c%npeak
    if (sim%g%myid == 1) then
       write(*,'(" Found",I12,"  density peaks")')int(sim%c%npeak_tot,kind=4)
    endif
    if (sim%c%npeak_tot == 0) return

    ! 5. Watershed segmentation
    call gpu_collect_patch(sim, sim%c%ntest, sim%c%npeak)

    ! 6. Merge irrelevant peak-patches
    call gpu_merge_clumps(sim, 'relevance', sim%c%ntest, sim%c%npeak)

    ! 7. Peak-patch properties
    call gpu_compute_clump_properties(sim, sim%r%rho_type_clump, sim%c%ntest, sim%c%npeak)

    ! 8. Dark matter particle-based peak-patch properties
    if (sim%r%part .and. sim%r%rho_type_clump == 1) then
       call gpu_particle_clump_properties(sim, 1, sim%c%npeak)
    endif

    ! 9. Merge peak-patches into halo-patches
    if (sim%c%saddle_threshold > 0) then
       call gpu_merge_clumps(sim, 'saddleden', sim%c%ntest, sim%c%npeak)
    endif

    ! 10. Map trees to peaks, reset tree positions to peak positions and count trees
    call gpu_particle_peak_id(sim, 4)
    call gpu_tree_in_peak(sim, .true., .true.)
#endif
  end subroutine gpu_tree_clump

  ! =========================================================================
  ! Device Function: Peak patch id (flag2) of the cell containing a particle
  ! =========================================================================
  attributes(device) function particle_peak_id_device(x, ilevel, boxlen, flag2, &
       & hash_key, hash_val, hash_size) result(ipeak)
    real(kind=dp), intent(in) :: x(1:ndim)
    integer, value :: ilevel, hash_size
    real(kind=dp), value :: boxlen
    integer, device :: flag2(1:twotondim, *)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer :: ipeak

    integer :: idim, igrid, icell
    integer(kind=8) :: hash_cell(0:3)
    real(kind=dp) :: dx_loc

    ! Find parent cell at particle's level using coordinate spacing
    dx_loc = boxlen / (2**ilevel)
    hash_cell = 0
    hash_cell(0) = ilevel + 1
    do idim = 1, ndim
       hash_cell(idim) = int(x(idim) / dx_loc)
    end do

    ! Look up parent cell coordinates in the spatial hash table
    call get_parent_cell_device(hash_cell, igrid, icell, hash_key, hash_val, hash_size)

    ipeak = 0
    if (igrid > 0) then
       ipeak = flag2(icell, igrid)
    endif
  end function particle_peak_id_device

  ! =========================================================================
  ! CUDA Kernel: Peak (flag2) or halo (flag1) id of the cell containing a particle
  ! =========================================================================
  attributes(global) subroutine particle_id_kernel(xp_d, id_d, flag, &
       & hash_key, hash_val, hash_size, boxlen, ilevel, head_part, num_parts, leading)
    integer(kind=8), value :: leading
    real(kind=dp), device :: xp_d(*)
    integer, device :: id_d(*)
    integer, device :: flag(1:twotondim, *)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer, value :: hash_size, ilevel, head_part, num_parts
    real(kind=dp), value :: boxlen

    integer :: ipart, gid, tid, idim
    real(kind=dp) :: x(1:ndim)

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > num_parts) return

    ! Particle of level ilevel (headp..tailp list, as on the CPU)
    ipart = head_part + gid - 1

    do idim = 1, ndim
       x(idim) = xp_d(ipart + (idim-1)*leading)
    end do
    id_d(ipart) = particle_peak_id_device(x, ilevel, boxlen, flag, &
         & hash_key, hash_val, hash_size)
  end subroutine particle_id_kernel

  ! =========================================================================
  ! Host Driver: Peak or halo id of particles, level by level (as on the CPU)
  ! =========================================================================
  subroutine launch_particle_id(sim, p, xp_d, id_d, flag, leading)
    use ramses_commons, only: ramses_t
    use pm_commons, only: part_t
    implicit none
    type(ramses_t) :: sim
    type(part_t) :: p
    real(kind=dp), device :: xp_d(*)
    integer, device :: id_d(*)
    integer, device :: flag(1:twotondim, *)
    integer(kind=8), intent(in) :: leading

    integer :: block_size, grid_size, ilevel, num_parts

    if (p%npart == 0) return

    ! Particles below levelmin are not assigned to peaks
    id_d(1:p%npart) = 0

    block_size = 256
    do ilevel = sim%r%levelmin, sim%r%nlevelmax
       num_parts = p%tailp(ilevel) - p%headp(ilevel) + 1
       if (num_parts <= 0) cycle
       grid_size = (num_parts + block_size - 1) / block_size
       call particle_id_kernel<<<grid_size, block_size>>>(xp_d, id_d, flag, &
            & hash_key, hash_val, sim%m%hash_size, real(sim%r%boxlen, kind=dp), &
            & ilevel, p%headp(ilevel), num_parts, leading)
       call GPU_Error_Check(__FILE__, __LINE__)
    end do
  end subroutine launch_particle_id

  ! =========================================================================
  ! Host Driver: Particle peak ids (flag2) on GPU
  ! =========================================================================
  subroutine gpu_particle_peak_id(sim, ptype)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: ptype ! 1 = dark matter, 2 = stars, 3 = sinks, 4 = trees

    if (ptype == 1) call launch_particle_id(sim, sim%p,    xp,      pid,      flag2, int(sim%r%npartmax, kind=8))
    if (ptype == 2) call launch_particle_id(sim, sim%star, star_xp, star_pid, flag2, int(sim%r%nstarmax, kind=8))
    if (ptype == 3) call launch_particle_id(sim, sim%sink, sink_xp, sink_pid, flag2, int(sim%r%nsinkmax, kind=8))
    if (ptype == 4) call launch_particle_id(sim, sim%tree, tree_xp, tree_pid, flag2, int(sim%r%ntreemax, kind=8))
  end subroutine gpu_particle_peak_id

  ! =========================================================================
  ! Host Driver: Particle halo ids (flag1) on GPU
  ! =========================================================================
  subroutine gpu_particle_halo_id(sim, ptype)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    integer, intent(in) :: ptype ! 1 = dark matter, 2 = stars, 3 = sinks, 4 = trees

    if (ptype == 1) call launch_particle_id(sim, sim%p,    xp,      hid,      flag1, int(sim%r%npartmax, kind=8))
    if (ptype == 2) call launch_particle_id(sim, sim%star, star_xp, star_hid, flag1, int(sim%r%nstarmax, kind=8))
    if (ptype == 3) call launch_particle_id(sim, sim%sink, sink_xp, sink_hid, flag1, int(sim%r%nsinkmax, kind=8))
    if (ptype == 4) call launch_particle_id(sim, sim%tree, tree_xp, tree_hid, flag1, int(sim%r%ntreemax, kind=8))
  end subroutine gpu_particle_halo_id

  ! =========================================================================
  ! Host Driver: Map sink particles to peak IDs on GPU
  ! =========================================================================
  subroutine gpu_sink_peak_id(sim)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim

    call launch_particle_id(sim, sim%sink, sink_xp, sink_pid, flag2, int(sim%r%nsinkmax, kind=8))
  end subroutine gpu_sink_peak_id

  ! =========================================================================
  ! CUDA Kernel: Reset sink position, velocity and force to peak values
  ! =========================================================================
  attributes(global) subroutine gpu_sink_recenter_kernel(nsink, dtnew_d)
    integer, value :: nsink
    real(kind=8), device :: dtnew_d(*)
    integer :: ipart, gid, tid, idim
    integer :: peak_nr, ilevel

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > nsink) return

    ipart = gid
    peak_nr = sink_pid(ipart)

    if (peak_nr > 0) then
       ilevel = peak_level_d(peak_nr)
       do idim = 1, ndim
          ! Compute sink particle position from peak position
          sink_xp(ipart, idim) = peak_com_d(idim, peak_nr)
          ! Compute sink particle velocity from peak velocity
          sink_vp(ipart, idim) = peak_vel_d(idim, peak_nr) - peak_acc_d(idim, peak_nr) * 0.5d0 * dtnew_d(ilevel)
          ! Compute sink particle old force from peak acceleration
          sink_fp(ipart, idim) = peak_acc_d(idim, peak_nr)
       end do
    endif
  end subroutine gpu_sink_recenter_kernel

  ! =========================================================================
  ! CUDA Kernel: Map each active sink to its peak and increment sink count
  ! =========================================================================
  attributes(global) subroutine gpu_count_sinks_kernel(nsink)
    integer, value :: nsink
    integer :: ipart, gid, tid
    integer :: global_peak_id
    integer :: peak_nr, info

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > nsink) return

    ipart = gid
    global_peak_id = sink_pid(ipart)

    if (global_peak_id > 0) then
       peak_nr = int(global_peak_id)
       info = atomicadd(nsink_d(peak_nr), 1)
    endif
  end subroutine gpu_count_sinks_kernel

  ! =========================================================================
  ! CUDA Kernel: Accumulate sink counts hierarchically from merged sub-peaks
  ! =========================================================================
  attributes(global) subroutine gpu_hierarchical_sink_count_kernel(npeak, ilev)
    integer, value :: npeak
    integer, value :: ilev
    integer :: ipeak, gid, tid, jpeak, info
    integer :: merge_to

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid

    if (lev_peak_d(ipeak) == ilev) then
       merge_to = new_peak_d(ipeak)
       ! Check if merged into a different parent peak
       if (merge_to /= ipeak) then
          jpeak = int(merge_to)
          info = atomicadd(nsink_d(jpeak), nsink_d(ipeak))
       endif
    endif
  end subroutine gpu_hierarchical_sink_count_kernel

  ! =========================================================================
  ! Host Driver: Count sinks in each peak/clump and propagate hierarchically
  ! =========================================================================
  subroutine gpu_sink_in_peak(sim, reset_sink_pos, count_sink)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    logical, intent(in) :: reset_sink_pos, count_sink

    integer :: block_size, grid_size_sinks, grid_size_peaks
    integer :: ilev

    if (sim%c%npeak == 0) return

    block_size = 256
    grid_size_sinks = (sim%sink%npart + block_size - 1) / block_size
    grid_size_peaks = (sim%c%npeak + block_size - 1) / block_size

    ! 1. Reset sink position to peak position
    if (reset_sink_pos .and. sim%sink%npart > 0) then
       dtnew_part_d = sim%g%dtnew
       call gpu_sink_recenter_kernel<<<grid_size_sinks, block_size>>>(sim%sink%npart, dtnew_part_d)
       call GPU_Error_Check(__FILE__, __LINE__)
    endif

    ! 2. Count sink particles in each halo
    if (count_sink) then
       ! Clear device sink counters
       nsink_d = 0
       ! Count sinks in each peak
       if (sim%sink%npart > 0) then
          call gpu_count_sinks_kernel<<<grid_size_sinks, block_size>>>(sim%sink%npart)
          call GPU_Error_Check(__FILE__, __LINE__)
       endif
       ! Count sinks hierarchically in each halo (if saddle threshold is active)
       if (sim%c%saddle_threshold > 0.0d0) then
          do ilev = 0, sim%c%merge_levelmax
             call gpu_hierarchical_sink_count_kernel<<<grid_size_peaks, block_size>>>(sim%c%npeak, ilev)
             call GPU_Error_Check(__FILE__, __LINE__)
          end do
       endif
    endif

    ! 3. Copy updated sink counts back to the host
    if (allocated(sim%c%nsink)) then
       sim%c%nsink(1:sim%c%npeak) = nsink_d(1:sim%c%npeak)
    endif
  end subroutine gpu_sink_in_peak

  ! =========================================================================
  ! CUDA Kernel: Reset bound tree particles to their peak, keep the min id
  ! =========================================================================
  attributes(global) subroutine tree_recenter_kernel(ntree, grav, boxlen, &
       & box_size1, box_size2, box_size3)
    integer, value :: ntree
    real(kind=dp), value :: grav, boxlen, box_size1, box_size2, box_size3
    integer :: ipart, gid, tid, idim
    integer :: peak_nr, ilevel
    integer(i8b) :: info
    real(kind=dp) :: radius, rad2, vel2, v2, r2, dx, box(1:3)
    logical :: bound

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntree) return

    ipart = gid
    peak_nr = tree_pid(ipart)
    if (peak_nr <= 0) return

    ! Compute peak's central core properties
    ilevel = peak_level_d(peak_nr)
    radius = 2.0_dp * boxlen / (2**ilevel)
    rad2 = radius**2
    ! Compute relative velocity and distance
    box(1) = box_size1; box(2) = box_size2; box(3) = box_size3
    v2 = 0.0_dp
    r2 = 0.0_dp
    do idim = 1, ndim
       v2 = v2 + (tree_vp(ipart, idim) - peak_vel_d(idim, peak_nr))**2
       dx = tree_xp(ipart, idim) - peak_com_d(idim, peak_nr)
       if (periodic(idim)) then
          if (dx >  box(idim)*0.5_dp) dx = dx - box(idim)
          if (dx < -box(idim)*0.5_dp) dx = dx + box(idim)
       endif
       r2 = r2 + dx**2
    end do
    ! Compute boundness criteria (a peak without particle mass binds nothing)
    bound = .false.
    if (particle_mass_d(peak_nr) > 0.0_dp) then
       vel2 = grav * particle_mass_d(peak_nr) / radius
       bound = ( v2/vel2 + 2.0_dp*sqrt(r2/rad2) < 20.0_dp )
    endif

    if (bound) then
       ! If not merged yet then mark as merger candidate
       if (tree_idm(ipart) == 0) tree_idm(ipart) = -2
       do idim = 1, ndim
          ! Compute tree particle position from peak position
          tree_xp(ipart, idim) = peak_com_d(idim, peak_nr)
          ! Compute tree particle velocity from peak velocity
          tree_vp(ipart, idim) = peak_vel_d(idim, peak_nr) - peak_acc_d(idim, peak_nr) * 0.5_dp * dtnew_dp_d(ilevel)
       end do
       ! Update minimum tree id in each clump
       info = atomicmin(min_tree_id_d(peak_nr), tree_idp(ipart))
    endif
  end subroutine tree_recenter_kernel

  ! =========================================================================
  ! CUDA Kernel: Merge the tree particles that sit in the same clump
  ! =========================================================================
  attributes(global) subroutine tree_merge_kernel(ntree, texp)
    integer, value :: ntree
    real(kind=dp), value :: texp
    integer :: ipart, gid, tid, peak_nr

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntree) return

    ipart = gid
    peak_nr = tree_pid(ipart)

    ! Set tracking id to zero for orphan merger tree tracer particles
    if (peak_nr <= 0) then
       tree_idt(ipart) = 0
       return
    endif
    ! If tree particle is not bound and not merged, set as orphan with zero tracking id
    if (tree_idm(ipart) == 0) tree_idt(ipart) = 0
    if (tree_idm(ipart) == -2) then
       if (tree_idp(ipart) /= min_tree_id_d(peak_nr)) then
          ! Bound and just merged: update merging age, merge-to id and tracking id
          tree_idm(ipart) = min_tree_id_d(peak_nr)
          tree_tm(ipart) = texp
       else
          ! Bound and not merged: update its tracking id
          tree_idm(ipart) = 0
       endif
       tree_idt(ipart) = peak_nr
    endif
  end subroutine tree_merge_kernel

  ! =========================================================================
  ! CUDA Kernel: Map each active tree to its peak and increment tree count
  ! =========================================================================
  attributes(global) subroutine gpu_count_trees_kernel(ntree)
    integer, value :: ntree
    integer :: ipart, gid, tid
    integer :: global_peak_id
    integer :: peak_nr, info

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > ntree) return

    ipart = gid
    global_peak_id = tree_pid(ipart)

    if (global_peak_id > 0) then
       peak_nr = int(global_peak_id)
       info = atomicadd(ntree_d(peak_nr), 1)
    endif
  end subroutine gpu_count_trees_kernel

  ! =========================================================================
  ! CUDA Kernel: Accumulate tree counts hierarchically from merged sub-peaks
  ! =========================================================================
  attributes(global) subroutine gpu_hierarchical_tree_count_kernel(npeak, ilev)
    integer, value :: npeak
    integer, value :: ilev
    integer :: ipeak, gid, tid, jpeak, info
    integer :: merge_to

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    ipeak = gid

    if (lev_peak_d(ipeak) == ilev) then
       merge_to = new_peak_d(ipeak)
       ! Check if merged into a different parent peak
       if (merge_to /= ipeak) then
          jpeak = int(merge_to)
          info = atomicadd(ntree_d(jpeak), ntree_d(ipeak))
       endif
    endif
  end subroutine gpu_hierarchical_tree_count_kernel

  ! =========================================================================
  ! Host Driver: Reset trees to peaks, merge them and count trees per peak/halo
  ! =========================================================================
  subroutine gpu_tree_in_peak(sim, reset_tree_pos, count_tree)
    use ramses_commons, only: ramses_t
    implicit none
    type(ramses_t) :: sim
    logical, intent(in) :: reset_tree_pos, count_tree

    integer :: block_size, grid_size_trees, grid_size_peaks
    integer :: ilev
    real(kind=8) :: pi, grav
    real(kind=dp), dimension(1:MAXLEVEL) :: dtnew_dp

    if (sim%c%npeak == 0) return

    block_size = 256
    grid_size_trees = (sim%tree%npart + block_size - 1) / block_size
    grid_size_peaks = (sim%c%npeak + block_size - 1) / block_size

    ! 1. Reset tree particle positions to peak position
    if (reset_tree_pos) then
       min_tree_id_d(1:sim%c%npeak) = huge(0_i8b)
       if (sim%tree%npart > 0) then
          pi = acos(-1.0d0)
          grav = 1.0d0
          if (sim%r%cosmo) grav = 3.0d0/8.0d0/pi*sim%g%omega_m*sim%g%aexp
          dtnew_dp = real(sim%g%dtnew, kind=dp)
          dtnew_dp_d = dtnew_dp
          call tree_recenter_kernel<<<grid_size_trees, block_size>>>(sim%tree%npart, &
               & real(grav, kind=dp), real(sim%r%boxlen, kind=dp), &
               & real(sim%r%box_size(1), kind=dp), real(sim%r%box_size(2), kind=dp), &
               & real(sim%r%box_size(3), kind=dp))
          call GPU_Error_Check(__FILE__, __LINE__)
       endif
    endif

    ! 2. Merge all tree particles that sit in the same clump
    if (sim%tree%npart > 0) then
       call tree_merge_kernel<<<grid_size_trees, block_size>>>(sim%tree%npart, &
            & real(sim%g%texp, kind=dp))
       call GPU_Error_Check(__FILE__, __LINE__)
    endif

    ! 3. Count tree particles in each peak, then hierarchically in each halo
    if (count_tree) then
       ntree_d = 0
       if (sim%tree%npart > 0) then
          call gpu_count_trees_kernel<<<grid_size_trees, block_size>>>(sim%tree%npart)
          call GPU_Error_Check(__FILE__, __LINE__)
       endif
       if (sim%c%saddle_threshold > 0.0d0) then
          do ilev = 0, sim%c%merge_levelmax
             call gpu_hierarchical_tree_count_kernel<<<grid_size_peaks, block_size>>>(sim%c%npeak, ilev)
             call GPU_Error_Check(__FILE__, __LINE__)
          end do
       endif
    endif
  end subroutine gpu_tree_in_peak

  ! =========================================================================
  ! CUDA Kernel: Evaluate sink formation sites on the GPU
  ! =========================================================================
  attributes(global) subroutine count_sink_site_kernel( &
       & npeak, relevance_threshold, mass_threshold, saddle_threshold, &
       & purity_threshold, mp_min, rho_type_sink, &
       & nstar_threshold, mseed, boxlen, prefix_sum)
    integer, value :: npeak
    real(kind=8), value :: relevance_threshold, mass_threshold, saddle_threshold
    real(kind=8), value :: purity_threshold, mp_min
    integer, value :: rho_type_sink
    real(kind=8), value :: nstar_threshold, mseed, boxlen
    integer(kind=4), device :: prefix_sum(*)

    integer :: gid, tid, jpeak
#ifdef HYDRO
    integer :: ind, igrid, ilevel
    real(kind=dp) :: dgas, dx_loc, vol_loc
#endif
    real(kind=dp) :: purity
    logical :: ok

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    jpeak = gid
    ok = .true.

    ! 1. Check if peak is a halo (only if halos have been computed)
    if (saddle_threshold > 0.0d0) then
       if (ind_halo_d(jpeak) /= jpeak) ok = .false.
    endif
    ! 2. Relevance threshold check
    if (relevance_d(jpeak) <= relevance_threshold) ok = .false.
    ! 3. Clump mass threshold check
    if (clump_mass_d(jpeak) <= mass_threshold) ok = .false.
    ! 4. Ensure no existing sinks in the peak
    if (nsink_d(jpeak) > 0) ok = .false.
    ! 5. Dark matter purity and particle count checks
    if (rho_type_sink == 1) then
       if (particle_mass_d(jpeak) > 0.0d0) then
          purity = npart_d(jpeak) * mp_min / particle_mass_d(jpeak)
          if (purity <= purity_threshold) ok = .false.
       endif
       if (npart_d(jpeak) == 0) ok = .false.
    endif
    ! 6. Hydro-specific conditions
#ifdef HYDRO
    if (ok) then
       ind = peak_cell_d(jpeak)
       igrid = peak_grid_d(jpeak)
       dgas = uold(ind, 1, igrid)
       ilevel = peak_level_d(jpeak)
       dx_loc = boxlen / (2**ilevel)
       vol_loc = dx_loc**ndim
       ! 7. Star forming cell check
       if (dgas <= nstar_threshold) ok = .false.
       ! 8. Enough gas mass available check
       if (mseed > 0.75d0 * dgas * vol_loc) ok = .false.
    endif
#endif

    if (ok) then
       prefix_sum(jpeak) = 1
    else
       prefix_sum(jpeak) = 0
    endif
  end subroutine count_sink_site_kernel

  ! =========================================================================
  ! CUDA Kernel: Map qualifying peak indices to compacted sink indices
  ! =========================================================================
  attributes(global) subroutine compute_sink_swap_table(swap_local, prefix_sum, npeak)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: prefix_sum(*)
    integer, value :: npeak

    integer :: gid, tid, jpeak, previous_sum, has_site, sink_idx

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    jpeak = gid

    if (jpeak > 1) then
       previous_sum = prefix_sum(jpeak - 1)
    else
       previous_sum = 0
    endif

    has_site = prefix_sum(jpeak) - previous_sum

    if (has_site > 0) then
       sink_idx = 1 + previous_sum
       swap_local(sink_idx) = jpeak
    endif
  end subroutine compute_sink_swap_table

  ! =========================================================================
  ! CUDA Kernel: Spawn sink particles on the GPU
  ! =========================================================================
  attributes(global) subroutine sink_formation_kernel( &
       & swap_local, head_part, npart_new, npart_tot_old, &
       & mseed, texp, dtnew_d, boxlen, nsinkmax)
    integer(kind=4), device :: swap_local(*)
    integer, value :: head_part, npart_new
    integer(kind=8), value :: npart_tot_old
    real(kind=8), value :: mseed, texp, boxlen
    real(kind=8), device :: dtnew_d(*)
    integer, value :: nsinkmax

    integer :: sink_idx, gid, tid, jpeak, ilevel, idim
#ifdef HYDRO
    integer :: ind, igrid, ivar
    real(kind=dp) :: dseed, mass_frac
#endif
    real(kind=dp) :: dx_loc

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npart_new) return

    jpeak = swap_local(gid)
    sink_idx = head_part + gid - 1

    ilevel = peak_level_d(jpeak)
    dx_loc = boxlen / (2**ilevel)

    ! Position from peak COM
    sink_xp(sink_idx, 1) = peak_com_d(1, jpeak)
    sink_xp(sink_idx, 2) = peak_com_d(2, jpeak)
    sink_xp(sink_idx, 3) = peak_com_d(3, jpeak)

    ! Velocity (with dt half-step correction from acceleration)
    sink_vp(sink_idx, 1) = peak_vel_d(1, jpeak) - peak_acc_d(1, jpeak) * 0.5d0 * dtnew_d(ilevel)
    sink_vp(sink_idx, 2) = peak_vel_d(2, jpeak) - peak_acc_d(2, jpeak) * 0.5d0 * dtnew_d(ilevel)
    sink_vp(sink_idx, 3) = peak_vel_d(3, jpeak) - peak_acc_d(3, jpeak) * 0.5d0 * dtnew_d(ilevel)

    ! Acceleration force
    sink_fp(sink_idx, 1) = peak_acc_d(1, jpeak)
    sink_fp(sink_idx, 2) = peak_acc_d(2, jpeak)
    sink_fp(sink_idx, 3) = peak_acc_d(3, jpeak)

    ! Set initial angular momentum to almost zero
    sink_jp(sink_idx, 1) = 0.0d0
    sink_jp(sink_idx, 2) = 0.0d0
    sink_jp(sink_idx, 3) = 1.0d-20

    ! Mass and birth properties
    sink_mp(sink_idx) = 0.0d0
#ifdef HYDRO
    sink_mp(sink_idx) = mseed
    ind = peak_cell_d(jpeak)
    igrid = peak_grid_d(jpeak)
    ! Remove seed mass from all cell gas variables
    dseed = mseed / (dx_loc**ndim)
    mass_frac = 1.0d0 - dseed / uold(ind, 1, igrid)
    do ivar = 1, nvar
       uold(ind, ivar, igrid) = uold(ind, ivar, igrid) * mass_frac
    end do
#endif
    sink_tp(sink_idx) = texp
    ! Set merging time to -1000
    sink_tm(sink_idx) = -1000.0d0
    ! Set merging id to 0
    sink_idm(sink_idx) = 0
    sink_levelp(sink_idx) = ilevel
    sink_idp(sink_idx) = npart_tot_old + gid
  end subroutine sink_formation_kernel

  ! =========================================================================
  ! Host Driver: Count sinks in each peak/clump and propagate hierarchically
  ! =========================================================================
  subroutine gpu_sink_formation(sim, msink_loc)
    use nvtx
    use constants, only: M_sun
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim
    real(kind=8), intent(inout) :: msink_loc

    real(kind=8) :: scale_nH, scale_T2, scale_l, scale_d, scale_t, scale_v, scale_m
    real(kind=8) :: mseed
    integer :: num_threads, num_blocks
    integer :: npart_new
    integer(kind=4), device :: npart_new_d
    integer :: head_part

    msink_loc = 0.0d0

    if (sim%c%npeak <= 0) return

    ! 1. Calculate physical constants and mseed on host
    call units(sim%r, sim%g, scale_l, scale_t, scale_d, scale_v, scale_nH, scale_T2)
    scale_m = scale_d * scale_l**3
    mseed = sim%r%sink_mseed * M_sun / scale_m

    num_threads = 256
    num_blocks = (sim%c%npeak + num_threads - 1) / num_threads

    ! 2. Evaluate formation sites on GPU
    call nvtxStartRange("Count Sink Formation Sites", color=5)!red
    call count_sink_site_kernel<<<num_blocks, num_threads>>>( &
         & sim%c%npeak, &
         & sim%c%relevance_threshold, sim%c%mass_threshold, sim%c%saddle_threshold, &
         & sim%c%purity_threshold, sim%g%mp_min, sim%r%rho_type_sink, &
         & sim%r%sink_nstar_frac * sim%r%n_star / scale_nH, mseed, sim%r%boxlen, &
         & prefix_sum)
    call GPU_Error_Check(__FILE__, __LINE__)
    call nvtxEndRange()

    ! 3. Run prefix sum on prefix_sum to get target offsets
    call gpu_scan(prefix_sum, 1, sim%c%npeak, npart_new_d)
    npart_new = npart_new_d

    if (npart_new > 0) then
       ! Check memory constraints
       head_part = sim%sink%npart + 1
       if (head_part + npart_new - 1 > sim%r%nsinkmax) then
          write(*,*) 'Not enough memory for sink particles on GPU'
          stop
       endif

       ! 4. Fill swap table
       call compute_sink_swap_table<<<num_blocks, num_threads>>>( &
            & swap_local, prefix_sum, sim%c%npeak)
       call GPU_Error_Check(__FILE__, __LINE__)

       ! 5. Copy time step to device
       dtnew_part_d = sim%g%dtnew

       ! 6. Launch spawning kernel
       num_blocks = (npart_new + num_threads - 1) / num_threads
       call nvtxStartRange("Create New Sink Particles", color=5)!red
       call sink_formation_kernel<<<num_blocks, num_threads>>>( &
            & swap_local, head_part, npart_new, sim%sink%npart_tot, &
            & mseed, sim%g%texp, dtnew_part_d, &
            & sim%r%boxlen, sim%r%nsinkmax)
       call GPU_Error_Check(__FILE__, __LINE__)
       call nvtxEndRange()

       ! 7. Update host-side metadata
       sim%sink%npart = sim%sink%npart + npart_new
       sim%sink%npart_tot = sim%sink%npart_tot + npart_new
       sim%sink%tailp(sim%r%nlevelmax) = sim%sink%tailp(sim%r%nlevelmax) + npart_new

#ifdef HYDRO
       msink_loc = real(npart_new, kind=8) * mseed
#endif
    endif

    if (sim%g%myid == 1) then
       write(*,'(" Formed",I11,"  new sinks for a total of ",I0)')npart_new,int(sim%sink%npart_tot,kind=4)
    endif
  end subroutine gpu_sink_formation

  ! =========================================================================
  ! CUDA Kernel: Evaluate tree formation sites on the GPU
  ! =========================================================================
  attributes(global) subroutine count_tree_site_kernel( &
       & npeak, relevance_threshold, mass_threshold, saddle_threshold, &
       & purity_threshold, mp_min, prefix_sum)
    integer, value :: npeak
    real(kind=dp), value :: relevance_threshold, mass_threshold, saddle_threshold
    real(kind=dp), value :: purity_threshold, mp_min
    integer(kind=4), device :: prefix_sum(*)

    integer :: gid, tid, jpeak
    real(kind=dp) :: purity
    logical :: ok

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npeak) return

    jpeak = gid
    ok = .true.

    ! 1. Peak must be its own halo, with enough mass
    if (saddle_threshold > 0.0_dp) then
       if (ind_halo_d(jpeak) /= jpeak) ok = .false.
       if (halo_mass_d(jpeak) <= 10.0_dp * mass_threshold) ok = .false.
    else
       if (clump_mass_d(jpeak) <= 10.0_dp * mass_threshold) ok = .false.
    endif
    ! 2. Relevance threshold check
    if (relevance_d(jpeak) <= relevance_threshold) ok = .false.
    ! 3. Peak must contain dark matter particles
    if (npart_d(jpeak) == 0) ok = .false.
    ! 4. Ensure no existing trees in the peak (or halo)
    if (ntree_d(jpeak) > 0) ok = .false.
    ! 5. Dark matter purity check
    if (particle_mass_d(jpeak) > 0.0_dp) then
       purity = npart_d(jpeak) * mp_min / particle_mass_d(jpeak)
       if (purity <= purity_threshold) ok = .false.
    endif

    if (ok) then
       prefix_sum(jpeak) = 1
    else
       prefix_sum(jpeak) = 0
    endif
  end subroutine count_tree_site_kernel

  ! =========================================================================
  ! CUDA Kernel: Spawn tree particles on the GPU
  ! =========================================================================
  attributes(global) subroutine tree_formation_kernel( &
       & swap_local, head_part, npart_new, npart_tot_old, texp)
    integer(kind=4), device :: swap_local(*)
    integer, value :: head_part, npart_new
    integer(kind=8), value :: npart_tot_old
    real(kind=dp), value :: texp

    integer :: tree_idx, gid, tid, jpeak, ilevel, idim

    tid = threadIdx%x
    gid = tid + (blockIdx%x - 1) * blockDim%x
    if (gid > npart_new) return

    jpeak = swap_local(gid)
    tree_idx = head_part + gid - 1
    ilevel = peak_level_d(jpeak)

    do idim = 1, ndim
       ! Compute tree particle position from peak position
       tree_xp(tree_idx, idim) = peak_com_d(idim, jpeak)
       ! Compute tree particle velocity from peak velocity
       tree_vp(tree_idx, idim) = peak_vel_d(idim, jpeak) - peak_acc_d(idim, jpeak) * 0.5_dp * dtnew_dp_d(ilevel)
    end do
    ! Set mass to zero
    tree_mp(tree_idx) = 0.0_dp
    ! Set tracking number to parent clump id
    tree_idt(tree_idx) = jpeak
    ! Compute tree particle birth time
    tree_tp(tree_idx) = texp
    ! Set merging time to -1000
    tree_tm(tree_idx) = -1000.0_dp
    ! Set merging id to 0
    tree_idm(tree_idx) = 0
    ! Compute level
    tree_levelp(tree_idx) = ilevel
    ! New tree particle index
    tree_idp(tree_idx) = int(npart_tot_old + gid, kind=i8b)
  end subroutine tree_formation_kernel

  ! =========================================================================
  ! Host Driver: Create new tree particles in the GPU clumps
  ! =========================================================================
  subroutine gpu_tree_formation(sim)
    use nvtx
    use ramses_commons, only: ramses_t
    type(ramses_t), intent(inout) :: sim

    integer :: num_threads, num_blocks
    integer :: npart_new
    integer(kind=4), device :: npart_new_d
    integer :: head_part
    real(kind=dp), dimension(1:MAXLEVEL) :: dtnew_dp

#if NDIM>2
    npart_new = 0
    if (sim%c%npeak > 0) then

       num_threads = 256
       num_blocks = (sim%c%npeak + num_threads - 1) / num_threads

       ! 1. Evaluate formation sites on GPU
       call nvtxStartRange("Count Tree Formation Sites", color=5)!red
       call count_tree_site_kernel<<<num_blocks, num_threads>>>( &
            & sim%c%npeak, &
            & real(sim%c%relevance_threshold, kind=dp), real(sim%c%mass_threshold, kind=dp), &
            & real(sim%c%saddle_threshold, kind=dp), real(sim%c%purity_threshold, kind=dp), &
            & real(sim%g%mp_min, kind=dp), prefix_sum)
       call GPU_Error_Check(__FILE__, __LINE__)
       call nvtxEndRange()

       ! 2. Run prefix sum to get target offsets
       call gpu_scan(prefix_sum, 1, sim%c%npeak, npart_new_d)
       npart_new = npart_new_d

       if (npart_new > 0) then
          ! Check memory constraints
          head_part = sim%tree%npart + 1
          if (head_part + npart_new - 1 > sim%r%ntreemax) then
             write(*,*) 'Not enough memory for tree particle'
             write(*,*) 'Increase ntreemax in the namelist'
             stop
          endif

          ! 3. Fill swap table
          call compute_sink_swap_table<<<num_blocks, num_threads>>>( &
               & swap_local, prefix_sum, sim%c%npeak)
          call GPU_Error_Check(__FILE__, __LINE__)

          ! 4. Copy time step to device
          dtnew_dp = real(sim%g%dtnew, kind=dp)
          dtnew_dp_d = dtnew_dp

          ! 5. Launch spawning kernel
          num_blocks = (npart_new + num_threads - 1) / num_threads
          call nvtxStartRange("Create New Tree Particles", color=5)!red
          call tree_formation_kernel<<<num_blocks, num_threads>>>( &
               & swap_local, head_part, npart_new, sim%tree%npart_tot, &
               & real(sim%g%texp, kind=dp))
          call GPU_Error_Check(__FILE__, __LINE__)
          call nvtxEndRange()

          ! 6. Update host-side metadata
          sim%tree%npart = sim%tree%npart + npart_new
          sim%tree%npart_tot = sim%tree%npart_tot + npart_new
          sim%tree%tailp(sim%r%nlevelmax) = sim%tree%tailp(sim%r%nlevelmax) + npart_new
       endif
    endif

    if (sim%g%myid == 1) then
       write(*,'(" Found",I12,"  new merger tree particles for a total of ",I0)')npart_new,int(sim%tree%npart_tot,kind=4)
    endif
#endif
  end subroutine gpu_tree_formation

end module clump_device
