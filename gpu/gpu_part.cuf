          & 1, sim%core%npart, int(sim%r%ncoremax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%core%headp(ilevel)
  tail_idx = sim%core%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc  = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim

  num_threads = 256
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  call nvtxStartRange("gpu_bspline_core:deposit", color=4)
  call bspline_part_kernel<<<num_blocks, num_threads>>>(&
       & core_sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & core_xp, core_mp, rho, nref, &
       & real(sim%m%skip(1),kind=dp), real(sim%m%skip(2),kind=dp), real(sim%m%skip(3),kind=dp), &
       & real(dx_loc,kind=dp), real(vol_loc,kind=dp), real(sim%r%mass_sph,kind=dp), .true., &
       & real(sim%r%m_refine(ilevel),kind=dp), real(sim%r%mass_cut_refine,kind=dp), &
       & order, ilevel, int(sim%r%ncoremax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_bspline_core

!> Per-level particle Courant reduction. Computes vmax = MAX|vp| and
!> ekin = SUM 0.5*mp*|vp|^2 over particles in level ilevel from device vp/mp
!> and combines them into the inout host scalars
subroutine gpu_newdt_part(sim, ilevel, vmax, ekin)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  real(kind=8), intent(inout) :: vmax, ekin

  integer(kind=4) :: head_idx, num_parts
  integer(kind=8) :: leading
  integer :: num_threads, num_blocks
  real(kind=8), device :: vmax_dev
  real(kind=8), device :: ekin_dev
  real(kind=8) :: vmax_host, ekin_host

  head_idx  = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(ilevel) - head_idx + 1

  if (num_parts <= 0) return

  leading = sim%r%npartmax
  vmax_dev = 0.0_dp
  ekin_dev = 0.0_dp

  num_threads = 256
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  call nvtxStartRange("gpu_newdt_part", color=4) ! purple
  call gpu_newdt_part_kernel<<<num_blocks, num_threads>>>(vp, mp, &
       & vmax_dev, ekin_dev, head_idx, num_parts, leading)
  call GPU_Error_Check("gpu/gpu_part.cuf", 0)
  call nvtxEndRange()

  vmax_host = vmax_dev   ! D->H
  ekin_host = ekin_dev   ! D->H

  vmax = MAX(vmax, vmax_host)
  ekin = ekin + ekin_host

end subroutine gpu_newdt_part

subroutine gpu_newdt_star(sim, ilevel, vmax, ekin)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
