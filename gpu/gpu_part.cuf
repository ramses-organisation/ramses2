!> GPU split_part.
subroutine gpu_split_part(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, ilev
  integer(kind=8) :: leading
  integer(kind=4), device :: n_fine_dev
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  head_idx = sim%p%headp(ilevel)
  num_parts = sim%p%tailp(sim%r%nlevelmax) - head_idx + 1
  leading = sim%r%npartmax

  if (num_parts <= 0) then
     sim%p%tailp(ilevel) = sim%p%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
        sim%p%tailp(ilev) = sim%p%npart
     end do
     return
  endif

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  ! Geometry
  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Partition into current level particles and finer levels particles
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call bucket_part_kernel<<<num_blocks, num_threads>>>(xp, isp_swap, &
       & grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
       & leading)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Initialize prefix sum using swap table sortp
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call init_prefix_sum_part_hilbert_fine<<<num_blocks, num_threads>>>( &
       & isp_swap, sortp, prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Compute prefix sum
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call gpu_scan(prefix_sum, head_idx, num_parts, n_fine_dev)
  call nvtxEndRange()

  n_fine = n_fine_dev
  n_coarse = num_parts - n_fine

  ! Update swap table sortp
  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call write_swap_global_hilbert_partition<<<num_blocks, num_threads>>>( &
       & isp_swap, sortp, prefix_sum, &
       & head_idx, num_parts, n_coarse)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  call nvtxStartRange("gpu_split_part", color=4) ! purple
  call write_sortp_part<<<num_blocks, num_threads>>>(sortp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Shuffle data according to swap table
  call nvtxStartRange("gpu_split_part", color=4) ! purple

  ! Positions
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, xp, &
          & sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(xp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Velocities
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, vp, &
          & sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(vp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Masses
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, mp, &
       & sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(mp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Levels
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, levelp, &
       & sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(levelp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Particle ids
  if (allocated(idp)) then
#ifndef LONGINT
     call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, idp, &
          & sortp, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idp, isp_swap, &
          & head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)
#else
     call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, idp, &
          & sortp, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(idp, idp_swap, &
          & head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)
#endif
  end if
  call nvtxEndRange()

  ! Bookkeeping
  sim%p%tailp(ilevel) = sim%p%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%p%headp(ilev) = sim%p%tailp(ilevel) + 1
     sim%p%tailp(ilev) = sim%p%npart
  end do

end subroutine gpu_split_part

subroutine gpu_split_star(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, ilev
  integer(kind=8) :: leading
  integer(kind=4), device :: n_fine_dev
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  head_idx = sim%star%headp(ilevel)
  num_parts = sim%star%tailp(sim%r%nlevelmax) - head_idx + 1
  leading = sim%r%nstarmax

  if (num_parts <= 0) then
     sim%star%tailp(ilevel) = sim%star%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%star%headp(ilev) = sim%star%tailp(ilevel) + 1
        sim%star%tailp(ilev) = sim%star%npart
     end do
     return
  endif

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  ! Geometry
  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Partition into current level particles and finer levels particles
  call nvtxStartRange("gpu_split_star", color=4) ! purple
  call bucket_part_kernel<<<num_blocks, num_threads>>>(star_xp, isp_swap, &
       & grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
       & leading)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Initialize prefix sum using swap table sortp
  call nvtxStartRange("gpu_split_star", color=4) ! purple
  call init_prefix_sum_part_hilbert_fine<<<num_blocks, num_threads>>>( &
       & isp_swap, star_sortp, prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Compute prefix sum
  call nvtxStartRange("gpu_split_star", color=4) ! purple
  call gpu_scan(prefix_sum, head_idx, num_parts, n_fine_dev)
  call nvtxEndRange()

  n_fine = n_fine_dev
  n_coarse = num_parts - n_fine

  ! Update swap table sortp
  call nvtxStartRange("gpu_split_star", color=4) ! purple
  call write_swap_global_hilbert_partition<<<num_blocks, num_threads>>>( &
       & isp_swap, star_sortp, prefix_sum, &
       & head_idx, num_parts, n_coarse)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  call nvtxStartRange("gpu_split_star", color=4) ! purple
  call write_sortp_part<<<num_blocks, num_threads>>>(star_sortp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Shuffle data according to swap table
  call nvtxStartRange("gpu_split_star", color=4) ! purple

  ! Positions
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, star_xp, &
          & star_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(star_xp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Velocities
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, star_vp, &
          & star_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(star_vp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Masses
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, star_mp, &
       & star_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(star_mp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Birth time
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, star_tp, &
       & star_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(star_tp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Metallicity
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, star_zp, &
       & star_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(star_zp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Levels
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, star_levelp, &
       & star_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(star_levelp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Particle ids
#ifndef LONGINT
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, star_idp, &
       & star_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(star_idp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#else
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, star_idp, &
       & star_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(star_idp, idp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#endif
  call nvtxEndRange()

  ! Bookkeeping
  sim%star%tailp(ilevel) = sim%star%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%star%headp(ilev) = sim%star%tailp(ilevel) + 1
     sim%star%tailp(ilev) = sim%star%npart
  end do

end subroutine gpu_split_star

subroutine gpu_split_sink(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, ilev
  integer(kind=8) :: leading
  integer(kind=4), device :: n_fine_dev
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  head_idx = sim%sink%headp(ilevel)
  num_parts = sim%sink%tailp(sim%r%nlevelmax) - head_idx + 1
  leading = sim%r%nsinkmax

  if (num_parts <= 0) then
     sim%sink%tailp(ilevel) = sim%sink%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%sink%headp(ilev) = sim%sink%tailp(ilevel) + 1
        sim%sink%tailp(ilev) = sim%sink%npart
     end do
     return
  endif

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  ! Geometry
  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Partition into current level particles and finer levels particles
  call nvtxStartRange("gpu_split_sink", color=4) ! purple
  call bucket_part_kernel<<<num_blocks, num_threads>>>(sink_xp, isp_swap, &
       & grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
       & leading)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Initialize prefix sum using swap table sortp
  call nvtxStartRange("gpu_split_sink", color=4) ! purple
  call init_prefix_sum_part_hilbert_fine<<<num_blocks, num_threads>>>( &
       & isp_swap, sink_sortp, prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Compute prefix sum
  call nvtxStartRange("gpu_split_sink", color=4) ! purple
  call gpu_scan(prefix_sum, head_idx, num_parts, n_fine_dev)
  call nvtxEndRange()

  n_fine = n_fine_dev
  n_coarse = num_parts - n_fine

  ! Update swap table sortp
  call nvtxStartRange("gpu_split_sink", color=4) ! purple
  call write_swap_global_hilbert_partition<<<num_blocks, num_threads>>>( &
       & isp_swap, sink_sortp, prefix_sum, &
       & head_idx, num_parts, n_coarse)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  call nvtxStartRange("gpu_split_sink", color=4) ! purple
  call write_sortp_part<<<num_blocks, num_threads>>>(sink_sortp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Shuffle data according to swap table
  call nvtxStartRange("gpu_split_sink", color=4) ! purple

  ! Positions
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, sink_xp, &
          & sink_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(sink_xp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Velocities
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, sink_vp, &
          & sink_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(sink_vp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Accelerations
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, sink_fp, &
          & sink_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(sink_fp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Angular momenta
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, sink_jp, &
          & sink_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(sink_jp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Masses
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, sink_mp, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(sink_mp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Birth time
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, sink_tp, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(sink_tp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Merging time
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, sink_tm, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(sink_tm, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Levels
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, sink_levelp, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(sink_levelp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Particle ids
#ifndef LONGINT
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, sink_idp, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(sink_idp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#else
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, sink_idp, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(sink_idp, idp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#endif

  ! Merging ids
#ifndef LONGINT
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, sink_idm, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(sink_idm, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#else
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, sink_idm, &
       & sink_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(sink_idm, idp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#endif
  call nvtxEndRange()

  ! Bookkeeping
  sim%sink%tailp(ilevel) = sim%sink%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%sink%headp(ilev) = sim%sink%tailp(ilevel) + 1
     sim%sink%tailp(ilev) = sim%sink%npart
  end do

end subroutine gpu_split_sink

!> GPU split_part for cores, in the row order of the host: coarse particles
!> in sortp order, fine particles in their previous row order.
! Written by Daniel Han (mini-ramses version October 2026).
subroutine gpu_split_core(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, ilev
  integer(kind=8) :: leading
  integer(kind=4), device :: n_fine_dev
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  head_idx = sim%core%headp(ilevel)
  num_parts = sim%core%tailp(sim%r%nlevelmax) - head_idx + 1
  leading = sim%r%ncoremax

  if (num_parts <= 0) then
     sim%core%tailp(ilevel) = sim%core%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%core%headp(ilev) = sim%core%tailp(ilevel) + 1
        sim%core%tailp(ilev) = sim%core%npart
     end do
     return
  endif

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  ! Geometry
  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Partition into current level particles and finer levels particles
  call nvtxStartRange("gpu_split_core", color=4) ! purple
  call bucket_part_kernel<<<num_blocks, num_threads>>>(core_xp, isp_swap, &
       & grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
       & leading)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Initialize prefix sums in sortp order and in row order
  call nvtxStartRange("gpu_split_core", color=4) ! purple
  call init_prefix_sum_part_hilbert_fine<<<num_blocks, num_threads>>>( &
       & isp_swap, core_sortp, prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call init_prefix_sum_part<<<num_blocks, num_threads>>>( &
       & isp_swap, prefix_sum_phys, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Compute prefix sums
  call nvtxStartRange("gpu_split_core", color=4) ! purple
  call gpu_scan(prefix_sum, head_idx, num_parts, n_fine_dev)
  call gpu_scan(prefix_sum_phys, head_idx, num_parts)
  call nvtxEndRange()

  n_fine = n_fine_dev
  n_coarse = num_parts - n_fine

  ! Update swap table sortp
  call nvtxStartRange("gpu_split_core", color=4) ! purple
  call write_swap_global_cpu_partition<<<num_blocks, num_threads>>>( &
       & isp_swap, core_sortp, prefix_sum, prefix_sum_phys, &
       & head_idx, num_parts, n_coarse)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  call nvtxStartRange("gpu_split_core", color=4) ! purple
  call write_sortp_part<<<num_blocks, num_threads>>>(core_sortp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Shuffle data according to swap table
  call nvtxStartRange("gpu_split_core", color=4) ! purple

  ! Positions
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, core_xp, &
          & core_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(core_xp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Velocities
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, core_vp, &
          & core_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(core_vp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Accelerations
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, core_fp, &
          & core_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(core_fp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Angular momenta
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, core_jp, &
          & core_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(core_jp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Masses
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, core_mp, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(core_mp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Metallicity
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, core_zp, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(core_zp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Birth time
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, core_tp, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(core_tp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Specific energy
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, core_up, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(core_up, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Levels
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, core_levelp, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(core_levelp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Last accretion steps
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, core_nacc, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(core_nacc, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Particle ids
#ifndef LONGINT
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, core_idp, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(core_idp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#else
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, core_idp, &
       & core_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(core_idp, idp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#endif
  call nvtxEndRange()

  ! Bookkeeping
  sim%core%tailp(ilevel) = sim%core%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%core%headp(ilev) = sim%core%tailp(ilevel) + 1
     sim%core%tailp(ilev) = sim%core%npart
  end do

end subroutine gpu_split_core

subroutine gpu_split_tree(sim, ilevel)
  use nvtx
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       compute_local_swap_table, update_global_swap_table
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, num_parts, n_fine, n_coarse, ilev
  integer(kind=8) :: leading
  integer(kind=4), device :: n_fine_dev
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  head_idx = sim%tree%headp(ilevel)
  num_parts = sim%tree%tailp(sim%r%nlevelmax) - head_idx + 1
  leading = sim%r%ntreemax

  if (num_parts <= 0) then
     sim%tree%tailp(ilevel) = sim%tree%headp(ilevel) - 1
     do ilev = ilevel + 1, sim%r%nlevelmax
        sim%tree%headp(ilev) = sim%tree%tailp(ilevel) + 1
        sim%tree%tailp(ilev) = sim%tree%npart
     end do
     return
  endif

  num_threads = 128
  num_blocks  = (num_parts + num_threads - 1) / num_threads

  ! Geometry
  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Partition into current level particles and finer levels particles
  call nvtxStartRange("gpu_split_tree", color=4) ! purple
  call bucket_part_kernel<<<num_blocks, num_threads>>>(tree_xp, isp_swap, &
       & grid, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & skip1, skip2, skip3, dx_loc, ilevel, head_idx, num_parts, &
       & leading)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Initialize prefix sum using swap table sortp
  call nvtxStartRange("gpu_split_tree", color=4) ! purple
  call init_prefix_sum_part_hilbert_fine<<<num_blocks, num_threads>>>( &
       & isp_swap, tree_sortp, prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Compute prefix sum
  call nvtxStartRange("gpu_split_tree", color=4) ! purple
  call gpu_scan(prefix_sum, head_idx, num_parts, n_fine_dev)
  call nvtxEndRange()

  n_fine = n_fine_dev
  n_coarse = num_parts - n_fine

  ! Update swap table sortp
  call nvtxStartRange("gpu_split_tree", color=4) ! purple
  call write_swap_global_hilbert_partition<<<num_blocks, num_threads>>>( &
       & isp_swap, tree_sortp, prefix_sum, &
       & head_idx, num_parts, n_coarse)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  call nvtxStartRange("gpu_split_tree", color=4) ! purple
  call write_sortp_part<<<num_blocks, num_threads>>>(tree_sortp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Shuffle data according to swap table
  call nvtxStartRange("gpu_split_tree", color=4) ! purple

  ! Positions
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, tree_xp, &
          & tree_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(tree_xp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Velocities
  do idim = 1, ndim
     call sort_gather_part_real_col<<<num_blocks, num_threads>>>(xp_swap, tree_vp, &
          & tree_sortp, head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
     call sort_scatter_part_real_col<<<num_blocks, num_threads>>>(tree_vp, xp_swap, &
          & head_idx, num_parts, leading, idim)
     call GPU_Error_Check(__FILE__, __LINE__)
  end do

  ! Masses
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, tree_mp, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(tree_mp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Birth time
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, tree_tp, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(tree_tp, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Merging time
  call sort_gather_part_real_1d<<<num_blocks, num_threads>>>(xp_swap, tree_tm, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_real_1d<<<num_blocks, num_threads>>>(tree_tm, xp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Levels
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, tree_levelp, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(tree_levelp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! Particle ids
#ifndef LONGINT
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, tree_idp, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(tree_idp, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#else
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, tree_idp, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(tree_idp, idp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#endif

  ! Merging ids
#ifndef LONGINT
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(isp_swap, tree_idm, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(tree_idm, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#else
  call sort_gather_part_i8_1d<<<num_blocks, num_threads>>>(idp_swap, tree_idm, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i8_1d<<<num_blocks, num_threads>>>(tree_idm, idp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
#endif

  ! Tracking (peak) ids
  call sort_gather_part_i4_1d<<<num_blocks, num_threads>>>(isp_swap, tree_idt, &
       & tree_sortp, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call sort_scatter_part_i4_1d<<<num_blocks, num_threads>>>(tree_idt, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Bookkeeping
  sim%tree%tailp(ilevel) = sim%tree%headp(ilevel) + n_coarse - 1
  do ilev = ilevel + 1, sim%r%nlevelmax
     sim%tree%headp(ilev) = sim%tree%tailp(ilevel) + 1
     sim%tree%tailp(ilev) = sim%tree%npart
  end do

end subroutine gpu_split_tree

!> Compute per-particle Hilbert sort keys.
!>
!> The source cell per axis is floor((xp+skip)/dx + shift). For the large
!> deposit (part_dep_algo=1) shift=0; for the shifted deposits (part_dep_algo=2
!> medium and 3 small) shift=0.5 so the source cell becomes the upper corner of
!> the standard CIC 2x2x2 stencil block (matching host cic_part's x+0.5 anchor).
!> GPU runs are periodic, so the (possibly shifted) source cell is wrapped into
!> the level's box_ckey_min/max range before keying: an upper-edge particle
!> groups with its periodic image, and the Hilbert key is computed at the
!> deposit level.
attributes(global) subroutine compute_hkey_part_kernel(xp, hkey_part_d, &
     & box_ckey_min_d, box_ckey_max_d, skip, dx_inv, head_idx, num_parts, &
     & leading, level, shift)
  implicit none
  real(kind=dp),   device :: xp(*)
  integer(kind=8), device :: hkey_part_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  real(kind=8), intent(in), device :: skip(*)
  real(kind=8), intent(in), value :: dx_inv
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=8), intent(in), value :: leading
  integer(kind=4), intent(in), value :: level
  real(kind=8),    intent(in), value :: shift

  integer :: thread_idx, block_idx, idx, ipart, idim
  integer(kind=4) :: ix(1:ndim), box_min(1:3), box_max(1:3)
  real(kind=8) :: xs

  thread_idx = threadIdx%x - 1
  block_idx = blockIdx%x  - 1

  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  box_min = 0
  box_max = 0
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, level+1)
     box_max(idim) = box_ckey_max_d(idim, level+1)
  end do

  do idim = 1, ndim
     xs = (xp(ipart + (idim-1)*leading) + skip(idim)) * dx_inv + shift
     ix(idim) = floor(xs)
     ! Match host CIC periodic BCs: wrap within the actual computational box.
     if (ix(idim) <  box_min(idim)) ix(idim) = box_max(idim) - 1
     if (ix(idim) >= box_max(idim)) ix(idim) = box_min(idim)
  end do

  hkey_part_d(ipart) = hilbert_key(ix, level)

end subroutine compute_hkey_part_kernel

!> One radix digit of hkey_part for the LSD sort.
attributes(global) subroutine init_prefix_sum_part_bit(hkey_part_d, swap_global_d, &
     & prefix_sum_d, head_idx, num_parts, ibit)
  integer(kind=8), device :: hkey_part_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: ibit

  integer :: thread_idx, block_idx, idx, old_idx

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1

  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx

  old_idx = swap_global_d(idx)
  prefix_sum_d(idx) = int(ibits(hkey_part_d(old_idx), ibit, 1), kind=4)

end subroutine init_prefix_sum_part_bit

attributes(global) subroutine write_sortp_part(sortp_d, swap_global_d, &
     & head_idx, num_parts)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=4), device :: swap_global_d(*)
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts

  integer :: thread_idx, block_idx, idx
  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  idx = head_idx + idx
  sortp_d(idx) = swap_global_d(idx)
end subroutine write_sortp_part

!> GPU sort_part.
subroutine gpu_sort_part(sim, ilevel)
  use nvtx
  use cub_module, only: radix_sort
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       & compute_local_swap_table, update_global_swap_table
  implicit none
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, tail_idx, num_parts, val
  integer :: num_threads, num_blocks, nblks
  integer, parameter :: nrnd = 16, nthr = 128
  integer :: ibit, level
  real(kind=8) :: dx, dx_inv, shift
  character(len=32) :: nvtx_lbl

  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  num_threads = 128
  num_blocks = (num_parts + num_threads - 1) / num_threads

  level = ilevel
  dx = sim%r%boxlen/2**level
  dx_inv = 1d0 / dx

  ! The shifted-source deposits (part_dep_algo=2 medium, 3 small) sort by the
  ! half-cell shifted source cell (upper corner of the 2x2x2 CIC block). The
  ! +1/2 shift can push the source cell to the upper edge of the computational
  ! box, which is wrapped back to box_ckey_min before keying (GPU runs are
  ! periodic). The large deposit (1) is unshifted.
  if (sim%r%part_dep_algo >= 2) then
     shift = 0.5_dp
  else
     shift = 0.0_dp
  end if

  call nvtxStartRange("gpu_sort_part", color=4) ! purple
  ! Compute Hilbert keys and store them in idp_swap
  call nvtxStartRange("gpu_sort_part:hkey", color=4)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(xp, idp_swap, &
       & box_ckey_min, box_ckey_max, d_skip, dx_inv, head_idx, num_parts, &
       & int(sim%r%npartmax,8), level, shift)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

#if defined(CUB_SORT_PART)
  ! generate the input sequence [head_idx ... head_idx + num_parts - 1]
  nblks = (((num_parts + nrnd - 1)/nrnd) + nthr - 1)/nthr
  call init_global_swap_table_kernel_u8<<<nblks,nthr>>>(isp_swap, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! idp_swap has keys to sort by. isp_swap is the input indices sequence
  ! sortp has the sorted indices. hkeyp will have the sorted keys. we don't
  ! need sorted keys but cub requires no overlap on input and output buffers.
  call radix_sort(c_loc(idp_swap(head_idx)), c_loc(hkeyp(head_idx)), &
                & c_loc(isp_swap(head_idx)), c_loc(sortp(head_idx)), &
                & head_idx, num_parts, 0, ndim * level)
#else
  ! Init sortp
  call nvtxStartRange("gpu_sort_part:init_sortp", color=4)
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(sortp, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Loop over bits (one NVTX range per radix pass; kernels visible in CUDA row)
  do ibit = 0, ndim * level - 1

     write(nvtx_lbl, '(A,I0)') 'gpu_sort_part:bit_', ibit
     call nvtxStartRange(trim(nvtx_lbl), color=4)

     ! Init prefix sum based on Hilbert key bit value
     call init_prefix_sum_part_bit<<<num_blocks, num_threads>>>(idp_swap, &
          & sortp, prefix_sum, head_idx, num_parts, ibit)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Compute prefix sum
     call gpu_scan(prefix_sum, head_idx, num_parts)

     ! Compute sorted indices
     call compute_local_swap_table<<<num_blocks, num_threads>>>(isp_swap, &
          & sortp, prefix_sum, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Store back to sortp
     call update_global_swap_table<<<num_blocks, num_threads>>>(sortp, &
          & isp_swap, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     call nvtxEndRange()
  end do
#endif
  call nvtxEndRange()

end subroutine gpu_sort_part

subroutine gpu_sort_star(sim, ilevel)
  use nvtx
  use cub_module, only: radix_sort
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       & compute_local_swap_table, update_global_swap_table
  implicit none
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, tail_idx, num_parts, val
  integer :: num_threads, num_blocks, nblks
  integer, parameter :: nrnd = 16, nthr = 128
  integer :: ibit, level
  real(kind=8) :: dx, dx_inv, shift
  character(len=32) :: nvtx_lbl

  head_idx = sim%star%headp(ilevel)
  tail_idx = sim%star%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  num_threads = 128
  num_blocks = (num_parts + num_threads - 1) / num_threads

  level = ilevel
  dx = sim%r%boxlen/2**level
  dx_inv = 1d0 / dx

  ! The shifted-source deposits (part_dep_algo=2 medium, 3 small) sort by the
  ! half-cell shifted source cell (upper corner of the 2x2x2 CIC block). The
  ! +1/2 shift can push the source cell to the upper edge of the computational
  ! box, which is wrapped back to box_ckey_min before keying (GPU runs are
  ! periodic). The large deposit (1) is unshifted.
  if (sim%r%star_dep_algo >= 2) then
     shift = 0.5_dp
  else
     shift = 0.0_dp
  end if

  call nvtxStartRange("gpu_sort_star", color=4) ! purple
  ! Compute Hilbert keys and store them in idp_swap
  call nvtxStartRange("gpu_sort_star:hkey", color=4)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(star_xp, idp_swap, &
       & box_ckey_min, box_ckey_max, d_skip, dx_inv, head_idx, num_parts, &
       & int(sim%r%nstarmax,8), level, shift)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

#if defined(CUB_SORT_PART)
  ! generate the input sequence [head_idx ... head_idx + num_parts - 1]
  nblks = (((num_parts + nrnd - 1)/nrnd) + nthr - 1)/nthr
  call init_global_swap_table_kernel_u8<<<nblks,nthr>>>(isp_swap, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! idp_swap has keys to sort by. isp_swap is the input indices sequence
  ! sortp has the sorted indices. hkeyp will have the sorted keys. we don't
  ! need sorted keys but cub requires no overlap on input and output buffers.
  call radix_sort(c_loc(idp_swap(head_idx)), c_loc(hkeyp(head_idx)), &
                & c_loc(isp_swap(head_idx)), c_loc(star_sortp(head_idx)), &
                & head_idx, num_parts, 0, ndim * level)
#else
  ! Init sortp
  call nvtxStartRange("gpu_sort_star:init_sortp", color=4)
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(star_sortp, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Loop over bits (one NVTX range per radix pass; kernels visible in CUDA row)
  do ibit = 0, ndim * level - 1

     write(nvtx_lbl, '(A,I0)') 'gpu_sort_star:bit_', ibit
     call nvtxStartRange(trim(nvtx_lbl), color=4)

     ! Init prefix sum based on Hilbert key bit value
     call init_prefix_sum_part_bit<<<num_blocks, num_threads>>>(idp_swap, &
          & star_sortp, prefix_sum, head_idx, num_parts, ibit)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Compute prefix sum
     call gpu_scan(prefix_sum, head_idx, num_parts)

     ! Compute sorted indices
     call compute_local_swap_table<<<num_blocks, num_threads>>>(isp_swap, &
          & star_sortp, prefix_sum, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Store back to sortp
     call update_global_swap_table<<<num_blocks, num_threads>>>(star_sortp, &
          & isp_swap, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     call nvtxEndRange()
  end do
#endif
  call nvtxEndRange()

end subroutine gpu_sort_star

subroutine gpu_sort_sink(sim, ilevel)
  use nvtx
  use cub_module, only: radix_sort
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       & compute_local_swap_table, update_global_swap_table
  implicit none
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, tail_idx, num_parts, val
  integer :: num_threads, num_blocks, nblks
  integer, parameter :: nrnd = 16, nthr = 128
  integer :: ibit, level
  real(kind=8) :: dx, dx_inv, shift
  character(len=32) :: nvtx_lbl

  head_idx = sim%sink%headp(ilevel)
  tail_idx = sim%sink%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  num_threads = 128
  num_blocks = (num_parts + num_threads - 1) / num_threads

  level = ilevel
  dx = sim%r%boxlen/2**level
  dx_inv = 1d0 / dx

  ! The shifted-source deposits (part_dep_algo=2 medium, 3 small) sort by the
  ! half-cell shifted source cell (upper corner of the 2x2x2 CIC block). The
  ! +1/2 shift can push the source cell to the upper edge of the computational
  ! box, which is wrapped back to box_ckey_min before keying (GPU runs are
  ! periodic). The large deposit (1) is unshifted.
  if (sim%r%sink_dep_algo >= 2) then
     shift = 0.5_dp
  else
     shift = 0.0_dp
  end if

  call nvtxStartRange("gpu_sort_sink", color=4) ! purple
  ! Compute Hilbert keys and store them in idp_swap
  call nvtxStartRange("gpu_sort_sink:hkey", color=4)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(sink_xp, idp_swap, &
       & box_ckey_min, box_ckey_max, d_skip, dx_inv, head_idx, num_parts, &
       & int(sim%r%nsinkmax,8), level, shift)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

#if defined(CUB_SORT_PART)
  ! generate the input sequence [head_idx ... head_idx + num_parts - 1]
  nblks = (((num_parts + nrnd - 1)/nrnd) + nthr - 1)/nthr
  call init_global_swap_table_kernel_u8<<<nblks,nthr>>>(isp_swap, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! idp_swap has keys to sort by. isp_swap is the input indices sequence
  ! sortp has the sorted indices. hkeyp will have the sorted keys. we don't
  ! need sorted keys but cub requires no overlap on input and output buffers.
  call radix_sort(c_loc(idp_swap(head_idx)), c_loc(hkeyp(head_idx)), &
                & c_loc(isp_swap(head_idx)), c_loc(sink_sortp(head_idx)), &
                & head_idx, num_parts, 0, ndim * level)
#else
  ! Init sortp
  call nvtxStartRange("gpu_sort_sink:init_sortp", color=4)
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(sink_sortp, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Loop over bits (one NVTX range per radix pass; kernels visible in CUDA row)
  do ibit = 0, ndim * level - 1

     write(nvtx_lbl, '(A,I0)') 'gpu_sort_sink:bit_', ibit
     call nvtxStartRange(trim(nvtx_lbl), color=4)

     ! Init prefix sum based on Hilbert key bit value
     call init_prefix_sum_part_bit<<<num_blocks, num_threads>>>(idp_swap, &
          & sink_sortp, prefix_sum, head_idx, num_parts, ibit)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Compute prefix sum
     call gpu_scan(prefix_sum, head_idx, num_parts)

     ! Compute sorted indices
     call compute_local_swap_table<<<num_blocks, num_threads>>>(isp_swap, &
          & sink_sortp, prefix_sum, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Store back to sortp
     call update_global_swap_table<<<num_blocks, num_threads>>>(sink_sortp, &
          & isp_swap, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     call nvtxEndRange()
  end do
#endif
  call nvtxEndRange()

end subroutine gpu_sort_sink

!> GPU sort_part for cores, with the stable key of the host sort_part.
subroutine gpu_sort_core(sim, ilevel)
  use nvtx
  use cub_module, only: radix_sort
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       & compute_local_swap_table, update_global_swap_table
  implicit none
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, nblks
  integer, parameter :: nrnd = 16, nthr = 128
  integer :: ibit, level
  real(kind=8) :: dx, dx_inv, shift
  character(len=32) :: nvtx_lbl

  head_idx = sim%core%headp(ilevel)
  tail_idx = sim%core%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  num_threads = 128
  num_blocks = (num_parts + num_threads - 1) / num_threads

  ! Hilbert key at level ilevel-1 (at least 1), as sort_part, so that
  ! gpu_split_core keeps the host order. Cores use the unshifted large deposit.
  level = max(ilevel - 1, 1)
  dx = sim%r%boxlen/2**level
  dx_inv = 1d0 / dx
  shift = 0.0_dp

  call nvtxStartRange("gpu_sort_core", color=4) ! purple
  ! Compute Hilbert keys and store them in idp_swap
  call nvtxStartRange("gpu_sort_core:hkey", color=4)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(core_xp, idp_swap, &
       & box_ckey_min, box_ckey_max, d_skip, dx_inv, head_idx, num_parts, &
       & int(sim%r%ncoremax,8), level, shift)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

#if defined(CUB_SORT_PART)
  ! generate the input sequence [head_idx ... head_idx + num_parts - 1]
  nblks = (((num_parts + nrnd - 1)/nrnd) + nthr - 1)/nthr
  call init_global_swap_table_kernel_u8<<<nblks,nthr>>>(isp_swap, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! idp_swap has keys to sort by. isp_swap is the input indices sequence
  ! sortp has the sorted indices. hkeyp will have the sorted keys. we don't
  ! need sorted keys but cub requires no overlap on input and output buffers.
  call radix_sort(c_loc(idp_swap(head_idx)), c_loc(hkeyp(head_idx)), &
                & c_loc(isp_swap(head_idx)), c_loc(core_sortp(head_idx)), &
                & head_idx, num_parts, 0, ndim * level)
#else
  ! Init sortp
  call nvtxStartRange("gpu_sort_core:init_sortp", color=4)
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(core_sortp, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Loop over bits (one NVTX range per radix pass; kernels visible in CUDA row)
  do ibit = 0, ndim * level - 1

     write(nvtx_lbl, '(A,I0)') 'gpu_sort_core:bit_', ibit
     call nvtxStartRange(trim(nvtx_lbl), color=4)

     ! Init prefix sum based on Hilbert key bit value
     call init_prefix_sum_part_bit<<<num_blocks, num_threads>>>(idp_swap, &
          & core_sortp, prefix_sum, head_idx, num_parts, ibit)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Compute prefix sum
     call gpu_scan(prefix_sum, head_idx, num_parts)

     ! Compute sorted indices
     call compute_local_swap_table<<<num_blocks, num_threads>>>(isp_swap, &
          & core_sortp, prefix_sum, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Store back to sortp
     call update_global_swap_table<<<num_blocks, num_threads>>>(core_sortp, &
          & isp_swap, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     call nvtxEndRange()
  end do
#endif
  call nvtxEndRange()

end subroutine gpu_sort_core

subroutine gpu_sort_tree(sim, ilevel)
  use nvtx
  use cub_module, only: radix_sort
  use ramses_commons, only: ramses_t
  use refine_device, only: init_global_swap_table_kernel, &
       & compute_local_swap_table, update_global_swap_table
  implicit none
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, nblks
  integer, parameter :: nrnd = 16, nthr = 128
  integer :: ibit, level
  real(kind=8) :: dx, dx_inv, shift
  character(len=32) :: nvtx_lbl

  head_idx = sim%tree%headp(ilevel)
  tail_idx = sim%tree%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  num_threads = 128
  num_blocks = (num_parts + num_threads - 1) / num_threads

  level = ilevel
  dx = sim%r%boxlen/2**level
  dx_inv = 1d0 / dx

  ! Trees are massless and never deposited: unshifted Hilbert sort
  shift = 0.0_dp

  call nvtxStartRange("gpu_sort_tree", color=4) ! purple
  ! Compute Hilbert keys and store them in idp_swap
  call nvtxStartRange("gpu_sort_tree:hkey", color=4)
  call compute_hkey_part_kernel<<<num_blocks, num_threads>>>(tree_xp, idp_swap, &
       & box_ckey_min, box_ckey_max, d_skip, dx_inv, head_idx, num_parts, &
       & int(sim%r%ntreemax,8), level, shift)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

#if defined(CUB_SORT_PART)
  ! generate the input sequence [head_idx ... head_idx + num_parts - 1]
  nblks = (((num_parts + nrnd - 1)/nrnd) + nthr - 1)/nthr
  call init_global_swap_table_kernel_u8<<<nblks,nthr>>>(isp_swap, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)

  ! idp_swap has keys to sort by. isp_swap is the input indices sequence
  ! sortp has the sorted indices. hkeyp will have the sorted keys. we don't
  ! need sorted keys but cub requires no overlap on input and output buffers.
  call radix_sort(c_loc(idp_swap(head_idx)), c_loc(hkeyp(head_idx)), &
                & c_loc(isp_swap(head_idx)), c_loc(tree_sortp(head_idx)), &
                & head_idx, num_parts, 0, ndim * level)
#else
  ! Init sortp
  call nvtxStartRange("gpu_sort_tree:init_sortp", color=4)
  call init_global_swap_table_kernel<<<num_blocks, num_threads>>>(tree_sortp, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Loop over bits (one NVTX range per radix pass; kernels visible in CUDA row)
  do ibit = 0, ndim * level - 1

     write(nvtx_lbl, '(A,I0)') 'gpu_sort_tree:bit_', ibit
     call nvtxStartRange(trim(nvtx_lbl), color=4)

     ! Init prefix sum based on Hilbert key bit value
     call init_prefix_sum_part_bit<<<num_blocks, num_threads>>>(idp_swap, &
          & tree_sortp, prefix_sum, head_idx, num_parts, ibit)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Compute prefix sum
     call gpu_scan(prefix_sum, head_idx, num_parts)

     ! Compute sorted indices
     call compute_local_swap_table<<<num_blocks, num_threads>>>(isp_swap, &
          & tree_sortp, prefix_sum, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     ! Store back to sortp
     call update_global_swap_table<<<num_blocks, num_threads>>>(tree_sortp, &
          & isp_swap, head_idx, num_parts)
     call GPU_Error_Check(__FILE__, __LINE__)

     call nvtxEndRange()
  end do
#endif
  call nvtxEndRange()

end subroutine gpu_sort_tree

!> Multipole reduction over [1, npart]: q(1)=sum(mp), q(idim+1)=sum(mp*xp).
attributes(global) subroutine multipole_q_kernel(xp_d, mp_d, multipole_q_d, &
     & head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: num_parts, head_idx
  integer(kind=8), intent(in), value :: leading
  real(kind=dp), device :: xp_d(*)
  real(kind=dp), device :: mp_d(*)
  real(kind=8), device :: multipole_q_d(1:ndim+1)

  integer :: thread_idx, block_idx, ipart, idim, info
  real(kind=8) :: q_loc(1:ndim+1)

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  ipart = head_idx + thread_idx + block_idx * blockDim%x

  q_loc = 0.0_dp
  if (ipart <= num_parts) then
     q_loc(1) = mp_d(ipart)
     do idim = 1, ndim
        q_loc(idim+1) = mp_d(ipart) * xp_d(ipart + (idim-1)*leading)
     end do
  endif

  do idim = 1, ndim+1
     q_loc(idim) = block_reduce_sum(q_loc(idim))
  end do

  if (threadIdx%x == 1) then
     do idim = 1, ndim+1
        info = atomicadd(multipole_q_d(idim), q_loc(idim))
     end do
  endif

end subroutine multipole_q_kernel

!> Per-level reduction of particle velocities for the Courant condition:
!> vmax = MAX |vp|, ekin = SUM 0.5 * mp * |vp|^2 over ipart in
!> [head_idx, head_idx+num_parts-1].
attributes(global) subroutine gpu_newdt_part_kernel(vp_d, mp_d, &
     & vmax_d, ekin_d, head_idx, num_parts, leading)
  integer(kind=4), intent(in), value :: head_idx, num_parts
  integer(kind=8), intent(in), value :: leading
  real(kind=dp),   device :: vp_d(*), mp_d(*)
  real(kind=8),    device :: vmax_d
  real(kind=8),    device :: ekin_d

  integer :: thread_idx, block_idx, ipart, idim, info
  real(kind=8) :: vmax_local, ekin_local, v, av, mi

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  ipart = head_idx + thread_idx + block_idx * blockDim%x

  vmax_local = 0.0_dp
  ekin_local = 0.0_dp
  if (ipart <= head_idx + num_parts - 1) then
     mi = mp_d(ipart)
     do idim = 1, ndim
        v  = vp_d(ipart + (idim-1)*leading)
        av = abs(v)
        if (av > vmax_local) vmax_local = av
        ekin_local = ekin_local + 0.5_dp * mi * v * v
     end do
  endif

  ! Block reductions: every thread in the block must reach these calls
  ! (they call syncthreads() internally). Threads past num_parts have
  ! contributed the neutral elements (0.0_dp) above and don't read OOB.
  vmax_local = block_reduce_max(vmax_local)
  ekin_local = block_reduce_sum(ekin_local)

  if (threadIdx%x == 1) then
     info = atomicadd(ekin_d, ekin_local)
     info = atomicmax(vmax_d, vmax_local)
  endif

end subroutine gpu_newdt_part_kernel

!> CIC mass deposit over sortp(head_idx:head_idx+num_parts-1).
!>
!> gpu_sort_part has sorted this range at depth ilevel, so particles sharing a
!> source cell appear in contiguous runs of sortp. The kernel is launched at
!> 256 threads/block = 8 warps/block, so each warp owns 32 consecutive slots
!> of the sorted window. Inside a warp, lanes split into "segments" -- maximal
!> runs of adjacent lanes whose source-cell key (the packed combined word each
!> lane builds at the top of the kernel) agrees. A uniform warp is one 32-lane
!> segment; a warp straddling a cell boundary contains two; OOD/OOB lanes
!> (combined == 0) cluster into a zero-segment that contributes nothing.
!>
!> For each of the threetondim = 3^ndim stencil offsets k:
!>   1) each lane forms its own CIC contribution (mp * w / vol_loc for rho;
!>      w for nref) from its fractional position -- no hashing here;
!>   2) an inclusive segmented Hillis-Steele scan along the warp accumulates
!>      each segment's contributions so the tail lane holds the segment sum;
!>   3) the tail lane hashes the segment's (shared) destination cell -- once,
!>      not once per lane -- and emits one atomicAdd per segment with
!>      non-zero, in-domain contribution.
!>
!> The result: one atomic per (warp, segment, stencil-offset) -- typically
!> just one atomic per warp per offset, because most warps are uniform.
!>
!> Note on the stencil width. The host's CIC uses a 2-cell stencil per axis
!> (left or right neighbour depending on the fractional position). The GPU
!> expresses it as a 3-cell stencil per axis with the "wrong-side" cell
!> carrying weight zero. That removes per-lane branching and lets the
!> zero-weight lanes drop out of the segmented scan silently.
attributes(global) subroutine cic_part_large_kernel(sortp_d, &
     & head_idx, num_parts, &
     & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     & box_ckey_min_d, box_ckey_max_d, periodic_d, &
     & xp_d, mp_d, rho_d, nref_d, &
     & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, star, &
     & m_refine_at_level, mass_cut_refine, ilevel, leading)
  logical, intent(in), value :: star
  integer(kind=4), intent(in), value :: head_idx, num_parts, ilevel
  integer(kind=8), intent(in), value :: leading
  integer(kind=4), device :: sortp_d(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  logical,         device :: periodic_d(1:3)
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  real(kind=dp),   device :: rho_d (1:twotondim, *)
  real(kind=dp),   device :: nref_d(1:twotondim, *)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_loc, vol_loc
  real(kind=8), intent(in), value :: m_refine_at_level, mass_cut_refine
  real(kind=8), intent(in), value :: mass_sph

  integer :: tid_local, lane, warp_local, warps_per_block, warp_global, slot_global
  integer :: ipart, idim, k, info
  integer :: icell_src_lane, igrid_src_lane
  integer :: ox, oy, oz, dst_igrid_lane, dst_icell_lane
  integer(kind=8) :: combined, prev_combined, next_combined
  integer(kind=4) :: head_acc, other_head, scan_iter, scan_offset
  integer(kind=4) :: src_full_ckey(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, hkey_offset, key, ix8, iy8, iz8
  logical :: valid_lane, in_domain, is_head, is_tail
  real(kind=8) :: my_rho, my_nref, mp_i, other_rho, other_nref
  real(kind=8) :: skip(1:3), xs, frac(1:3)
  real(kind=8) :: wx(0:2), wy(0:2), wz(0:2), w

  ! ------------------------------------------------------------------
  ! Lane bookkeeping: map (block, thread) -> (warp, lane, slot_global).
  ! slot_global is 1-based into the sortp(head_idx..) window (Fortran
  ! convention). valid_lane is .false. for lanes past num_parts.
  ! ------------------------------------------------------------------
  tid_local       = threadIdx%x - 1
  warps_per_block = blockDim%x / warpsize        ! 256 / 32 = 8
  warp_local      = tid_local / warpsize
  lane            = mod(tid_local, warpsize)
  warp_global     = (blockIdx%x - 1) * warps_per_block + warp_local
  slot_global     = warp_global * warpsize + lane + 1

  valid_lane = (slot_global <= num_parts)

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  ! Hash geometry at level ilevel (grid(:) stores the parent octs there).
  nx          = int(ckey_max_d(ilevel), kind=8)
  hkey_offset = key_off_d(ilevel)

  ! ------------------------------------------------------------------
  ! Per-lane source-cell geometry (fused from the former build_src_part_kernel
  ! pass). Each lane reads its own particle through sortp -- no isp_swap round
  ! trip -- and derives everything the deposit needs straight from xp:
  !   * src_full_ckey = floor((xp+skip)/dx_loc), the level-ilevel source cell;
  !   * frac, the in-cell fractional position that sets the CIC weights;
  !   * combined = packed (igrid, icell) of the parent oct, from a single
  !     hash_get, which both identifies the source cell for segment detection
  !     and carries the out-of-domain sentinel.
  ! Folding the build pass in here removes a whole kernel launch plus the
  ! isp_swap global write/read, and lets us take src_full_ckey directly from
  ! the position instead of reading back grid(igrid)%ckey. combined == 0 marks
  ! an out-of-domain particle (hash miss); OOD lanes and out-of-bounds (OOB)
  ! tail lanes share that zero word and group into one zero-segment.
  ! ------------------------------------------------------------------
  ipart          = 0
  combined       = 0_8
  icell_src_lane = 0
  igrid_src_lane = 0
  mp_i           = 0.0_dp
  frac           = 0.0_dp
  src_full_ckey  = 0
  if (valid_lane) then
     ipart = sortp_d(head_idx + slot_global - 1)
     mp_i  = mp_d(ipart)

     ! Level-ilevel source cell key and the in-cell fractional position. This
     ! is the same level-ilevel cell the old build pass found, but taken
     ! straight from the position rather than rebuilt from grid(igrid)%ckey.
     do idim = 1, ndim
        xs = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
        src_full_ckey(idim) = floor(xs)
        frac(idim) = xs - src_full_ckey(idim)
     end do

     ! Split the source cell into (parent oct ckey, in-oct cell) and hash the
     ! parent oct -- the same decomposition the deposit uses for destinations.
     father_ckey = src_full_ckey / 2
     ii          = src_full_ckey - 2 * father_ckey
     icell_src_lane = 1
     do idim = 1, ndim
        icell_src_lane = icell_src_lane + ii(idim) * (2**(idim-1))
     end do
     ix8 = int(father_ckey(1), kind=8)
     iy8 = int(father_ckey(2), kind=8)
     iz8 = int(father_ckey(3), kind=8)
     key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
     igrid_src_lane = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

     if (igrid_src_lane == 0) then
        ! Parent oct not materialised on this rank: drop the lane into the
        ! zero-segment (matches the old build pass writing the 0 sentinel).
        valid_lane    = .false.
        mp_i          = 0.0_dp
        frac          = 0.0_dp
        src_full_ckey = 0
     else
        combined = ior(ishft(int(igrid_src_lane, kind=8), 5), int(icell_src_lane, kind=8))
     endif
  endif

  ! ------------------------------------------------------------------
  ! 1D CIC weights expressed on a 3-cell stencil per axis. For f in [0, 1):
  !   f < 1/2:  w(-1) = 1/2 - f,  w(0) = 1/2 + f,  w(+1) = 0
  !   f >= 1/2: w(-1) = 0,        w(0) = 3/2 - f,  w(+1) = f - 1/2
  ! This is the textbook 2-cell CIC with the "wrong-side" cell zero-padded,
  ! so we can loop over all 3^ndim offsets unconditionally and let zero
  ! weights silently drop those lanes from the segmented scan.
  ! Unused dimensions keep wy(1) = wz(1) = 1 so the 3D product also works
  ! correctly for ndim = 1 or 2.
  ! ------------------------------------------------------------------
  ! Literals are kind-8 (d0) to match the real(kind=8) weight/frac variables:
  ! dp can be single precision (NPRE==4), and mixing a real*4 _dp literal with
  ! these real*8 expressions otherwise triggers a type-conversion warning.
  wx(0) = max(0.0d0, 0.5d0 - frac(1))
  wx(1) = 1.0d0 - abs(frac(1) - 0.5d0)
  wx(2) = max(0.0d0, frac(1) - 0.5d0)
  wy = 0.0d0
  wz = 0.0d0
  wy(1) = 1.0d0
  wz(1) = 1.0d0
  if (ndim >= 2) then
     wy(0) = max(0.0d0, 0.5d0 - frac(2))
     wy(1) = 1.0d0 - abs(frac(2) - 0.5d0)
     wy(2) = max(0.0d0, frac(2) - 0.5d0)
  endif
  if (ndim >= 3) then
     wz(0) = max(0.0d0, 0.5d0 - frac(3))
     wz(1) = 1.0d0 - abs(frac(3) - 0.5d0)
     wz(2) = max(0.0d0, frac(3) - 0.5d0)
  endif

  ! ------------------------------------------------------------------
  ! Per-level box bounds. box_min/box_max bound the local tile at the deposit
  ! level (level ilevel) and drive periodic wrap / OOB rejection below. Note
  ! the box arrays store these level-ilevel cell coordinates in slot ilevel+1
  ! -- an array-indexing convention, not a finer AMR level. (nx / hkey_offset
  ! for the oct hash were set with the source geometry above.)
  ! ------------------------------------------------------------------
  box_min = 0
  box_max = 0
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, ilevel+1)
     box_max(idim) = box_ckey_max_d(idim, ilevel+1)
  end do

  ! ------------------------------------------------------------------
  ! Segment boundary detection. Adjacent-lane equality of `combined` is
  ! enough: lane L is a segment head iff its left neighbour disagrees (or
  ! it is lane 0); lane L is a tail iff its right neighbour disagrees (or
  ! it is lane warpsize-1). The detection is done once per warp because
  ! `combined` does not depend on the stencil offset k.
  ! __shfl_up / __shfl_down read from lane L-1 / L+1 within the warp;
  ! the explicit (lane == 0) / (lane == warpsize-1) clauses cover the
  ! out-of-range boundaries.
  ! ------------------------------------------------------------------
  prev_combined = __shfl_up  (combined, 1)
  next_combined = __shfl_down(combined, 1)
  is_head = (lane == 0)              .or. (combined /= prev_combined)
  is_tail = (lane == warpsize - 1)   .or. (combined /= next_combined)

  ! ------------------------------------------------------------------
  ! Stencil loop: iterate over the 3^ndim offsets (ox, oy, oz) in {-1, 0, +1}.
  ! Per offset: each lane computes its own destination + contribution, the
  ! warp runs a segmented inclusive scan, and each segment's tail emits at
  ! most one atomicAdd into rho (and one into nref, if gated).
  do k = 1, threetondim
     ! Decode the linear index k = 1..27 into mixed-radix-3 offsets.
     ox = mod(k - 1, 3) - 1
     oy = mod((k - 1) / 3, 3) - 1
     oz = (k - 1) / 9 - 1

     ! Per-lane CIC contribution for this stencil offset. The weight depends
     ! on each lane's own fractional position, so every valid lane computes
     ! it; invalid lanes keep my_rho = my_nref = 0 and drop out of the scan.
     ! No destination gate here: if a lane's segment lands on an off-rank or
     ! out-of-domain cell, its accumulated contribution is simply never
     ! emitted, because emission is gated on the (segment-uniform) tail lookup.
     my_rho  = 0.0_dp
     my_nref = 0.0_dp
     if (valid_lane) then
        ! CIC weight = product of 1D weights at offset (ox, oy, oz). Only
        ! 2**ndim of the 3**ndim offsets are non-zero for a given particle
        ! (8 of 27 in 3D); zero-weight lanes join the scan contributing nothing.
        w = wx(ox+1) * wy(oy+1) * wz(oz+1)
        if (w > 0.0_dp) then
           my_rho = mp_i * w / vol_loc
           if (m_refine_at_level >= 0.0_dp) then
              if (.not. star) then
                 ! nref follows the host refinement gate: either all masses count
                 ! (mass_cut_refine <= 0), or only particles below mass_cut_refine.
                 if (mass_cut_refine > 0.0_dp) then
                    if (mp_i < mass_cut_refine) then
                       my_nref = w
                    endif
                 else
                    my_nref = w
                 endif
              else
                 my_nref = mp_i * w / mass_sph
              endif
           endif
        endif
     endif

     ! Destination cell. Lanes in one segment share the source cell, so at a
     ! fixed offset k they all map to the SAME destination oct -- the hash is
     ! segment-uniform. Only the tail lane emits the segment's atomic, so only
     ! the tail needs the destination: hash on the tail alone and skip the
     ! expensive hash_get on the segment's other (up to warpsize-1) lanes.
     dst_igrid_lane = 0
     dst_icell_lane = 0
     if (is_tail .and. valid_lane) then
        ! Target cell key at level ilevel = source key + stencil offset.
        target_ckey = 0
        target_ckey(1) = src_full_ckey(1) + ox
        if (ndim >= 2) target_ckey(2) = src_full_ckey(2) + oy
        if (ndim >= 3) target_ckey(3) = src_full_ckey(3) + oz

        ! Boundary handling. Periodic axes wrap within the deposit-level box;
        ! a non-periodic out-of-bounds target leaves dst_igrid_lane = 0, which
        ! suppresses the atomic via the dst_igrid_lane /= 0 guard below.
        in_domain = .true.
        do idim = 1, ndim
           if (periodic_d(idim)) then
              if (target_ckey(idim) < box_min(idim))  target_ckey(idim) = box_max(idim) - 1
              if (target_ckey(idim) >= box_max(idim)) target_ckey(idim) = box_min(idim)
           else
              if (target_ckey(idim) < box_min(idim))  in_domain = .false.
              if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
           endif
        end do
        if (in_domain) then
           ! Same decomposition as for the source cell above: pull the parent
           ! oct's ckey and the in-oct child index out of the level-ilevel
           ! target ckey, then hash the parent oct.
           father_ckey = target_ckey / 2
           ii = target_ckey - 2 * father_ckey
           dst_icell_lane = 1
           do idim = 1, ndim
              dst_icell_lane = dst_icell_lane + ii(idim) * (2**(idim-1))
           end do
           ix8 = int(father_ckey(1), kind=8)
           iy8 = int(father_ckey(2), kind=8)
           iz8 = int(father_ckey(3), kind=8)
           key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
           ! hash_get returns 0 if the destination oct is not present on this
           ! rank, which again suppresses the atomic for this segment.
           dst_igrid_lane = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
        endif
     endif

     ! ---------------------------------------------------------------
     ! Segmented inclusive Hillis-Steele scan along the warp.
     !
     ! head_acc starts at 1 on segment heads, 0 elsewhere, and is OR'd up
     ! the warp via __shfl_up in lock-step with the values. At iteration s
     ! (scan_offset = 2^s), each lane looks back 2^s positions:
     !   - if its lookback has not yet crossed a head (head_acc == 0), the
     !     value 2^s back is still inside this segment -- fold it in;
     !   - once a head is encountered (head_acc flips to 1), further
     !     additions are skipped: the lane has summed from its segment's
     !     head through itself and is done.
     ! After 5 iterations (covering offsets 1, 2, 4, 8, 16) every lane in
     ! a warp holds the inclusive segment sum from its segment's head up
     ! through itself; in particular, the segment tail holds the total.
     ! The (lane >= scan_offset) guard handles low-lane positions whose
     ! __shfl_up source would be out of warp range.
     ! ---------------------------------------------------------------
     if (is_head) then
        head_acc = 1
     else
        head_acc = 0
     endif
     do scan_iter = 0, 4
        scan_offset = ishft(1, scan_iter)        ! 1, 2, 4, 8, 16
        other_rho  = __shfl_up(my_rho,   scan_offset)
        other_nref = __shfl_up(my_nref,  scan_offset)
        other_head = __shfl_up(head_acc, scan_offset)
        if (lane >= scan_offset) then
           if (head_acc == 0) then
              my_rho  = my_rho  + other_rho
              my_nref = my_nref + other_nref
           endif
           head_acc = ior(head_acc, other_head)
        endif
     end do

     ! ---------------------------------------------------------------
     ! Tail emission: one atomicAdd per segment per stencil offset.
     ! The triple guard is sharp:
     !   is_tail            -- exactly one lane per segment;
     !   valid_lane         -- skip OOD / OOB zero-segments;
     !   dst_igrid_lane /= 0 -- skip off-rank destinations.
     ! The my_rho / my_nref != 0 checks save no-op atomics on segments
     ! whose total at this k is identically zero (e.g. an entire segment
     ! sitting on the wrong side of the stencil).
     ! ---------------------------------------------------------------
     if (is_tail .and. valid_lane .and. dst_igrid_lane /= 0) then
        if (my_rho /= 0.0_dp) then
           info = atomicadd(rho_d(dst_icell_lane, dst_igrid_lane), real(my_rho, kind=dp))
        endif
        if (m_refine_at_level >= 0.0_dp .and. my_nref /= 0.0_dp) then
           info = atomicadd(nref_d(dst_icell_lane, dst_igrid_lane), real(my_nref, kind=dp))
        endif
     endif
  end do

end subroutine cic_part_large_kernel

!> Host dispatcher for the GPU CIC mass deposit at level ilevel.
!>
!> Pipeline:
!>   1. If rtype is not 0 or 1, bail out (matches the host's deposition guard).
!>   2. On the coarsest active level only, launch multipole_q_kernel to
!>      accumulate the global monopole and dipole (q_0 = sum mp, q_alpha =
!>      sum mp * xp_alpha) over the full particle table.
!>   3. Launch cic_part_large_kernel over sortp(head_idx..head_idx+num_parts-1)
!>      to deposit into rho and nref via a per-warp segmented Hillis-Steele
!>      scan. Each lane builds its own source map (parent-oct hash + packed
!>      (igrid, icell)) from xp at the top of the kernel -- the former separate
!>      build_src_part_kernel pass and its isp_swap source map are folded in.
!>
!> Preconditions:
!>   - gpu_sort_part has just run at depth ilevel, so sortp groups particles
!>     that share a source cell into contiguous runs. The deposit kernel does
!>     not re-sort -- it relies on this grouping to keep most warps uniform
!>     (one segment, one atomic per stencil offset).
!>   - The deposit cells are at level ilevel (side dx_loc = boxlen/2**ilevel),
!>     where the CIC weights are formed -- the same level the host cic_part
!>     uses. (The per-level box arrays index these cell coordinates at slot
!>     ilevel+1, an array convention only.) Particle ownership runs from
!>     head_idx = p%headp(ilevel) through p%tailp(nlevelmax), so the range
!>     covers every particle at or below ilevel (matching the host cic_part
!>     loop bounds).
subroutine gpu_cic_part_large(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! If not ALL and not DM return
  if (rtype /= 0 .and. rtype /= 1) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%p%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%p%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_part_large:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(xp, mp, q_d, &
          & 1, sim%p%npart, int(sim%r%npartmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  ! Geometry. dx_loc = boxlen/2**ilevel is the deposit CELL side at level
  ! ilevel (the host's "mesh spacing at level ilevel"); the parent oct spans
  ! 2*dx_loc. vol_loc = dx_loc**ndim is the level-ilevel cell volume used to
  ! convert mass to density. skip(:) recentres positions on this rank's tile.
  dx_loc  = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Single-pass warp-segmented CIC deposit. 256 threads/block = 8 warps/block;
  ! each warp owns 32 contiguous slots of sortp and emits roughly one
  ! atomicAdd per stencil offset (more on cell boundaries). The former build
  ! pass (which hashed each particle's parent oct into the isp_swap source map)
  ! is now folded into this kernel: every lane derives its source cell, frac
  ! position, and packed (igrid, icell) directly from xp, so no isp_swap
  ! write/read round trip or grid(igrid)%ckey read is needed.
  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_part_large:deposit", color=4)
  call cic_part_large_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & xp, mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, 1d0, .false., &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, int(sim%r%npartmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_cic_part_large

subroutine gpu_cic_star_large(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3, mass_sph
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! If not ALL and not STAR return
  if (rtype /= 0 .and. rtype /= 2) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%star%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%star%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_star_large:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(star_xp, star_mp, q_d, &
          & 1, sim%star%npart, int(sim%r%nstarmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%star%headp(ilevel)
  tail_idx = sim%star%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  ! Geometry. dx_loc = boxlen/2**ilevel is the deposit CELL side at level
  ! ilevel (the host's "mesh spacing at level ilevel"); the parent oct spans
  ! 2*dx_loc. vol_loc = dx_loc**ndim is the level-ilevel cell volume used to
  ! convert mass to density. skip(:) recentres positions on this rank's tile.
  dx_loc = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  mass_sph = sim%r%mass_sph

  ! Single-pass warp-segmented CIC deposit. 256 threads/block = 8 warps/block;
  ! each warp owns 32 contiguous slots of sortp and emits roughly one
  ! atomicAdd per stencil offset (more on cell boundaries). The former build
  ! pass (which hashed each particle's parent oct into the isp_swap source map)
  ! is now folded into this kernel: every lane derives its source cell, frac
  ! position, and packed (igrid, icell) directly from xp, so no isp_swap
  ! write/read round trip or grid(igrid)%ckey read is needed.
  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_star_large:deposit", color=4)
  call cic_part_large_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & star_sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & star_xp, star_mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, .true., &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, int(sim%r%nstarmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_cic_star_large

subroutine gpu_cic_sink_large(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3, mass_sph
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! If not ALL and not SINK return
  if (rtype /= 0 .and. rtype /= 3) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%sink%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%sink%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_sink_large:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(sink_xp, sink_mp, q_d, &
          & 1, sim%sink%npart, int(sim%r%nsinkmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%sink%headp(ilevel)
  tail_idx = sim%sink%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  ! Geometry. dx_loc = boxlen/2**ilevel is the deposit CELL side at level
  ! ilevel (the host's "mesh spacing at level ilevel"); the parent oct spans
  ! 2*dx_loc. vol_loc = dx_loc**ndim is the level-ilevel cell volume used to
  ! convert mass to density. skip(:) recentres positions on this rank's tile.
  dx_loc = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  mass_sph = sim%r%mass_sph

  ! Single-pass warp-segmented CIC deposit. 256 threads/block = 8 warps/block;
  ! each warp owns 32 contiguous slots of sortp and emits roughly one
  ! atomicAdd per stencil offset (more on cell boundaries). The former build
  ! pass (which hashed each particle's parent oct into the isp_swap source map)
  ! is now folded into this kernel: every lane derives its source cell, frac
  ! position, and packed (igrid, icell) directly from xp, so no isp_swap
  ! write/read round trip or grid(igrid)%ckey read is needed.
  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_sink_large:deposit", color=4)
  call cic_part_large_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & sink_sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & sink_xp, sink_mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, .true., &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, int(sim%r%nsinkmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_cic_sink_large

subroutine gpu_cic_core_large(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3, mass_sph
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! If not ALL return
  if (rtype /= 0) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%core%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%core%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_core_large:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(core_xp, core_mp, q_d, &
          & 1, sim%core%npart, int(sim%r%ncoremax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%core%headp(ilevel)
  tail_idx = sim%core%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  mass_sph = sim%r%mass_sph

  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_core_large:deposit", color=4)
  call cic_part_large_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & core_sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & core_xp, core_mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, .true., &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, int(sim%r%ncoremax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_cic_core_large

!################################################################
!  GPU CIC medium-stencil deposit (part_dep_algo = 2)
!################################################################
!
!> CIC mass deposit, structured exactly like cic_part_large_kernel (per-warp
!> segmented Hillis-Steele scan + one atomicAdd per segment per offset), but
!> using the half-cell shift trick: the source cell is the UPPER corner of the
!> standard 2x2x2 CIC block, src = floor((xp+skip)/dx + 1/2), so the stencil is
!> the 2**ndim cells {src, src-1}^ndim and the loop runs over k = 1..twotondim
!> offsets instead of the 3**ndim of the large kernel. For axis offset bit b in
!> {0,1}: b=1 -> source cell (offset 0), weight = frac; b=0 -> lower neighbour
!> (offset -1), weight = 1-frac, where frac = (xp+skip)/dx + 1/2 - src. This is
!> the same 8 target cells the large kernel hits, just anchored at the upper
!> corner so no offset is ever zero-weight.
!>
!> Requires gpu_sort_part to have grouped particles by the SAME shifted source
!> cell (part_dep_algo >= 2 enables the +1/2 shift + periodic wrap in the sort),
!> so the packed (igrid, icell) segment key `combined` is uniform within a run.
!> As in the large kernel, a lane whose (shifted) source oct is not materialised
!> on this rank drops into the zero-segment; for a single-rank periodic domain
!> the wrapped source cell is always present, so no particle is dropped.
attributes(global) subroutine cic_part_medium_kernel(sortp_d, &
     & head_idx, num_parts, &
     & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     & box_ckey_min_d, box_ckey_max_d, &
     & xp_d, mp_d, rho_d, nref_d, &
     & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, star, &
     & m_refine_at_level, mass_cut_refine, ilevel, leading)
  logical, intent(in), value :: star
  integer(kind=4), intent(in), value :: head_idx, num_parts, ilevel
  integer(kind=8), intent(in), value :: leading
  integer(kind=4), device :: sortp_d(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  real(kind=dp),   device :: rho_d (1:twotondim, *)
  real(kind=dp),   device :: nref_d(1:twotondim, *)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_loc, vol_loc
  real(kind=8), intent(in), value :: m_refine_at_level, mass_cut_refine
  real(kind=8), intent(in), value :: mass_sph

  integer :: tid_local, lane, warp_local, warps_per_block, warp_global, slot_global
  integer :: ipart, idim, k, info
  integer :: icell_src_lane, igrid_src_lane
  integer :: bx, by, bz, dst_igrid_lane, dst_icell_lane
  integer(kind=8) :: combined, prev_combined, next_combined
  integer(kind=4) :: head_acc, other_head, scan_iter, scan_offset
  integer(kind=4) :: src_full_ckey(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, hkey_offset, key, ix8, iy8, iz8
  logical :: valid_lane, is_head, is_tail
  real(kind=8) :: my_rho, my_nref, mp_i, other_rho, other_nref
  real(kind=8) :: skip(1:3), xs, frac(1:3)
  real(kind=8) :: wx(0:1), wy(0:1), wz(0:1), w

  ! Lane bookkeeping (identical to the large kernel).
  tid_local       = threadIdx%x - 1
  warps_per_block = blockDim%x / warpsize
  warp_local      = tid_local / warpsize
  lane            = mod(tid_local, warpsize)
  warp_global     = (blockIdx%x - 1) * warps_per_block + warp_local
  slot_global     = warp_global * warpsize + lane + 1

  valid_lane = (slot_global <= num_parts)

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  nx          = int(ckey_max_d(ilevel), kind=8)
  hkey_offset = key_off_d(ilevel)

  ! Per-level box bounds. These are level-ilevel cell coordinates stored in
  ! slot ilevel+1, matching the host CIC convention.
  box_min = 0
  box_max = 0
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, ilevel+1)
     box_max(idim) = box_ckey_max_d(idim, ilevel+1)
  end do

  ! ------------------------------------------------------------------
  ! Per-lane source-cell geometry. The only difference from the large
  ! kernel is the +1/2 shift (upper-corner source) and the periodic wrap of
  ! the source cell into [box_min, box_max): the half-cell shift can push the
  ! source to box_max at the top edge, where it wraps to its periodic image.
  ! frac is taken from the unwrapped position (wrap is integer), so the
  ! in-cell fraction is unaffected.
  ! ------------------------------------------------------------------
  ipart          = 0
  combined       = 0_8
  icell_src_lane = 0
  igrid_src_lane = 0
  mp_i           = 0.0_dp
  frac           = 0.0_dp
  src_full_ckey  = 0
  if (valid_lane) then
     ipart = sortp_d(head_idx + slot_global - 1)
     mp_i  = mp_d(ipart)

     do idim = 1, ndim
        xs = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc + 0.5d0
        src_full_ckey(idim) = floor(xs)
        frac(idim) = xs - src_full_ckey(idim)
        ! Match host CIC periodic BCs: wrap within the actual computational box.
        if (src_full_ckey(idim) <  box_min(idim)) src_full_ckey(idim) = box_max(idim) - 1
        if (src_full_ckey(idim) >= box_max(idim)) src_full_ckey(idim) = box_min(idim)
     end do

     ! Split the (shifted) source cell into (parent oct ckey, in-oct cell)
     ! and hash the parent oct -- the segment key, as in the large kernel.
     father_ckey = src_full_ckey / 2
     ii          = src_full_ckey - 2 * father_ckey
     icell_src_lane = 1
     do idim = 1, ndim
        icell_src_lane = icell_src_lane + ii(idim) * (2**(idim-1))
     end do
     ix8 = int(father_ckey(1), kind=8)
     iy8 = int(father_ckey(2), kind=8)
     iz8 = int(father_ckey(3), kind=8)
     key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
     igrid_src_lane = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

     if (igrid_src_lane == 0) then
        valid_lane    = .false.
        mp_i          = 0.0_dp
        frac          = 0.0_dp
        src_full_ckey = 0
     else
        combined = ior(ishft(int(igrid_src_lane, kind=8), 5), int(icell_src_lane, kind=8))
     endif
  endif

  ! ------------------------------------------------------------------
  ! 1D CIC weights on a 2-cell stencil for the upper-corner source. Index
  ! by the offset bit b: w(1) = frac (source cell), w(0) = 1-frac (lower
  ! neighbour). Unused dimensions keep w(0)=1 (their bit is always 0).
  ! ------------------------------------------------------------------
  wx(0) = 1.0d0 - frac(1)
  wx(1) = frac(1)
  wy(0) = 1.0d0
  wy(1) = 0.0d0
  wz(0) = 1.0d0
  wz(1) = 0.0d0
  if (ndim >= 2) then
     wy(0) = 1.0d0 - frac(2)
     wy(1) = frac(2)
  endif
  if (ndim >= 3) then
     wz(0) = 1.0d0 - frac(3)
     wz(1) = frac(3)
  endif

  ! Segment boundary detection (k-independent), identical to the large kernel.
  prev_combined = __shfl_up  (combined, 1)
  next_combined = __shfl_down(combined, 1)
  is_head = (lane == 0)              .or. (combined /= prev_combined)
  is_tail = (lane == warpsize - 1)   .or. (combined /= next_combined)

  ! ------------------------------------------------------------------
  ! Stencil loop over the twotondim = 2**ndim offsets. For offset bit b on
  ! each axis: cell = src - 1 + b (b=1 -> source, b=0 -> lower neighbour).
  ! ------------------------------------------------------------------
  do k = 1, twotondim
     bx = ibits(k - 1, 0, 1)
     by = ibits(k - 1, 1, 1)
     bz = ibits(k - 1, 2, 1)

     my_rho  = 0.0_dp
     my_nref = 0.0_dp
     if (valid_lane) then
        w = wx(bx) * wy(by) * wz(bz)
        if (w > 0.0_dp) then
           my_rho = mp_i * w / vol_loc
           if (m_refine_at_level >= 0.0_dp) then
              if (.not. star) then
                 if (mass_cut_refine > 0.0_dp) then
                    if (mp_i < mass_cut_refine) then
                       my_nref = w
                    endif
                 else
                    my_nref = w
                 endif
              else
                 my_nref = mp_i * w / mass_sph
              endif
           endif
        endif
     endif

     ! Destination cell: only the segment tail hashes it (segment-uniform).
     dst_igrid_lane = 0
     dst_icell_lane = 0
     if (is_tail .and. valid_lane) then
        target_ckey = 0
        target_ckey(1) = src_full_ckey(1) - 1 + bx
        if (ndim >= 2) target_ckey(2) = src_full_ckey(2) - 1 + by
        if (ndim >= 3) target_ckey(3) = src_full_ckey(3) - 1 + bz

        ! GPU runs are periodic: wrap the target cell into [box_min, box_max).
        do idim = 1, ndim
           if (target_ckey(idim) < box_min(idim))  target_ckey(idim) = box_max(idim) - 1
           if (target_ckey(idim) >= box_max(idim)) target_ckey(idim) = box_min(idim)
        end do
        father_ckey = target_ckey / 2
        ii = target_ckey - 2 * father_ckey
        dst_icell_lane = 1
        do idim = 1, ndim
           dst_icell_lane = dst_icell_lane + ii(idim) * (2**(idim-1))
        end do
        ix8 = int(father_ckey(1), kind=8)
        iy8 = int(father_ckey(2), kind=8)
        iz8 = int(father_ckey(3), kind=8)
        key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
        dst_igrid_lane = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
     endif

     ! Segmented inclusive Hillis-Steele scan along the warp (identical).
     if (is_head) then
        head_acc = 1
     else
        head_acc = 0
     endif
     do scan_iter = 0, 4
        scan_offset = ishft(1, scan_iter)
        other_rho  = __shfl_up(my_rho,   scan_offset)
        other_nref = __shfl_up(my_nref,  scan_offset)
        other_head = __shfl_up(head_acc, scan_offset)
        if (lane >= scan_offset) then
           if (head_acc == 0) then
              my_rho  = my_rho  + other_rho
              my_nref = my_nref + other_nref
           endif
           head_acc = ior(head_acc, other_head)
        endif
     end do

     ! Tail emission: one atomicAdd per segment per offset (identical).
     if (is_tail .and. valid_lane .and. dst_igrid_lane /= 0) then
        if (my_rho /= 0.0_dp) then
           info = atomicadd(rho_d(dst_icell_lane, dst_igrid_lane), real(my_rho, kind=dp))
        endif
        if (m_refine_at_level >= 0.0_dp .and. my_nref /= 0.0_dp) then
           info = atomicadd(nref_d(dst_icell_lane, dst_igrid_lane), real(my_nref, kind=dp))
        endif
     endif
  end do

end subroutine cic_part_medium_kernel

!> Host dispatcher for the GPU CIC medium-stencil deposit at level ilevel.
!> Identical to gpu_cic_part_large (multipole on the coarsest level, then a
!> single warp-segmented deposit launch) but dispatches cic_part_medium_kernel,
!> which uses the half-cell shifted upper-corner source and twotondim offsets.
subroutine gpu_cic_part_medium(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  if (rtype /= 0 .and. rtype /= 1) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%p%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%p%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_part_medium:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(xp, mp, q_d, &
          & 1, sim%p%npart, int(sim%r%npartmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc  = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_part_medium:deposit", color=4)
  call cic_part_medium_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, &
       & xp, mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, 1d0, .false., &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, int(sim%r%npartmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_cic_part_medium

subroutine gpu_cic_star_medium(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3, mass_sph
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  if (rtype /= 0 .and. rtype /= 2) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%star%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%star%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_star_medium:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(star_xp, star_mp, q_d, &
          & 1, sim%star%npart, int(sim%r%nstarmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  head_idx = sim%star%headp(ilevel)
  tail_idx = sim%star%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  mass_sph = sim%r%mass_sph

  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_part_medium:deposit", color=4)
  call cic_part_medium_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & star_sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, &
       & star_xp, star_mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, .true., &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, int(sim%r%nstarmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_cic_star_medium

subroutine gpu_cic_sink_medium(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  integer :: deposit_block_size, deposit_num_blocks
  real(kind=8) :: dx_loc, vol_loc, skip1, skip2, skip3, mass_sph
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  if (rtype /= 0 .and. rtype /= 3) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%sink%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%sink%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_sink_medium:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(sink_xp, sink_mp, q_d, &
          & 1, sim%sink%npart, int(sim%r%nsinkmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  head_idx = sim%sink%headp(ilevel)
  tail_idx = sim%sink%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  mass_sph = sim%r%mass_sph

  deposit_block_size = 256
  deposit_num_blocks = (num_parts + deposit_block_size - 1) / deposit_block_size
  call nvtxStartRange("gpu_cic_part_medium:deposit", color=4)
  call cic_part_medium_kernel<<<deposit_num_blocks, deposit_block_size>>>(&
       & sink_sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, &
       & sink_xp, sink_mp, rho, nref, &
       & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, .true., &
       & sim%r%m_refine(ilevel), sim%r%mass_cut_refine, ilevel, int(sim%r%nsinkmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_cic_sink_medium

!################################################################
!  GPU CIC small-stencil deposit (part_dep_algo = 3)
!################################################################
!
!> Mark source-cell run leaders into prefix_sum (1 at a run head, 0 otherwise).
!>
!> After the shifted gpu_sort_part, particles sharing a (half-cell shifted)
!> source cell have an identical Hilbert key in hkey_part_d and are contiguous
!> in sortp. A slot is a run leader when its key differs from the previous
!> slot's key (the first slot is always a leader).
attributes(global) subroutine init_leader_marker_part_small(sortp_d, hkey_part_d, &
     & prefix_sum_d, head_idx, num_parts)
  integer(kind=4), device :: sortp_d(*)
  integer(kind=8), device :: hkey_part_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), intent(in), value :: head_idx, num_parts

  integer :: thread_idx, block_idx, idx, g

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  g = head_idx + idx

  if (idx == 0) then
     prefix_sum_d(g) = 1
  else if (hkey_part_d(sortp_d(g)) /= hkey_part_d(sortp_d(g-1))) then
     prefix_sum_d(g) = 1
  else
     prefix_sum_d(g) = 0
  end if

end subroutine init_leader_marker_part_small

!> Record, for each source-cell run, the 1-based slot of its last particle.
!>
!> prefix_sum_d already holds the inclusive run id per slot (the scan of the
!> leader markers). A slot is the run tail when it is the last particle or the
!> next slot belongs to a different run.
attributes(global) subroutine fill_run_tail_part_small(prefix_sum_d, run_tail_d, &
     & head_idx, num_parts)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), device :: run_tail_d(*)
  integer(kind=4), intent(in), value :: head_idx, num_parts

  integer :: thread_idx, block_idx, idx, g, rid

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  g = head_idx + idx
  rid = prefix_sum_d(g)

  if (idx == num_parts - 1) then
     run_tail_d(rid) = idx + 1
  else if (prefix_sum_d(g+1) /= rid) then
     run_tail_d(rid) = idx + 1
  end if

end subroutine fill_run_tail_part_small

!> Per-particle CIC contribution for stencil offset k into contrib_d.
!>
!> The shifted source cell is the upper corner of the 2x2x2 stencil; for offset
!> k (1..twotondim) bit (idim-1) selects the source cell (weight = frac) when
!> set or the lower neighbour (weight = 1-frac) when clear, matching host
!> cic_index/cic_weight ordering. mode 0 fills rho contributions (mp*w/vol_loc);
!> mode 1 fills nref contributions (w, gated by mass_cut_refine, DM branch).
attributes(global) subroutine fill_contrib_part_small(sortp_d, xp_d, mp_d, contrib_d, &
     & skip1, skip2, skip3, dx_inv, vol_loc, k, mode, mass_cut_refine, mass_sph, &
     & head_idx, num_parts, leading)
  integer(kind=4), device :: sortp_d(*)
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  real(kind=dp),   device :: contrib_d(*)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_inv, vol_loc
  real(kind=8), intent(in), value ::mass_cut_refine, mass_sph
  integer(kind=4), intent(in), value :: k, mode, head_idx, num_parts
  integer(kind=8), intent(in), value :: leading

  integer :: thread_idx, block_idx, idx, g, ipart, idim, bit, kk
  real(kind=8) :: skip(1:3), xs, fr(1:3), w, mp_i

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  g = head_idx + idx
  ipart = sortp_d(g)

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  fr = 0.0d0
  do idim = 1, ndim
     xs = (xp_d(ipart + (idim-1)*leading) + skip(idim)) * dx_inv + 0.5d0
     fr(idim) = xs - floor(xs)
  end do

  kk = k - 1
  w = 1.0d0
  do idim = 1, ndim
     bit = ibits(kk, idim-1, 1)
     if (bit == 1) then
        w = w * fr(idim)
     else
        w = w * (1.0d0 - fr(idim))
     end if
  end do

  if (mode == 0) then ! mass density
     mp_i = mp_d(ipart)
     contrib_d(g) = real(mp_i * w / vol_loc, kind=dp)
  else if (mode == 1) then ! particle number density
     if (mass_cut_refine > 0.0d0) then
        if (mp_d(ipart) < mass_cut_refine) then
           contrib_d(g) = real(w, kind=dp)
        else
           contrib_d(g) = 0.0_dp
        end if
     else
        contrib_d(g) = real(w, kind=dp)
     end if
  else ! baryon number density
     mp_i = mp_d(ipart)
     contrib_d(g) = real(mp_i * w / mass_sph, kind=dp)
  end if

end subroutine fill_contrib_part_small

!> Deposit one accumulated value per source-cell run for stencil offset k.
!>
!> contrib_d holds the inclusive prefix sum of the per-particle contributions,
!> so a run's total is contrib_d(tail) - contrib_d(head-1). Only the run leader
!> emits; it hashes the single target cell (source cell + offset k) and writes
!> it. For a fixed offset distinct source cells map to distinct target cells, so
!> the plain read-modify-write is race free (no atomics needed).
attributes(global) subroutine deposit_runs_part_small(sortp_d, xp_d, contrib_d, &
     & prefix_sum_d, run_tail_d, &
     & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     & box_ckey_min_d, box_ckey_max_d, out_d, &
     & skip1, skip2, skip3, dx_inv, k, ilevel, head_idx, num_parts, leading)
  integer(kind=4), device :: sortp_d(*)
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: contrib_d(*)
  integer(kind=4), device :: prefix_sum_d(*)
  integer(kind=4), device :: run_tail_d(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  real(kind=dp),   device :: out_d(1:twotondim, *)
  real(kind=8), intent(in), value :: skip1, skip2, skip3, dx_inv
  integer(kind=4), intent(in), value :: k, ilevel, head_idx, num_parts
  integer(kind=8), intent(in), value :: leading

  integer :: thread_idx, block_idx, idx, g, ipart, idim, bit, kk, rid
  integer :: tail_slot, g_t, igrid, icell
  integer(kind=4) :: src_ckey(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, hkey_offset, key, ix8, iy8, iz8
  real(kind=8) :: skip(1:3), xs, run_sum

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  g = head_idx + idx

  ! Only the run leader works (first slot, or a key change vs the previous slot).
  if (idx > 0) then
     if (prefix_sum_d(g) == prefix_sum_d(g-1)) return
  end if

  ! Run total = prefix(tail) - prefix(head-1).
  rid = prefix_sum_d(g)
  tail_slot = run_tail_d(rid)
  g_t = head_idx + tail_slot - 1
  run_sum = contrib_d(g_t)
  if (idx > 0) run_sum = run_sum - contrib_d(g-1)
  if (run_sum == 0.0_dp) return

  ! Per-level box bounds (stored at slot ilevel+1, an array convention).
  box_min = 0
  box_max = 0
  do idim = 1, ndim
     box_min(idim) = box_ckey_min_d(idim, ilevel+1)
     box_max(idim) = box_ckey_max_d(idim, ilevel+1)
  end do

  ! Recompute the canonical (shifted, periodic-wrapped) source cell.
  ipart = sortp_d(g)
  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3
  src_ckey = 0
  do idim = 1, ndim
     xs = (xp_d(ipart + (idim-1)*leading) + skip(idim)) * dx_inv + 0.5d0
     src_ckey(idim) = floor(xs)
     ! Match host CIC periodic BCs: wrap within the actual computational box.
     if (src_ckey(idim) <  box_min(idim)) src_ckey(idim) = box_max(idim) - 1
     if (src_ckey(idim) >= box_max(idim)) src_ckey(idim) = box_min(idim)
  end do

  ! Target cell for offset k: bit set -> source cell, bit clear -> lower neighbour.
  kk = k - 1
  target_ckey = 0
  do idim = 1, ndim
     bit = ibits(kk, idim-1, 1)
     target_ckey(idim) = src_ckey(idim) - 1 + bit
     ! GPU runs are periodic: wrap the target cell into [box_min, box_max).
     if (target_ckey(idim) <  box_min(idim)) target_ckey(idim) = box_max(idim) - 1
     if (target_ckey(idim) >= box_max(idim)) target_ckey(idim) = box_min(idim)
  end do

  ! Hash the target cell's parent oct; skip if it is not present on this rank.
  nx          = int(ckey_max_d(ilevel), kind=8)
  hkey_offset = key_off_d(ilevel)
  father_ckey = target_ckey / 2
  ii          = target_ckey - 2 * father_ckey
  icell = 1
  do idim = 1, ndim
     icell = icell + ii(idim) * (2**(idim-1))
  end do
  ix8 = int(father_ckey(1), kind=8)
  iy8 = int(father_ckey(2), kind=8)
  iz8 = int(father_ckey(3), kind=8)
  key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
  igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
  if (igrid == 0) return

  ! Race free: distinct runs (source cells) map to distinct target cells here.
  out_d(icell, igrid) = out_d(icell, igrid) + real(run_sum, kind=dp)

end subroutine deposit_runs_part_small

!> Host dispatcher for the GPU CIC small-stencil mass deposit at level ilevel.
!>
!> Like gpu_cic_part_large, this accumulates the global monopole/dipole on the
!> coarsest level, then deposits particle mass into rho (and nref). Unlike the
!> large path it relies on gpu_sort_part having grouped particles by their
!> half-cell shifted source cell, builds one run per source cell, and for each
!> of the twotondim = 2**ndim stencil offsets runs a real prefix sum over the
!> per-particle weights and emits a single value per run. Because a fixed offset
!> maps every distinct source cell to a distinct target cell, the run leaders
!> write without atomics. The offsets are looped on the host so only one
!> contribution buffer (xp_swap) is live at a time.
subroutine gpu_cic_part_small(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim, k
  integer :: blk, nblk
  real(kind=8) :: dx_loc, vol_loc, dx_inv, skip1, skip2, skip3
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! rtype gate: matches the host's "deposit DM into rho" branch.
  if (rtype /= 0 .and. rtype /= 1) return

  ! Coarsest level: accumulate global monopole and dipole (same as large path).
  if (ilevel == sim%r%levelmin .and. sim%p%npart > 0) then
     num_threads = 256
     num_blocks  = (sim%p%npart + num_threads - 1) / num_threads
     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_part_small:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(xp, mp, q_d, &
          & 1, sim%p%npart, int(sim%r%npartmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d
     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do
  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc  = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  dx_inv  = 1.0_dp/dx_loc
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  nblk = 256
  blk  = (num_parts + nblk - 1) / nblk

  ! Build source-cell runs: leader markers -> inclusive scan (run id in
  ! prefix_sum) -> per-run tail slot (in isp_swap).
  call nvtxStartRange("gpu_cic_part_small:runs", color=4)
  call init_leader_marker_part_small<<<blk, nblk>>>(sortp, idp_swap, &
       & prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call gpu_scan(prefix_sum, head_idx, num_parts)
  call fill_run_tail_part_small<<<blk, nblk>>>(prefix_sum, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Per stencil offset: prefix sum the weighted contributions and deposit one
  ! value per source-cell run.
  call nvtxStartRange("gpu_cic_part_small:deposit", color=4)
  do k = 1, twotondim
     ! rho contribution (mp * w / vol_loc)
     call fill_contrib_part_small<<<blk, nblk>>>(sortp, xp, mp, xp_swap, &
          & skip1, skip2, skip3, dx_inv, vol_loc, k, 0, sim%r%mass_cut_refine, 1d0, &
          & head_idx, num_parts, int(sim%r%npartmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call gpu_scan_dp(xp_swap, head_idx, num_parts)
     call deposit_runs_part_small<<<blk, nblk>>>(sortp, xp, xp_swap, &
          & prefix_sum, isp_swap, &
          & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, rho, &
          & skip1, skip2, skip3, dx_inv, k, ilevel, head_idx, num_parts, int(sim%r%npartmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)

     ! nref contribution (w, gated), only when the refinement gate is active.
     if (sim%r%m_refine(ilevel) >= 0.0_dp) then
        call fill_contrib_part_small<<<blk, nblk>>>(sortp, xp, mp, xp_swap, &
             & skip1, skip2, skip3, dx_inv, vol_loc, k, 1, sim%r%mass_cut_refine, 1d0, &
             & head_idx, num_parts, int(sim%r%npartmax,8))
        call GPU_Error_Check(__FILE__, __LINE__)
        call gpu_scan_dp(xp_swap, head_idx, num_parts)
        call deposit_runs_part_small<<<blk, nblk>>>(sortp, xp, xp_swap, &
             & prefix_sum, isp_swap, &
             & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
             & box_ckey_min, box_ckey_max, nref, &
             & skip1, skip2, skip3, dx_inv, k, ilevel, head_idx, num_parts, int(sim%r%npartmax,8))
        call GPU_Error_Check(__FILE__, __LINE__)
     endif
  end do
  call nvtxEndRange()

end subroutine gpu_cic_part_small

subroutine gpu_cic_star_small(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim, k
  integer :: blk, nblk
  real(kind=8) :: dx_loc, vol_loc, dx_inv, skip1, skip2, skip3, mass_sph
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! rtype gate: matches the host's "deposit DM into rho" branch.
  if (rtype /= 0 .and. rtype /= 2) return

  ! Coarsest level: accumulate global monopole and dipole (same as large path).
  if (ilevel == sim%r%levelmin .and. sim%star%npart > 0) then
     num_threads = 256
     num_blocks  = (sim%star%npart + num_threads - 1) / num_threads
     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_star_small:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(star_xp, star_mp, q_d, &
          & 1, sim%star%npart, int(sim%r%nstarmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d
     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do
  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%star%headp(ilevel)
  tail_idx = sim%star%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  dx_inv  = 1.0_dp/dx_loc
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  mass_sph = sim%r%mass_sph

  nblk = 256
  blk  = (num_parts + nblk - 1) / nblk

  ! Build source-cell runs: leader markers -> inclusive scan (run id in
  ! prefix_sum) -> per-run tail slot (in isp_swap).
  call nvtxStartRange("gpu_cic_star_small:runs", color=4)
  call init_leader_marker_part_small<<<blk, nblk>>>(star_sortp, idp_swap, &
       & prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call gpu_scan(prefix_sum, head_idx, num_parts)
  call fill_run_tail_part_small<<<blk, nblk>>>(prefix_sum, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Per stencil offset: prefix sum the weighted contributions and deposit one
  ! value per source-cell run.
  call nvtxStartRange("gpu_cic_star_small:deposit", color=4)
  do k = 1, twotondim
     ! rho contribution (mp * w / vol_loc)
     call fill_contrib_part_small<<<blk, nblk>>>(star_sortp, star_xp, star_mp, xp_swap, &
          & skip1, skip2, skip3, dx_inv, vol_loc, k, 0, sim%r%mass_cut_refine, 1d0, &
          & head_idx, num_parts, int(sim%r%nstarmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call gpu_scan_dp(xp_swap, head_idx, num_parts)
     call deposit_runs_part_small<<<blk, nblk>>>(star_sortp, star_xp, xp_swap, &
          & prefix_sum, isp_swap, &
          & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, rho, &
          & skip1, skip2, skip3, dx_inv, k, ilevel, head_idx, num_parts, int(sim%r%nstarmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)

     ! nref contribution (w, gated), only when the refinement gate is active.
     if (sim%r%m_refine(ilevel) >= 0.0_dp) then
        call fill_contrib_part_small<<<blk, nblk>>>(star_sortp, star_xp, star_mp, xp_swap, &
             & skip1, skip2, skip3, dx_inv, vol_loc, k, 2, sim%r%mass_cut_refine, mass_sph,&
             & head_idx, num_parts, int(sim%r%nstarmax,8))
        call GPU_Error_Check(__FILE__, __LINE__)
        call gpu_scan_dp(xp_swap, head_idx, num_parts)
        call deposit_runs_part_small<<<blk, nblk>>>(star_sortp, star_xp, xp_swap, &
             & prefix_sum, isp_swap, &
             & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
             & box_ckey_min, box_ckey_max, nref, &
             & skip1, skip2, skip3, dx_inv, k, ilevel, head_idx, num_parts, int(sim%r%nstarmax,8))
        call GPU_Error_Check(__FILE__, __LINE__)
     endif
  end do
  call nvtxEndRange()

end subroutine gpu_cic_star_small

subroutine gpu_cic_sink_small(sim, ilevel, rtype)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim, k
  integer :: blk, nblk
  real(kind=8) :: dx_loc, vol_loc, dx_inv, skip1, skip2, skip3, mass_sph
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! rtype gate: matches the host's "deposit DM into rho" branch.
  if (rtype /= 0 .and. rtype /= 3) return

  ! Coarsest level: accumulate global monopole and dipole (same as large path).
  if (ilevel == sim%r%levelmin .and. sim%sink%npart > 0) then
     num_threads = 256
     num_blocks  = (sim%sink%npart + num_threads - 1) / num_threads
     q_d = 0.0_dp
     call nvtxStartRange("gpu_cic_sink_small:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(sink_xp, sink_mp, q_d, &
          & 1, sim%sink%npart, int(sim%r%nsinkmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d
     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do
  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%sink%headp(ilevel)
  tail_idx = sim%sink%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim
  dx_inv  = 1.0_dp/dx_loc
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  mass_sph = sim%r%mass_sph

  nblk = 256
  blk  = (num_parts + nblk - 1) / nblk

  ! Build source-cell runs: leader markers -> inclusive scan (run id in
  ! prefix_sum) -> per-run tail slot (in isp_swap).
  call nvtxStartRange("gpu_cic_sink_small:runs", color=4)
  call init_leader_marker_part_small<<<blk, nblk>>>(sink_sortp, idp_swap, &
       & prefix_sum, head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call gpu_scan(prefix_sum, head_idx, num_parts)
  call fill_run_tail_part_small<<<blk, nblk>>>(prefix_sum, isp_swap, &
       & head_idx, num_parts)
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

  ! Per stencil offset: prefix sum the weighted contributions and deposit one
  ! value per source-cell run.
  call nvtxStartRange("gpu_cic_sink_small:deposit", color=4)
  do k = 1, twotondim
     ! rho contribution (mp * w / vol_loc)
     call fill_contrib_part_small<<<blk, nblk>>>(sink_sortp, sink_xp, sink_mp, xp_swap, &
          & skip1, skip2, skip3, dx_inv, vol_loc, k, 0, sim%r%mass_cut_refine, 1d0, &
          & head_idx, num_parts, int(sim%r%nsinkmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call gpu_scan_dp(xp_swap, head_idx, num_parts)
     call deposit_runs_part_small<<<blk, nblk>>>(sink_sortp, sink_xp, xp_swap, &
          & prefix_sum, isp_swap, &
          & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, rho, &
          & skip1, skip2, skip3, dx_inv, k, ilevel, head_idx, num_parts, int(sim%r%nsinkmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)

     ! nref contribution (w, gated), only when the refinement gate is active.
     if (sim%r%m_refine(ilevel) >= 0.0_dp) then
        call fill_contrib_part_small<<<blk, nblk>>>(sink_sortp, sink_xp, sink_mp, xp_swap, &
             & skip1, skip2, skip3, dx_inv, vol_loc, k, 2, sim%r%mass_cut_refine, mass_sph,&
             & head_idx, num_parts, int(sim%r%nsinkmax,8))
        call GPU_Error_Check(__FILE__, __LINE__)
        call gpu_scan_dp(xp_swap, head_idx, num_parts)
        call deposit_runs_part_small<<<blk, nblk>>>(sink_sortp, sink_xp, xp_swap, &
             & prefix_sum, isp_swap, &
             & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
             & box_ckey_min, box_ckey_max, nref, &
             & skip1, skip2, skip3, dx_inv, k, ilevel, head_idx, num_parts, int(sim%r%nsinkmax,8))
        call GPU_Error_Check(__FILE__, __LINE__)
     endif
  end do
  call nvtxEndRange()

end subroutine gpu_cic_sink_small

!################################################################
!  GPU TSC/PCS deposit (part/star/sink_mass_deposition_scheme = 2, 3)
!################################################################
!
!> Direct TSC/PCS mass deposit at level ilevel (order 3 or 4).
!>
!> One thread per particle in sortp(head_idx..head_idx+num_parts-1); each thread
!> loops over its order**3 stencil cells and atomically adds its contribution
!> to rho and nref. Cell keys, weights and periodic wrap come from
!> sink_bspline_device, which mirrors host tsc_part/pcs_part; the nref rules
!> also follow the host.
!> High order kernels are meant for the few sink/core particles, so there is no
!> sort-based reduction and the deposit does not depend on *_dep_algo. A target
!> cell whose parent oct is absent is skipped, as in the CIC deposit kernels.
attributes(global) subroutine bspline_part_kernel(sortp_d, &
     & head_idx, num_parts, &
     & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     & box_ckey_min_d, box_ckey_max_d, periodic_d, &
     & xp_d, mp_d, rho_d, nref_d, &
     & skip1, skip2, skip3, dx_loc, vol_loc, mass_sph, star, &
     & m_refine_at_level, mass_cut_refine, order, ilevel, leading)
  logical, intent(in), value :: star
  integer(kind=4), intent(in), value :: head_idx, num_parts, order, ilevel
  integer(kind=8), intent(in), value :: leading
  integer(kind=4), device :: sortp_d(*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3, *)
  integer(kind=4), device :: box_ckey_max_d(1:3, *)
  logical,         device :: periodic_d(1:3)
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: mp_d(*)
  real(kind=dp),   device :: rho_d (1:twotondim, *)
  real(kind=dp),   device :: nref_d(1:twotondim, *)
  real(kind=dp), intent(in), value :: skip1, skip2, skip3, dx_loc, vol_loc
  real(kind=dp), intent(in), value :: m_refine_at_level, mass_cut_refine
  real(kind=dp), intent(in), value :: mass_sph

  integer :: thread_idx, block_idx, idx, ipart, idim, j, igrid, icell, info
  integer(kind=4) :: ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=8) :: nx, hkey_offset, key, ix8, iy8, iz8
  real(kind=dp) :: x(1:3), xnei(1:3), w, mp_i, my_nref

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1
  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = sortp_d(head_idx + idx)
  mp_i  = mp_d(ipart)

  ! Hash geometry at level ilevel (grid(:) stores the parent octs there).
  nx          = int(ckey_max_d(ilevel), kind=8)
  hkey_offset = key_off_d(ilevel)

  ! Particle position in units of dx at level ilevel (the GPU runs in 3D only).
  x(1) = (xp_d(ipart            ) + skip1) / dx_loc
  x(2) = (xp_d(ipart +   leading) + skip2) / dx_loc
  x(3) = (xp_d(ipart + 2*leading) + skip3) / dx_loc

  ! Stencil loop over the order**3 cells.
  do j = 0, order**3 - 1
     call sink_bspline_device(order, x, j, box_ckey_min_d, box_ckey_max_d, periodic_d, &
          & ilevel, ckey, xnei, w)

     ! Parent oct of the target cell; skip the cell if the oct is absent.
     father_ckey = ckey / 2
     ii = ckey - 2 * father_ckey
     icell = 1
     do idim = 1, ndim
        icell = icell + ii(idim) * (2**(idim-1))
     end do
     ix8 = int(father_ckey(1), kind=8)
     iy8 = int(father_ckey(2), kind=8)
     iz8 = int(father_ckey(3), kind=8)
     key = hkey_offset + ix8 + iy8*nx + iz8*nx*nx
     igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
     if (igrid == 0) cycle

     info = atomicadd(rho_d(icell, igrid), mp_i * w / vol_loc)
     if (m_refine_at_level >= 0.0_dp) then
        my_nref = 0.0_dp
        if (.not. star) then
           ! nref follows the host refinement gate: either all masses count
           ! (mass_cut_refine <= 0), or only particles below mass_cut_refine.
           if (mass_cut_refine > 0.0_dp) then
              if (mp_i < mass_cut_refine) then
                 my_nref = w
              endif
           else
              my_nref = w
           endif
        else
           my_nref = mp_i * w / mass_sph
        endif
        if (my_nref /= 0.0_dp) then
           info = atomicadd(nref_d(icell, igrid), my_nref)
        endif
     endif
  end do

end subroutine bspline_part_kernel

!> Host dispatcher for the GPU TSC/PCS deposit of dark matter particles at
!> level ilevel (order = part_mass_deposition_scheme + 1). Same structure as
!> gpu_cic_part_large: multipole on the coarsest level, then one deposit launch.
subroutine gpu_bspline_part(sim, ilevel, rtype, order)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype
  integer, intent(in) :: order

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks, idim
  real(kind=8) :: dx_loc, vol_loc
  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! If not ALL and not DM return
  if (rtype /= 0 .and. rtype /= 1) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%p%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%p%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_bspline_part:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(xp, mp, q_d, &
          & 1, sim%p%npart, int(sim%r%npartmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc  = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim

  num_threads = 256
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  call nvtxStartRange("gpu_bspline_part:deposit", color=4)
  call bspline_part_kernel<<<num_blocks, num_threads>>>(&
       & sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & xp, mp, rho, nref, &
       & real(sim%m%skip(1),kind=dp), real(sim%m%skip(2),kind=dp), real(sim%m%skip(3),kind=dp), &
       & real(dx_loc,kind=dp), real(vol_loc,kind=dp), 1.0_dp, .false., &
       & real(sim%r%m_refine(ilevel),kind=dp), real(sim%r%mass_cut_refine,kind=dp), &
       & order, ilevel, int(sim%r%npartmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_bspline_part

!> Host dispatcher for the GPU TSC/PCS deposit of star particles
!> (order = star_mass_deposition_scheme + 1).
subroutine gpu_bspline_star(sim, ilevel, rtype, order)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: rtype
