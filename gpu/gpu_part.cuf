  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Refresh the persistent (module-scope) device time-step arrays for this step.
  dtnew_part_d = sim%g%dtnew
  dtold_part_d = sim%g%dtold

  head_idx = sim%tree%headp(ilevel)
  tail_idx = sim%tree%tailp(ilevel)
  num_parts = tail_idx - head_idx + 1

  if (num_parts > 0) then

     num_threads = 128
     num_blocks  = (num_parts + num_threads - 1) / num_threads

     call nvtxStartRange("gpu_kick_drift_tree", color=4) ! purple
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(tree_xp, tree_vp, tree_xp, &
          & tree_levelp, f, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, box_size, periodic, sim%r%ngridmax, &
          & dtnew_part_d, dtold_part_d, &
          & skip1, skip2, skip3, dx_loc, 0d0, action_part, ilevel, head_idx, num_parts, &
          & int(sim%r%ntreemax,8), .false., sim%tree%static, &
          & sim%r%tree_force_interpolation_scheme+1)
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

  endif

end subroutine gpu_kick_drift_tree

end module part_device
