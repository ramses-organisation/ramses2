attributes(device) subroutine gather_cic_force_part(f_d, hash_key_d, hash_val_d, &
     hash_size_d, ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
     ngridmax, x_in, cell_level, grid_level, ff, ok_level)
  real(kind=dp),   device :: f_d(1:twotondim,1:ndim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  logical,         device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: ngridmax
  real(kind=8) :: x_in(1:3), ff(1:3)
  integer(kind=4), intent(in), value :: cell_level, grid_level
  logical :: ok_level

  integer :: idim, bx, by, bz, igrid, icell
  integer(kind=4) :: il(1:3), ir(1:3), target_ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=4) :: box_min(1:3), box_max(1:3)
  integer(kind=8) :: nx, offset, key, ix8, iy8, iz8
  real(kind=8) :: dr(1:3), dl(1:3), weight
  logical :: in_domain

  ok_level = .true.
  ff = 0.0_dp
  if (grid_level < 1) then
     ok_level = .false.
     return
  endif

  il = 0
  ir = 0
  dr = 0.0_dp
  dl = 1.0_dp
  box_min = 0
  box_max = 0

  do idim = 1, ndim
     dr(idim) = x_in(idim) + 0.5_dp
     ir(idim) = int(dr(idim))
     dr(idim) = dr(idim) - ir(idim)
     dl(idim) = 1.0_dp - dr(idim)
     il(idim) = ir(idim) - 1
     box_min(idim) = box_ckey_min_d(idim, cell_level)
     box_max(idim) = box_ckey_max_d(idim, cell_level)
     if (periodic_d(idim)) then
        if (il(idim) <  box_min(idim)) il(idim) = box_max(idim) - 1
        if (ir(idim) >= box_max(idim)) ir(idim) = box_min(idim)
     endif
  end do

  do bz = 0, 1
     do by = 0, 1
        do bx = 0, 1

           target_ckey = 0
           target_ckey(1) = merge(ir(1), il(1), bx == 1)
           weight = merge(dr(1), dl(1), bx == 1)
           target_ckey(2) = merge(ir(2), il(2), by == 1)
           weight = weight * merge(dr(2), dl(2), by == 1)
           target_ckey(3) = merge(ir(3), il(3), bz == 1)
           weight = weight * merge(dr(3), dl(3), bz == 1)

           in_domain = .true.
           do idim = 1, ndim
              if (.not. periodic_d(idim)) then
                 if (target_ckey(idim) < box_min(idim))  in_domain = .false.
                 if (target_ckey(idim) >= box_max(idim)) in_domain = .false.
              endif
           end do
           if (.not. in_domain) then
              ok_level = .false.
              cycle
           endif

           father_ckey = target_ckey / 2
           ii = target_ckey - 2 * father_ckey
           icell = 1
           do idim = 1, ndim
              icell = icell + ii(idim) * 2**(idim-1)
           end do

           ix8 = int(father_ckey(1), kind=8)
           iy8 = int(father_ckey(2), kind=8)
           iz8 = int(father_ckey(3), kind=8)
           nx  = int(ckey_max_d(grid_level), kind=8)
           offset = key_off_d(grid_level)
           key = offset + ix8 + iy8*nx + iz8*nx*nx

           igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

           ! Skip cache/ghost octs (igrid > ngridmax): gpu_gradient_phi does
           ! not update them, so f there is stale. CPU mirrors this by
           ! returning child=0 in get_grid; same convention as gpu_mg.cuf.
           if (igrid == 0 .or. igrid > ngridmax) then
              ok_level = .false.
              cycle
           endif

           do idim = 1, ndim
              ff(idim) = ff(idim) + real(f_d(icell, idim, igrid), kind=8) * weight
           end do

        end do
     end do
  end do

  if (.not. ok_level) then
     ff = 0.0_dp
  endif

end subroutine gather_cic_force_part

!> TSC/PCS force gather (order 3 or 4) at level ilevel for a particle at x_in,
!> in units of dx at level ilevel. Cell keys, weights and periodic wrap come
!> from sink_bspline_device. Mirrors host tsc/pcs_kick_drift_part: a stencil
!> cell whose oct is absent (igrid<=0, or a cache/ghost oct igrid>ngridmax whose
!> f is stale) is skipped, with no fallback to the coarser level.
attributes(device) subroutine gather_bspline_force_part(order, f_d, hash_key_d, hash_val_d, &
     hash_size_d, ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
     ngridmax, x_in, ilevel, ff)
  integer(kind=4), intent(in), value :: order
  real(kind=dp),   device :: f_d(1:twotondim,1:ndim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  logical,         device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: ngridmax
  real(kind=8) :: x_in(1:3), ff(1:3)
  integer(kind=4), intent(in), value :: ilevel

  integer :: idim, j, igrid, icell
  integer(kind=4) :: ckey(1:3), father_ckey(1:3), ii(1:3)
  integer(kind=8) :: nx, offset, key, ix8, iy8, iz8
  real(kind=dp) :: x(1:3), xnei(1:3), w

  ff = 0.0_dp
  x = real(x_in, kind=dp)
  nx     = int(ckey_max_d(ilevel), kind=8)
  offset = key_off_d(ilevel)

  do j = 0, order**3 - 1
     call sink_bspline_device(order, x, j, box_ckey_min_d, box_ckey_max_d, periodic_d, &
          & ilevel, ckey, xnei, w)

     father_ckey = ckey / 2
     ii = ckey - 2 * father_ckey
     icell = 1
     do idim = 1, ndim
        icell = icell + ii(idim) * 2**(idim-1)
     end do
     ix8 = int(father_ckey(1), kind=8)
     iy8 = int(father_ckey(2), kind=8)
     iz8 = int(father_ckey(3), kind=8)
     key = offset + ix8 + iy8*nx + iz8*nx*nx
     igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
     if (igrid <= 0 .or. igrid > ngridmax) cycle

     do idim = 1, ndim
        ff(idim) = ff(idim) + real(f_d(icell, idim, igrid) * w, kind=8)
     end do
  end do

end subroutine gather_bspline_force_part

attributes(global) subroutine kick_drift_part_kernel(xp_d, vp_d, fp_d, levelp_d, &
     f_d, hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
     box_ckey_min_d, box_ckey_max_d, box_size_d, periodic_d, ngridmax, &
     dtnew_d, dtold_d, skip1, skip2, skip3, dx_loc, fudge_descent, &
     action_part, ilevel, head_idx, num_parts, leading, has_fp, static, force_order)
  integer(kind=8), intent(in), value :: leading
  real(kind=dp),   device :: xp_d(*)
  real(kind=dp),   device :: vp_d(*)
  real(kind=dp),   device :: fp_d(*)
  integer(kind=4), device :: levelp_d(*)
  real(kind=dp),   device :: f_d(1:twotondim,1:ndim,*)
  integer(kind=8), device :: hash_key_d(*)
  integer(kind=4), device :: hash_val_d(*)
  integer(kind=4), intent(in), value :: hash_size_d
  integer(kind=4), device :: ckey_max_d(*)
  integer(kind=8), device :: key_off_d(*)
  integer(kind=4), device :: box_ckey_min_d(1:3,*)
  integer(kind=4), device :: box_ckey_max_d(1:3,*)
  real(kind=8),    device :: box_size_d(1:3)
  logical,         device :: periodic_d(1:3)
  integer(kind=4), intent(in), value :: ngridmax
  real(kind=8),    device :: dtnew_d(*)
  real(kind=8),    device :: dtold_d(*)
  logical,         intent(in), value :: has_fp
  logical,         intent(in), value :: static
  real(kind=8),    intent(in), value :: skip1, skip2, skip3
  real(kind=8),    intent(in), value :: dx_loc, fudge_descent
  integer(kind=4), intent(in), value :: action_part
  integer(kind=4), intent(in), value :: ilevel
  integer(kind=4), intent(in), value :: head_idx
  integer(kind=4), intent(in), value :: num_parts
  integer(kind=4), intent(in), value :: force_order

  integer :: thread_idx, block_idx, idx, ipart, idim, lp
  real(kind=8) :: skip(1:3), x(1:3), x_coarse(1:3), ff(1:3)
  real(kind=8) :: dteff, xnew
  real(kind=dp) :: gamma, norm2, fnorm, delta
  logical :: ok_level

  thread_idx = threadIdx%x - 1
  block_idx  = blockIdx%x  - 1

  idx = thread_idx + block_idx * blockDim%x
  if (idx >= num_parts) return
  ipart = head_idx + idx

  ! Static particles are not kicked or drifted, only set to this level
  if (static) then
     levelp_d(ipart) = ilevel
     return
  endif

  ff = 0.0_dp

  skip(1) = skip1
  skip(2) = skip2
  skip(3) = skip3

  x = 0.0_dp
  do idim = 1, ndim
     x(idim) = (xp_d(ipart + (idim-1)*leading) + skip(idim)) / dx_loc
  end do

  if (force_order > 2) then

     ! TSC/PCS at level ilevel only, as host tsc/pcs_kick_drift_part
     call gather_bspline_force_part(force_order, f_d, hash_key_d, hash_val_d, hash_size_d, &
          & ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
          & ngridmax, x, ilevel, ff)

  else

     call gather_cic_force_part(f_d, hash_key_d, hash_val_d, hash_size_d, &
          & ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
          & ngridmax, x, ilevel+1, ilevel, ff, ok_level)

     if (.not. ok_level) then

        x_coarse = x / 2.0_dp
        call gather_cic_force_part(f_d, hash_key_d, hash_val_d, hash_size_d, &
             & ckey_max_d, key_off_d, box_ckey_min_d, box_ckey_max_d, periodic_d, &
             & ngridmax, x_coarse, ilevel, ilevel-1, ff, ok_level)

     endif

  endif

  if (action_part == 2) then ! kick-drift

     do idim = 1, ndim

        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             & + ff(idim) * 0.5_dp * dtnew_d(ilevel)

        xnew = xp_d(ipart + (idim-1)*leading) &
             & + vp_d(ipart + (idim-1)*leading) * dtnew_d(ilevel)

        if (periodic_d(idim)) then
           if (xnew < 0.0_dp)            xnew = xnew + box_size_d(idim)
           if (xnew >= box_size_d(idim)) xnew = xnew - box_size_d(idim)
        endif

        xp_d(ipart + (idim-1)*leading) = xnew

     end do

     ! Gradient descent
     if (has_fp .and. (fudge_descent > 0d0)) then

        ! Compute coefficients
        gamma = 0.0_dp
        norm2 = 0.0_dp
        fnorm = 0.0_dp
        do idim = 1, ndim
           gamma = gamma + real(vp_d(ipart + (idim-1)*leading) * (ff(idim) - fp_d(ipart + (idim-1)*leading)), kind=dp)
           norm2 = norm2 + real((ff(idim) - fp_d(ipart + (idim-1)*leading))**2, kind=dp)
           fnorm = fnorm + real(ff(idim)**2, kind=dp)
        enddo
        gamma = gamma * real(dtnew_d(ilevel), kind=dp) ! cm2 s-2
        fnorm = sqrt(fnorm)
        delta = 0.0_dp
        if (norm2 > 0.0_dp) then
           delta = MIN(real(fudge_descent, kind=dp) * real(dtnew_d(ilevel), kind=dp) &
                & * sqrt(abs(gamma)/norm2)*fnorm, 0.5_dp*real(dx_loc, kind=dp))
        endif

        ! Update position
        if(fnorm>0)then
           do idim = 1, ndim
              xp_d(ipart + (idim-1)*leading) = xp_d(ipart + (idim-1)*leading) + ff(idim)/fnorm*delta
           end do
        endif

     endif

     ! Store old force
     if (has_fp) then
        do idim = 1, ndim
           fp_d(ipart + (idim-1)*leading) = ff(idim)
        end do
     endif

  else if (action_part == 1) then ! kick-only

     lp = levelp_d(ipart)

     if (lp >= ilevel) then
        dteff = dtnew_d(lp)
     else
        dteff = dtold_d(lp)
     endif

     levelp_d(ipart) = ilevel

     do idim = 1, ndim
        vp_d(ipart + (idim-1)*leading) = vp_d(ipart + (idim-1)*leading) &
             & + ff(idim) * 0.5_dp * dteff
     end do

  endif

end subroutine kick_drift_part_kernel

subroutine gpu_kick_drift_part(sim, ilevel, action_part)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: action_part

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Refresh the persistent (module-scope) device time-step arrays for this step.
  dtnew_part_d = sim%g%dtnew
  dtold_part_d = sim%g%dtold

  head_idx = sim%p%headp(ilevel)
  tail_idx = sim%p%tailp(ilevel)
  num_parts = tail_idx - head_idx + 1

  if (num_parts > 0) then

     num_threads = 128
     num_blocks  = (num_parts + num_threads - 1) / num_threads

     call nvtxStartRange("gpu_kick_drift_part", color=4) ! purple
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(xp, vp, xp, levelp, &
          & f, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, box_size, periodic, sim%r%ngridmax, &
          & dtnew_part_d, dtold_part_d, &
          & skip1, skip2, skip3, dx_loc, 0d0, action_part, ilevel, head_idx, num_parts, &
          & int(sim%r%npartmax,8), .false., sim%p%static, &
          & sim%r%part_force_interpolation_scheme+1)
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

  endif

end subroutine gpu_kick_drift_part

subroutine gpu_kick_drift_star(sim, ilevel, action_part)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: action_part

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Refresh the persistent (module-scope) device time-step arrays for this step.
  dtnew_part_d = sim%g%dtnew
  dtold_part_d = sim%g%dtold

  head_idx = sim%star%headp(ilevel)
  tail_idx = sim%star%tailp(ilevel)
  num_parts = tail_idx - head_idx + 1

  if (num_parts > 0) then

     num_threads = 128
     num_blocks  = (num_parts + num_threads - 1) / num_threads

     call nvtxStartRange("gpu_kick_drift_star", color=4) ! purple
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(star_xp, star_vp, star_xp, &
          & star_levelp, f, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, box_size, periodic, sim%r%ngridmax, &
          & dtnew_part_d, dtold_part_d, &
          & skip1, skip2, skip3, dx_loc, 0d0, action_part, ilevel, head_idx, num_parts, &
          & int(sim%r%nstarmax,8), .false., sim%star%static, &
          & sim%r%star_force_interpolation_scheme+1)
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

  endif

end subroutine gpu_kick_drift_star

subroutine gpu_kick_drift_sink(sim, ilevel, action_part)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: action_part

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks
  real(kind=8) :: fudge_descent, dx_loc, skip1, skip2, skip3

  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)
  fudge_descent = 0d0
  if ((sim%g%nstep_coarse > 0) .and. sim%r%sink_descent) then
     fudge_descent = sim%r%fudge_descent
  endif

  ! Refresh the time step on device
  dtnew_part_d = sim%g%dtnew
  dtold_part_d = sim%g%dtold

  head_idx = sim%sink%headp(ilevel)
  tail_idx = sim%sink%tailp(ilevel)
  num_parts = tail_idx - head_idx + 1

  if (num_parts > 0) then

     num_threads = 128
     num_blocks  = (num_parts + num_threads - 1) / num_threads

     call nvtxStartRange("gpu_kick_drift_sink", color=4) ! purple
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(sink_xp, sink_vp, sink_fp, sink_levelp, &
          & f, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, box_size, periodic, sim%r%ngridmax, &
          & dtnew_part_d, dtold_part_d, &
          & skip1, skip2, skip3, dx_loc, fudge_descent, &
          & action_part, ilevel, head_idx, num_parts, &
          & int(sim%r%nsinkmax,8), .true., sim%sink%static, &
          & sim%r%sink_force_interpolation_scheme+1)
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

  endif

end subroutine gpu_kick_drift_sink

subroutine gpu_kick_drift_core(sim, ilevel, action_part)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
  integer, intent(in) :: ilevel
  integer, intent(in) :: action_part

  integer(kind=4) :: head_idx, tail_idx, num_parts
  integer :: num_threads, num_blocks
  real(kind=8) :: dx_loc, skip1, skip2, skip3

  dx_loc = sim%r%boxlen/2**ilevel
  skip1 = sim%m%skip(1)
  skip2 = sim%m%skip(2)
  skip3 = sim%m%skip(3)

  ! Refresh the time step on device
  dtnew_part_d = sim%g%dtnew
  dtold_part_d = sim%g%dtold

  head_idx = sim%core%headp(ilevel)
  tail_idx = sim%core%tailp(ilevel)
  num_parts = tail_idx - head_idx + 1

  if (num_parts > 0) then

     num_threads = 128
     num_blocks  = (num_parts + num_threads - 1) / num_threads

     ! Cores keep their force in fp, with no gradient descent
     call nvtxStartRange("gpu_kick_drift_core", color=4) ! purple
     call kick_drift_part_kernel<<<num_blocks, num_threads>>>(core_xp, core_vp, core_fp, core_levelp, &
          & f, hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
          & box_ckey_min, box_ckey_max, box_size, periodic, sim%r%ngridmax, &
          & dtnew_part_d, dtold_part_d, &
          & skip1, skip2, skip3, dx_loc, 0d0, &
          & action_part, ilevel, head_idx, num_parts, &
          & int(sim%r%ncoremax,8), .true., sim%core%static, &
          & sim%r%sink_force_interpolation_scheme+1)
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()

  endif

end subroutine gpu_kick_drift_core

subroutine gpu_kick_drift_tree(sim, ilevel, action_part)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
