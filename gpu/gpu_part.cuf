  real(kind=8) :: q_h(1:ndim+1)
  real(kind=8), device :: q_d(1:ndim+1)

  ! If not ALL and not STAR return
  if (rtype /= 0 .and. rtype /= 2) return

  ! Coarsest level: accumulate global monopole and dipole.
  if (ilevel == sim%r%levelmin .and. sim%star%npart > 0) then

     num_threads = 256
     num_blocks  = (sim%star%npart + num_threads - 1) / num_threads

     q_d = 0.0_dp
     call nvtxStartRange("gpu_bspline_star:multipole", color=4)
     call multipole_q_kernel<<<num_blocks, num_threads>>>(star_xp, star_mp, q_d, &
          & 1, sim%star%npart, int(sim%r%nstarmax,8))
     call GPU_Error_Check(__FILE__, __LINE__)
     call nvtxEndRange()
     q_h = q_d

     do idim = 1, ndim+1
        sim%g%multipole%q(idim) = sim%g%multipole%q(idim) + q_h(idim)
     end do

  endif

  ! Particle index range for the deposit: everything at or below ilevel.
  head_idx = sim%star%headp(ilevel)
  tail_idx = sim%star%tailp(sim%r%nlevelmax)
  num_parts = tail_idx - head_idx + 1

  if (num_parts <= 0) return

  dx_loc  = sim%r%boxlen/2**ilevel
  vol_loc = dx_loc**ndim

  num_threads = 256
  num_blocks  = (num_parts + num_threads - 1) / num_threads
  call nvtxStartRange("gpu_bspline_star:deposit", color=4)
  call bspline_part_kernel<<<num_blocks, num_threads>>>(&
       & star_sortp, head_idx, num_parts, &
       & hash_key, hash_val, sim%m%hash_size, ckey_max, key_off, &
       & box_ckey_min, box_ckey_max, periodic, &
       & star_xp, star_mp, rho, nref, &
       & real(sim%m%skip(1),kind=dp), real(sim%m%skip(2),kind=dp), real(sim%m%skip(3),kind=dp), &
       & real(dx_loc,kind=dp), real(vol_loc,kind=dp), real(sim%r%mass_sph,kind=dp), .true., &
       & real(sim%r%m_refine(ilevel),kind=dp), real(sim%r%mass_cut_refine,kind=dp), &
       & order, ilevel, int(sim%r%nstarmax,8))
  call GPU_Error_Check(__FILE__, __LINE__)
  call nvtxEndRange()

end subroutine gpu_bspline_star

!> Host dispatcher for the GPU TSC/PCS deposit of sink particles
!> (order = sink_mass_deposition_scheme + 1).
subroutine gpu_bspline_sink(sim, ilevel, rtype, order)
  use nvtx
  use ramses_commons, only: ramses_t
  type(ramses_t), intent(inout) :: sim
