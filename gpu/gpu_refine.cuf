  ! =========================================================================
  attributes(grid_global) subroutine sort_gather_scatter_grid_flag(grid, &
      &flag1, flag2, swap_global, head_idx, num_octs)
    use cooperative_groups
    implicit none
    type(oct), device :: grid(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    type(grid_group) :: gg
    gg = this_grid()

    call sort_gather_grid_impl(flag2, grid, swap_global, head_idx, num_octs)
    call syncthreads(gg)

    call sort_scatter_grid_impl(grid, flag2, head_idx, num_octs)
    call syncthreads(gg)

    call sort_gather_flag_impl(flag2, flag1, swap_global, head_idx, num_octs)
    call syncthreads(gg)

    call sort_scatter_flag_impl(flag1, flag2, head_idx, num_octs)

  end subroutine sort_gather_scatter_grid_flag
  ! =========================================================================

  ! =========================================================================
  attributes(grid_global) subroutine sort_gather_scatter_force_phi(f, phi, phi_old, &
      & nref, swap_global, head_idx, num_octs)

    use cooperative_groups
    implicit none

    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: phi(1:twotondim,*)
    real(kind=dp), device :: phi_old(1:twotondim,*)
    real(kind=dp), device :: nref(1:twotondim,*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    type(grid_group) :: gg
    gg = this_grid()

    call sort_gather_force_impl(nref, f, 1, swap_global, head_idx, num_octs)
    call syncthreads(gg)

    call sort_scatter_force_impl(f, nref, 1, head_idx, num_octs)
    call syncthreads(gg)

    call sort_gather_force_impl(nref, f, 2, swap_global, head_idx, num_octs)
    call syncthreads(gg)

    call sort_scatter_force_impl(f, nref, 2, head_idx, num_octs)
    call syncthreads(gg)

    call sort_gather_force_impl(nref, f, 3, swap_global, head_idx, num_octs)
    call syncthreads(gg)

    call sort_scatter_force_impl(f, nref, 3, head_idx, num_octs)
    call syncthreads(gg)

    call sort_gather_phi_impl(nref, phi, swap_global, head_idx, num_octs)
    call syncthreads(gg)

    call sort_scatter_phi_impl(phi, nref, head_idx, num_octs)
    call syncthreads(gg)

    call sort_gather_phi_impl(nref, phi_old, swap_global, head_idx, num_octs)
    call syncthreads(gg)

    call sort_scatter_phi_impl(phi_old, nref, head_idx, num_octs)

  end subroutine sort_gather_scatter_force_phi
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine update_father_array(grid, father, hash_key, hash_val, hash_size, &
       & ckey_max, key_off, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: father(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer(kind=8) :: parent_key, offset, ix, iy, iz, nx
    integer :: thread_idx, block_idx, oct_idx, parent_idx
    integer :: ilevel

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute parent oct hash table key
    ilevel = grid(oct_idx)%lev - 1
    ix = int(grid(oct_idx)%ckey(1) / 2, kind=8)
    iy = int(grid(oct_idx)%ckey(2) / 2, kind=8)
    iz = int(grid(oct_idx)%ckey(3) / 2, kind=8)
    nx = int(ckey_max(ilevel), kind=8)
    offset = key_off(ilevel)
    parent_key = offset + ix + iy * nx + iz * nx * nx

    ! Get parent oct index in memory
    parent_idx = hash_get(hash_key, hash_val, hash_size, parent_key)
    father(oct_idx) = parent_idx

  end subroutine update_father_array
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine update_nbor_array(nbor, grid, hash_key, hash_val, hash_size, &
       & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_subgrids, &
       & input_ind, prefix_sum)
    logical, device :: periodic(1:3)
    type(oct), device :: grid(*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), device, optional :: prefix_sum(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=4), device :: box_ckey_min(1:ndim,*)
    integer(kind=4), device :: box_ckey_max(1:ndim,*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_subgrids
    integer(kind=4), intent(in), value :: input_ind

    integer(kind=8) :: key, offset, ix, iy, iz, nx
    integer :: thread_idx, block_idx, subgrid_idx, oct_idx, nbor_idx
    integer :: ilevel, i, j, k, ind, idim
    integer(kind=4), dimension(1:ndim) ::ckey

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute subgrid and leading oct idx
    subgrid_idx = thread_idx + block_idx * blockDim%x
    if (subgrid_idx >= num_subgrids) return
    subgrid_idx = head_idx + subgrid_idx
    oct_idx = (subgrid_idx - 1) * nsubgridtondim + 1

    ! Compute offsets to get nbor oct
    ind = input_ind - 1
    k = ind / nsubgridp2sq
    ind = ind - k * nsubgridp2sq
    j = ind / nsubgridp2
    i = ind - j * nsubgridp2

    ! Compute neighboring oct Cartesian key
    ilevel = grid(oct_idx)%lev
    ckey(1) = (grid(oct_idx)%ckey(1) / nsubgrid) * nsubgrid + i - 1
    ckey(2) = (grid(oct_idx)%ckey(2) / nsubgrid) * nsubgrid + j - 1
    ckey(3) = (grid(oct_idx)%ckey(3) / nsubgrid) * nsubgrid + k - 1

    ! Periodic boundary conditions
    do idim = 1,ndim
       if(periodic(idim))then
          if(ckey(idim)<box_ckey_min(idim,ilevel))ckey(idim)=box_ckey_max(idim,ilevel)-1
          if(ckey(idim)>=box_ckey_max(idim,ilevel))ckey(idim)=box_ckey_min(idim,ilevel)
       endif
    enddo

    ! Conpute key
    ix = int(ckey(1), kind=8)
    iy = int(ckey(2), kind=8)
    iz = int(ckey(3), kind=8)
    nx = int(ckey_max(ilevel), kind=8)
    offset = key_off(ilevel)
    key = offset + ix + iy * nx + iz * nx * nx

    ! Get parent oct index in memory
    nbor_idx = hash_get(hash_key, hash_val, hash_size, key)
    nbor(input_ind, subgrid_idx) = nbor_idx

    ! If nbor index is zero set prefix_sum to one
    if (present(prefix_sum)) then
       if(nbor_idx == 0)then
          prefix_sum(subgrid_idx) = 1
       else
          prefix_sum(subgrid_idx) = 0
       endif
    endif

  end subroutine update_nbor_array
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine init_prefix_sum_nbor(nbor, prefix_sum, head_idx, num_subgrids, input_ind)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_subgrids
    integer(kind=4), intent(in), value :: input_ind

    integer :: subgrid_idx, thread_idx, block_idx, nbor_idx

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    subgrid_idx = thread_idx + block_idx * blockDim%x
    if (subgrid_idx >= num_subgrids) return
    subgrid_idx = head_idx + subgrid_idx

    ! Get nbor idx
    nbor_idx = nbor(input_ind, subgrid_idx)

    ! If nbor index is zero set prefix_sum to one
    if(nbor_idx == 0)then
       prefix_sum(subgrid_idx) = 1
    else
       prefix_sum(subgrid_idx) = 0
    endif

  end subroutine init_prefix_sum_nbor
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine compute_cache_swap_table(swap_local, prefix_sum, head_idx, num_subgrids)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_subgrids
    call compute_cache_swap_table_impl(swap_local, prefix_sum, head_idx, num_subgrids)
  end subroutine compute_cache_swap_table

  ! =========================================================================
  attributes(device) subroutine compute_cache_swap_table_impl(swap_local, prefix_sum, head_idx, num_subgrids)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_subgrids

    integer :: subgrid_idx, thread_idx, block_idx, cache_idx
    integer :: previous_sum, bit

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute new oct idx
    subgrid_idx = thread_idx + block_idx * blockDim%x
    if (subgrid_idx >= num_subgrids) return
    subgrid_idx = head_idx + subgrid_idx

    ! Get previous prefix sum
    if (subgrid_idx > head_idx)then
       previous_sum = prefix_sum(subgrid_idx - 1)
    else
       previous_sum = 0
    endif

    ! Compute original table value (0 or 1)
    bit = prefix_sum(subgrid_idx) - previous_sum

    ! Compute new index in the cache
    if(bit == 1)then
       cache_idx = previous_sum + 1
       swap_local(cache_idx) = subgrid_idx
    endif

  end subroutine compute_cache_swap_table_impl

  ! =========================================================================
  attributes(grid_global) subroutine make_cache_insert_ghost_octs(grid, flag1, &
       & uold, bold, f, phi, phi_old, swap_local, prefix_sum, father, nbor, hash_key, &
       & hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, &
       & periodic, ngridmax, ncachemax, ifree_cache, cache_overflow, input_ind, head_idx, &
       & num_subgrids, interpol_var, interpol_type, smallr)

    use cooperative_groups

    implicit none
    type(oct), device :: grid(*)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: phi(1:twotondim,*)
    real(kind=dp), device :: phi_old(1:twotondim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), device :: father(*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:ndim,*)
    integer(kind=4), device :: box_ckey_max(1:ndim,*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    logical, device :: periodic(1:3)
    integer(kind=4), device :: ifree_cache, cache_overflow
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: ngridmax, ncachemax
    integer(kind=4), intent(in), value :: input_ind
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_subgrids
    integer(kind=4), intent(in), value :: interpol_var, interpol_type
    real(kind=dp), intent(in), value :: smallr
    integer(kind=4) :: num_octs

    type(grid_group) :: gg
    gg = this_grid()

    ! all threads need the value
    num_octs = prefix_sum(head_idx + num_subgrids - 1)

    ! Compute cache swap table
    call compute_cache_swap_table_impl(swap_local, prefix_sum, head_idx, num_subgrids)
    call syncthreads(gg)

    ! Make new ghost octs in cache
    call make_cache_octs_impl(grid, flag1, uold, bold, f, phi, phi_old, swap_local, father, nbor, &
        & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
        & ngridmax, ncachemax, ifree_cache, cache_overflow, num_octs, input_ind, interpol_var, interpol_type, smallr)
    call syncthreads(gg)

    ! Insert new octs in hash table
    call insert_hash_cache_impl(grid, hash_key, hash_val, hash_size, &
        & ckey_max, key_off, ngridmax, ifree_cache, cache_overflow, num_octs)
    call syncthreads(gg)

    ! Increment ifree_cache on device
    if ((1 == threadIdx%x) .AND. (1 == blockIdx%x) .AND. (cache_overflow == 0)) then
      ifree_cache = ifree_cache + num_octs
    endif

  end subroutine make_cache_insert_ghost_octs
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine make_cache_octs(grid, flag1, uold, bold, f, phi, phi_old, swap_local, father, nbor, &
       & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
       & ngridmax, ncachemax, ifree_cache, cache_overflow, num_octs, input_ind, interpol_var, interpol_type, smallr)
    type(oct), device :: grid(*)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: phi(1:twotondim,*)
    real(kind=dp), device :: phi_old(1:twotondim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: father(*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:ndim,*)
    integer(kind=4), device :: box_ckey_max(1:ndim,*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    logical, device :: periodic(1:3)
    integer(kind=4), device :: ifree_cache, cache_overflow, num_octs
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: ngridmax, ncachemax
    integer(kind=4), intent(in), value :: input_ind
    integer(kind=4), intent(in), value :: interpol_var, interpol_type
    real(kind=dp), intent(in), value :: smallr

    call make_cache_octs_impl(grid, flag1, uold, bold, f, phi, phi_old, swap_local, father, nbor, &
        & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
        & ngridmax, ncachemax, ifree_cache, cache_overflow, num_octs, input_ind, interpol_var, interpol_type, smallr)

  end subroutine make_cache_octs

  ! =========================================================================
  attributes(device) subroutine make_cache_octs_impl(grid, flag1, uold, bold, f, phi, phi_old, swap_local, father, nbor, &
       & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
       & ngridmax, ncachemax, ifree_cache, cache_overflow, num_octs, input_ind, interpol_var, interpol_type, smallr)
    type(oct), device :: grid(*)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: phi(1:twotondim,*)
    real(kind=dp), device :: phi_old(1:twotondim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: father(*)
    integer(kind=4), device :: nbor(1:subgridsize,*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:ndim,*)
    integer(kind=4), device :: box_ckey_max(1:ndim,*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    logical, device :: periodic(1:3)
    integer(kind=4), device :: ifree_cache, cache_overflow, num_octs
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: ngridmax, ncachemax
    integer(kind=4), intent(in), value :: input_ind
    integer(kind=4), intent(in), value :: interpol_var, interpol_type
    real(kind=dp), intent(in), value :: smallr

    integer(kind=8) :: hkey, parent_key, offset, ix, iy, iz, nx
    integer :: oct_idx, subgrid_idx, thread_idx, block_idx, cache_idx, parent_idx, cell_idx
    integer :: ind, i, j, k, ilevel, idim, ivar
    integer, dimension(1:ndim) :: ckey
    ! Prolongation scratch for parent stencil and children.
    real(kind=dp) :: u1(0:twondim,1:nvar)
    real(kind=dp) :: u2(1:twotondim,1:nvar)
#ifdef MHD
    real(kind=dp) :: b1(0:twondim,1:6)
    real(kind=dp) :: b2(1:twotondim,1:6)
    real(kind=dp) :: b3(1:twondim,1:twotondim,1:6)
    logical :: refined(1:twondim)
#endif
    integer :: igrid_nbor(0:twondim), ind_nbor(0:twondim)

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute new cache index
    cache_idx = thread_idx + block_idx * blockDim%x
    if (cache_idx >= num_octs) return

    ! Flag cache overflow and skip instead of writing out of bounds
    if (cache_overflow /= 0 .or. ifree_cache + num_octs - 1 > ncachemax) then
       cache_overflow = 1
       return
    endif

    ! Get original subgrid index
    subgrid_idx = swap_local(cache_idx + 1)

    ! Get corresponding leading oct index
    oct_idx = (subgrid_idx - 1) * nsubgridtondim + 1

    ! Get proper idx for cache grid
    cache_idx = ngridmax + ifree_cache + cache_idx

    ! Update nbor index (no race condition)
    nbor(input_ind, subgrid_idx) = cache_idx

    ! Compute offsets to get nbor oct
    ind = input_ind - 1
    k = ind / nsubgridp2sq
    ind = ind - k * nsubgridp2sq
    j = ind / nsubgridp2
    i = ind - j * nsubgridp2

    ! Compute neighboring oct Cartesian key
    ilevel = grid(oct_idx)%lev
    ckey(1) = (grid(oct_idx)%ckey(1) / nsubgrid) * nsubgrid + i - 1
    ckey(2) = (grid(oct_idx)%ckey(2) / nsubgrid) * nsubgrid + j - 1
    ckey(3) = (grid(oct_idx)%ckey(3) / nsubgrid) * nsubgrid + k - 1

    ! Periodic boundary conditions
    do idim = 1,ndim
       if(periodic(idim))then
          if(ckey(idim)<box_ckey_min(idim,ilevel))ckey(idim)=box_ckey_max(idim,ilevel)-1
          if(ckey(idim)>=box_ckey_max(idim,ilevel))ckey(idim)=box_ckey_min(idim,ilevel)
       endif
    enddo

    ! Compute cache oct properties
    grid(cache_idx)%lev = grid(oct_idx)%lev
    do idim = 1, ndim
       grid(cache_idx)%ckey(idim) = ckey(idim)
    end do
    grid(cache_idx)%refined(1:twotondim) = .false.
    flag1(1:twotondim, cache_idx) = 0

    ! Compute new oct Hilbert key
    hkey = hilbert_key(ckey, ilevel - 1)
    grid(cache_idx)%hkey(1) = hkey

    ! Compute parent oct hash table key
    ilevel = ilevel - 1
    ix = int(ckey(1) / 2, kind=8)
    iy = int(ckey(2) / 2, kind=8)
    iz = int(ckey(3) / 2, kind=8)
    nx = int(ckey_max(ilevel), kind=8)
    offset = key_off(ilevel)
    parent_key = offset + ix + iy * nx + iz * nx * nx

    ! Get parent oct index in memory (always exists)
    parent_idx = hash_get(hash_key, hash_val, hash_size, parent_key)
    father(cache_idx) = parent_idx

    ! Get parent cell index
    i = ckey(1) - 2*ix
    j = ckey(2) - 2*iy
    k = ckey(3) - 2*iz
    cell_idx = 1 + i + 2*j + 4*k

#ifdef MHD
    ! divB-preserving MHD prolongation for
    ! cache (ghost) octs.  ilevel is now the parent level, so the cache oct's own
    ! (child) level is ilevel+1 and its Cartesian key is ckey.
    call gather_twondim_parent_stencil(grid, uold, bold, hash_key, hash_val, hash_size, &
         & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, ilevel+1, ckey, parent_idx, cell_idx, u1, &
         & igrid_nbor, ind_nbor, b1, b3, refined)
    call interpol_mhd_d(u1, u2, b1, b2, b3, refined, interpol_var, interpol_type, smallr)
    do ivar = 1, nvar
       do ind = 1, twotondim
          uold(ind,ivar,cache_idx) = u2(ind,ivar)
       end do
    end do
    do ivar = 1, 6
       do ind = 1, twotondim
          bold(ind,ivar,cache_idx) = b2(ind,ivar)
       end do
    end do
#else
#ifdef HYDRO
    ! Hydro prolongation from the 7-point parent stencil (ilevel is the parent level)
    if (interpol_type == 0) then
       do ivar = 1, nvar
          u1(0:twondim,ivar) = uold(cell_idx,ivar,parent_idx)
       end do
    else
       call gather_twondim_parent_stencil(grid, uold, bold, hash_key, hash_val, hash_size, &
            & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, ilevel+1, ckey, parent_idx, cell_idx, u1, &
            & igrid_nbor, ind_nbor)
    end if
    call interpol_hydro_d(u1, u2, interpol_var, interpol_type, smallr)
    do ivar = 1, nvar
       do ind = 1, twotondim
          uold(ind,ivar,cache_idx) = u2(ind,ivar)
       end do
    end do
#endif
#endif

#ifdef GRAV
    ! Straight injection for gravity variables
    do ind = 1, twotondim
       f(ind,1,cache_idx) = f(cell_idx,1,parent_idx)
       f(ind,2,cache_idx) = f(cell_idx,2,parent_idx)
       f(ind,3,cache_idx) = f(cell_idx,3,parent_idx)
       phi(ind,cache_idx) = phi(cell_idx,parent_idx)
       phi_old(ind,cache_idx) = phi_old(cell_idx,parent_idx)
    end do
#endif

  end subroutine make_cache_octs_impl
  ! =========================================================================

  ! =========================================================================
  !> Refresh the hydro and gravity variables of existing cache (ghost) octs
  !> from their parent cells, as in make_cache_octs_impl. One thread per oct.
  attributes(global) subroutine refresh_cache_octs_kernel(grid, uold, bold, f, father, &
       & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
       & head_idx, num_octs, interpol_var, interpol_type, smallr)
    type(oct), device :: grid(*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    integer(kind=4), device :: father(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:ndim,*)
    integer(kind=4), device :: box_ckey_max(1:ndim,*)
    logical, device :: periodic(1:3)
    integer(kind=4), intent(in), value :: head_idx, num_octs
    integer(kind=4), intent(in), value :: interpol_var, interpol_type
    real(kind=dp), intent(in), value :: smallr

    integer :: cache_idx, parent_idx, cell_idx, ind, ivar
    integer, dimension(1:ndim) :: ckey
    ! Prolongation scratch for parent stencil and children.
    real(kind=dp) :: u1(0:twondim,1:nvar)
    real(kind=dp) :: u2(1:twotondim,1:nvar)
#ifdef MHD
    real(kind=dp) :: b1(0:twondim,1:6)
    real(kind=dp) :: b2(1:twotondim,1:6)
    real(kind=dp) :: b3(1:twondim,1:twotondim,1:6)
    logical :: refined(1:twondim)
#endif
    integer :: igrid_nbor(0:twondim), ind_nbor(0:twondim)

    ! Compute cache oct idx
    cache_idx = threadIdx%x - 1 + (blockIdx%x - 1) * blockDim%x
    if (cache_idx >= num_octs) return
    cache_idx = head_idx + cache_idx

    ! Get parent oct and parent cell idx
    parent_idx = father(cache_idx)
    ckey(1:ndim) = grid(cache_idx)%ckey(1:ndim)
    cell_idx = parent_cell_idx(ckey, grid(parent_idx)%ckey)

#ifdef MHD
    ! divB-preserving MHD prolongation
    call gather_twondim_parent_stencil(grid, uold, bold, hash_key, hash_val, hash_size, &
         & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, grid(cache_idx)%lev, ckey, &
         & parent_idx, cell_idx, u1, igrid_nbor, ind_nbor, b1, b3, refined)
    call interpol_mhd_d(u1, u2, b1, b2, b3, refined, interpol_var, interpol_type, smallr)
    do ivar = 1, nvar
       do ind = 1, twotondim
          uold(ind,ivar,cache_idx) = u2(ind,ivar)
       end do
    end do
    do ivar = 1, 6
       do ind = 1, twotondim
          bold(ind,ivar,cache_idx) = b2(ind,ivar)
       end do
    end do
#else
#ifdef HYDRO
    ! Hydro prolongation from the 7-point parent stencil (the parent cell alone for injection)
    if (interpol_type == 0) then
       do ivar = 1, nvar
          u1(0:twondim,ivar) = uold(cell_idx,ivar,parent_idx)
       end do
    else
       call gather_twondim_parent_stencil(grid, uold, bold, hash_key, hash_val, hash_size, &
            & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, grid(cache_idx)%lev, ckey, &
            & parent_idx, cell_idx, u1, igrid_nbor, ind_nbor)
    end if
    call interpol_hydro_d(u1, u2, interpol_var, interpol_type, smallr)
    do ivar = 1, nvar
       do ind = 1, twotondim
          uold(ind,ivar,cache_idx) = u2(ind,ivar)
       end do
    end do
#endif
#endif

#ifdef GRAV
    ! Straight injection for gravity force
    do ind = 1, twotondim
       f(ind,1,cache_idx) = f(cell_idx,1,parent_idx)
       f(ind,2,cache_idx) = f(cell_idx,2,parent_idx)
       f(ind,3,cache_idx) = f(cell_idx,3,parent_idx)
    end do
#endif

  end subroutine refresh_cache_octs_kernel
  ! =========================================================================

end module refine_device
