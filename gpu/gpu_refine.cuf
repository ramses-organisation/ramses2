module refine_device
  use amr_parameters, only: dp, ndim, twotondim, twondim, nhilbert
  use hydro_parameters, only: nvar, nener
#ifdef DO_RT
  use rt_parameters, only: nrtvar
#endif
  use oct_commons, only: oct
  use gpu_utils
  use cudafor
  implicit none

contains

  include 'gpu_hash.cuf'
  include 'gpu_hilbert.cuf'
  include 'gpu_cell.cuf'
#include "gpu_interpol.cuf"

! Hydro prolongation (interpol_hydro_d).

! Interpolate the parent stencil u1 (father cell and its 2*ndim neighbours)
! into the 2**ndim children u2, as interpol_hydro on the CPU.
! Written by Daniel Han (mini-ramses version October 2026).
attributes(device) subroutine interpol_hydro_d(u1, u2, interpol_var, interpol_type, smallr)
  implicit none
  real(kind=dp) :: u1(0:twondim,1:nvar)
  real(kind=dp) :: u2(1:twotondim,1:nvar)
  integer, value :: interpol_var, interpol_type
  real(kind=dp), value :: smallr
#if NENER>0
  integer :: irad
#endif
  integer :: j, ivar, idim, ind
  real(kind=dp) :: xc(1:8,1:3)
  real(kind=dp) :: a(0:twondim)
  real(kind=dp) :: ekin, erad

  ! Set position of cell centers relative to grid center
  call child_centers_d(xc)

  ! If necessary, convert fathers total energy into internal energy
  if (interpol_var == 1) then
     do j = 0, twondim
        ekin = 0.0_dp
        do idim = 1, 3
           ekin = ekin + 0.5_dp*u1(j,idim+1)**2/max(u1(j,1),smallr)
        end do
        erad = 0.0_dp
#if NENER>0
        do irad = 1, nener
           erad = erad + u1(j,5+irad)
        end do
#endif
        u1(j,5) = u1(j,5) - ekin - erad
     end do
  end if

  ! Loop over interpolation variables
  do ivar = 1, nvar

     ! Load father variable
     do j = 0, twondim
        a(j) = u1(j,ivar)
     end do

     ! Interpolate over children cells
     call interpol_one_var_d(a, u2(:,ivar), xc, interpol_type)

  end do
  ! End loop over variables

  ! If necessary, convert children internal energy into total energy
  if (interpol_var == 1) then
     do ind = 1, twotondim
        ekin = 0.0_dp
        do idim = 1, 3
           ekin = ekin + 0.5_dp*u2(ind,idim+1)**2/max(u2(ind,1),smallr)
        end do
        erad = 0.0_dp
#if NENER>0
        do irad = 1, nener
           erad = erad + u2(ind,5+irad)
        end do
#endif
        u2(ind,5) = u2(ind,5) + ekin + erad
     end do
  end if

end subroutine interpol_hydro_d

#ifdef MHD
! divB-preserving MHD prolongation.

! 2D TVD face-slope limiter (interpol_type selects mode).
attributes(device) subroutine compute_2d_tvd_d(b, s, interpol_type)
  implicit none
  real(kind=dp) :: b(0:4)
  real(kind=dp) :: s(1:2)
  integer, value :: interpol_type
  real(kind=dp) :: dsgn, dlim, dcen, dlft, drgt, slop, rtype

  if (interpol_type == 3) then
     dlft = 0.5_dp*(b(0) - b(1))
     drgt = 0.5_dp*(b(2) - b(0))
     s(1) = dlft + drgt
     dlft = 0.5_dp*(b(0) - b(3))
     drgt = 0.5_dp*(b(4) - b(0))
     s(2) = dlft + drgt
     return
  end if

  rtype = real(interpol_type, kind=dp)

  dlft = rtype*(b(0) - b(1))
  drgt = rtype*(b(2) - b(0))
  dcen = 0.5_dp*(dlft+drgt)/rtype
  dsgn = sign(1.0_dp, dcen)
  slop = min(abs(dlft),abs(drgt))
  dlim = slop
  if ((dlft*drgt) <= 0.0_dp) dlim = 0.0_dp
  s(1) = dsgn*min(dlim,abs(dcen))

  dlft = rtype*(b(0) - b(3))
  drgt = rtype*(b(4) - b(0))
  dcen = 0.5_dp*(dlft+drgt)/rtype
  dsgn = sign(1.0_dp, dcen)
  slop = min(abs(dlft),abs(drgt))
  dlim = slop
  if ((dlft*drgt) <= 0.0_dp) dlim = 0.0_dp
  s(2) = dsgn*min(dlim,abs(dcen))
end subroutine compute_2d_tvd_d

! TVD interpolation of fine B onto coarse side faces.
attributes(device) subroutine interpol_faces_d(B1, u, v, w, interpol_type)
  implicit none
  real(kind=dp) :: B1(0:twondim,1:6)
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)
  integer, value :: interpol_type
  integer :: i, j, k
  real(kind=dp) :: b(0:4)
  real(kind=dp) :: s(1:2)

  ! Left face along direction x (interpolate Bx)
  b(0) = B1(0,1); b(1) = B1(3,1); b(2) = B1(4,1); b(3) = B1(5,1); b(4) = B1(6,1)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do j = 0, 1
  do k = 0, 1
     u(-1,j,k) = b(0) + 0.5_dp*s(1)*(real(j,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Right face along direction x (interpolate Bx)
  b(0) = B1(0,4); b(1) = B1(3,4); b(2) = B1(4,4); b(3) = B1(5,4); b(4) = B1(6,4)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do j = 0, 1
  do k = 0, 1
     u(+1,j,k) = b(0) + 0.5_dp*s(1)*(real(j,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Left face along direction y (interpolate By)
  b(0) = B1(0,2); b(1) = B1(1,2); b(2) = B1(2,2); b(3) = B1(5,2); b(4) = B1(6,2)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do k = 0, 1
     v(i,-1,k) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Right face along direction y (interpolate By)
  b(0) = B1(0,5); b(1) = B1(1,5); b(2) = B1(2,5); b(3) = B1(5,5); b(4) = B1(6,5)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do k = 0, 1
     v(i,+1,k) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(k,kind=dp)-0.5_dp)
  end do
  end do

  ! Left face along direction z (interpolate Bz)
  b(0) = B1(0,3); b(1) = B1(1,3); b(2) = B1(2,3); b(3) = B1(3,3); b(4) = B1(4,3)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do j = 0, 1
     w(i,j,-1) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(j,kind=dp)-0.5_dp)
  end do
  end do

  ! Right face along direction z (interpolate Bz)
  b(0) = B1(0,6); b(1) = B1(1,6); b(2) = B1(2,6); b(3) = B1(3,6); b(4) = B1(4,6)
  s(1:2) = 0.0_dp
  if (interpol_type > 0) call compute_2d_tvd_d(b, s, interpol_type)
  do i = 0, 1
  do j = 0, 1
     w(i,j,+1) = b(0) + 0.5_dp*s(1)*(real(i,kind=dp)-0.5_dp) + 0.5_dp*s(2)*(real(j,kind=dp)-0.5_dp)
  end do
  end do
end subroutine interpol_faces_d

! Copy refined sibling face-B from neighbour.
attributes(device) subroutine copy_from_refined_faces_d(B3, refined, u, v, w)
  implicit none
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)
  integer :: i, j, k, ind

  ! Left face along direction x
  do j = 0, 1
  do k = 0, 1
     ind = 1 + 1 + j*2 + k*4
     if (refined(1)) u(-1,j,k) = B3(1,ind,4)
  end do
  end do
  ! Right face along direction x
  do j = 0, 1
  do k = 0, 1
     ind = 1 + 0 + j*2 + k*4
     if (refined(2)) u(+1,j,k) = B3(2,ind,1)
  end do
  end do

  ! Left face along direction y
  do i = 0, 1
  do k = 0, 1
     ind = 1 + i + 1*2 + k*4
     if (refined(3)) v(i,-1,k) = B3(3,ind,5)
  end do
  end do
  ! Right face along direction y
  do i = 0, 1
  do k = 0, 1
     ind = 1 + i + 0*2 + k*4
     if (refined(4)) v(i,+1,k) = B3(4,ind,2)
  end do
  end do

  ! Left face along direction z
  do i = 0, 1
  do j = 0, 1
     ind = 1 + i + j*2 + 1*4
     if (refined(5)) w(i,j,-1) = B3(5,ind,6)
  end do
  end do
  ! Right face along direction z
  do i = 0, 1
  do j = 0, 1
     ind = 1 + i + j*2 + 0*4
     if (refined(6)) w(i,j,+1) = B3(6,ind,3)
  end do
  end do
end subroutine copy_from_refined_faces_d

! Reconstruct interior face-B with divB=0 constraint.
attributes(device) subroutine cmp_central_faces_d(u, v, w)
  implicit none
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)
  integer :: i, j, k, ii, jj, kk
  real(kind=dp) :: UXX, VYY, WZZ, UXYZ, VXYZ, WXYZ

  UXX = 0.0_dp; VYY = 0.0_dp; WZZ = 0.0_dp
  UXYZ = 0.0_dp; VXYZ = 0.0_dp; WXYZ = 0.0_dp

  do i = 0, 1
  do j = 0, 1
  do k = 0, 1
     ii = 2*i-1
     jj = 2*j-1
     kk = 2*k-1
     UXX  = UXX  + (real(ii*jj,kind=dp)*v(i,jj,k)+real(ii*kk,kind=dp)*w(i,j,kk))*0.125_dp
     VYY  = VYY  + (real(jj*kk,kind=dp)*w(i,j,kk)+real(ii*jj,kind=dp)*u(ii,j,k))*0.125_dp
     WZZ  = WZZ  + (real(ii*kk,kind=dp)*u(ii,j,k)+real(jj*kk,kind=dp)*v(i,jj,k))*0.125_dp
     UXYZ = UXYZ + (real(ii*jj*kk,kind=dp)*u(ii,j,k))*0.125_dp
     VXYZ = VXYZ + (real(ii*jj*kk,kind=dp)*v(i,jj,k))*0.125_dp
     WXYZ = WXYZ + (real(ii*jj*kk,kind=dp)*w(i,j,kk))*0.125_dp
  end do
  end do
  end do

  ! Bx on central faces
  do j = 0, 1
  do k = 0, 1
     u(0,j,k) = 0.5_dp*(u(-1,j,k)+u(+1,j,k)) + UXX &
          &   + (real(k,kind=dp)-0.5_dp)*VXYZ + (real(j,kind=dp)-0.5_dp)*WXYZ
  end do
  end do
  ! By on central faces
  do i = 0, 1
  do k = 0, 1
     v(i,0,k) = 0.5_dp*(v(i,-1,k)+v(i,+1,k)) + VYY &
          &   + (real(i,kind=dp)-0.5_dp)*WXYZ + (real(k,kind=dp)-0.5_dp)*UXYZ
  end do
  end do
  ! Bz on central faces
  do i = 0, 1
  do j = 0, 1
     w(i,j,0) = 0.5_dp*(w(i,j,-1)+w(i,j,+1)) + WZZ &
          &   + (real(j,kind=dp)-0.5_dp)*UXYZ + (real(i,kind=dp)-0.5_dp)*VXYZ
  end do
  end do
end subroutine cmp_central_faces_d

! Balsara constrained face-B prolongation.
attributes(device) subroutine interpol_mag_d(B1, B2, B3, refined, interpol_type)
  implicit none
  real(kind=dp) :: B1(0:twondim,1:6)
  real(kind=dp) :: B2(1:twotondim,1:6)
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)
  integer, value :: interpol_type
  integer :: i, j, k, ind
  real(kind=dp) :: u(-1:1,0:1,0:1)
  real(kind=dp) :: v(0:1,-1:1,0:1)
  real(kind=dp) :: w(0:1,0:1,-1:1)

  ! Compute interpolated fine B over coarse side faces
  call interpol_faces_d(B1, u, v, w, interpol_type)
  ! Get fine B from refined faces, if any
  call copy_from_refined_faces_d(B3, refined, u, v, w)
  ! Compute interpolated fine B inside coarse cell
  call cmp_central_faces_d(u, v, w)

  ! Scatter results onto the 8 children's 6 face-B slots
  do i = 0, 1
  do j = 0, 1
  do k = 0, 1
     ind = 1 + i + 2*j + 4*k
     B2(ind,1) = u(i-1,j,k)
     B2(ind,4) = u(i,j,k)
     B2(ind,2) = v(i,j-1,k)
     B2(ind,5) = v(i,j,k)
     B2(ind,3) = w(i,j,k-1)
     B2(ind,6) = w(i,j,k)
  end do
  end do
  end do
end subroutine interpol_mag_d

! Constrained MHD prolongation of hydro and face-B.

attributes(device) subroutine interpol_mhd_d(u1, u2, B1, B2, B3, refined, &
     & interpol_var, interpol_type, smallr)
  implicit none
  real(kind=dp) :: u1(0:twondim,1:nvar)
  real(kind=dp) :: u2(1:twotondim,1:nvar)
  real(kind=dp) :: B1(0:twondim,1:6)
  real(kind=dp) :: B2(1:twotondim,1:6)
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)
  integer, value :: interpol_var, interpol_type
  real(kind=dp), value :: smallr
  integer :: irad
  integer :: j, ivar, idim, ind, ix, iy, iz
  real(kind=dp) :: xc(1:twotondim,1:3)
  real(kind=dp) :: a(0:twondim)
  real(kind=dp) :: ww(1:ndim)
  real(kind=dp) :: ekin, emag, erad

  ! Set position of cell centers relative to grid center
  do ind = 1, twotondim
     iz = (ind-1)/4
     iy = (ind-1-4*iz)/2
     ix = (ind-1-2*iy-4*iz)
     xc(ind,1) = (real(ix,kind=dp)-0.5_dp)
     xc(ind,2) = (real(iy,kind=dp)-0.5_dp)
     xc(ind,3) = (real(iz,kind=dp)-0.5_dp)
  end do

  ! If necessary, convert father total energy into internal energy
  if (interpol_var == 1) then
     do j = 0, twondim
        ekin = 0.0_dp
        do idim = 1, 3
           ekin = ekin + 0.5_dp*u1(j,idim+1)**2/max(u1(j,1),smallr)
        end do
        emag = 0.0_dp
        do idim = 1, 3
           emag = emag + 0.125_dp*(B1(j,idim)+B1(j,idim+3))**2
        end do
        erad = 0.0_dp
        do irad = 1, nener
           erad = erad + u1(j,5+irad)
        end do
        u1(j,5) = u1(j,5) - ekin - emag - erad
     end do
  end if

  ! Cell-centred hydro variables (B handled on faces).
  ! nvar+3-ndim collapses to nvar, so only the hydro slots (and passive
  ! scalars) are interpolated here; cell-centred B comes from interpol_mag.
  do ivar = 1, nvar
     ! Load father variable
     do j = 0, twondim
        a(j) = u1(j,ivar)
     end do
     ! Reset gradient
     ww(1:ndim) = 0.0_dp
     ! Compute gradient with chosen limiter
     if (interpol_type == 1) call compute_limiter_minmod_d(a, ww)
     if (interpol_type == 2) call compute_limiter_central_d(a, ww)
     if (interpol_type == 3) call compute_central_d(a, ww)
     ! Interpolate over children cells
     do ind = 1, twotondim
        u2(ind,ivar) = a(0)
        do idim = 1, ndim
           u2(ind,ivar) = u2(ind,ivar) + ww(idim)*xc(ind,idim)
        end do
     end do
  end do

  ! Interpolate face-centred MHD variables (Balsara constrained)
  call interpol_mag_d(B1, B2, B3, refined, interpol_type)

  ! If necessary, convert children internal energy into total energy
  if (interpol_var == 1) then
     do ind = 1, twotondim
        ekin = 0.0_dp
        do idim = 1, 3
           ekin = ekin + 0.5_dp*u2(ind,idim+1)**2/max(u2(ind,1),smallr)
        end do
        emag = 0.0_dp
        do idim = 1, 3
           emag = emag + 0.125_dp*(B2(ind,idim)+B2(ind,idim+3))**2
        end do
        erad = 0.0_dp
        do irad = 1, nener
           erad = erad + u2(ind,5+irad)
        end do
        u2(ind,5) = u2(ind,5) + ekin + emag + erad
     end do
  end if
end subroutine interpol_mhd_d
#endif

#ifdef MHD
! Face B of ghost octs prolongated from the coarser level, as in make_cache_octs.
attributes(global) subroutine nimhd_ghost_b_kernel(grid, uold, b, father, hash_key, hash_val, hash_size, &
     & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, head_idx, num_octs, interpol_type)
  implicit none
  type(oct), device :: grid(*)
  real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
  real(kind=dp), device :: b(1:twotondim,1:6,*)
  integer(kind=4), device :: father(*)
  integer(kind=8), device :: hash_key(*)
  integer(kind=4), device :: hash_val(*)
  integer(kind=4), value :: hash_size
  integer(kind=4), device :: ckey_max(*)
  integer(kind=8), device :: key_off(*)
  integer(kind=4), device :: box_ckey_min(1:ndim,*)
  integer(kind=4), device :: box_ckey_max(1:ndim,*)
  logical, device :: periodic(1:3)
  integer(kind=4), value :: head_idx, num_octs, interpol_type
  integer(kind=4) :: cache_idx, cell_idx, ckey(1:ndim)
  integer :: ind, ib
  real(kind=dp) :: u1(0:twondim,1:nvar), B1(0:twondim,1:6), B2(1:twotondim,1:6)
  real(kind=dp) :: B3(1:twondim,1:twotondim,1:6)
  logical :: refined(1:twondim)
  integer :: igrid_nbor(0:twondim), ind_nbor(0:twondim)

  cache_idx = threadIdx%x - 1 + (blockIdx%x - 1) * blockDim%x
  if (cache_idx >= num_octs) return
  cache_idx = head_idx + cache_idx
  ckey(1:ndim) = grid(cache_idx)%ckey(1:ndim)
  cell_idx = 1 + (ckey(1) - 2*(ckey(1)/2)) + 2*(ckey(2) - 2*(ckey(2)/2)) + 4*(ckey(3) - 2*(ckey(3)/2))
  call gather_twondim_parent_stencil(grid, uold, b, hash_key, hash_val, hash_size, &
       & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, grid(cache_idx)%lev, ckey, &
       & father(cache_idx), cell_idx, u1, igrid_nbor, ind_nbor, B1, B3, refined)
  call interpol_mag_d(B1, B2, B3, refined, interpol_type)
  do ib = 1, 6
     do ind = 1, twotondim
        b(ind,ib,cache_idx) = B2(ind,ib)
     end do
  end do
end subroutine nimhd_ghost_b_kernel
#endif

  ! =========================================================================
  attributes(device) subroutine make_new_oct(grid, flag1, uold, bold, f, phi, phi_old, ifree, ngridmax, oct_idx, cell_idx, &
       & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
#ifdef DO_RT
       & rtuold, rt_c, &
#endif
       & interpol_var, interpol_type, smallr)
    use amr_parameters, only: ndim
    type(oct), device :: grid(*)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: phi(1:twotondim,*)
    real(kind=dp), device :: phi_old(1:twotondim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer, device :: ifree
    integer(kind=4), value :: ngridmax
    integer, value :: oct_idx, cell_idx
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), value :: hash_size
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:ndim,*)
    integer(kind=4), device :: box_ckey_max(1:ndim,*)
    logical, device :: periodic(1:3)
#ifdef DO_RT
    real(kind=dp), device :: rtuold(1:twotondim,1:nrtvar,*)
    real(kind=dp), device :: rt_c(*)
#endif
    integer(kind=4), value :: interpol_var, interpol_type
    real(kind=dp), value :: smallr

    integer(kind=4) :: i, j, k, ind, child_idx, ilevel, ivar
    ! Prolongation scratch for parent stencil and children.
    real(kind=dp) :: u1(0:twondim,1:nvar)
    real(kind=dp) :: u2(1:twotondim,1:nvar)
#ifdef MHD
    real(kind=dp) :: b1(0:twondim,1:6)
    real(kind=dp) :: b2(1:twotondim,1:6)
    real(kind=dp) :: b3(1:twondim,1:twotondim,1:6)
    logical :: refined(1:twondim)
#endif
    integer :: igrid_nbor(0:twondim), ind_nbor(0:twondim)
#ifdef DO_RT
    integer :: inbor
    real(kind=dp) :: rtu1(0:twondim), rtu2(1:twotondim), xc(1:8,1:3)
#endif
    integer(kind=4), dimension(1:ndim) :: ckey
    integer(kind=8) :: hkey

    ! Compute cell coordinates
    i = MOD((cell_idx-1)  , 2)
    j = MOD((cell_idx-1)/2, 2)
    k = MOD((cell_idx-1)/4, 2)

    ! Compute child level and Cartesian key
    ilevel =    grid(oct_idx)%lev + 1
    ckey(1) = 2*grid(oct_idx)%ckey(1) + i
    ckey(2) = 2*grid(oct_idx)%ckey(2) + j
    ckey(3) = 2*grid(oct_idx)%ckey(3) + k

    ! Get index from free memory
    child_idx = atomicadd(ifree, 1)

    ! Skip instead of writing out of bounds if the grid memory is full
    if (child_idx > ngridmax) return

    ! Set new oct properties
    grid(child_idx)%lev = ilevel
    grid(child_idx)%ckey(1) = ckey(1)
    grid(child_idx)%ckey(2) = ckey(2)
    grid(child_idx)%ckey(3) = ckey(3)
    grid(child_idx)%refined(1:twotondim) = .false.
    flag1(1:twotondim,child_idx) = 0

    ! Compute new oct Hilbert key
    hkey = hilbert_key(ckey, ilevel - 1)
    grid(child_idx)%hkey(1) = hkey

#ifdef MHD
    ! divB-preserving MHD prolongation.
    ! Gather the 7-point coarse stencil + refined-sibling face-B, interpolate
    ! hydro + face-B together (Balsara 2001), and scatter all nvar + 6 child

    call gather_twondim_parent_stencil(grid, uold, bold, hash_key, hash_val, hash_size, &
         & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, ilevel, ckey, oct_idx, cell_idx, u1, &
         & igrid_nbor, ind_nbor, b1, b3, refined)
    call interpol_mhd_d(u1, u2, b1, b2, b3, refined, interpol_var, interpol_type, smallr)
    do ivar = 1, nvar
       do ind = 1, twotondim
          uold(ind,ivar,child_idx) = u2(ind,ivar)
       end do
    end do
    do ivar = 1, 6
       do ind = 1, twotondim
          bold(ind,ivar,child_idx) = b2(ind,ivar)
       end do
    end do
#else
#ifdef HYDRO
    ! Hydro prolongation from the 7-point parent stencil (the parent cell alone for injection)
    if (interpol_type == 0) then
       do ivar = 1, nvar
          u1(0:twondim,ivar) = uold(cell_idx,ivar,oct_idx)
       end do
       igrid_nbor(:) = oct_idx
       ind_nbor(:) = cell_idx
    else
       call gather_twondim_parent_stencil(grid, uold, bold, hash_key, hash_val, hash_size, &
            & ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, ilevel, ckey, oct_idx, cell_idx, u1, &
            & igrid_nbor, ind_nbor)
    end if
    call interpol_hydro_d(u1, u2, interpol_var, interpol_type, smallr)
    do ivar = 1, nvar
       do ind = 1, twotondim
          uold(ind,ivar,child_idx) = u2(ind,ivar)
       end do
    end do
#endif
#endif

#ifdef HYDRO
#ifdef DO_RT
    ! Set position of cell centers relative to grid center
    call child_centers_d(xc)

    ! RT prolongation, one variable at a time, from the parent cells of the hydro stencil
    do ivar = 1, nrtvar
       do inbor = 0, twondim
          if (igrid_nbor(inbor) > 0) then
             rtu1(inbor) = rtuold(ind_nbor(inbor),ivar,igrid_nbor(inbor))
          else
             rtu1(inbor) = rtu1(0)
          end if
       end do
       call interpol_one_var_d(rtu1, rtu2, xc, interpol_type)
       do ind = 1, twotondim
          rtuold(ind,ivar,child_idx) = rtu2(ind)
          ! Rescale according to speed of light difference
          if (mod(ivar,ndim+1) == 1) then
             rtuold(ind,ivar,child_idx) = (rtuold(ind,ivar,child_idx) * rt_c(ilevel-1)) / rt_c(ilevel)
          end if
       end do
    end do
#endif
#endif

#ifdef GRAV
      ! Straight injection for gravity variables
    do ind = 1, twotondim
       f(ind,1,child_idx) = f(cell_idx,1,oct_idx)
       f(ind,2,child_idx) = f(cell_idx,2,oct_idx)
       f(ind,3,child_idx) = f(cell_idx,3,oct_idx)
       phi(ind,child_idx) = phi(cell_idx,oct_idx)
       phi_old(ind,child_idx) = phi_old(cell_idx,oct_idx)
    end do
#endif

  end subroutine make_new_oct
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine refine_kernel(grid, flag1, uold, bold, f, phi, phi_old, ifree, ngridmax, head_idx, num_octs, &
       & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
#ifdef DO_RT
       & rtuold, rt_c, &
#endif
       & interpol_var, interpol_type, smallr)
    type(oct), device :: grid(*)
    integer, device :: flag1(1:twotondim,*)
    real(kind=dp), device :: f(1:twotondim,1:ndim,*)
    real(kind=dp), device :: phi(1:twotondim,*)
    real(kind=dp), device :: phi_old(1:twotondim,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer, device :: ifree
    integer(kind=4), intent(in), value :: ngridmax
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    ! Parent stencil for MHD prolongation.
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=4), device :: box_ckey_min(1:ndim,*)
    integer(kind=4), device :: box_ckey_max(1:ndim,*)
    logical, device :: periodic(1:3)
#ifdef DO_RT
    real(kind=dp), device :: rtuold(1:twotondim,1:nrtvar,*)
    real(kind=dp), device :: rt_c(*)
#endif
    integer(kind=4), intent(in), value :: interpol_var, interpol_type
    real(kind=dp), intent(in), value :: smallr

    integer :: block_idx, oct_idx, cell_idx
    logical :: flagged, refined

    ! Compute block idx
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute cell idx
    cell_idx = threadIdx%x

    flagged = flag1(cell_idx,oct_idx) == 1
    refined = grid(oct_idx)%refined(cell_idx)

    ! Create new oct
    if (flagged .and. .not. refined) then
       call make_new_oct(grid, flag1, uold, bold, f, phi, phi_old, ifree, ngridmax, oct_idx, cell_idx, &
            & hash_key, hash_val, hash_size, ckey_max, key_off, box_ckey_min, box_ckey_max, periodic, &
#ifdef DO_RT
            & rtuold, rt_c, &
#endif
            & interpol_var, interpol_type, smallr)
       grid(oct_idx)%refined(cell_idx) = .true.
    endif

  end subroutine refine_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine derefine_kernel(grid, flag1, hash_key, hash_val, hash_size, ckey_max, key_off, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer(kind=8) :: key, parent_key, offset
    integer(kind=8) :: ix, iy, iz, nx
    integer :: thread_idx, block_idx, oct_idx, cell_idx, parent_idx
    integer :: ilevel, i, j, k
    logical :: flagged, refined

    integer(kind=8), dimension(1:ndim) :: ckey

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Get oct Cartesian key
    ckey(1) = grid(oct_idx)%ckey(1)
    ckey(2) = grid(oct_idx)%ckey(2)
    ckey(3) = grid(oct_idx)%ckey(3)

    ! Compute oct hash table key
    ilevel = grid(oct_idx)%lev
    ix = int(ckey(1), kind=8)
    iy = int(ckey(2), kind=8)
    iz = int(ckey(3), kind=8)
    nx = int(ckey_max(ilevel), kind=8)
    offset = key_off(ilevel)
    key = offset + ix + iy * nx + iz * nx * nx

    ! Compute parent oct hash table key
    ilevel = grid(oct_idx)%lev - 1
    ix = int(ckey(1) / 2, kind=8)
    iy = int(ckey(2) / 2, kind=8)
    iz = int(ckey(3) / 2, kind=8)
    nx = int(ckey_max(ilevel), kind=8)
    offset = key_off(ilevel)
    parent_key = offset + ix + iy * nx + iz * nx * nx

    ! Get parent oct index in memory
    parent_idx = hash_get(hash_key, hash_val, hash_size, parent_key)

    ! Get parent cell idx
    i = ckey(1) - 2*ix
    j = ckey(2) - 2*iy
    k = ckey(3) - 2*iz
    cell_idx = 1 + i + 2*j + 4*k

    flagged = (flag1(cell_idx, parent_idx) == 1)
    refined = grid(parent_idx)%refined(cell_idx)

    ! Derefine
    if (.not. flagged .and. refined) then
       ! Free key/val pair in hash table
       call hash_free(hash_key, hash_val, hash_size, key)
       ! Set level to 0
       grid(oct_idx)%lev = 0
       ! Set parent refinement flag to .false.
       grid(parent_idx)%refined(cell_idx) = .false.
    endif

  end subroutine derefine_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine insert_hash_kernel(grid, hash_key, hash_val, hash_size, ckey_max, key_off, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: thread_idx, block_idx, oct_idx
    integer(kind=8) :: key, ix, iy, iz, nx, offset
    integer(kind=4) :: val, ilevel

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Get oct level
    ilevel = grid(oct_idx)%lev

    if (ilevel > 0)then

       ! Compute key and value
       ix = int(grid(oct_idx)%ckey(1), kind=8)
       iy = int(grid(oct_idx)%ckey(2), kind=8)
       iz = int(grid(oct_idx)%ckey(3), kind=8)
       nx = int(ckey_max(ilevel), kind=8)
       offset = key_off(ilevel)

       key = offset + ix + iy * nx + iz * nx * nx
       val = oct_idx

       ! Insert key/value pair in hash table
       call hash_set(hash_key, hash_val, hash_size, key, val)

    end if

  end subroutine insert_hash_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine insert_hash_cache(grid, hash_key, hash_val, hash_size, &
       & ckey_max, key_off, ngridmax, ifree_cache, cache_overflow, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), device :: num_octs
    integer(kind=4), device :: ifree_cache, cache_overflow
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: ngridmax

    call insert_hash_cache_impl(grid, hash_key, hash_val, hash_size, &
       & ckey_max, key_off, ngridmax, ifree_cache, cache_overflow, num_octs)

  end subroutine insert_hash_cache

  ! =========================================================================
  attributes(device) subroutine insert_hash_cache_impl(grid, hash_key, hash_val, hash_size, &
       & ckey_max, key_off, ngridmax, ifree_cache, cache_overflow, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), device :: num_octs
    integer(kind=4), device :: ifree_cache, cache_overflow
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: ngridmax

    integer :: thread_idx, block_idx, oct_idx
    integer(kind=8) :: key, ix, iy, iz, nx, offset
    integer(kind=4) :: val, ilevel

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    if (cache_overflow /= 0) return
    oct_idx = ngridmax + ifree_cache + oct_idx

    ! Get oct level
    ilevel = grid(oct_idx)%lev

    if (ilevel > 0)then

       ! Compute key and value
       ix = int(grid(oct_idx)%ckey(1), kind=8)
       iy = int(grid(oct_idx)%ckey(2), kind=8)
       iz = int(grid(oct_idx)%ckey(3), kind=8)
       nx = int(ckey_max(ilevel), kind=8)
       offset = key_off(ilevel)

       key = offset + ix + iy * nx + iz * nx * nx
       val = oct_idx

       ! Insert key/value pair in hash table
       call hash_set(hash_key, hash_val, hash_size, key, val)

    end if

  end subroutine insert_hash_cache_impl
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine advance_ifree_cache(ifree_cache_d, new_noct_d, cache_overflow)
    integer(kind=4), device :: ifree_cache_d, new_noct_d, cache_overflow
    if (cache_overflow == 0) ifree_cache_d = ifree_cache_d + new_noct_d
  end subroutine advance_ifree_cache
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine free_hash_kernel(grid, hash_key, hash_val, hash_size, ckey_max, key_off, &
       & head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: thread_idx, block_idx, oct_idx
    integer(kind=8) :: key, ix, iy, iz, nx, offset
    integer(kind=4) :: val, ilevel

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Get oct level
    ilevel = grid(oct_idx)%lev

    if (ilevel > 0)then

       ! Compute key and value
       ix = int(grid(oct_idx)%ckey(1), kind=8)
       iy = int(grid(oct_idx)%ckey(2), kind=8)
       iz = int(grid(oct_idx)%ckey(3), kind=8)
       nx = int(ckey_max(ilevel), kind=8)
       offset = key_off(ilevel)

       key = offset + ix + iy * nx + iz * nx * nx

       ! Free key location in hash table
       call hash_free(hash_key, hash_val, hash_size, key)

    end if

  end subroutine free_hash_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine update_hash_kernel(grid, hash_key, hash_val, hash_size, ckey_max, key_off, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: ckey_max(*)
    integer(kind=8), device :: key_off(*)
    integer(kind=8), device :: hash_key(*)
    integer(kind=4), device :: hash_val(*)
    integer(kind=4), intent(in), value :: hash_size
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: thread_idx, block_idx, oct_idx
    integer(kind=8) :: key, ix, iy, iz, nx, offset
    integer(kind=4) :: val, ilevel

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute key and value
    ilevel = grid(oct_idx)%lev
    ix = int(grid(oct_idx)%ckey(1), kind=8)
    iy = int(grid(oct_idx)%ckey(2), kind=8)
    iz = int(grid(oct_idx)%ckey(3), kind=8)
    nx = int(ckey_max(ilevel), kind=8)
    offset = key_off(ilevel)

    key = offset + ix + iy * nx + iz * nx * nx
    val = oct_idx

    ! Update value at key location in hash table
    if (ilevel > 0)then
       call hash_update(hash_key, hash_val, hash_size, key, val)
    endif

  end subroutine update_hash_kernel
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine init_global_swap_table_kernel(swap_global, head_idx, num_octs)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, thread_idx, block_idx

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    swap_global(oct_idx) = oct_idx

  end subroutine init_global_swap_table_kernel
  ! =========================================================================

  ! =========================================================================
  ! this is the same as init_global_swap_table_kernel but uses a grid stride loop
  ! that can be unrolled by the compiler. it needs to be launched with 1/8 the number
  ! of threads as the original kernel. A speedup is acheived when num_octs >= 500k.
  ! with 2M octs this kernels is ~3x faster than the original.
  attributes(global) subroutine init_global_swap_table_kernel_u8(swap_global, head_idx, num_octs)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: i, i0, i1, di, ii

    i0 = (threadIdx%x - 1) + (blockIdx%x - 1)*blockDim%x
    i1 = num_octs - 1
    di = blockDim%x*gridDim%x
    ii = i0 + head_idx

    !$acc do seq unroll(8)
    do i = i0,i1,di
      swap_global(ii) = ii
      ii = ii + di
    end do

  end subroutine init_global_swap_table_kernel_u8
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine init_prefix_sum_level(grid, swap_global, prefix_sum, head_idx, num_octs, ilevel)
    type(oct), device :: grid(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    integer(kind=4), intent(in), value :: ilevel

    integer :: oct_idx, thread_idx, block_idx, old_oct_idx

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Get old oct idx
    old_oct_idx = swap_global(oct_idx)

    ! If level is equal to ilevel set prefix_sum to zero
    if(grid(old_oct_idx)%lev == ilevel)then
       prefix_sum(oct_idx) = 0
    else
       prefix_sum(oct_idx) = 1
    endif

  end subroutine init_prefix_sum_level
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine init_prefix_sum_bit(grid, swap_global, prefix_sum, head_idx, num_octs, ibit)
    type(oct), device :: grid(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    integer(kind=4), intent(in), value :: ibit

    integer :: oct_idx, thread_idx, block_idx, old_oct_idx

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Get old oct idx
    old_oct_idx = swap_global(oct_idx)

    ! Set prefix_sum to value of bit at position ibit
    prefix_sum(oct_idx) = int(ibits(grid(old_oct_idx)%hkey(1), ibit, 1), kind=4)

  end subroutine init_prefix_sum_bit
  ! =========================================================================
  ! =========================================================================
  attributes(global) subroutine gather_keys(grid, swap_global, head_idx, num_octs, hkeys)
    implicit none
    type(oct), device :: grid(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    integer(kind=8), device :: hkeys(*)

    integer :: oct_idx, thread_idx, block_idx, old_oct_idx

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Get old oct idx
    old_oct_idx = swap_global(oct_idx)

    ! Set prefix_sum to value of bit at position ibit
    hkeys(oct_idx) = grid(old_oct_idx)%hkey(1)

  end subroutine gather_keys
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine gather_keys_2(grid, swap_global, head_idx, num_octs, hkeys)
    implicit none
    type(oct), device :: grid(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    integer(kind=8), device :: hkeys(*)
    !
    integer(kind=8), i, i0, i1, di

    i0 = threadIdx%x + blockDim%x * ( blockIdx%x - 1 ) + head_idx - 1
    i1 = num_octs + head_idx - 1
    di = gridDim%x*blockDim%x

    !$acc do seq unroll(8)
    do i = i0,i1,di
      hkeys(i) = grid(swap_global(i))%hkey(1)
    end do

  end subroutine gather_keys_2
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine compute_local_swap_table(swap_local, swap_global, prefix_sum, head_idx, num_octs)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    call compute_local_swap_table_impl(swap_local, swap_global, prefix_sum, head_idx, num_octs)

  end subroutine compute_local_swap_table
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine compute_local_swap_table_impl(swap_local, swap_global, prefix_sum, head_idx, num_octs)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, thread_idx, block_idx
    integer :: old_oct_idx, sorted_idx
    integer :: nfinal, nones, nzeros, previous_sum, bit

    ! Compute thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute final oct idx
    nfinal = head_idx + num_octs - 1

    ! Compute total counts
    nones = prefix_sum(nfinal)
    nzeros = num_octs - nones

    ! Get previous prefix sum
    if (oct_idx > head_idx)then
       previous_sum = prefix_sum(oct_idx - 1)
    else
       previous_sum = 0
    endif

    ! Compute original table value (0 or 1)
    bit = prefix_sum(oct_idx) - previous_sum

    ! Get old oct idx
    old_oct_idx = swap_global(oct_idx)

    ! Compute sorted new index
    if(bit == 0)then
       sorted_idx = oct_idx - previous_sum
    else
       sorted_idx = head_idx + nzeros + previous_sum
    endif

    ! Compute local swap table
    swap_local(sorted_idx) = old_oct_idx

  end subroutine compute_local_swap_table_impl
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine update_global_swap_table(swap_global, swap_local, head_idx, num_octs)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    call update_global_swap_table_impl(swap_global, swap_local, head_idx, num_octs)

  end subroutine
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine update_global_swap_table_impl(swap_global, swap_local, head_idx, num_octs)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, thread_idx, block_idx

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute the new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Update the global swap table
    swap_global(oct_idx) = swap_local(oct_idx)

  end subroutine update_global_swap_table_impl
  ! =========================================================================

  ! =========================================================================
  attributes(grid_global) subroutine compute_and_update_swap_table(swap_local, swap_global, prefix_sum, head_idx, num_octs, total_sum)
    use cooperative_groups
    implicit none
    integer(kind=4), device :: swap_local(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs
    integer(kind=4), optional, device :: total_sum
    type(grid_group) :: gg
    gg = this_grid()

    call compute_local_swap_table_impl(swap_local, swap_global, prefix_sum, head_idx, num_octs)
    call syncthreads(gg)

    call update_global_swap_table_impl(swap_global, swap_local, head_idx, num_octs)

    ! no sync because prefix_sum is computed in an earlier kernel
    if (present(total_sum)) then
      if ((1 == blockIdx%x) .AND. (1 == threadIdx%x)) then
        total_sum = prefix_sum(head_idx + num_octs - 1)
      endif
    endif

  end subroutine compute_and_update_swap_table
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine sort_gather_grid(flag2, grid, swap_global, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    call sort_gather_grid_impl(flag2, grid, swap_global, head_idx, num_octs)

  end subroutine sort_gather_grid
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine sort_gather_grid_impl(flag2, grid, swap_global, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, thread_idx, block_idx, old_oct_idx
    integer :: bit, mask, idim, ind

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute the new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Update the global swap table
    old_oct_idx = swap_global(oct_idx)

    ! Gather grid properties into flag2
    flag2(1, oct_idx) = grid(old_oct_idx)%lev
    do idim = 1, ndim
       flag2(1 + idim, oct_idx) = grid(old_oct_idx)%ckey(idim)
    end do
    mask = 0
    do ind = 1, twotondim
       if (grid(old_oct_idx)%refined(ind)) then
          mask = IBSET(mask, ind - 1)
       end if
    end do
    flag2(ndim + 2, oct_idx) = mask

  end subroutine sort_gather_grid_impl
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine sort_scatter_grid(grid, flag2, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    call sort_scatter_grid_impl(grid, flag2, head_idx, num_octs)

  end subroutine sort_scatter_grid
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine sort_scatter_grid_impl(grid, flag2, head_idx, num_octs)
    type(oct), device :: grid(*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, thread_idx, block_idx
    integer :: ind, idim, mask, bit, ilevel
    integer(kind=4), dimension(1:ndim) :: ckey
    integer(kind=8) :: hkey

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute the new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Scatter flag2 to new grid properties
    grid(oct_idx)%lev = flag2(1, oct_idx)
    do idim = 1, ndim
       grid(oct_idx)%ckey(idim) = flag2(1 + idim, oct_idx)
    end do
    mask = flag2(ndim + 2, oct_idx)
    do ind = 1, twotondim
       bit = IBITS(mask, ind - 1, 1)
       grid(oct_idx)%refined(ind) = (bit == 1)
    end do

    ! Compute Hilbert key
    ckey = grid(oct_idx)%ckey
    ilevel = grid(oct_idx)%lev
    hkey = hilbert_key(ckey, ilevel - 1)
    grid(oct_idx)%hkey(1) = hkey

  end subroutine sort_scatter_grid_impl
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine sort_gather_flag(flag2, flag1, swap_global, head_idx, num_octs)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    call sort_gather_flag_impl(flag2, flag1, swap_global, head_idx, num_octs)

  end subroutine sort_gather_flag
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine sort_gather_flag_impl(flag2, flag1, swap_global, head_idx, num_octs)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, thread_idx, block_idx, old_oct_idx

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute the new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Update the global swap table
    old_oct_idx = swap_global(oct_idx)

    ! Gather flag1 into flag2
    flag2(:, oct_idx) = flag1(:, old_oct_idx)

  end subroutine sort_gather_flag_impl
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine sort_scatter_flag(flag1, flag2, head_idx, num_octs)
    integer(kind=4), device :: flag1(1:twotondim,*)
    integer(kind=4), device :: flag2(1:twotondim,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

