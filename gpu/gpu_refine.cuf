  ! =========================================================================
  attributes(global) subroutine sort_gather_hydro(unew, uold, bnew, bold, swap_global, head_idx, num_octs)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bnew(1:twotondim,1:6,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    call sort_gather_hydro_impl(unew, uold, bnew, bold, swap_global, head_idx, num_octs)

  end subroutine sort_gather_hydro

  ! =========================================================================
  attributes(device) subroutine sort_gather_hydro_impl(unew, uold, bnew, bold, swap_global, head_idx, num_octs)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: bnew(1:twotondim,1:6,*)
    real(kind=dp), device :: bold(1:twotondim,1:6,*)
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, cell_idx, thread_idx, block_idx, old_oct_idx, ivar

    ! Compute block idx
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute cell idx
    cell_idx = threadIdx%x

    ! Update the global swap table
    old_oct_idx = swap_global(oct_idx)

    ! Gather uold into unew
    do ivar = 1, nvar
       unew(cell_idx, ivar, oct_idx) = uold(cell_idx, ivar, old_oct_idx)
    end do

#ifdef MHD
    ! Gather bold into bnew
    do ivar = 1, 6
       bnew(cell_idx, ivar, oct_idx) = bold(cell_idx, ivar, old_oct_idx)
    end do
#endif

  end subroutine sort_gather_hydro_impl
  ! =========================================================================

  ! =========================================================================
  attributes(global) subroutine sort_scatter_hydro(uold, unew, head_idx, num_octs)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    call  sort_scatter_hydro_impl(uold, unew, head_idx, num_octs)

  end subroutine sort_scatter_hydro
  ! =========================================================================

  ! =========================================================================
  attributes(device) subroutine sort_scatter_hydro_impl(uold, unew, head_idx, num_octs)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, thread_idx, block_idx

    ! Compute the thread and block idx
    thread_idx = threadIdx%x - 1
    block_idx = blockIdx%x - 1

    ! Compute the new oct idx
    oct_idx = thread_idx + block_idx * blockDim%x
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Scatter unew to uold
    uold(:, :, oct_idx) = unew(:, :, oct_idx)

  end subroutine sort_scatter_hydro_impl
  ! =========================================================================

#ifdef DO_RT
  ! =========================================================================
  ! Gather RT variables ivar0+1..ivar0+nv into the scratch unew in sorted order.
  attributes(global) subroutine sort_gather_rt(unew, rtuold, ivar0, nv, swap_global, head_idx, num_octs)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: rtuold(1:twotondim,1:nrtvar,*)
    integer(kind=4), intent(in), value :: ivar0, nv
    integer(kind=4), device :: swap_global(*)
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, cell_idx, block_idx, old_oct_idx, ivar

    ! Compute block idx
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute cell idx
    cell_idx = threadIdx%x

    old_oct_idx = swap_global(oct_idx)
    do ivar = 1, nv
       unew(cell_idx, ivar, oct_idx) = rtuold(cell_idx, ivar0+ivar, old_oct_idx)
    end do

  end subroutine sort_gather_rt
  ! =========================================================================

  ! =========================================================================
  ! Copy the sorted RT variables ivar0+1..ivar0+nv back from unew.
  attributes(global) subroutine sort_scatter_rt(rtuold, unew, ivar0, nv, head_idx, num_octs)
    real(kind=dp), device :: rtuold(1:twotondim,1:nrtvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    integer(kind=4), intent(in), value :: ivar0, nv
    integer(kind=4), intent(in), value :: head_idx
    integer(kind=4), intent(in), value :: num_octs

    integer :: oct_idx, cell_idx, block_idx, ivar

    ! Compute block idx
    block_idx = blockIdx%x - 1

    ! Compute oct idx
    oct_idx = block_idx * blockDim%y + threadIdx%y - 1
    if (oct_idx >= num_octs) return
    oct_idx = head_idx + oct_idx

    ! Compute cell idx
    cell_idx = threadIdx%x

    do ivar = 1, nv
       rtuold(cell_idx, ivar0+ivar, oct_idx) = unew(cell_idx, ivar, oct_idx)
    end do

  end subroutine sort_scatter_rt
  ! =========================================================================
#endif

