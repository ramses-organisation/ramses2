!> GPU thermal feedback CUDA kernels.
module feedback_device
  use amr_parameters, only: ndim, twotondim, dp, i8b
  use hydro_parameters, only: nvar
  use oct_commons, only: oct
  use gpu_utils
  use cudafor

  implicit none

contains

  include 'gpu_hash.cuf'

  !> Select the stars whose supernova time falls within this level step
  attributes(global) subroutine select_feedback_stars_kernel(star_tp, prefix_sum, head_idx, num_stars, texp, t_SN, texp_old)
    implicit none
    real(kind=dp), device :: star_tp(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx, num_stars
    real(kind=8), intent(in), value :: texp, t_SN, texp_old

    integer :: tid, ipart
    real(kind=dp) :: birth_time

    tid = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if (tid >= num_stars) return

    ipart = head_idx + tid
    birth_time = star_tp(ipart)

    if (birth_time >= (texp_old - t_SN) .and. birth_time < (texp - t_SN)) then
       prefix_sum(tid + 1) = 1
    else
       prefix_sum(tid + 1) = 0
    endif

  end subroutine select_feedback_stars_kernel

  !> Compute swap table for feedback stars
  attributes(global) subroutine compute_feedback_swap_table(isp_swap, prefix_sum, head_idx, num_stars)
    implicit none
    integer(kind=4), device :: isp_swap(*)
    integer(kind=4), device :: prefix_sum(*)
    integer(kind=4), intent(in), value :: head_idx, num_stars

    integer :: tid, ipart
    integer :: previous_sum, is_selected

    tid = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if (tid >= num_stars) return

    ipart = head_idx + tid

    if (tid > 0) then
       previous_sum = prefix_sum(tid)
    else
       previous_sum = 0
    endif

    is_selected = prefix_sum(tid + 1) - previous_sum

    if (is_selected > 0) then
       isp_swap(1 + previous_sum) = ipart
    endif

  end subroutine compute_feedback_swap_table

  !> Perform the thermal feedback updates on the gas cells
  attributes(global) subroutine thermal_feedback_kernel(grid, uold, unew, &
       & star_xp, star_vp, star_mp, star_zp, &
       & isp_swap, num_selected, &
       & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, ngridmax, &
       & eta_SNII, yield_SNII, e_SN, metal, imetal, entropy, dual_energy, gamma, &
       & ientropy, d_skip, dx_loc, vol_loc, ilevel, leading, msn_loc_d)
    implicit none
    type(oct), device :: grid(*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: star_xp(*)
    real(kind=dp), device :: star_vp(*)
    real(kind=dp), device :: star_mp(*)
    real(kind=dp), device :: star_zp(*)
    integer(kind=4), device :: isp_swap(*)
    integer(kind=4), intent(in), value :: num_selected
    integer(kind=8), device :: hash_key_d(*)
    integer(kind=4), device :: hash_val_d(*)
    integer(kind=4), intent(in), value :: hash_size_d
    integer(kind=4), device :: ckey_max_d(*)
    integer(kind=8), device :: key_off_d(*)
    integer(kind=4), intent(in), value :: ngridmax
    real(kind=8), intent(in), value :: eta_SNII, yield_SNII, e_SN
    logical, intent(in), value :: metal
    integer(kind=4), intent(in), value :: imetal
    logical, intent(in), value :: entropy
    real(kind=8), intent(in), value :: dual_energy
    real(kind=8), intent(in), value :: gamma
    integer(kind=4), intent(in), value :: ientropy
    real(kind=8), device :: d_skip(1:3)
    real(kind=8), intent(in), value :: dx_loc, vol_loc
    integer(kind=4), intent(in), value :: ilevel
    integer(kind=8), intent(in), value :: leading
    real(kind=8), device :: msn_loc_d

    integer :: tid, ipart, igrid, icell, idim, info
    real(kind=dp) :: mejecta, dloss, ethermal, ekinetic, zloss, dzloss, dold
    real(kind=dp) :: vol_cell, vp_sum, s_new
    real(kind=8) :: xs, inv_dx_loc, inv_2dx_loc, inv_4dx_loc
    integer(kind=4) :: ix(1:3), ii(1:3)
    integer(kind=8) :: ix8, iy8, iz8, nx, offset, key

    tid = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    if (tid >= num_selected) return

    ! Get the original index of the selected star particle
    ipart = isp_swap(1 + tid)

    inv_dx_loc  = 1.0_dp / dx_loc
    inv_2dx_loc = 0.5_dp * inv_dx_loc
    inv_4dx_loc = 0.25_dp * inv_dx_loc

    ! First try ilevel
    do idim = 1, ndim
       xs = star_xp(ipart + (idim-1)*leading) + d_skip(idim)
       ix(idim) = floor(xs * inv_2dx_loc)
    end do
    ix8 = int(ix(1), kind=8)
    iy8 = int(ix(2), kind=8)
    iz8 = int(ix(3), kind=8)
    nx  = int(ckey_max_d(ilevel), kind=8)
    offset = key_off_d(ilevel)
    key = offset + ix8 + iy8*nx + iz8*nx*nx
    igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
    vol_cell = vol_loc

    if (igrid > 0 .and. igrid <= ngridmax) then
       do idim = 1, ndim
          xs = star_xp(ipart + (idim-1)*leading) + d_skip(idim)
          ii(idim) = int(xs * inv_dx_loc - 2*ix(idim))
       end do
       icell = 1
       do idim = 1, ndim
          icell = icell + ii(idim) * 2**(idim-1)
       end do
    else

       ! If necessary try ilevel - 1
       do idim = 1, ndim
          xs = star_xp(ipart + (idim-1)*leading) + d_skip(idim)
          ix(idim) = floor(xs * inv_4dx_loc)
       end do
       ix8 = int(ix(1), kind=8)
       iy8 = int(ix(2), kind=8)
       iz8 = int(ix(3), kind=8)
       nx  = int(ckey_max_d(ilevel - 1), kind=8)
       offset = key_off_d(ilevel - 1)
       key = offset + ix8 + iy8*nx + iz8*nx*nx
       igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
       vol_cell = vol_loc * 8.0d0

       if (igrid > 0 .and. igrid <= ngridmax) then
          do idim = 1, ndim
             xs = star_xp(ipart + (idim-1)*leading) + d_skip(idim)
             ii(idim) = int(xs * (0.5d0 * inv_dx_loc) - 2*ix(idim))
          end do
          icell = 1
          do idim = 1, ndim
             icell = icell + ii(idim) * 2**(idim-1)
          end do
       endif
    endif

    ! If cell not found, or in ghost zone, or not a leaf cell, we skip
    if (igrid <= 0 .or. igrid > ngridmax) return
    if (grid(igrid)%refined(icell)) return

    ! Compute supernova properties
    mejecta = eta_SNII * star_mp(ipart)
    dloss = mejecta / vol_cell
    ethermal = dloss * e_SN
    vp_sum = star_vp(ipart)**2 + star_vp(ipart + leading)**2 + star_vp(ipart + 2*leading)**2
    ekinetic = dloss * 0.5d0 * vp_sum
    zloss = yield_SNII + (1.0d0 - yield_SNII) * star_zp(ipart)
    dzloss = dloss * zloss

    ! Update unew using atomic additions
    info = atomicadd(unew(icell, 1, igrid), dloss)
    info = atomicadd(unew(icell, 2, igrid), dloss * star_vp(ipart))
    info = atomicadd(unew(icell, 3, igrid), dloss * star_vp(ipart + leading))
    info = atomicadd(unew(icell, 4, igrid), dloss * star_vp(ipart + 2*leading))
    info = atomicadd(unew(icell, 5, igrid), ekinetic + ethermal)

    if (metal) then
       info = atomicadd(unew(icell, imetal, igrid), dzloss)
    endif

    ! If dual energy scheme is activated, update entropy
    if (entropy .and. dual_energy >= 0.0d0) then
       dold = uold(icell, 1, igrid)
       s_new = ethermal / dold**(gamma - 1.0d0) * (gamma - 1.0d0)
       info = atomicadd(unew(icell, ientropy, igrid), s_new)
    endif

    ! Update particle mass
    star_mp(ipart) = star_mp(ipart) - mejecta

    ! Accumulate total ejecta mass
    info = atomicadd(msn_loc_d, real(mejecta, kind=8))

  end subroutine thermal_feedback_kernel

  !> Helper device subroutine to query a grid and cell by integer coordinates
  attributes(device) subroutine get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, &
       & level, ckey_nbor, igrid, icell)
    implicit none
    integer(kind=8), device :: hash_key_d(*)
    integer(kind=4), device :: hash_val_d(*)
    integer(kind=4), intent(in), value :: hash_size_d
    integer(kind=4), device :: ckey_max_d(*)
    integer(kind=8), device :: key_off_d(*)
    integer(kind=4), intent(in), value :: level
    integer(kind=4), intent(in) :: ckey_nbor(3)
    integer(kind=4), intent(out) :: igrid, icell

    integer :: ix(3), ii(3), idim
    integer(kind=8) :: ix8, iy8, iz8, nx, offset, key

    do idim = 1, 3
       ix(idim) = ckey_nbor(idim) / 2
       ii(idim) = mod(ckey_nbor(idim), 2)
    end do

    ix8 = int(ix(1), kind=8)
    iy8 = int(ix(2), kind=8)
    iz8 = int(ix(3), kind=8)
    nx  = int(ckey_max_d(level), kind=8)
    offset = key_off_d(level)
    key = offset + ix8 + iy8*nx + iz8*nx*nx
    igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)

    if (igrid /= 0) then
       icell = 1 + ii(1) + ii(2) * 2 + ii(3) * 4
    else
       icell = 0
    endif
  end subroutine get_cell_by_key

  !> Perform the mechanical feedback updates on the gas cells
  attributes(global) subroutine mechanical_feedback_kernel(grid, uold, unew, &
       & star_xp, star_vp, star_mp, star_zp, &
       & isp_swap, num_selected, &
       & hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, ngridmax, &
       & box_ckey_min_d, box_ckey_max_d, periodic_d, &
       & eta_SNII, yield_SNII, e_SN, E_SNII_51, m_SN, M_SNII, z_ave, scale_nH, metal, imetal, gamma, &
       & skip1, skip2, skip3, dx_loc, vol_loc, ilevel, leading, msn_loc_d, smallr)
    implicit none
    type(oct), device :: grid(*)
    real(kind=dp), device :: uold(1:twotondim,1:nvar,*)
    real(kind=dp), device :: unew(1:twotondim,1:nvar,*)
    real(kind=dp), device :: star_xp(*)
    real(kind=dp), device :: star_vp(*)
    real(kind=dp), device :: star_mp(*)
    real(kind=dp), device :: star_zp(*)
    integer(kind=4), device :: isp_swap(*)
    integer(kind=4), intent(in), value :: num_selected
    integer(kind=8), device :: hash_key_d(*)
    integer(kind=4), device :: hash_val_d(*)
    integer(kind=4), intent(in), value :: hash_size_d
    integer(kind=4), device :: ckey_max_d(*)
    integer(kind=8), device :: key_off_d(*)
    integer(kind=4), intent(in), value :: ngridmax
    integer(kind=4), device :: box_ckey_min_d(3,*)
    integer(kind=4), device :: box_ckey_max_d(3,*)
    logical, device :: periodic_d(3)
    real(kind=dp), intent(in), value :: eta_SNII, yield_SNII, e_SN, E_SNII_51, m_SN, M_SNII, z_ave, scale_nH
    logical, intent(in), value :: metal
    integer(kind=4), intent(in), value :: imetal
    real(kind=dp), intent(in), value :: gamma
    real(kind=dp), intent(in), value :: skip1, skip2, skip3
    real(kind=dp), intent(in), value :: dx_loc, vol_loc
    integer(kind=4), intent(in), value :: ilevel
    integer(kind=8), intent(in), value :: leading
    real(kind=dp), device :: msn_loc_d
    real(kind=dp), intent(in), value :: smallr

    ! Neighbor coordinate offsets
    real(kind=dp), parameter, dimension(3, 48) :: xSNnei_const = reshape((/ &
      -0.25_dp, -0.75_dp, -0.75_dp, &
      0.25_dp, -0.75_dp, -0.75_dp, &
      -0.75_dp, -0.25_dp, -0.75_dp, &
      -0.25_dp, -0.25_dp, -0.75_dp, &
      0.25_dp, -0.25_dp, -0.75_dp, &
      0.75_dp, -0.25_dp, -0.75_dp, &
      -0.75_dp, 0.25_dp, -0.75_dp, &
      -0.25_dp, 0.25_dp, -0.75_dp, &
      0.25_dp, 0.25_dp, -0.75_dp, &
      0.75_dp, 0.25_dp, -0.75_dp, &
      -0.25_dp, 0.75_dp, -0.75_dp, &
      0.25_dp, 0.75_dp, -0.75_dp, &
      -0.75_dp, -0.75_dp, -0.25_dp, &
      -0.25_dp, -0.75_dp, -0.25_dp, &
      0.25_dp, -0.75_dp, -0.25_dp, &
      0.75_dp, -0.75_dp, -0.25_dp, &
      -0.75_dp, -0.25_dp, -0.25_dp, &
      0.75_dp, -0.25_dp, -0.25_dp, &
      -0.75_dp, 0.25_dp, -0.25_dp, &
      0.75_dp, 0.25_dp, -0.25_dp, &
      -0.75_dp, 0.75_dp, -0.25_dp, &
      -0.25_dp, 0.75_dp, -0.25_dp, &
      0.25_dp, 0.75_dp, -0.25_dp, &
      0.75_dp, 0.75_dp, -0.25_dp, &
      -0.75_dp, -0.75_dp, 0.25_dp, &
      -0.25_dp, -0.75_dp, 0.25_dp, &
      0.25_dp, -0.75_dp, 0.25_dp, &
      0.75_dp, -0.75_dp, 0.25_dp, &
      -0.75_dp, -0.25_dp, 0.25_dp, &
      0.75_dp, -0.25_dp, 0.25_dp, &
      -0.75_dp, 0.25_dp, 0.25_dp, &
      0.75_dp, 0.25_dp, 0.25_dp, &
      -0.75_dp, 0.75_dp, 0.25_dp, &
      -0.25_dp, 0.75_dp, 0.25_dp, &
      0.25_dp, 0.75_dp, 0.25_dp, &
      0.75_dp, 0.75_dp, 0.25_dp, &
      -0.25_dp, -0.75_dp, 0.75_dp, &
      0.25_dp, -0.75_dp, 0.75_dp, &
      -0.75_dp, -0.25_dp, 0.75_dp, &
      -0.25_dp, -0.25_dp, 0.75_dp, &
      0.25_dp, -0.25_dp, 0.75_dp, &
      0.75_dp, -0.25_dp, 0.75_dp, &
      -0.75_dp, 0.25_dp, 0.75_dp, &
      -0.25_dp, 0.25_dp, 0.75_dp, &
      0.25_dp, 0.25_dp, 0.75_dp, &
      0.75_dp, 0.25_dp, 0.75_dp, &
      -0.25_dp, 0.75_dp, 0.75_dp, &
      0.25_dp, 0.75_dp, 0.75_dp &
    /), (/3, 48/))

    ! Neighbor unit directions
    real(kind=dp), parameter, dimension(3, 48) :: vSNnei_const = reshape((/ &
      -2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, &
      2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, &
      -6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, &
      -3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, &
      3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, &
      6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, &
      -6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, &
      -3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, &
      3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, &
      6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, &
      -2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, &
      2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, &
      -6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, &
      -3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, &
      3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, &
      6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, &
      -9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, &
      9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, &
      -9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, &
      9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, &
      -6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, &
      -3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, &
      3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, &
      6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, &
      -6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, &
      -3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, &
      3.01511344577763629e-01_dp, -9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, &
      6.88247201611685178e-01_dp, -6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, &
      -9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, &
      9.04534033733290888e-01_dp, -3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, &
      -9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, &
      9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, &
      -6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, &
      -3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, &
      3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, 3.01511344577763629e-01_dp, &
      6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, &
      -2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp, &
      2.29415733870561744e-01_dp, -6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp, &
      -6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, &
      -3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, &
      3.01511344577763629e-01_dp, -3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, &
      6.88247201611685178e-01_dp, -2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, &
      -6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, &
      -3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, &
      3.01511344577763629e-01_dp, 3.01511344577763629e-01_dp, 9.04534033733290888e-01_dp, &
      6.88247201611685178e-01_dp, 2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, &
      -2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp, &
      2.29415733870561744e-01_dp, 6.88247201611685178e-01_dp, 6.88247201611685178e-01_dp &
    /), (/3, 48/))

    ! Mechanical feedback constants
    real(kind=dp), parameter :: A_SN = 3.0e5_dp
    real(kind=dp), parameter :: expN_SN = -2.0_dp / 17.0_dp
    real(kind=dp), parameter :: expE_SN = 16.0_dp / 17.0_dp
    real(kind=dp), parameter :: expZ_SN = -0.14_dp
    real(kind=dp), parameter :: f_LOAD = 48.0_dp / 52.0_dp
    real(kind=dp), parameter :: f_LOAD_CEN = 0.0_dp
    real(kind=dp), parameter :: f_CANCEL = 0.9387_dp
    real(kind=dp), parameter :: f_ESN = 0.676_dp

    integer :: tid, tid_star, lane, ipart, igrid, icell, idim, info, ivar
    integer :: igridn, icelln, level_nbor, cell_level
    real(kind=dp) :: mejecta, dloss, ekloss, zloss, dzloss, num_sn, up, vp, wp, d_nei
    real(kind=dp) :: dold, vp_sum, xs, inv_dx_loc, inv_2dx_loc, inv_4dx_loc
    real(kind=dp) :: skip(3)
    real(kind=dp) :: xcen(3), xnei(3)
    real(kind=dp) :: d, u, v, w, e, ekk, eth, T2, z, q(nvar)
    real(kind=dp) :: x_off, y_off, z_off, xnei_min, xnei_max
    real(kind=dp) :: dm_ejecta, dm_load, vol_nei, Z_nei, f_w_cell, nH_nei, Zdepen, f_w_crit
    real(kind=dp) :: vload_rad, f_esn2, vload, p_solid, vol_cell, m_pt, de
    real(kind=dp) :: vv(3), p_pt(3), v_new(3)
    integer :: ix(3), ii(3)
    integer(kind=4) :: ckey_nbor(3)
    integer(kind=8) :: ix8, iy8, iz8, nx, offset, key

    tid = (blockIdx%x - 1) * blockDim%x + threadIdx%x - 1
    tid_star = tid / 48
    lane = mod(tid, 48)

    if (tid_star < num_selected) then
       ! Get the original index of the selected star particle
       ipart = isp_swap(1 + tid_star)
       ! Compute supernova ejecta mass before any thread modifies star_mp
       mejecta = eta_SNII * star_mp(ipart)
    endif
    call syncthreads()

    if (tid_star >= num_selected) return

    skip(1) = skip1
    skip(2) = skip2
    skip(3) = skip3

    inv_dx_loc  = 1.0_dp / dx_loc
    inv_2dx_loc = 0.5_dp * inv_dx_loc
    inv_4dx_loc = 0.25_dp * inv_dx_loc

    ! Try ilevel first
    do idim = 1, 3
       xs = star_xp(ipart + (idim-1)*leading) + skip(idim)
       ix(idim) = floor(xs * inv_2dx_loc)
    end do
    ix8 = int(ix(1), kind=8)
    iy8 = int(ix(2), kind=8)
    iz8 = int(ix(3), kind=8)
    nx  = int(ckey_max_d(ilevel), kind=8)
    offset = key_off_d(ilevel)
    key = offset + ix8 + iy8*nx + iz8*nx*nx
    igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
    cell_level = ilevel

    if (igrid > 0 .and. igrid <= ngridmax) then
       do idim = 1, 3
          xs = star_xp(ipart + (idim-1)*leading) + skip(idim)
          ii(idim) = int(xs * inv_dx_loc - 2*ix(idim))
       end do
       icell = 1
       do idim = 1, 3
          icell = icell + ii(idim) * 2**(idim-1)
       end do
    else
       ! Try ilevel - 1
       do idim = 1, 3
          xs = star_xp(ipart + (idim-1)*leading) + skip(idim)
          ix(idim) = floor(xs * inv_4dx_loc)
       end do
       ix8 = int(ix(1), kind=8)
       iy8 = int(ix(2), kind=8)
       iz8 = int(ix(3), kind=8)
       nx  = int(ckey_max_d(ilevel - 1), kind=8)
       offset = key_off_d(ilevel - 1)
       key = offset + ix8 + iy8*nx + iz8*nx*nx
       igrid = hash_get(hash_key_d, hash_val_d, hash_size_d, key)
       cell_level = ilevel - 1

       if (igrid > 0 .and. igrid <= ngridmax) then
          do idim = 1, 3
             xs = star_xp(ipart + (idim-1)*leading) + skip(idim)
             ii(idim) = int(xs * (0.5_dp * inv_dx_loc) - 2*ix(idim))
          end do
          icell = 1
          do idim = 1, 3
             icell = icell + ii(idim) * 2**(idim-1)
          end do
       endif
    endif

    ! If cell not found, or in ghost zone, or not a leaf cell, we skip
    if (igrid <= 0 .or. igrid > ngridmax) return
    if (grid(igrid)%refined(icell)) return

    if (cell_level == ilevel) then
       vol_cell = vol_loc
    else
       vol_cell = vol_loc * 8.0_dp
    endif

    ! Parent cell center coordinates
    do idim = 1, 3
       xcen(idim) = 2.0_dp * ix(idim) + ii(idim) + 0.5_dp
    end do

    ! Compute supernova properties
    up = star_vp(ipart)
    vp = star_vp(ipart + leading)
    wp = star_vp(ipart + 2*leading)
    dloss = mejecta / vol_cell
    ekloss = dloss * 0.5_dp * (up**2 + vp**2 + wp**2)
    zloss = yield_SNII + (1.0_dp - yield_SNII) * star_zp(ipart)
    dzloss = dloss * zloss
    num_sn = mejecta / m_SN

    ! Central cell properties
    d = max(uold(icell, 1, igrid), smallr)
    u = uold(icell, 2, igrid) / d
    v = uold(icell, 3, igrid) / d
    w = uold(icell, 4, igrid) / d
    e = uold(icell, 5, igrid)
    ekk = 0.5_dp * d * (u**2 + v**2 + w**2)
    eth = e - ekk

    z = 0.0_dp
    if (metal) then
       z = uold(icell, imetal, igrid) / d
    endif

    do ivar = 6, nvar
       if (metal .and. ivar == imetal) cycle
       q(ivar) = uold(icell, ivar, igrid) / d
    end do

    ! Only lane 0 updates the central cell and particle mass
    if (lane == 0) then
       info = atomicadd(unew(icell, 1, igrid), dloss - dloss * f_LOAD - d * f_LOAD_CEN)
       info = atomicadd(unew(icell, 2, igrid), dloss * up - dloss * up * f_LOAD - d * u * f_LOAD_CEN)
       info = atomicadd(unew(icell, 3, igrid), dloss * vp - dloss * vp * f_LOAD - d * v * f_LOAD_CEN)
       info = atomicadd(unew(icell, 4, igrid), dloss * wp - dloss * wp * f_LOAD - d * w * f_LOAD_CEN)
       info = atomicadd(unew(icell, 5, igrid), ekloss - ekloss * f_LOAD - (ekk + eth) * f_LOAD_CEN)

       if (metal) then
          info = atomicadd(unew(icell, imetal, igrid), dzloss - dzloss * f_LOAD - d * z * f_LOAD_CEN)
       endif

       do ivar = 6, nvar
          if (metal .and. ivar == imetal) cycle
          info = atomicadd(unew(icell, ivar, igrid), (dloss - dloss * f_LOAD - d * f_LOAD_CEN) * q(ivar))
       end do

       ! Update particle mass
       star_mp(ipart) = star_mp(ipart) - mejecta

       ! Accumulate total ejecta mass
       info = atomicadd(msn_loc_d, mejecta)
    endif

    ! Each lane processes one of the 48 neighboring cells
    x_off = xSNnei_const(1, lane + 1)
    y_off = xSNnei_const(2, lane + 1)
    z_off = xSNnei_const(3, lane + 1)

    xnei(1) = xcen(1) + x_off
    xnei(2) = xcen(2) + y_off
    xnei(3) = xcen(3) + z_off

    ! Periodic boundary conditions
    do idim = 1, 3
       if (periodic_d(idim)) then
          xnei_min = real(box_ckey_min_d(idim, cell_level + 1), kind=dp)
          xnei_max = real(box_ckey_max_d(idim, cell_level + 1), kind=dp)
          if (xnei(idim) < xnei_min) then
             xnei(idim) = xnei(idim) - xnei_min + xnei_max
          endif
          if (xnei(idim) >= xnei_max) then
             xnei(idim) = xnei(idim) + xnei_min - xnei_max
          endif
       endif
    end do

    level_nbor = cell_level
    ckey_nbor(1) = int(xnei(1))
    ckey_nbor(2) = int(xnei(2))
    ckey_nbor(3) = int(xnei(3))

    call get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, level_nbor, ckey_nbor, igridn, icelln)

    if (igridn <= 0 .or. igridn > ngridmax) then
       level_nbor = cell_level - 1
       ckey_nbor(1) = int(xnei(1) * 0.5_dp)
       ckey_nbor(2) = int(xnei(2) * 0.5_dp)
       ckey_nbor(3) = int(xnei(3) * 0.5_dp)
       call get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, level_nbor, ckey_nbor, igridn, icelln)
    else if (grid(igridn)%refined(icelln)) then
       level_nbor = cell_level + 1
       ckey_nbor(1) = int(xnei(1) * 2.0_dp)
       ckey_nbor(2) = int(xnei(2) * 2.0_dp)
       ckey_nbor(3) = int(xnei(3) * 2.0_dp)
       call get_cell_by_key(hash_key_d, hash_val_d, hash_size_d, ckey_max_d, key_off_d, level_nbor, ckey_nbor, igridn, icelln)
    endif

    ! If missing, in ghost zone, or not a leaf cell, skip
    if (igridn <= 0 .or. igridn > ngridmax) return
    if (grid(igridn)%refined(icelln)) return

    ! Cell volume ratio relative to parent cell level
    if (level_nbor == cell_level) then
       vol_nei = 1.0_dp
    else if (level_nbor == cell_level - 1) then
       vol_nei = 8.0_dp
    else
       vol_nei = 0.125_dp
    endif

    Z_nei = z_ave * 0.02_dp
    d_nei = max(uold(icelln, 1, igridn), smallr)
    if (metal) then
       Z_nei = uold(icelln, imetal, igridn) / d_nei
    endif

    ! Compute actual mass ratio
    dm_ejecta = dloss * f_LOAD / 48.0_dp
    dm_load = dm_ejecta + d * f_LOAD_CEN / 48.0_dp
    f_w_cell = (dm_load + d_nei / 8.0_dp) / dm_ejecta - 1.0_dp

    ! Compute critical mass ratio
    nH_nei = d_nei * scale_nH
    Zdepen = (max(0.01_dp, Z_nei / 0.02_dp))**(expZ_SN * 2.0_dp)
    f_w_crit = (A_SN / 1.0e4_dp)**2.0_dp / (f_ESN * M_SNII) * num_sn**((expE_SN - 1.0_dp) * 2.0_dp) * E_SNII_51**(2.0_dp * expE_SN - 1.0_dp) * nH_nei**(expN_SN * 2.0_dp) * Zdepen - 1.0_dp
    f_w_crit = max(0.0_dp, f_w_crit)

    ! Compute SN terminal velocity
    vload_rad = sqrt(2.0_dp * f_ESN * e_SN * (1.0_dp + f_w_crit)) / f_CANCEL / (1.0_dp + f_w_cell) / f_LOAD

    if (f_w_cell >= f_w_crit) then
       vload = vload_rad
    else
       f_esn2 = 1.0_dp - (1.0_dp - f_ESN) * f_w_cell / f_w_crit
       vload = sqrt(2.0_dp * f_esn2 * e_SN / (1.0_dp + f_w_cell)) / f_LOAD
    endif
    if (vload > vload_rad) vload = vload_rad

    ! Compute radial momentum
    p_solid = (1.0_dp + f_w_cell) * dm_ejecta * vload

    ! Energy: kinetic energy change of the gas of the sample point after
    ! merging with the loaded mass and the shell momentum, so that its
    ! thermal energy is unchanged (plus the thermal energy of the gas
    ! loaded from the central cell)
    m_pt = d_nei / 8.0_dp
    vv(1) = uold(icelln, 2, igridn) / d_nei
    vv(2) = uold(icelln, 3, igridn) / d_nei
    vv(3) = uold(icelln, 4, igridn) / d_nei
    p_pt(1) = (dloss * up * f_LOAD + d * u * f_LOAD_CEN) / 48.0_dp + p_solid * vSNnei_const(1, lane + 1)
    p_pt(2) = (dloss * vp * f_LOAD + d * v * f_LOAD_CEN) / 48.0_dp + p_solid * vSNnei_const(2, lane + 1)
    p_pt(3) = (dloss * wp * f_LOAD + d * w * f_LOAD_CEN) / 48.0_dp + p_solid * vSNnei_const(3, lane + 1)
    v_new(1:3) = (m_pt * vv(1:3) + p_pt(1:3)) / (m_pt + dm_load)
    de = 0.5_dp * (m_pt + dm_load) * (v_new(1)**2 + v_new(2)**2 + v_new(3)**2) &
         - 0.5_dp * m_pt * (vv(1)**2 + vv(2)**2 + vv(3)**2) + eth * f_LOAD_CEN / 48.0_dp

    ! Deposit contributions to neighbor cell using atomicadd
    info = atomicadd(unew(icelln, 1, igridn), (dloss * f_LOAD + d * f_LOAD_CEN) / 48.0_dp / vol_nei)
    info = atomicadd(unew(icelln, 2, igridn), (dloss * up * f_LOAD + d * u * f_LOAD_CEN) / 48.0_dp / vol_nei)
    info = atomicadd(unew(icelln, 3, igridn), (dloss * vp * f_LOAD + d * v * f_LOAD_CEN) / 48.0_dp / vol_nei)
    info = atomicadd(unew(icelln, 4, igridn), (dloss * wp * f_LOAD + d * w * f_LOAD_CEN) / 48.0_dp / vol_nei)
    info = atomicadd(unew(icelln, 5, igridn), de / vol_nei)

    if (metal) then
       info = atomicadd(unew(icelln, imetal, igridn), (dzloss * f_LOAD + d * z * f_LOAD_CEN) / 48.0_dp / vol_nei)
    endif

    do ivar = 6, nvar
       if (metal .and. ivar == imetal) cycle
       info = atomicadd(unew(icelln, ivar, igridn), (dloss * f_LOAD + d * f_LOAD_CEN) * q(ivar) / 48.0_dp / vol_nei)
    end do

    info = atomicadd(unew(icelln, 2, igridn), p_solid * vSNnei_const(1, lane + 1) / vol_nei)
    info = atomicadd(unew(icelln, 3, igridn), p_solid * vSNnei_const(2, lane + 1) / vol_nei)
    info = atomicadd(unew(icelln, 4, igridn), p_solid * vSNnei_const(3, lane + 1) / vol_nei)

  end subroutine mechanical_feedback_kernel

end module feedback_device
